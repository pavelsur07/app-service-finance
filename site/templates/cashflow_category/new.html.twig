{% extends 'base.html.twig' %}
{% block title %}Новая статья ДДС{% endblock %}
{% block body %}
    <div class="page-header d-print-none">
        <div class="container-xl">
            <div class="row g-2 align-items-center">
                <div class="col">
                    <div class="page-pretitle">Справочники · Категории ДДС</div>
                    <h2 class="page-title">Новая статья ДДС</h2>
                </div>
                <div class="col-auto ms-auto">
                    <div class="btn-list">
                        <a href="{{ path('cashflow_category_index') }}" class="btn btn-ghost-secondary d-none d-sm-inline-flex"><i class="ti ti-arrow-left me-1"></i>К списку</a>
                        <button type="submit" form="cashflow-category-new-form" class="btn btn-primary"><i class="ti ti-device-floppy me-1"></i>Сохранить</button>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="container-xl mt-3">
        {{ form_start(form, {'attr': {'id': 'cashflow-category-new-form'}}) }}
        <div class="row row-cards">
            <div class="col-lg-8">
                <div class="card">
                    <div class="card-header">
                        <h3 class="card-title">Основные данные</h3>
                    </div>
                    <div class="card-body">
                        <div class="row g-3">
                            <div class="col-md-8">
                                {{ form_row(form.name) }}
                            </div>
                            <div class="col-md-4">
                                {{ form_row(form.code) }}
                            </div>
                            <div class="col-md-6">
                                {{ form_row(form.parent) }}
                            </div>
                            <div class="col-md-6">
                                {{ form_row(form.plCategory) }}
                            </div>
                            <div class="col-12">
                                {{ form_row(form.description) }}
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <div class="col-lg-4">
                <div class="card">
                    <div class="card-header"><h3 class="card-title">Параметры</h3></div>
                    <div class="card-body">
                        {{ form_row(form.status) }}
                        {{ form_row(form.sort) }}
                        {{ form_row(form.allowPlDocument, {'label_attr': {'class': 'checkbox-switch'}}) }}
                        {% if form.flowKind is defined %}
                            {{ form_row(form.flowKind, {'help': 'только для категорий верхнего уровня'}) }}
                        {% endif %}
                    </div>
                </div>
            </div>
        </div>
        {{ form_rest(form) }}
        {{ form_end(form) }}
    </div>
{% endblock %}
