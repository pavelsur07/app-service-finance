{#
  Кнопка «Удалить» статьи ДДС: открывает #cashflow-category-confirm (partials/_confirm_modal).
  Используемую статью удалить нельзя — диалог объясняет почему и ведёт к её операциям.
  Параметры: category, usage (CashflowCategoryUsage|null), class, label.
#}
{% set in_use = usage is not null and usage.used %}
<button type="button" class="{{ class }}"
        data-bs-toggle="modal" data-bs-target="#cashflow-category-confirm"
        data-confirm-action="{{ path('cashflow_category_delete', {id: category.id}) }}"
        data-confirm-token="{{ csrf_token('delete' ~ category.id) }}"
        {% if in_use %}
        data-confirm-blocked="true"
        data-confirm-title="Статью нельзя удалить"
        data-confirm-body="«{{ category.name }}». {{ usage.summary }} Перенесите их на другую статью, затем удалите эту."
        {% if usage.transactions > 0 %}
        data-confirm-link-href="{{ path('cash_transaction_index', {categoryId: category.id}) }}"
        data-confirm-link-label="Показать операции"
        {% endif %}
        {% else %}
        data-confirm-title="Удалить статью?"
        data-confirm-body="«{{ category.name }}» будет удалена без возможности восстановления."
        data-confirm-submit="Удалить"
        data-confirm-variant="danger"
        {% endif %}>{{ label|raw }}</button>
