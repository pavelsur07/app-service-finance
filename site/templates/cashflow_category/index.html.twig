{% macro render_items(items, usage) %}
    <ul class="cashflow-category-list list-unstyled mb-0">
    {% for item in items %}
        {% set has_children = item.children|length > 0 %}
        <li class="cashflow-category-node">
            <div class="cashflow-category-item d-flex align-items-center">
                {% if has_children %}
                    <button class="cashflow-category-toggle btn btn-link btn-sm p-0 me-2 collapsed" type="button" aria-expanded="false">
                        <span class="visually-hidden">Переключить вложенные статьи</span>
                    </button>
                {% else %}
                    <span class="cashflow-category-toggle-placeholder me-2"></span>
                {% endif %}
                <a href="{{ path('cashflow_category_edit', {'id': item.id}) }}" class="cashflow-category-link text-reset text-decoration-none" title="{{ item.name }}">{{ item.name }}</a>
                <span class="cashflow-category-col cashflow-category-col--code">
                    {% if item.code %}
                        <span class="badge bg-secondary-lt" title="{{ item.code }}">{{ item.code }}</span>
                    {% endif %}
                </span>
                <span class="cashflow-category-col cashflow-category-col--pl">
                    {% if item.allowPlDocument %}
                        <span class="cashflow-category-pl-yes" title="Можно создавать документ ОПиУ" aria-hidden="true">✓</span>
                        <span class="visually-hidden">ОПиУ: можно создавать документ</span>
                    {% else %}
                        <span class="cashflow-category-pl-no" title="Нельзя создавать документ ОПиУ" aria-hidden="true">—</span>
                        <span class="visually-hidden">ОПиУ: нельзя создавать документ</span>
                    {% endif %}
                </span>
                <span class="cashflow-category-col cashflow-category-col--actions">
                    {% if not item.system %}
                    {{ include('cashflow_category/_delete_trigger.html.twig', {category: item, usage: usage[item.id] ?? null, class: 'btn btn-sm btn-danger', label: '🗑'}, with_context=false) }}
                    {% endif %}
                </span>
            </div>
            {% if has_children %}
                <div class="cashflow-category-children" hidden>
                    {{ _self.render_items(item.children, usage) }}
                </div>
            {% endif %}
        </li>
    {% endfor %}
    </ul>
{% endmacro %}

{% import _self as macros %}

{% block body %}
    {% embed 'partials/_page_header.html.twig' with {title: 'Статьи ДДС'} %}
        {% block actions %}
            <div class="d-flex gap-2">
                <a href="{{ path('cashflow_category_export_json') }}" class="btn btn-outline-primary">Выгрузить справочник ДДС (JSON)</a>
                <a href="{{ path('cashflow_category_new') }}" class="btn btn-primary">+ Добавить статью</a>
            </div>
        {% endblock %}
    {% endembed %}
    <div class="container-xl mt-3">
            <div class="card">
            <div class="card-body">
                <div class="cashflow-category-head d-flex align-items-center" aria-hidden="true">
                    <span class="cashflow-category-head-name">Статья</span>
                    <span class="cashflow-category-col cashflow-category-col--code"></span>
                    <span class="cashflow-category-col cashflow-category-col--pl">ОПиУ</span>
                    <span class="cashflow-category-col cashflow-category-col--actions"></span>
                </div>
                {{ macros.render_items(items, usage) }}
            </div>
        </div>
    </div>
    {% include 'partials/_confirm_modal.html.twig' with {id: 'cashflow-category-confirm'} only %}
{% endblock %}

{% block javascripts %}
    {{ parent() }}
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            document.querySelectorAll('.cashflow-category-toggle').forEach(function (button) {
                button.addEventListener('click', function () {
                    var node = button.closest('.cashflow-category-node');
                    if (!node) {
                        return;
                    }

                    var children = null;
                    for (var i = 0; i < node.children.length; i++) {
                        var child = node.children[i];
                        if (child.classList && child.classList.contains('cashflow-category-children')) {
                            children = child;
                            break;
                        }
                    }

                    if (!children) {
                        return;
                    }

                    var isHidden = children.hasAttribute('hidden');
                    if (isHidden) {
                        children.removeAttribute('hidden');
                    } else {
                        children.setAttribute('hidden', '');
                    }

                    button.classList.toggle('collapsed', !isHidden);
                    button.setAttribute('aria-expanded', String(isHidden));
                });
            });
        });
    </script>
{% endblock %}
