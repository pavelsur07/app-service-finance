{% extends 'base.html.twig' %}
{% block title %}Редактирование статьи ДДС{% endblock %}
{% block body %}
    <div class="page-header d-print-none">
        <div class="container-xl">
            <div class="row g-2 align-items-center">
                <div class="col">
                    <div class="page-pretitle">Справочники · Категории ДДС</div>
                    <h2 class="page-title">Редактирование «{{ article.name }}»</h2>
                </div>
                <div class="col-auto ms-auto">
                    <div class="btn-list">
                        <a href="{{ path('cashflow_category_index') }}" class="btn btn-ghost-secondary d-none d-sm-inline-flex"><i class="ti ti-arrow-left me-1"></i>К списку</a>
                        {% if not article.system %}
                            <form method="post" action="{{ path('cashflow_category_delete', {'id': article.id}) }}" class="d-inline" onsubmit="return confirm('Удалить категорию?');">
                                <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ article.id) }}">
                                <button type="submit" class="btn btn-ghost-danger"><i class="ti ti-trash me-1"></i>Удалить</button>
                            </form>
                        {% endif %}
                        <button type="submit" form="cashflow-category-edit-form" class="btn btn-primary"><i class="ti ti-device-floppy me-1"></i>Сохранить</button>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="container-xl mt-3">
        {{ form_start(form, {'attr': {'id': 'cashflow-category-edit-form'}}) }}
        <div class="row row-cards">
            <div class="col-lg-8">
                <div class="card">
                    <div class="card-header">
                        <h3 class="card-title">Основные данные</h3>
                        <div class="card-actions">
                            {% if article.status.value == 'active' %}
                                <span class="badge bg-green-lt"><i class="ti ti-point-filled"></i>Активна</span>
                            {% else %}
                                <span class="badge bg-secondary-lt"><i class="ti ti-point-filled"></i>Не активна</span>
                            {% endif %}
                        </div>
                    </div>
                    <div class="card-body">
                        {% if article.system %}
                            <div class="alert alert-info">
                                Системную категорию нельзя переименовать, переместить или удалить.
                            </div>
                        {% endif %}
                        <div class="row g-3">
                            {% if article.system %}
                                <div class="col-md-8">
                                    <label class="form-label">Наименование</label>
                                    <input type="text" class="form-control" value="{{ article.name }}" disabled>
                                </div>
                                <div class="col-md-4">
                                    <label class="form-label">Код</label>
                                    <input type="text" class="form-control" value="{{ article.code }}" disabled>
                                </div>
                                <div class="col-md-6">
                                    <label class="form-label">Родитель</label>
                                    <input type="text" class="form-control" value="{{ article.parent ? article.parent.name : '— Нет (корневая категория) —' }}" disabled>
                                </div>
                            {% else %}
                                <div class="col-md-8">
                                    {{ form_row(form.name) }}
                                </div>
                                <div class="col-md-4">
                                    {{ form_row(form.code) }}
                                </div>
                                <div class="col-md-6">
                                    {{ form_row(form.parent) }}
                                </div>
                            {% endif %}
                            <div class="col-md-6">
                                {{ form_row(form.plCategory) }}
                            </div>
                            <div class="col-12">
                                {{ form_row(form.description) }}
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <div class="col-lg-4">
                <div class="card">
                    <div class="card-header"><h3 class="card-title">Параметры</h3></div>
                    <div class="card-body">
                        {{ form_row(form.status) }}
                        {% if form.sort is defined %}
                            {{ form_row(form.sort) }}
                        {% else %}
                            <div class="mb-3">
                                <label class="form-label">Сортировка</label>
                                <input type="number" class="form-control" value="{{ article.sort }}" disabled>
                            </div>
                        {% endif %}
                        {{ form_row(form.allowPlDocument, {'label_attr': {'class': 'checkbox-switch'}}) }}
                        {% if form.flowKind is defined %}
                            {{ form_row(form.flowKind, {'help': 'только для категорий верхнего уровня'}) }}
                        {% endif %}
                    </div>
                </div>
            </div>
        </div>
        {{ form_rest(form) }}
        {{ form_end(form) }}
    </div>
{% endblock %}
