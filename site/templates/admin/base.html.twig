{#
  Admin base layout (UI Kit v2.3) — monolithic, self-contained (no partial includes).
  Origin: screens/AdminShell.dc.html via screen-intake; replaced legacy Tabler base.

  Blocks for child templates: title, admin_styles, body, admin_scripts.
  Remaining TODO: Stimulus collapse for domain groups, breadcrumb, app.user identity.
  NB: admin child templates are still legacy Tabler markup — migrate per screens matrix.
#}
<!DOCTYPE html>
<html lang="ru">
<head>
    <meta charset="UTF-8"/>
    <meta name="viewport" content="width=device-width, initial-scale=1"/>
    <title>{% block title %}Admin · {{ app.request.host }}{% endblock %}</title>
    <link rel="icon" type="image/svg+xml" href="{{ asset('static/favicon.svg') }}">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Manrope:wght@400;500;600;700;800&display=swap" rel="stylesheet">

  {{ vite_entry_link_tags('design_tokens') }}
  {{ vite_entry_link_tags('vf_custom_classes') }}
  {{ vite_entry_link_tags('app') }}
  {{ vite_entry_link_tags('admin_shell') }}
  {% block admin_styles %}{% endblock %}
</head>
<body>
<div class="app">

  {# ====================== APP HEADER ====================== #}
  <header class="app-header">
    <div class="app-header-brand">
      <a href="{{ path('admin_dashboard') }}" style="display:block; text-decoration:none;">
        <img src="{{ asset('static/logo-vf-001.png') }}" alt="Ваш Финдир — финансы для бизнеса" style="display:block; height:32px; width:auto; max-width:100%;">
      </a>
    </div>
    <div class="app-header-body">
      <nav class="crumbs">
        <a href="#">Админка</a>
        <span class="crumb-sep"><svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="9 18 15 12 9 6"></polyline></svg></span>
        {# TODO(symfony): breadcrumb текущей страницы через block или переменную #}
        <span class="crumb-current">Панель управления</span>
      </nav>
    </div>
    <div class="app-header-actions">
      <button class="h-btn h-btn--icon" type="button" title="Уведомления">
        <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round"><path d="M18 8A6 6 0 0 0 6 8c0 7-3 9-3 9h18s-3-2-3-9"></path><path d="M13.73 21a2 2 0 0 1-3.46 0"></path></svg>
        <span class="dot"></span>
      </button>
    </div>
  </header>

  <div class="app-body">

    {# ====================== SIDEBAR ====================== #}
    <aside class="app-sidebar">
      <div class="sb">

        <div class="sb-nav">
          <div class="sb-group-title">Основное</div>

          <a class="sb-item {% if app.request.get('_route') starts with 'admin_dashboard' %}is-active{% endif %}" href="{{ path('admin_dashboard') }}">
            <svg class="ico" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="3" width="7" height="9" rx="1"></rect><rect x="14" y="3" width="7" height="5" rx="1"></rect><rect x="14" y="12" width="7" height="9" rx="1"></rect><rect x="3" y="16" width="7" height="5" rx="1"></rect></svg>
            <span class="lbl">Dashboard</span>
          </a>

          <a class="sb-item {% if app.request.get('_route') starts with 'admin_user_' %}is-active{% endif %}" href="{{ path('admin_user_index') }}">
            <svg class="ico" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M17 21v-2a4 4 0 0 0-4-4H7a4 4 0 0 0-4 4v2"></path><circle cx="10" cy="7" r="4"></circle><path d="M23 21v-2a4 4 0 0 0-3-3.87"></path><path d="M16 3.13a4 4 0 0 1 0 7.75"></path></svg>
            <span class="lbl">Пользователи</span>
          </a>

          <a class="sb-item {% if app.request.get('_route') starts with 'admin_telegram_bot_' %}is-active{% endif %}" href="{{ path('admin_telegram_bot_index') }}">
            <svg class="ico" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M22 2L11 13"></path><path d="M22 2l-7 20-4-9-9-4z"></path></svg>
            <span class="lbl">Telegram · Боты</span>
          </a>

          <a class="sb-item {% if app.request.get('_route') starts with 'admin_analytics_pl_recalc_' %}is-active{% endif %}" href="{{ path('admin_analytics_pl_recalc_form') }}">
            <svg class="ico" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><circle cx="5" cy="12" r="2"></circle><circle cx="12" cy="5" r="2"></circle><circle cx="19" cy="12" r="2"></circle><circle cx="12" cy="19" r="2"></circle><path d="M7 12h5M12 7v5M14 13l4 4"></path></svg>
            <span class="lbl">Analytics · PL Recalc</span>
          </a>

          <a class="sb-item {% if app.request.get('_route') starts with 'admin_billing_' %}is-active{% endif %}" href="{{ path('admin_billing_index') }}">
            <svg class="ico" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M14 3H6a2 2 0 0 0-2 2v14l3-2 3 2 3-2 3 2 3-2V8z"></path><path d="M8 9h6M8 13h6M8 17h4"></path></svg>
            <span class="lbl">Billing</span>
          </a>

          <div class="sb-group-title">Домены</div>

          {# TODO(stimulus): collapse-тумблер (добавлять 'is-collapsed' когда группа закрыта) #}
          <button class="sb-item {% if app.request.get('_route') starts with 'admin_marketplace_' %}is-active{% endif %}" type="button">
            <svg class="ico" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><circle cx="9" cy="21" r="1"></circle><circle cx="20" cy="21" r="1"></circle><path d="M1 1h4l2.7 13.4a2 2 0 0 0 2 1.6h9.7a2 2 0 0 0 2-1.6L23 6H6"></path></svg>
            <span class="lbl">Маркетплейсы</span>
            <svg class="chev" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="6 9 12 15 18 9"></polyline></svg>
          </button>
          {# TODO(stimulus): скрывать/показывать .sb-sub по состоянию тумблера выше #}
          <div class="sb-sub">
            <a class="sb-item {% if app.request.get('_route') == 'admin_marketplace_mapping_errors' %}is-active{% endif %}" href="{{ path('admin_marketplace_mapping_errors') }}"><span class="ico-dot"></span><span class="lbl">Неизвестные затраты</span></a>
            <a class="sb-item {% if app.request.get('_route') starts with 'admin_marketplace_reprocess_' %}is-active{% endif %}" href="{{ path('admin_marketplace_reprocess_index') }}"><span class="ico-dot"></span><span class="lbl">Переобработка затрат</span></a>
          </div>

          {# TODO(stimulus): collapse-тумблер (добавлять 'is-collapsed' когда группа закрыта) #}
          <button class="sb-item {% if app.request.get('_route') starts with 'admin_ingestion_' %}is-active{% endif %}" type="button">
            <svg class="ico" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><ellipse cx="12" cy="5" rx="9" ry="3"></ellipse><path d="M3 5v6c0 1.7 4 3 9 3s9-1.3 9-3V5"></path><path d="M3 11v6c0 1.7 4 3 9 3s9-1.3 9-3v-6"></path></svg>
            <span class="lbl">Ingestion</span>
            <svg class="chev" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="6 9 12 15 18 9"></polyline></svg>
          </button>
          {# TODO(stimulus): скрывать/показывать .sb-sub по состоянию тумблера выше #}
          <div class="sb-sub">
            <a class="sb-item {% if app.request.get('_route') starts with 'admin_ingestion_external_categories_' %}is-active{% endif %}" href="{{ path('admin_ingestion_external_categories_index') }}"><span class="ico-dot"></span><span class="lbl">Внешние категории</span></a>
          </div>

          <div class="sb-group-title">Прочее</div>

          <a class="sb-item {% if app.request.get('_route') starts with 'admin_demo' %}is-active{% endif %}" href="{{ path('admin_demo') }}">
            <svg class="ico" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M17 21v-2a4 4 0 0 0-4-4H7a4 4 0 0 0-4 4v2"></path><circle cx="10" cy="7" r="4"></circle></svg>
            <span class="lbl">Demo</span>
          </a>
        </div>

        <div class="sb-foot">
          {# TODO(symfony): инициалы/имя/роль из app.user #}
          <span class="avatar avatar--md avatar--tint-4">ДС</span>
          <div style="flex:1; min-width:0; line-height:1.2;">
            <div class="me-name" style="white-space:nowrap; overflow:hidden; text-overflow:ellipsis;">{{ app.user ? app.user.email : 'Дмитрий Соколов' }}</div>
            <div class="me-role">Super-admin</div>
          </div>
          <a class="settings" href="{{ path('app_logout') }}" title="Выйти">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"></path><polyline points="16 17 21 12 16 7"></polyline><line x1="21" y1="12" x2="9" y2="12"></line></svg>
          </a>
        </div>
      </div>
    </aside>

    {# ====================== WORK ZONE ====================== #}
    <main class="app-workzone">
      {% block body %}{% endblock %}
    </main>
  </div>
</div>
{% block admin_scripts %}{% endblock %}
</body>
</html>
