{#
  Admin base layout (UI Kit) — app-shell scaffold + header/sidebar partials.
  Origin: screens/AdminShell.dc.html via screen-intake; replaced legacy Tabler base.

  Partials: admin/partials/_header.html.twig, admin/partials/_sidebar.html.twig.
  Blocks for child templates: title, admin_styles, body, admin_modals,
  admin_portals, admin_scripts.
  Remaining TODO: Stimulus collapse for domain groups, breadcrumb, app.user identity.
  NB: admin child templates are still legacy Tabler markup — migrate per screens matrix.
#}
<!DOCTYPE html>
<html lang="ru">
<head>
    <meta charset="UTF-8"/>
    <meta name="viewport" content="width=device-width, initial-scale=1"/>
    <title>{% block title %}Admin · {{ app.request.host }}{% endblock %}</title>
    <link rel="icon" type="image/svg+xml" href="{{ asset('static/favicon.svg') }}">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Manrope:wght@400;500;600;700;800&display=swap" rel="stylesheet">

  {{ vite_entry_link_tags('app') }}
  {{ vite_entry_link_tags('admin_shell') }}
  {% block admin_styles %}{% endblock %}
</head>
<body class="uikit-base">
{% include 'admin/_toasts.html.twig' %}

<div class="app">

  {% include 'admin/partials/_header.html.twig' %}

  <div class="app-body">

    {% include 'admin/partials/_sidebar.html.twig' %}

    {# ====================== WORK ZONE ====================== #}
    <main class="app-workzone">
      {% block body %}{% endblock %}
    </main>
  </div>
</div>

<div id="admin-modal-root"></div>
<div id="admin-drawer-root"></div>
<div id="admin-live-region" class="sr-only" aria-live="polite" aria-atomic="true"></div>

<dialog id="admin-confirm-dialog" class="dlg" aria-labelledby="admin-confirm-title" aria-describedby="admin-confirm-message">
  <div class="mdl mdl--compact">
    <div class="confirm-body">
      <div id="admin-confirm-title" class="confirm-title">Подтвердить действие?</div>
      <div id="admin-confirm-message" class="confirm-text">Действие будет выполнено после подтверждения.</div>
    </div>
    <div class="confirm-foot">
      <button type="button" class="btn btn-md btn-secondary" data-admin-confirm-cancel>Отмена</button>
      <button type="button" class="btn btn-md btn-danger-solid" data-admin-confirm-accept>Подтвердить</button>
    </div>
  </div>
</dialog>

{% block admin_modals %}{% endblock %}
{% block admin_portals %}{% endblock %}
{{ vite_entry_script_tags('admin_shell_runtime') }}
{% block admin_scripts %}{% endblock %}
</body>
</html>
