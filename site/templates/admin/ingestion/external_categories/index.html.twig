{% extends 'admin/base.html.twig' %}

{% block title %}Admin · Внешние категории Ingestion{% endblock %}

{% block body %}
  {% set category_status_tone = {
    'mapped': 'success',
    'new': 'warning',
    'needs_identification': 'warning',
    'ignored': 'neutral',
    'deprecated': 'neutral',
  } %}
  {% set mapping_status_tone = {
    'active': 'success',
    'needs_review': 'warning',
    'disabled': 'neutral',
  } %}
  {% set category_status_labels = {} %}
  {% for status in category_statuses %}
    {% set category_status_labels = category_status_labels|merge({(status.value): status.label}) %}
  {% endfor %}
  {% set mapping_status_labels = {} %}
  {% for status in mapping_statuses %}
    {% set mapping_status_labels = mapping_status_labels|merge({(status.value): status.label}) %}
  {% endfor %}

  <div class="wz-head">
    <h1 class="wz-title">Внешние категории Ingestion</h1>
  </div>

  <div class="wz-kpi-row">
    <div class="kpi u-flex-1 u-min-w-200">
      <div class="kpi-label">Неклассифицированные операции Ozon</div>
      <div class="kpi-value">{{ unclassified.transactions }}</div>
    </div>
    <div class="kpi u-flex-1 u-min-w-200">
      <div class="kpi-label">Неклассифицированные группы</div>
      <div class="kpi-value">{{ unclassified.groups }}</div>
    </div>
  </div>

  {% include 'admin/ingestion/external_categories/_ozon_new_types.html.twig' with {ozon_type_queue: ozon_type_queue, ozon_groups: ozon_groups} only %}

  {% if ozon_type_disputes is not empty %}
    {% include 'admin/ingestion/external_categories/_ozon_disputes.html.twig' with {ozon_type_disputes: ozon_type_disputes} only %}
  {% endif %}

  {% if last_import %}
    {% include 'admin/ingestion/external_categories/_import_result.html.twig' with {last_import: last_import} only %}
  {% endif %}

  {% include 'admin/ingestion/external_categories/_operations.html.twig' only %}

  {% if last_refresh %}
    {% include 'admin/ingestion/external_categories/_refresh_status.html.twig' with {last_refresh: last_refresh} only %}
  {% endif %}

  {% include 'admin/ingestion/external_categories/_dictionary_statuses.html.twig' with {status_summary: status_summary, category_status_tone: category_status_tone, category_status_labels: category_status_labels} only %}

  {% if latest_categories is empty %}
    {% embed 'partials/_empty.html.twig' with {title: 'Категорий пока нет', hint: 'Запустите discovery — найденные внешние категории Ozon появятся в этом списке.', variant: 'app'} %}
        {% block icon %}
            <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M4 6h16"/><path d="M4 12h16"/><path d="M4 18h16"/></svg>
        {% endblock %}
    {% endembed %}
  {% else %}
    {% include 'admin/ingestion/external_categories/_latest_categories.html.twig' with {latest_categories: latest_categories, category_status_tone: category_status_tone, category_status_labels: category_status_labels, mapping_status_tone: mapping_status_tone, mapping_status_labels: mapping_status_labels} only %}
  {% endif %}
{% endblock %}

{% block admin_modals %}
  {% for row in latest_categories %}
    {% include 'admin/ingestion/external_categories/_modal_mapping.html.twig' with {row: row, ozon_groups: ozon_groups, transaction_types: transaction_types, mapping_statuses: mapping_statuses} only %}
  {% endfor %}
{% endblock %}
