{# Опасные действия (DS-Controls): карточка с рамкой danger, кнопка — danger outline, подтверждение — data-confirm. #}
<section class="card admin-danger-zone">
  <h2>Danger Zone</h2>
  <p class="admin-danger-zone__text">Опасные действия требуют подтверждения и могут повлиять на работу системы.</p>
  <div class="wz-row">
    {% for i in items|default([]) %}
      <div class="card">
        <h3 class="admin-danger-zone__title">{{ i.title }}</h3>
        <p class="admin-danger-zone__text">{{ i.desc }}</p>
        <a href="{{ i.action }}" class="btn btn-md btn-danger" data-confirm="true">Запустить</a>
      </div>
    {% endfor %}
  </div>
</section>
