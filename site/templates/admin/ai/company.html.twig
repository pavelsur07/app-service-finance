{% extends 'admin/base.html.twig' %}

{% block title %}Admin · ИИ · {{ company.name }}{% endblock %}

{% set skipLabels = {
  awaiting_results: 'ждёт ответов прошлого запуска',
  budget_exceeded: 'лимит исчерпан',
  disabled: 'сервис выключен',
  locked: 'идёт другой запуск',
  no_categories: 'нет статей',
  too_many_categories: 'статей больше лимита',
} %}
{% set budget = overview.budget %}

{% block body %}
  <div class="wz-head">
    <div>
      <h1 class="wz-title">ИИ кабинета</h1>
      <div class="wz-subtitle">
        {{ company.name }}{% if company.inn %} · ИНН {{ company.inn }}{% endif %}
      </div>
    </div>
    <a href="{{ path('admin_user_index', {company: company.id}) }}" class="btn btn-md btn-secondary">К пользователям</a>
  </div>

  {# Состояние #}
  <section class="card u-mb-4" data-ai-state>
    <div class="wz-stat-row">
      <div>
        <div class="form-hint">Подключение</div>
        {% if overview.connected %}
          <span class="status status--{{ overview.serviceEnabled ? 'success' : 'warning' }}"><span class="dot"></span>ИИ вкл</span>
          <div class="form-hint">с {{ overview.enabledAt|date('d.m.Y H:i') }}{% if not overview.serviceEnabled %} · сервис выключен (AI_SERVICE_ENABLED){% endif %}</div>
        {% else %}
          <span class="status status--neutral"><span class="dot"></span>ИИ выкл</span>
        {% endif %}
      </div>
      <div data-ai-spent>
        <div class="form-hint">Расход за месяц</div>
        <div class="u-tnum u-fw-600">
          {{ budget.spentRub|number_format(2, ',', ' ') }} ₽ из {{ budget.limitRub|number_format(0, ',', ' ') }} ₽
        </div>
        {% if overview.connected and budget.companyExceeded %}
          <span class="status status--danger" data-ai-exhausted><span class="dot"></span>Лимит исчерпан</span>
        {% endif %}
      </div>
      <div>
        <div class="form-hint">Все компании за месяц</div>
        <div class="u-tnum">{{ budget.totalSpentRub|number_format(2, ',', ' ') }} ₽ из {{ budget.totalLimitRub|number_format(0, ',', ' ') }} ₽</div>
        {% if budget.totalExceeded %}
          <span class="status status--danger"><span class="dot"></span>Общий лимит исчерпан</span>
        {% endif %}
      </div>
      <div>
        <div class="form-hint">Результатов / токенов за месяц</div>
        <div class="u-tnum">
          {{ overview.resultsThisMonth }} · {{ overview.inputTokensThisMonth|number_format(0, ',', ' ') }} вход / {{ overview.outputTokensThisMonth|number_format(0, ',', ' ') }} выход
        </div>
      </div>
      <div>
        <div class="form-hint">Последний запуск</div>
        {% set last = overview.lastRun %}
        {% if last %}
          <div class="u-tnum">{{ last.ranAt|date('d.m.Y H:i') }}</div>
          <div class="form-hint">
            {%- if last.error -%}сбой: {{ last.error }}
            {%- elseif last.skippedReason -%}пропуск: {{ skipLabels[last.skippedReason] ?? last.skippedReason }}
            {%- else -%}отправлено операций: {{ last.requested }}{%- endif -%}
          </div>
        {% else %}
          <div>—</div>
        {% endif %}
      </div>
    </div>
  </section>

  <div class="wz-card-grid">
    {# Лимиты / подключение #}
    <section class="card">
      {% if overview.connected %}
        <h2 class="wz-card-title">Лимиты</h2>
        <p class="form-hint u-m-0 u-mb-3">Расход считается по календарному месяцу; при исчерпании новые операции не отправляются до нового месяца или повышения лимита.</p>
        <form method="post" action="{{ path('admin_ai_company_limits', {companyId: company.id}) }}" data-ai-limits-form>
          <input type="hidden" name="_token" value="{{ csrf_token('ai_company_limits_' ~ company.id) }}">
      {% else %}
        <h2 class="wz-card-title">Подключить ИИ</h2>
        <p class="form-hint u-m-0 u-mb-3">Операции без статьи за выбранный период уйдут в ближайший запуск (в :25 каждого часа) — это платные запросы к LLM.</p>
        <form method="post" action="{{ path('admin_ai_company_access', {companyId: company.id}) }}" data-ai-connect-form>
          <input type="hidden" name="_token" value="{{ csrf_token('ai_company_access_' ~ company.id) }}">
          <input type="hidden" name="enabled" value="1">
          <input type="hidden" name="return_to" value="company">
      {% endif %}
          <div class="u-flex u-gap-3">
            <div class="form-field u-flex-1">
              <label class="form-label" for="ai-limit">Лимит в месяц, ₽</label>
              <input id="ai-limit" type="text" inputmode="decimal" name="monthly_limit_rub" class="input" value="{{ budget.limitRub|number_format(2, ',', '') }}" required>
            </div>
            <div class="form-field u-flex-1">
              <label class="form-label" for="ai-lookback">Глубина выгрузки</label>
              <select id="ai-lookback" name="lookback_days" class="select">
                {% for days in lookbackChoices %}
                  <option value="{{ days }}" {% if days == budget.lookbackDays %}selected{% endif %}>{{ days }} дней</option>
                {% endfor %}
              </select>
            </div>
          </div>
          <button type="submit" class="btn btn-md btn-primary">{{ overview.connected ? 'Сохранить' : 'Подключить' }}</button>
        </form>
    </section>

    {# Подсказки #}
    <section class="card" data-ai-suggestions>
      <h2 class="wz-card-title">Подсказки за {{ statsDays }} дней</h2>
      {% set precision = stats.precision %}
      <p class="form-hint u-m-0 u-mb-3">
        Доля верных среди решённых людьми: {{ precision is null ? '— (решений нет)' : (precision * 100)|round(0) ~ ' %' }}
        {%- if stats.corrected or stats.confirmedByEdit %} · правкой операции: подтверждено {{ stats.confirmedByEdit }}, исправлено {{ stats.corrected }}{% endif %}
      </p>
      <p class="form-hint u-m-0 u-mb-3" data-ai-transfer-skipped>
        Похоже на перевод собственных средств, в ИИ не отправлено (операции за {{ transferWindowDays }} дней): {{ stats.transferLikeSkipped }}
      </p>
      {% if stats.byStatus is empty %}
        <div class="form-hint">Подсказок не было.</div>
      {% else %}
        <table class="t-table">
          <tbody>
            {% for status, count in stats.byStatus %}
              {% set statusEnum = enum('App\\Cash\\Enum\\Transaction\\CashCategorySuggestionStatus').tryFrom(status) %}<tr><td>{{ statusEnum ? statusEnum.label() : status }}</td><td class="t-cell--right u-tnum">{{ count }}</td></tr>
            {% endfor %}
          </tbody>
        </table>
      {% endif %}
    </section>
  </div>

  {# Журнал запусков #}
  <section class="card u-p-0 wz-scroll" data-ai-runs>
    <div class="wz-card-intro"><h2 class="u-fs-15 u-m-0">Запуски</h2></div>
    {% if overview.runs is empty %}
      <div class="form-hint u-p-4">Запусков ещё не было: cron идёт в :25 каждого часа.</div>
    {% else %}
      <table class="t-table">
        <thead>
          <tr>
            <th>Время</th>
            <th class="t-cell--right">Операций</th>
            <th class="t-cell--right">Задач</th>
            <th class="t-cell--right">Переотправлено</th>
            <th class="t-cell--right">Просрочено</th>
            <th>Итог</th>
          </tr>
        </thead>
        <tbody>
          {% for run in overview.runs %}
            <tr>
              <td class="u-tnum">{{ run.ranAt|date('d.m.Y H:i') }}</td>
              <td class="t-cell--right">{{ run.requested }}</td>
              <td class="t-cell--right">{{ run.tasks }}</td>
              <td class="t-cell--right">{{ run.redispatched }}</td>
              <td class="t-cell--right">{{ run.expired }}</td>
              <td>
                {% if run.error %}
                  <span class="status status--danger"><span class="dot"></span>Сбой</span> <span class="form-hint">{{ run.error }}</span>
                {% elseif run.skippedReason %}
                  <span class="status status--warning"><span class="dot"></span>{{ skipLabels[run.skippedReason] ?? run.skippedReason }}</span>
                {% else %}
                  <span class="status status--success"><span class="dot"></span>Готово</span>
                {% endif %}
              </td>
            </tr>
          {% endfor %}
        </tbody>
      </table>
    {% endif %}
  </section>
{% endblock %}
