{% extends 'admin/base.html.twig' %}

{% block title %}Admin · Удаление пользователя{% endblock %}

{% block body %}
  <div class="wz-head">
    <h1 class="wz-title">Удаление пользователя<span class="wz-sub">{{ user.email }}</span></h1>
  </div>

  <section class="card">
    <div class="alert alert--warning" role="alert">
      <div class="a-body">
        <p class="a-text"><strong>Внимание:</strong> удаление пользователя приведёт к безвозвратному удалению всех связанных с ним данных
        (компаний, финансовых операций, интеграций и логов).</p>
      </div>
    </div>

    <form method="post" action="{{ path('admin_user_delete', { id: user.id }) }}">
      <input type="hidden" name="_token" value="{{ csrf_token('admin_user_delete_' ~ user.id) }}">

      <div class="form-field admin-delete-field">
        <label for="confirm-email" class="form-label">Введите email пользователя для подтверждения</label>
        <input
          type="email"
          id="confirm-email"
          name="email"
          required
          class="input"
          placeholder="{{ userEmail }}"
          value="{{ enteredEmail }}"
          autocomplete="off"
        >
        <p class="field-helper">Удаление станет доступным только после точного ввода email.</p>
      </div>

      <div class="wz-actions">
        {# DS-Controls: подтверждение необратимого действия — сплошная опасная кнопка. #}
        <button type="submit" class="btn btn-md btn-danger-solid">Удалить пользователя</button>
        <a href="{{ path('admin_user_index') }}" class="btn btn-md btn-secondary">Отмена</a>
      </div>
    </form>
  </section>
{% endblock %}
