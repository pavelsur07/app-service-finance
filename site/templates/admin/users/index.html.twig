{% extends 'admin/base.html.twig' %}

{% block title %}Admin · Пользователи{% endblock %}

{% block body %}
  <div class="wz-head">
    <h1 class="wz-title">{{ title }}</h1>
    <button type="button" class="btn btn-md btn-primary" data-admin-dialog-open="account-create-dialog">
      <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg>
      Добавить аккаунт
    </button>
  </div>

  <div class="wz-kpi-row">
    <div class="kpi u-flex-1 u-min-w-200">
      <div class="kpi-label">Всего пользователей</div>
      <div class="kpi-value">{{ totalUsers }}</div>
    </div>
    <div class="kpi u-flex-1 u-min-w-200">
      <div class="kpi-label">За последние 7 дней</div>
      <div class="kpi-value">{{ recentUsers }}</div>
      <div class="kpi-meta">новые регистрации</div>
    </div>
  </div>

  <form method="get" action="{{ path('admin_user_index') }}" class="card u-p-3" style="display:flex;gap:var(--s-3);align-items:flex-end;flex-wrap:wrap;margin-bottom:var(--s-3);">
    <div class="form-field" style="margin:0;min-width:300px;">
      <label class="form-label" for="filter-company">Кабинет</label>
      <select id="filter-company" name="company" class="select">
        <option value="" {% if filter.companyId is null and not filter.withoutCompany %}selected{% endif %}>Все кабинеты</option>
        <option value="none" {% if filter.withoutCompany %}selected{% endif %}>— Без кабинета —</option>
        {% for cabinet in cabinetChoices %}
          <option value="{{ cabinet.id }}" {% if filter.companyId == cabinet.id %}selected{% endif %}>{{ cabinet.name }}{% if cabinet.inn %} · ИНН {{ cabinet.inn }}{% endif %}</option>
        {% endfor %}
      </select>
    </div>
    <button type="submit" class="btn btn-md btn-primary">Применить</button>
    {% if filter.active %}
      <a href="{{ path('admin_user_index') }}" class="btn btn-md btn-ghost">Сбросить</a>
    {% endif %}
    {# тоггл сохраняет фильтр кабинета; page не передаём — пагинация сбрасывается #}
    {% set ownersToggleParams = {} %}
    {% if filter.withoutCompany %}
      {% set ownersToggleParams = ownersToggleParams|merge({company: 'none'}) %}
    {% elseif filter.companyId is not null %}
      {% set ownersToggleParams = ownersToggleParams|merge({company: filter.companyId}) %}
    {% endif %}
    {% if not filter.ownersOnly %}
      {% set ownersToggleParams = ownersToggleParams|merge({owners: 1}) %}
    {% endif %}
    <a href="{{ path('admin_user_index', ownersToggleParams) }}" class="btn btn-md {% if filter.ownersOnly %}btn-primary{% else %}btn-secondary{% endif %}">
      Только владельцы{% if filter.ownersOnly %} ✓{% endif %}
    </a>
  </form>

  {% if users is not empty %}
    <div class="card u-p-0" style="overflow-x:auto;">
      <table class="t-table">
        <thead>
          <tr>
            <th>Email</th>
            <th>Кабинеты</th>
            <th style="width:160px">Дата регистрации</th>
            <th>Роли</th>
            <th class="t-cell--right" style="width:160px">Действия</th>
          </tr>
        </thead>
        <tbody>
          {% for user in users %}
            {# ROLE_USER есть у всех — шум; незнакомые роли показываем как есть, чтобы не прятать выданные права #}
            {% set userRoleLabels = user.roles|filter(role => role != 'ROLE_USER')|map(role => roleLabels[role] ?? role) %}
            <tr>
              <td>{{ user.email }}</td>
              <td>
                {% set cabinets = userCabinets[user.id] ?? [] %}
                {% if cabinets is not empty %}
                  {% for cabinet in cabinets %}
                    <div style="display:flex;align-items:center;flex-wrap:wrap;gap:var(--s-2);{% if not loop.last %}margin-bottom:var(--s-2);{% endif %}">
                      <span>{{ cabinet.name }}</span>
                      {% if cabinet.inn %}<span style="color:var(--text-muted);font-size:12px;">ИНН {{ cabinet.inn }}</span>{% endif %}
                      {% if cabinet.owner %}
                        <span class="status status--success"><span class="dot"></span>Владелец</span>
                      {% else %}
                        <span class="status status--neutral"><span class="dot"></span>Участник</span>
                      {% endif %}
                    </div>
                  {% endfor %}
                {% else %}
                  <span style="color:var(--text-faint);">Без кабинета</span>
                {% endif %}
              </td>
              <td style="font-variant-numeric:tabular-nums;">{{ user.createdAt|date('d.m.Y') }}</td>
              <td>
                {% if userRoleLabels is not empty %}
                  {{ userRoleLabels|join(', ') }}
                {% else %}
                  <span style="color:var(--text-faint);">—</span>
                {% endif %}
              </td>
              <td class="t-cell--right">
                <a href="{{ path('admin_user_update_roles', { id: user.id }) }}" class="btn btn-sm btn-secondary">Изменить роль</a>
              </td>
            </tr>
          {% endfor %}
        </tbody>
      </table>
      {# route явно: при 422 re-render из CreateAccountController текущий _route — POST-only #}
      {% include 'app/_ui/_pagination.html.twig' with { pager: pager, route: 'admin_user_index', params: app.request.query.all } %}
    </div>
  {% else %}
    <div class="empty">
      <div class="empty-icon">
        <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M22 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/></svg>
      </div>
      <div class="empty-title">Нет зарегистрированных пользователей</div>
      <div class="empty-text">Создайте первый аккаунт — пользователь и его компания появятся в этом списке.</div>
      <button type="button" class="btn btn-md btn-primary" data-admin-dialog-open="account-create-dialog">Добавить аккаунт</button>
    </div>
  {% endif %}
{% endblock %}

{% block admin_modals %}
  <dialog id="account-create-dialog" class="dlg" aria-labelledby="account-create-title">
    <div class="mdl">
      {{ form_start(accountForm, { action: path('admin_user_create_account'), method: 'POST' }) }}
        <div class="mdl-head">
          <div class="u-flex-1">
            <h3 id="account-create-title">Добавить аккаунт</h3>
            <div class="sub">Создаёт пользователя и его компанию</div>
          </div>
          <button type="button" class="btn btn-sm btn-ghost u-w-28 u-p-0" data-admin-dialog-close aria-label="Закрыть">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><line x1="6" y1="6" x2="18" y2="18"/><line x1="18" y1="6" x2="6" y2="18"/></svg>
          </button>
        </div>
        <div class="mdl-body">
          {% if accountForm.vars.errors|length > 0 %}
            <div class="alert alert--danger" role="alert" style="margin-bottom:var(--s-3);">
              <div class="a-body">
                <div class="a-text">{{ form_errors(accountForm) }}</div>
              </div>
            </div>
          {% endif %}

          <div class="form-field">
            {{ form_label(accountForm.email, 'Email', { label_attr: { class: 'form-label' } }) }}
            {{ form_widget(accountForm.email, {
              attr: {
                class: 'input' ~ (accountForm.email.vars.errors|length > 0 ? ' is-error'),
                placeholder: 'user@example.com',
                autocomplete: 'email'
              }
            }) }}
            {{ form_errors(accountForm.email) }}
          </div>

          <div class="form-field">
            {{ form_label(accountForm.plainPassword, 'Пароль', { label_attr: { class: 'form-label' } }) }}
            {{ form_widget(accountForm.plainPassword, {
              attr: {
                class: 'input' ~ (accountForm.plainPassword.vars.errors|length > 0 ? ' is-error'),
                placeholder: '••••••••',
                autocomplete: 'new-password'
              }
            }) }}
            {{ form_errors(accountForm.plainPassword) }}
          </div>

          <div class="form-field">
            {{ form_label(accountForm.companyName, 'Название компании', { label_attr: { class: 'form-label' } }) }}
            {{ form_widget(accountForm.companyName, {
              attr: {
                class: 'input' ~ (accountForm.companyName.vars.errors|length > 0 ? ' is-error'),
                placeholder: 'ООО Ромашка'
              }
            }) }}
            {{ form_errors(accountForm.companyName) }}
          </div>

          <div class="form-field">
            <span class="form-label">Профиль бизнеса</span>
            <div class="radio-group">
              {% for choice in accountForm.businessProfile %}
                <label class="radio-label">
                  <input type="radio" class="radio" id="{{ choice.vars.id }}" name="{{ choice.vars.full_name }}" value="{{ choice.vars.value }}" {{ choice.vars.checked ? 'checked' }}>
                  {{ choice.vars.label }}
                </label>
                {% do choice.setRendered %}
              {% endfor %}
            </div>
            {{ form_errors(accountForm.businessProfile) }}
          </div>
        </div>
        <div class="mdl-foot">
          <button type="button" class="btn btn-md btn-secondary" data-admin-dialog-close>Отмена</button>
          <button type="submit" class="btn btn-md btn-primary">Создать аккаунт</button>
        </div>
      {{ form_end(accountForm) }}
    </div>
  </dialog>
{% endblock %}

{% block admin_scripts %}
  {{ parent() }}
  {% if showAccountModal %}
    <script>
      document.addEventListener('DOMContentLoaded', () => {
        document.getElementById('account-create-dialog')?.showModal();
      });
    </script>
  {% endif %}
{% endblock %}
