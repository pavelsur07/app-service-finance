{% extends 'balance/layout.html.twig' %}
{% block balance_content %}
    <div class="wz-head">
        <h1 class="wz-title">Статьи баланса<span class="wz-sub">Четыре уровня внутри сторон Актив и Пассив. Счета находятся в конечных статьях.</span>
        </h1>
        {% if permissions.manage %}
            <a class="btn btn-md btn-primary" href="{{ path('balance_structure_new') }}">Создать статью</a>
        {% endif %}
    </div>
    <section class="card report-scroll">
        <table class="t-table">
            <thead>
                <tr>
                    <th>Статья</th>
                    <th>Тип</th>
                    <th>Назначение</th>
                    <th>Действия</th>
                </tr>
            </thead>
            <tbody>
                {% for item in items %}
                    <tr>
                        <td>
                            {% for n in 1..item.level %}
                                {% if n > 1 %}— {% endif %}
                            {% endfor %}
                            <a href="{{ path('balance_article_card',{id:item.id}) }}">{{ item.name }}
                            </a>
                            {% if item.is_archived %} · Архив{% endif %}
                            <p>{{ item.code }}
                            </p>
                        </td>
                        <td>{{ item.type == 'asset' ? 'Актив':'Пассив' }}
                        </td>
                        <td>{{ item.kind == 'group' ? 'Группа':'Конечная статья' }}
                        </td>
                        <td>
                            {% if permissions.manage %}
                                <a class="btn btn-sm btn-secondary" href="{{ path('balance_structure_edit',{id:item.id}) }}">Изменить</a>
                                <form method="post" action="{{ path('balance_structure_move') }}">
                                    <input type="hidden" name="_token" value="{{ csrf_token('category_move_'~item.id) }}">
                                    <input type="hidden" name="category_id" value="{{ item.id }}">
                                    <button class="btn btn-sm btn-secondary" name="direction" value="up" aria-label="Поднять {{ item.name }}">↑</button>
                                    <button class="btn btn-sm btn-secondary" name="direction" value="down" aria-label="Опустить {{ item.name }}">↓</button>
                                </form>
                                <form method="post" action="{{ path('balance_structure_archive',{id:item.id}) }}">
                                    <input type="hidden" name="_token" value="{{ csrf_token('category_archive_'~item.id) }}">
                                    <input type="hidden" name="archive" value="{{ item.is_archived ? '0':'1' }}">
                                    <button class="btn btn-sm btn-secondary">{{ item.is_archived ? 'Вернуть из архива':'Архивировать' }}
                                    </button>
                                </form>
                            {% endif %}
                        </td>
                    </tr>
                {% else %}
                    <tr>
                        <td colspan="4">Структура еще не создана.</td>
                    </tr>
                {% endfor %}
            </tbody>
        </table>
    </section>
{% endblock %}
