{% extends 'base.html.twig' %}

{% block title %}Подключения банков{% endblock %}

{% block body %}
    <div class="page-header d-print-none">
        <div class="container-xl">
            <div class="row g-2 align-items-center">
                <div class="col">
                    <h2 class="page-title">Подключения банков</h2>
                </div>
                <div class="col-auto ms-auto d-print-none">
                    {% for start in oauth_starts %}
                        <form method="post" action="{{ path('bank_sync_oauth_start') }}" class="d-inline">
                            <input type="hidden" name="_token" value="{{ csrf_token(oauth_start_csrf_id) }}">
                            <input type="hidden" name="bank_code" value="{{ start.bank_code }}">
                            <input type="hidden" name="base_url" value="{{ start.base_url }}">
                            <button class="btn btn-outline-primary">Подключить через {{ start.label }}</button>
                        </form>
                    {% endfor %}
                    {% if can_add_with_token %}
                        <a href="{{ path('bank_sync_connection_new') }}" class="btn btn-primary">Добавить</a>
                    {% endif %}
                </div>
            </div>
        </div>
    </div>
    <div class="container-xl mt-3">
        <div class="card">
            <div class="card-body">
                <table class="table table-vcenter">
                    <thead>
                        <tr>
                            <th>Банк</th>
                            <th>Base URL</th>
                            <th>Статус</th>
                            <th>Согласие</th>
                            <th>Обновлено</th>
                            <th class="w-1"></th>
                        </tr>
                    </thead>
                    <tbody>
                    {% for connection in connections %}
                        <tr>
                            <td>{{ connection.bankCode.label }}</td>
                            <td>{{ connection.baseUrl }}</td>
                            <td>
                                <span class="badge {{ connection.status.value == 'active' ? 'bg-green' : (connection.status.value == 'disabled' ? 'bg-secondary' : 'bg-red') }}">{{ connection.status.label }}</span>
                                {% if connection.statusReason %}
                                    <div class="text-secondary small">{{ connection.statusReason }} · {{ connection.statusChangedAt|date('d.m.Y H:i') }}</div>
                                {% endif %}
                            </td>
                            <td>
                                {% if connection.consentExpiresAt %}
                                    до {{ connection.consentExpiresAt|date('d.m.Y') }}
                                    {% if connection.status.value == 'active' and connection.consentExpiresAt <= consent_warning_until %}
                                        <div class="text-warning small">Согласие скоро истечёт — войдите в банк заново</div>
                                    {% endif %}
                                {% elseif connection.externalSubject %}
                                    <span class="text-secondary">уточняется</span>
                                {% else %}
                                    <span class="text-secondary">—</span>
                                {% endif %}
                            </td>
                            <td>{{ connection.updatedAt|date('d.m.Y H:i') }}</td>
                            <td class="text-end">
                                {% set consent_expiring = connection.status.value == 'active' and connection.consentExpiresAt and connection.consentExpiresAt <= consent_warning_until %}
                                {% if (connection.status.value in ['needs_reauth', 'revoked'] or consent_expiring) and (connection.bankCode.value ~ '|' ~ connection.baseUrl) in oauth_environments %}
                                    <form method="post" action="{{ path('bank_sync_oauth_start') }}" class="d-inline">
                                        <input type="hidden" name="_token" value="{{ csrf_token(oauth_start_csrf_id) }}">
                                        <input type="hidden" name="connection_id" value="{{ connection.id }}">
                                        <button class="btn btn-sm btn-outline-warning">Переподключить</button>
                                    </form>
                                {% endif %}
                                <a href="{{ path('bank_sync_connection_accounts', {'id': connection.id}) }}" class="btn btn-sm btn-outline-secondary">
                                    Счета банка
                                    {% if unlinked_accounts[connection.id] ?? 0 %}
                                        <span class="badge bg-warning text-white ms-1" title="Счета без денежного счёта: выписка по ним не загружается">{{ unlinked_accounts[connection.id] }}</span>
                                    {% endif %}
                                </a>
                                <a href="{{ path('bank_sync_connection_edit', {'id': connection.id}) }}" class="btn btn-icon" title="Редактировать">
                                    <i class="ti ti-pencil"></i>
                                </a>
                                <form method="post" action="{{ path('bank_sync_connection_enqueue_sync', {'id': connection.id}) }}" class="d-inline">
                                    <input type="hidden" name="_token" value="{{ csrf_token('enqueue_import_' ~ connection.id) }}">
                                    <button class="btn btn-sm btn-outline-primary" title="Запустить импорт сейчас">
                                        Запустить импорт сейчас
                                    </button>
                                </form>
                                <form method="post" action="{{ path('bank_sync_connection_delete', {'id': connection.id}) }}" class="d-inline" onsubmit="return confirm('Удалить подключение?');">
                                    <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ connection.id) }}">
                                    <button class="btn btn-icon btn-danger" title="Удалить">
                                        <i class="ti ti-trash"></i>
                                    </button>
                                </form>
                            </td>
                        </tr>
                    {% else %}
                        <tr>
                            <td colspan="6" class="text-center text-secondary">Подключений ещё нет.</td>
                        </tr>
                    {% endfor %}
                    </tbody>
                </table>
            </div>
        </div>
    </div>
{% endblock %}
