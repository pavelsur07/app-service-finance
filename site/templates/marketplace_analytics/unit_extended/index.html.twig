{% extends 'base.html.twig' %}

{% block title %}Unit — Экономика — Аналитика маркетплейсов{% endblock %}

{% block content %}
    <div class="page-body">
        <div class="container-xl">
            <div
                id="react-unit-extended"
                data-marketplaces="{{ marketplaces|json_encode|e('html_attr') }}"
                data-tags="{{ tags|json_encode|e('html_attr') }}"
            ></div>
        </div>
    </div>
{% endblock %}

{% block javascripts %}
    {{ parent() }}
    {{ vite_entry_script_tags('unit_extended_page') }}
{% endblock %}
