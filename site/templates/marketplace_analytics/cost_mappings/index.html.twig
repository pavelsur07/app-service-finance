{% extends 'base.html.twig' %}

{% block title %}Настройки — Аналитика маркетплейсов{% endblock %}

{% set perPage = 50 %}
{% set pages = (total / perPage)|round(0, 'ceil') %}
{% if pages < 1 %}{% set pages = 1 %}{% endif %}

{% block content %}
    {% include 'marketplace_analytics/_tabs.html.twig' with {activeTab: 'settings'} %}

    <div class="page-body">
        <div class="container-xl">
            <div class="tab-content">
                <div class="tab-pane active show" data-cost-mappings
                     data-add-url="{{ path('marketplace_analytics_api_cost_mapping_add') }}"
                     data-index-url="{{ path('marketplace_analytics_cost_mappings_index') }}">

                    {# Форма добавления маппинга #}
                    <div class="card mb-3">
                        <div class="card-header">
                            <h3 class="card-title">Добавить маппинг</h3>
                        </div>
                        <div class="card-body">
                            <div class="row g-2 align-items-end">

                                <div class="col-auto">
                                    <label class="form-label">Маркетплейс</label>
                                    <select name="marketplace" class="form-select" data-cost-mapping-marketplace>
                                        {% for mp in available_marketplaces %}
                                            <option value="{{ mp.value }}"
                                                {{ selected_marketplace == mp.value ? 'selected' }}>
                                                {{ mp.getDisplayName() }}
                                            </option>
                                        {% endfor %}
                                    </select>
                                </div>

                                <div class="col-auto">
                                    <label class="form-label">Статья юнит-экономики</label>
                                    <select class="form-select" data-cost-mapping-type>
                                        <option value="">— выберите —</option>
                                        {% for type in cost_types %}
                                            <option value="{{ type.value }}">
                                                {{ type.getLabel() }}
                                            </option>
                                        {% endfor %}
                                    </select>
                                </div>

                                <div class="col-auto">
                                    <label class="form-label">Категория затрат МП</label>
                                    <select class="form-select" data-cost-mapping-category>
                                        <option value="">— выберите —</option>
                                        {% for cat in categories %}
                                            <option
                                                value="{{ cat.id }}"
                                                data-name="{{ cat.name|e('html_attr') }}"
                                            >{{ cat.name }}</option>
                                        {% endfor %}
                                    </select>
                                </div>

                                <div class="col-auto">
                                    <button type="button" class="btn btn-primary" data-cost-mapping-add>Добавить</button>
                                </div>

                            </div>
                        </div>
                    </div>

                    {# Таблица маппингов #}
                    <div class="card">
                        <div class="table-responsive">
                            <table class="table table-vcenter card-table">
                                <thead>
                                    <tr>
                                        <th>Маркетплейс</th>
                                        <th>Статья юнит-экономики</th>
                                        <th>Категория затрат МП</th>
                                        <th>Действия</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    {% if mappings is empty %}
                                        <tr>
                                            <td colspan="4" class="text-center py-5 text-muted">
                                                Маппинги не добавлены. Добавьте первый маппинг выше.
                                            </td>
                                        </tr>
                                    {% else %}
                                        {% for mapping in mappings %}
                                            <tr>
                                                <td>{{ mapping.marketplace.getDisplayName() }}</td>
                                                <td>{{ mapping.unitEconomyCostType.getLabel() }}</td>
                                                <td>{{ mapping.costCategoryName }}</td>
                                                <td>
                                                    <button type="button" class="btn btn-sm btn-ghost-danger"
                                                            data-bs-toggle="modal" data-bs-target="#cost-mapping-confirm"
                                                            data-cost-mapping-delete
                                                            data-confirm-action="{{ path('marketplace_analytics_api_cost_mapping_delete', {id: mapping.id}) }}"
                                                            data-confirm-token="{{ csrf_token('cost_mapping_delete') }}"
                                                            data-confirm-title="Удалить маппинг?"
                                                            data-confirm-body="{{ mapping.costCategoryName }} → {{ mapping.unitEconomyCostType.getLabel() }}"
                                                            data-confirm-submit="Удалить" data-confirm-variant="danger">Удалить</button>
                                                </td>
                                            </tr>
                                        {% endfor %}
                                    {% endif %}
                                </tbody>
                            </table>
                        </div>

                        {# Пагинация #}
                        {% if pages > 1 %}
                            <div class="card-footer">
                                {% include 'partials/_pagination.html.twig' with {
                                    page: page, total: total, perPage: perPage,
                                    route: 'marketplace_analytics_cost_mappings_index', params: filters
                                } only %}
                            </div>
                        {% endif %}
                    </div>

                </div>
            </div>
        </div>
    </div>

    {% include 'partials/_confirm_modal.html.twig' with {id: 'cost-mapping-confirm'} only %}
{% endblock %}
