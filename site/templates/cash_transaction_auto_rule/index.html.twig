{% extends 'base.html.twig' %}
{% block title %}Автоправила ДДС{% endblock %}

{% block body %}
    <div class="page-header d-print-none">
        <div class="container-xl">
            <div class="row g-2 align-items-center">
                <div class="col">
                    <h2 class="page-title mb-0">Автоправила ДДС</h2>
                </div>
                <div class="col-auto ms-auto d-print-none">
                    <div class="btn-list">
                        {# Поиск отдельной GET-формой: остальные фильтры переезжают
                           скрытыми полями, иначе строка поиска сбрасывала бы их. #}
                        <form method="get" class="d-flex" role="search">
                            {# Сравнение с пустой строкой, а не проверка на truthy:
                               значение «0» в Twig ложно и молча потерялось бы. #}
                            {% for name, value in filters %}
                                {% if name != 'q' and value is not null and value != '' %}
                                    <input type="hidden" name="{{ name }}" value="{{ value }}">
                                {% endif %}
                            {% endfor %}
                            <input type="search"
                                   name="q"
                                   value="{{ filters.q }}"
                                   class="form-control"
                                   style="min-width: 16rem;"
                                   placeholder="Название, контрагент, условие"
                                   aria-label="Поиск правил">
                            <button type="submit" class="btn btn-outline-secondary ms-2">Найти</button>
                        </form>
                        <a href="{{ path('cash_transaction_auto_rule_candidates') }}" class="btn btn-outline-primary">
                            Кандидаты правил
                        </a>
                        <a href="#"
                           class="btn btn-outline-secondary"
                           data-bs-toggle="offcanvas"
                           data-bs-target="#auto-rule-filters-offcanvas">
                            <i class="ti ti-filter"></i>
                            Фильтры
                        </a>
                        <a href="{{ path('cash_transaction_auto_rule_new') }}" class="btn btn-success">+ Добавить</a>
                    </div>
                </div>
            </div>
        </div>
    </div>
    {# Карточка обрезает выпадающее меню последних строк, как это уже было в списке
       операций ДДС — там лечится тем же overflow. #}
    <style>
        .auto-rule-list,
        .auto-rule-list .card-body {
            overflow: visible;
        }
    </style>
    <div class="container-xl mt-3">
        <div class="card auto-rule-list">
            <div class="card-body">
                <table class="table">
                    <thead>
                        <tr>
                            <th>Название</th>
                            <th>Приоритет</th>
                            <th>Статус</th>
                            <th>Действие</th>
                            <th>Тип операции</th>
                            <th>Направление / проект</th>
                            <th>ЦФО</th>
                            <th>Контрагент</th>
                            <th></th>
                        </tr>
                    </thead>
                    <tbody>
                    {% for item in items %}
                        {% set titleParts = [] %}
                        {% if item.cashflowCategory %}
                            {% set titleParts = titleParts|merge([item.cashflowCategory.name]) %}
                        {% endif %}
                        {% if item.counterparty %}
                            {% set titleParts = titleParts|merge([item.counterparty.name]) %}
                        {% endif %}
                        <tr{% if not item.active %} class="text-muted"{% endif %}>
                            <td>
                                <div>{{ item.name }}</div>
                                <small class="text-muted">{{ titleParts|join(' + ') }}</small>
                            </td>
                            <td>{{ item.priority }}</td>
                            <td>
                                {% if item.active %}
                                    <span class="badge bg-success-lt">Активно</span>
                                {% else %}
                                    <span class="badge bg-secondary-lt">Выключено</span>
                                {% endif %}
                            </td>
                            <td>
                                Безопасное заполнение{% if item.action.value == 'UPDATE' %} (legacy UPDATE){% endif %}
                            </td>
                            <td>{{ item.operationType.name }}</td>
                            <td>{{ item.projectDirection ? item.projectDirection.name : '' }}</td>
                            <td>{{ responsibilityCenterLabels[item.responsibilityCenterId]|default(item.responsibilityCenterId ? 'Недоступен или архивирован' : '') }}</td>
                            <td>
                                {% if item.counterparty %}
                                    {{ item.counterparty.name|length > 30 ? item.counterparty.name|slice(0, 30) ~ '…' : item.counterparty.name }}
                                {% endif %}
                            </td>
                            <td class="text-end">
                                <div class="dropdown position-static {{ loop.last ? 'dropup' : '' }}">
                                    <button class="btn btn-link p-0 text-muted" data-bs-toggle="dropdown" aria-expanded="false" aria-label="Действия">
                                        <svg xmlns="http://www.w3.org/2000/svg" class="icon" viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="2">
                                            <path stroke="none" d="M0 0h24v24H0z"/>
                                            <circle cx="5" cy="12" r="1"/>
                                            <circle cx="12" cy="12" r="1"/>
                                            <circle cx="19" cy="12" r="1"/>
                                        </svg>
                                    </button>

                                    <div class="dropdown-menu dropdown-menu-end shadow-sm">
                                        <a class="dropdown-item" href="{{ path('cash_transaction_auto_rule_check', {id: item.id}) }}">
                                            <i class="ti ti-list-search me-2"></i> Проверка
                                        </a>
                                        <a class="dropdown-item" href="{{ path('cash_transaction_auto_rule_edit', {id: item.id}) }}">
                                            <i class="ti ti-pencil me-2"></i> Редактирование
                                        </a>
                                        {% if item.active %}
                                            <button type="button"
                                                    class="dropdown-item"
                                                    data-bs-toggle="modal"
                                                    data-bs-target="#disable-modal-{{ item.id }}">
                                                <i class="ti ti-ban me-2"></i> Отключить
                                            </button>
                                        {% else %}
                                            {# Включение обратимо, поэтому подтверждения не требует. #}
                                            <form method="post" action="{{ path('cash_transaction_auto_rule_enable', {id: item.id}) }}">
                                                <input type="hidden" name="_token" value="{{ csrf_token('enable' ~ item.id) }}">
                                                <button type="submit" class="dropdown-item">
                                                    <i class="ti ti-player-play me-2"></i> Включить
                                                </button>
                                            </form>
                                        {% endif %}

                                        <div class="dropdown-divider"></div>

                                        <button type="button"
                                                class="dropdown-item text-danger"
                                                data-bs-toggle="modal"
                                                data-bs-target="#delete-modal-{{ item.id }}">
                                            <i class="ti ti-trash me-2"></i> Удалить
                                        </button>
                                    </div>
                                </div>

                                {% if item.active %}
                                    {{ include('cash_transaction_auto_rule/_confirm_modal.html.twig', {
                                        modalId: 'disable-modal-' ~ item.id,
                                        body: 'Отключить правило «' ~ item.name ~ '»? Включить его обратно нельзя.',
                                        actionPath: path('cash_transaction_auto_rule_disable', {id: item.id}),
                                        token: csrf_token('disable' ~ item.id),
                                        submitLabel: 'Отключить',
                                        submitClass: 'btn-warning',
                                    }) }}
                                {% endif %}
                                {{ include('cash_transaction_auto_rule/_confirm_modal.html.twig', {
                                    modalId: 'delete-modal-' ~ item.id,
                                    body: 'Удалить правило «' ~ item.name ~ '» безвозвратно? Вместе с ним удалятся его условия.',
                                    actionPath: path('cash_transaction_auto_rule_delete', {id: item.id}),
                                    token: csrf_token('delete' ~ item.id),
                                    submitLabel: 'Удалить',
                                    submitClass: 'btn-danger',
                                }) }}
                            </td>
                        </tr>
                    {% else %}
                        {# «Правил ещё нет» и «под фильтры ничего не подошло» — разные
                           состояния: одинаковый текст толкает завести дубль правила. #}
                        <tr>
                            <td colspan="9" class="text-center text-muted">
                                {% if hasAnyRule %}
                                    По заданным условиям ничего не найдено.
                                    {# Именно «показать все», а не «сбросить»: сброс вернёт
                                       фильтр по умолчанию «активные», и компания, у которой
                                       все правила отключены, снова увидит пустой список. #}
                                    <a href="{{ path('cash_transaction_auto_rule_index', {status: 'all'}) }}">Показать все правила</a>
                                {% else %}
                                    Автоправил пока нет.
                                    <a href="{{ path('cash_transaction_auto_rule_new') }}">Создать первое</a>
                                {% endif %}
                            </td>
                        </tr>
                    {% endfor %}
                    </tbody>
                </table>
            </div>
            <div class="card-footer d-flex align-items-center">
                <span class="text-muted">Найдено правил: {{ pager.nbResults }}</span>
                <div class="ms-auto">
                    {% include 'partials/_pagerfanta.html.twig' with {pager: pager} %}
                </div>
            </div>
        </div>
    </div>
    <div class="offcanvas offcanvas-end" tabindex="-1" id="auto-rule-filters-offcanvas" aria-labelledby="auto-rule-filters-offcanvas-label">
        <div class="offcanvas-header">
            <h2 class="offcanvas-title" id="auto-rule-filters-offcanvas-label">Фильтры</h2>
            <button type="button" class="btn-close" data-bs-dismiss="offcanvas" aria-label="Закрыть"></button>
        </div>
        <div class="offcanvas-body">
            <form method="get" class="d-flex flex-column gap-4">
                {% if filters.q != '' %}
                    <input type="hidden" name="q" value="{{ filters.q }}">
                {% endif %}
                <div class="row g-3">
                    <div class="col-12">
                        <label class="form-label" for="filter-status">Статус</label>
                        <select id="filter-status" name="status" class="form-select">
                            {% for status in statusOptions %}
                                <option value="{{ status.value }}" {{ filters.status == status.value ? 'selected' : '' }}>{{ status.label }}</option>
                            {% endfor %}
                        </select>
                    </div>
                    <div class="col-12">
                        <label class="form-label" for="filter-category">Категория ДДС</label>
                        <select id="filter-category" name="category" class="form-select">
                            <option value="">Все категории</option>
                            {% for category in categoryOptions %}
                                <option value="{{ category.id }}" {{ filters.category == category.id ? 'selected' : '' }}>{{ category.label }}</option>
                            {% endfor %}
                        </select>
                    </div>
                    <div class="col-12">
                        <label class="form-label" for="filter-action">Действие</label>
                        <select id="filter-action" name="action" class="form-select">
                            <option value="">Все действия</option>
                            {% for action in actionOptions %}
                                <option value="{{ action.value }}" {{ filters.action == action.value ? 'selected' : '' }}>{{ action.label }}</option>
                            {% endfor %}
                        </select>
                    </div>
                    <div class="col-12">
                        <label class="form-label" for="filter-operation">Тип операции</label>
                        <select id="filter-operation" name="operationType" class="form-select">
                            <option value="">Все типы</option>
                            {% for type in operationOptions %}
                                <option value="{{ type.value }}" {{ filters.operationType == type.value ? 'selected' : '' }}>{{ type.label }}</option>
                            {% endfor %}
                        </select>
                    </div>
                </div>
                <div class="d-grid gap-2">
                    <button type="submit" class="btn btn-primary">Применить</button>
                    <a href="{{ path('cash_transaction_auto_rule_index') }}" class="btn btn-outline-secondary">Сбросить</a>
                </div>
            </form>
        </div>
    </div>
{% endblock %}
