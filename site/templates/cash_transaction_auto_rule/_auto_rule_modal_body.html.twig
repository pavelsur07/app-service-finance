{# Это только BODY модалки; сама модалка — ниже #}

{% if skipReason %}
  <div class="alert alert-warning mb-0">{{ skipReason.label }}</div>
  <div class="d-flex gap-2 mt-3">
    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Закрыть</button>
  </div>
{% elseif rule %}
  {% if conflicts %}
    {% set fieldLabels = {
      cashflowCategory: 'Статья ДДС',
      projectDirection: 'Проект',
      counterparty: 'Контрагент'
    } %}
    <div class="alert alert-warning">
      <div class="fw-bold">Конфликтующие поля будут пропущены</div>
      <ul class="mb-0 mt-2">
        {% for field, rules in conflicts %}
          <li>
            {{ fieldLabels[field]|default(field) }}:
            {% for conflictingRule in rules %}
              {{ conflictingRule.name }}{% if not loop.last %}, {% endif %}
            {% endfor %}
          </li>
        {% endfor %}
      </ul>
    </div>
  {% endif %}
  <div class="mb-2">
    <div class="h3">Найдено автоправило</div>
    <div class="text-muted">«{{ rule.name }}» (безопасное заполнение, {{ rule.operationType.value }})</div>
  </div>

  <form id="autoRuleApplyForm" method="post"
        action="{{ path('cash_transaction_auto_rule_apply_one', {transactionId: transaction.id}) }}">
    <input type="hidden" name="ruleId" value="{{ rule.id }}">
    <input type="hidden" name="_token" value="{{ csrf_token('apply-auto-rule' ~ transaction.id) }}">
    <div class="d-flex gap-2 mt-3">
      <button type="submit" class="btn btn-primary">Применить</button>
      <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Закрыть</button>
    </div>
  </form>
{% elseif conflictingRules %}
  <div class="alert alert-danger mb-0">
    <div class="fw-bold">Все найденные поля конфликтуют и не будут изменены</div>
    <ul class="mb-0 mt-2">
      {% for conflictingRule in conflictingRules %}
        <li>{{ conflictingRule.name }} — приоритет {{ conflictingRule.priority }}</li>
      {% endfor %}
    </ul>
  </div>
  <div class="d-flex gap-2 mt-3">
    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Закрыть</button>
  </div>
{% else %}
  <div class="mb-2">
    <div class="h3">Подходящих автоправил не найдено</div>
  </div>
  <div class="d-flex gap-2 mt-3">
    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Закрыть</button>
  </div>
{% endif %}
