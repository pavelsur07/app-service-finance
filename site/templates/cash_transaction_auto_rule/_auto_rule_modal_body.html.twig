{# Это только BODY модалки; сама модалка — ниже #}

{% if skipReason %}
  <div class="alert alert-warning mb-0">{{ skipReason.label }}</div>
  <div class="d-flex gap-2 mt-3">
    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Закрыть</button>
  </div>
{% elseif conflictingRules %}
  <div class="alert alert-danger mb-0">
    <div class="fw-bold">Обнаружен конфликт автоправил с одинаковым приоритетом</div>
    <ul class="mb-0 mt-2">
      {% for conflictingRule in conflictingRules %}
        <li>{{ conflictingRule.name }} — приоритет {{ conflictingRule.priority }}</li>
      {% endfor %}
    </ul>
  </div>
  <div class="d-flex gap-2 mt-3">
    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Закрыть</button>
  </div>
{% elseif rule %}
  <div class="mb-2">
    <div class="h3">Найдено автоправило</div>
    <div class="text-muted">«{{ rule.name }}» ({{ rule.action.value }}, {{ rule.operationType.value }})</div>
  </div>

  <form id="autoRuleApplyForm" method="post"
        action="{{ path('cash_transaction_auto_rule_apply_one', {transactionId: transaction.id}) }}">
    <input type="hidden" name="ruleId" value="{{ rule.id }}">
    <input type="hidden" name="_token" value="{{ csrf_token('apply-auto-rule' ~ transaction.id) }}">
    <div class="d-flex gap-2 mt-3">
      <button type="submit" class="btn btn-primary">Применить</button>
      <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Закрыть</button>
    </div>
  </form>
{% else %}
  <div class="mb-2">
    <div class="h3">Подходящих автоправил не найдено</div>
  </div>
  <div class="d-flex gap-2 mt-3">
    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Закрыть</button>
  </div>
{% endif %}
