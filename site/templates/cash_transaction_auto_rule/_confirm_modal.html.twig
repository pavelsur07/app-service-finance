{# Подтверждение необратимого действия над автоправилом.
   Один партиал на отключение и удаление: разметка одна, различаются только текст,
   маршрут и CSRF-токен — токены разные, иначе одна подпись годилась бы для двух
   разных операций. #}
<div class="modal fade" id="{{ modalId }}" tabindex="-1" aria-hidden="true" aria-labelledby="{{ modalId }}-title">
    <div class="modal-dialog" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="{{ modalId }}-title">Подтверждение</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Закрыть"></button>
            </div>
            <div class="modal-body">
                {{ body }}
            </div>
            <div class="modal-footer">
                <form method="post" action="{{ actionPath }}">
                    <input type="hidden" name="_token" value="{{ token }}">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Отмена</button>
                    <button type="submit" class="btn {{ submitClass }}">{{ submitLabel }}</button>
                </form>
            </div>
        </div>
    </div>
</div>
