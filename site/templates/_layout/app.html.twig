<!DOCTYPE html>
<html lang="ru" data-ui-mode="app">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>{% block title %}Ваш Финдир{% endblock %}</title>
    <link rel="icon" type="image/svg+xml" href="{{ asset('static/favicon.svg') }}">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Manrope:wght@400;500;600;700;800&display=swap">
    {{ vite_entry_link_tags('app') }}
    {% block stylesheets %}{% endblock %}
</head>
<body class="uikit-base">
    <div class="app app-customer">
        {% include 'app/_shell/header.html.twig' %}
        <div class="app-body">
            {% include 'app/_shell/sidebar.html.twig' %}
            <main class="app-workzone">
                {% block content %}{% block body %}{% endblock %}{% endblock %}
            </main>
        </div>
    </div>
    {{ vite_entry_script_tags('app') }}
    {% block javascripts %}{% endblock %}
</body>
</html>
