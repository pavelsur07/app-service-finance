{% extends 'base.html.twig' %}
{% form_theme form.type 'form_div_layout.html.twig' %}
{% set is_edit = account is defined %}

{% block title %}{{ is_edit ? 'Редактирование счёта' : 'Новый счёт' }}{% endblock %}

{% block stylesheets %}
    <style>
        #money-account-create-page .money-account-type-description {
            font-size: .78rem;
        }

        #money-account-create-page .money-account-currency {
            max-width: 6rem;
        }

        #money-account-create-page .money-account-info {
            font-size: .85rem;
            line-height: 1.5;
        }
    </style>
{% endblock %}

{% block body %}
    {% embed 'partials/_page_header.html.twig' with {pretitle: 'Счета и кассы'} %}
        {% block title %}
            {{ is_edit ? 'Редактирование счёта' : 'Новый счёт' }}
        {% endblock %}
        {% block actions %}
            <div class="btn-list">
                <a href="{{ path('money_account_index') }}" class="btn btn-ghost-secondary d-none d-sm-inline-flex"><i class="ti ti-arrow-left me-1"></i>К списку</a>
                <button type="submit" form="money-account-create-form" class="btn btn-primary"><i class="ti ti-device-floppy me-1"></i>{{ is_edit ? 'Сохранить' : 'Создать' }}</button>
            </div>
        {% endblock %}
    {% endembed %}

    <div id="money-account-create-page" class="page-body">
        <div class="container-xl">
            <div class="row row-cards">
                <div class="col-lg-8">
                    {{ form_start(form, {'attr': {'id': 'money-account-create-form', 'class': 'card', 'data-money-account-form': '1'}}) }}
                        <div class="card-header">
                            <h3 class="card-title">Реквизиты счёта</h3>
                            <div class="card-actions">
                                <span id="money-account-default-badge" data-money-account-default-badge class="badge bg-blue-lt{{ form.isDefault.vars.data ? '' : ' d-none' }}"><i class="ti ti-star-filled me-1"></i>Основной</span>
                            </div>
                        </div>
                        <div class="card-body">
                            {{ form_errors(form) }}
                            <div class="row g-3">
                                <div class="col-12">
                                    {{ form_label(form.name, 'Наименование') }}
                                    {{ form_widget(form.name, {'attr': {'placeholder': 'Например, Сбер · Основной'}}) }}
                                    {{ form_errors(form.name) }}
                                    <small class="form-hint">Как счёт отображается в операциях и отчётах.</small>
                                </div>

                                <div class="col-12">
                                    {% set type_config = {
                                        'bank': {'icon': 'ti-building-bank', 'title': 'Банк', 'description': 'Расчётный счёт'},
                                        'cash': {'icon': 'ti-cash', 'title': 'Касса', 'description': 'Наличные'},
                                        'ewallet': {'icon': 'ti-wallet', 'title': 'Кошелёк', 'description': 'ЮMoney, QIWI…'},
                                        'crypto_wallet': {'icon': 'ti-currency-bitcoin', 'title': 'Крипто-кошелёк', 'description': 'USDT, BTC…'}
                                    } %}
                                    <div class="form-selectgroup form-selectgroup-boxes d-flex flex-wrap">
                                        {% for choice in form.type %}
                                            {% set config = type_config[choice.vars.value] %}
                                            <label class="form-selectgroup-item flex-fill" for="{{ choice.vars.id }}">
                                                {{ form_widget(choice, {'attr': {'class': 'form-selectgroup-input', 'data-money-account-type': choice.vars.value}}) }}
                                                <span class="form-selectgroup-label d-flex align-items-center p-3">
                                                    <span class="me-2"><i class="ti {{ config.icon }} fs-2"></i></span>
                                                    <span class="form-selectgroup-label-content">
                                                        <span class="form-selectgroup-title fw-semibold">{{ config.title }}</span>
                                                        <span class="money-account-type-description d-block text-secondary">{{ config.description }}</span>
                                                    </span>
                                                </span>
                                            </label>
                                        {% endfor %}
                                    </div>
                                    {{ form_errors(form.type) }}
                                </div>

                                <div id="money-account-number-field" class="col-12" data-money-account-number-field>
                                    {{ form_label(form.accountNumber, 'Расчётный счёт') }}
                                    <div class="input-group input-group-flat">
                                        <span class="input-group-text"><i class="ti ti-hash"></i></span>
                                        {{ form_widget(form.accountNumber, {'attr': {'class': 'font-monospace', 'placeholder': '20 цифр', 'inputmode': 'numeric', 'data-money-account-number': '1'}}) }}
                                    </div>
                                    {{ form_errors(form.accountNumber) }}
                                    <small class="form-hint">Укажите номер для банковского счёта.</small>
                                </div>

                                <div class="col-md-6">
                                    {{ form_label(form.openingBalance, 'Начальное сальдо') }}
                                    <div class="input-group">
                                        {{ form_widget(form.openingBalance, {'attr': {'class': 'text-end font-monospace', 'placeholder': '0,00'}}) }}
                                        {{ form_widget(form.currency, {'attr': {'class': 'money-account-currency'}}) }}
                                    </div>
                                    {{ form_errors(form.openingBalance) }}
                                    {{ form_errors(form.currency) }}
                                    <small class="form-hint">Остаток на дату начала учёта.</small>
                                </div>
                                <div class="col-md-6">
                                    {{ form_label(form.openingBalanceDate, 'Дата начального сальдо') }}
                                    <div class="input-group input-group-flat">
                                        <span class="input-group-text"><i class="ti ti-calendar"></i></span>
                                        {{ form_widget(form.openingBalanceDate) }}
                                    </div>
                                    {{ form_errors(form.openingBalanceDate) }}
                                </div>

                                <div class="col-12">
                                    <label class="form-check form-switch mb-0" for="{{ form.isDefault.vars.id }}">
                                        {{ form_widget(form.isDefault, {'attr': {'class': 'form-check-input', 'data-money-account-default': '1'}}) }}
                                        <span class="form-check-label">По умолчанию (основной счёт)</span>
                                    </label>
                                    {{ form_errors(form.isDefault) }}
                                    <small class="form-hint mt-1">Может быть только один основной счёт на компанию — он подставляется в новые операции.</small>
                                </div>
                            </div>
                        </div>

                        <div class="card-footer d-flex align-items-center">
                            <div class="btn-list ms-auto">
                                <a href="{{ path('money_account_index') }}" class="btn">Отмена</a>
                                <button type="submit" class="btn btn-primary"><i class="ti ti-device-floppy me-1"></i>{{ is_edit ? 'Сохранить' : 'Создать' }}</button>
                            </div>
                        </div>
                        {{ form_rest(form) }}
                    {{ form_end(form, {'render_rest': false}) }}
                </div>

                <div class="col-lg-4">
                    <div class="card">
                        <div class="card-status-start bg-primary"></div>
                        <div class="card-body">
                            <div class="d-flex align-items-center mb-2">
                                <span class="avatar avatar-sm me-2 bg-primary-lt"><i class="ti ti-info-circle"></i></span>
                                <h3 class="card-title mb-0">О начальном сальдо</h3>
                            </div>
                            <p class="money-account-info text-secondary mb-0">Начальное сальдо — это остаток средств на счёте на дату старта учёта. Все дальнейшие операции ДДС считаются от него. Основной счёт может быть только один и используется по умолчанию при создании операций.</p>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
{% endblock %}
