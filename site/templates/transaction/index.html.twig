{% extends 'base.html.twig' %}
{% block title %}Операции ДДС{% endblock %}

{#{% block breadcrumbs %}
    {% include 'partials/_breadcrumbs.html.twig' with {
        breadcrumbs: [
            {'label': 'Главная', 'path': 'app_home_index'},
            {'label': 'Финансы'},
            {'label': 'Транзакции', 'path': 'cash_transaction_index'}
        ]
    } %}
{% endblock %}#}

{% block content %}
{# Рефакторинг по эталону docs/design-system/screens/Operations.dc.html; отчёт — docs/plan/ds-operations-dds.md. #}
{% set query = app.request.query.all %}
{% set filterKeys = ['dateFrom', 'dateTo', 'accountId', 'categoryId', 'counterpartyId', 'direction', 'currency', 'amountMin', 'amountMax', 'q'] %}
{% set hasFilters = filters|filter((v, k) => k in filterKeys and v is not null)|length > 0 %}
{% set totalFound = pager.nbResults %}

{# Применённые фильтры: подпись и параметры, которые снимает крестик. #}
{% set applied = [] %}
{% if filters.dateFrom or filters.dateTo %}
    {% set applied = applied|merge([{label: 'Период: ' ~ (filters.dateFrom ? filters.dateFrom|date('d.m.Y') : '…') ~ ' — ' ~ (filters.dateTo ? filters.dateTo|date('d.m.Y') : '…'), keys: ['dateFrom', 'dateTo']}]) %}
{% endif %}
{% if filters.accountId %}
    {% set account = accounts|filter(a => a.id == filters.accountId)|first %}
    {% set applied = applied|merge([{label: 'Счёт: ' ~ (account ? account.name : filters.accountId), keys: ['accountId']}]) %}
{% endif %}
{% if filters.categoryId %}
    {% set category = categories|filter(c => c.id == filters.categoryId)|first %}
    {% set applied = applied|merge([{label: 'Статья: ' ~ (category ? category.name : filters.categoryId), keys: ['categoryId']}]) %}
{% endif %}
{% if filters.counterpartyId %}
    {% set counterparty = counterparties|filter(c => c.id == filters.counterpartyId)|first %}
    {% set applied = applied|merge([{label: 'Контрагент: ' ~ (counterparty ? counterparty.name : filters.counterpartyId), keys: ['counterpartyId']}]) %}
{% endif %}
{% if filters.direction %}
    {% set applied = applied|merge([{label: filters.direction == 'INFLOW' ? 'Приток' : 'Отток', keys: ['direction']}]) %}
{% endif %}
{% if filters.currency %}
    {% set applied = applied|merge([{label: 'Валюта: ' ~ filters.currency, keys: ['currency']}]) %}
{% endif %}
{% if filters.amountMin or filters.amountMax %}
    {% set applied = applied|merge([{label: 'Сумма: ' ~ (filters.amountMin ? 'от ' ~ filters.amountMin : '') ~ (filters.amountMin and filters.amountMax ? ' ' : '') ~ (filters.amountMax ? 'до ' ~ filters.amountMax : ''), keys: ['amountMin', 'amountMax']}]) %}
{% endif %}
{% if filters.q %}
    {% set applied = applied|merge([{label: 'Поиск: «' ~ filters.q ~ '»', keys: ['q']}]) %}
{% endif %}

<div class="vf-ops-head">
    <div class="vf-ops-head__title">
        <nav aria-label="Путь">
            <ol class="breadcrumb">
                <li class="breadcrumb-item">Деньги</li>
                <li class="breadcrumb-item active" aria-current="page">Операции ДДС</li>
            </ol>
        </nav>
        <h1>Операции ДДС</h1>
        <p class="vf-ops-head__lead">Все движения денег по счетам и кассам: загружайте выписки, разносите операции по статьям и формируйте ОПиУ.</p>
    </div>
    <div class="btn-list d-print-none">
        <a href="#"
           class="btn"
           data-bs-toggle="offcanvas"
           data-bs-target="#transaction-filters-offcanvas"
           aria-controls="transaction-filters-offcanvas">
            <i class="ti ti-filter me-1" aria-hidden="true"></i>
            Фильтры
        </a>
        <a href="{{ path('cash_transaction_export', query) }}"
           class="btn"
           data-testid="btn-export-xls">
            <i class="ti ti-download me-1" aria-hidden="true"></i>
            Экспорт XLS
        </a>
        <div class="dropdown">
            <button type="button" class="btn dropdown-toggle" data-bs-toggle="dropdown" aria-haspopup="menu" aria-expanded="false">
                <i class="ti ti-upload me-1" aria-hidden="true"></i>
                Импорт
            </button>
            <div class="dropdown-menu dropdown-menu-end">
                <a class="dropdown-item" href="/cash/import/bank1c" data-testid="btn-import-1c">Импорт 1С</a>
                <a class="dropdown-item" href="/cash/import/file" data-testid="btn-import-file">Импорт из файла</a>
            </div>
        </div>
        <div class="dropdown">
            <button type="button" class="btn btn-primary dropdown-toggle" data-bs-toggle="dropdown" aria-haspopup="menu" aria-expanded="false">
                <i class="ti ti-plus me-1" aria-hidden="true"></i>
                Добавить
            </button>
            <div class="dropdown-menu dropdown-menu-end">
                <a class="dropdown-item" href="{{ path('cash_transaction_new', query) }}">Операция</a>
                <a class="dropdown-item" href="{{ path('cash_transfer_new') }}">Перевод между счетами</a>
            </div>
        </div>
    </div>
</div>

<div class="card cashflow-ops vf-ops mb-4"
     data-csrf-token="{{ csrf_token('cash_transaction_create_from') }}">
    <div class="card-header">
        {% include 'transaction/_tabs.html.twig' with {active: 'all'} only %}
    </div>

    {% if applied is not empty %}
        <div class="vf-ops-applied">
            <span class="vf-ops-label">Применено</span>
            {% for chip in applied %}
                <span class="vf-ops-chip">
                    {{ chip.label }}
                    <a href="{{ path('cash_transaction_index', query|filter((v, k) => k not in chip.keys and k != 'page')) }}"
                       aria-label="Снять фильтр «{{ chip.label }}»"><i class="ti ti-x" aria-hidden="true"></i></a>
                </span>
            {% endfor %}
            <a href="{{ path('cash_transaction_index') }}" class="small fw-medium">Сбросить всё</a>
        </div>
    {% endif %}

    {# Итоги по фильтру контроллер не считает (TODO(ds), отчёт §4) — показываем число найденных. #}
    <div class="vf-ops-bar" id="cash-transactions-summary" role="status">
        Найдено {{ totalFound|vf_number }} {{ totalFound % 10 == 1 and totalFound % 100 != 11 ? 'операция' : (totalFound % 10 in 2..4 and (totalFound % 100 < 10 or totalFound % 100 >= 20) ? 'операции' : 'операций') }}
    </div>
    <div class="vf-ops-bar vf-ops-bar--selection" id="cash-transactions-selection" role="toolbar" aria-label="Действия с выбранными" hidden>
        <span class="vf-ops-bar__count" id="cash-transactions-selection-count">Выбрано: 0</span>
        <button type="button"
                class="btn btn-sm vf-btn-destructive"
                id="bulk-delete-button"
                data-bs-toggle="modal"
                data-bs-target="#bulkDeleteModal"
                disabled>
            <i class="ti ti-trash me-1" aria-hidden="true"></i>
            <span id="bulk-delete-button-label">Удалить</span>
        </button>
        <button type="button" class="btn btn-link" id="cash-transactions-clear-selection">Снять выбор</button>
    </div>

    {% if transactions is empty %}
        {% if hasFilters %}
            <div class="vf-ops-empty border-top">
                <div class="vf-ops-empty__title">Операции не найдены</div>
                <div class="vf-ops-empty__hint">Измените фильтры или сбросьте их.</div>
                <a href="{{ path('cash_transaction_index') }}" class="btn btn-sm">Сбросить фильтры</a>
            </div>
        {% else %}
            <div class="vf-ops-empty border-top">
                <div class="vf-ops-empty__title">Пока нет операций</div>
                <div class="vf-ops-empty__hint">Загрузите выписку в формате 1С или добавьте операцию вручную.</div>
                <div class="btn-list justify-content-center">
                    <a href="{{ path('cash_bank1c_import_upload') }}" class="btn btn-primary">Импорт 1С</a>
                    <a href="/cash/import/file" class="btn" data-testid="btn-import-file-empty">Импорт из файла</a>
                    <a href="{{ path('cash_transaction_new', query) }}" class="btn">Добавить операцию</a>
                </div>
            </div>
        {% endif %}
    {% endif %}

    <div class="table-responsive"{% if transactions is empty %} hidden{% endif %}>
        <table class="table card-table table-vcenter vf-ops-table">
            <thead class="sticky-top">
                <tr>
                    <th class="w-1">
                        <input type="checkbox"
                               class="form-check-input m-0"
                               id="cash-transactions-select-all"
                               aria-label="Выбрать все транзакции на странице"
                               {{ not hasStandaloneTransactions ? 'disabled' : '' }}>
                    </th>
                    <th>Дата / счёт</th>
                    {# DS-Money: «₽» в заголовке — только когда вся колонка в рублях; суммы не пересчитываются. #}
                    {% set amounts_in_rub = transactions|filter(t => t.currency != 'RUB')|length == 0 %}
                    <th class="text-end text-nowrap">Сумма{% if amounts_in_rub %}, ₽{% endif %}</th>
                    <th>Статья / проект</th>
                    <th>Контрагент</th>
                    <th class="text-center text-nowrap" title="Зелёная — документы ОПиУ созданы, серая — можно создать, жёлтая — создан без полного маппинга">ОПиУ</th>
                    <th><span class="visually-hidden">Действия</span></th>
                </tr>
            </thead>
            <tbody>
            {% for tx in transactions %}
                {% set transfer = transferByTransactionId[tx.id]|default(null) %}
                <tr>
                    <td>
                        <input type="checkbox"
                               class="form-check-input m-0{{ transfer ? '' : ' js-cash-transaction-select' }}"
                               value="{{ tx.id }}"
                               aria-label="Выбрать транзакцию от {{ tx.occurredAt|date('d.m.Y') }}"
                               {{ transfer ? 'disabled' : '' }}>
                    </td>
                    <td>
                        <div class="vf-ops-date">{{ tx.occurredAt|date('d.m.Y') }}</div>
                        {% if tx.moneyAccount %}
                            <div class="vf-ops-sub vf-ops-clip" title="{{ tx.moneyAccount.name }}">{{ tx.moneyAccount.name }}</div>
                        {% endif %}
                    </td>
                    {# DS-Money: ₽ — в заголовке, если вся колонка в рублях; иначе валюта в каждой строке, включая ₽. Приход — зелёный с плюсом, расход — основной цвет с минусом. #}
                    {% set inflow = tx.direction.value == 'INFLOW' %}
                    <td class="text-end vf-ops-amount">{{ tx.amount|vf_amount(2, inflow ? 'income' : null, signed: true, currency: amounts_in_rub or tx.currency != 'RUB' ? tx.currency : '₽', negate: not inflow) }}</td>
                    <td>
                        {% if tx.splits is empty %}
                            <span class="vf-ops-badge-warn">Не распределено</span>
                        {% else %}
                            <div class="vf-ops-strong">{% for s in tx.splits %}{{ s.cashflowCategory.name }}{% if not loop.last %}, {% endif %}{% endfor %}</div>
                        {% endif %}
                        <div class="vf-ops-sub">
                            {% if tx.projectDirection %}{{ tx.projectDirection.name }} · {% endif %}
                            {% if transfer %}
                                <a href="{{ path('cash_transfer_show', {id: transfer.id}) }}">Открыть перевод</a>
                            {% else %}
                                <a href="{{ path('cash_transaction_splits', {id: tx.id}) }}"
                                   title="Разнести операцию по нескольким статьям">{{ tx.splits|length > 1 ? 'изменить разбивку' : 'разбить' }}</a>
                            {% endif %}
                        </div>
                    </td>
                    <td>
                        {% if tx.counterparty %}
                            <div class="vf-ops-strong vf-ops-clip" title="{{ tx.counterparty.name }}">{{ tx.counterparty.name }}</div>
                        {% else %}
                            <div class="text-secondary">—</div>
                        {% endif %}
                        {% set description = tx.description|default('') %}
                        {% if description %}
                            <div class="vf-ops-sub vf-ops-clip" title="{{ description }}">{{ description }}</div>
                        {% endif %}
                    </td>
                    <td class="text-center text-nowrap" data-tx-id="{{ tx.id }}">
                        {% if tx.isHasViolatedDocument %}
                            <i class="ti ti-alert-triangle text-warning" role="img" aria-label="Документ создан без полного маппинга категорий ОПиУ"
                               title="Документ создан без полного маппинга категорий ОПиУ"></i>
                        {% elseif tx.remainingAmount == 0 and tx.documents is not empty %}
                            <i class="ti ti-file-check text-success" role="img" aria-label="Документы ОПиУ созданы на всю сумму"
                               title="Документы ОПиУ созданы на всю сумму"></i>
                        {# Документ ОПиУ строится из одной категории (решение D1),
                           поэтому предлагаем его только при единственной строке разбивки. #}
                        {% elseif not tx.isTransfer
                                     and tx.splits|length == 1
                                     and tx.splits|first.cashflowCategory.allowPlDocument
                                     and tx.remainingAmount > 0 %}
                            <i class="ti ti-file-plus text-secondary" role="img" aria-label="Можно создать документ ОПиУ"
                               title="Можно создать документ ОПиУ"></i>
                        {% else %}
                            <span class="text-secondary" title="ОПиУ недоступна">—</span>
                        {% endif %}
                    </td>
                    <td class="text-end">
                        {% if transfer %}
                            <a href="{{ path('cash_transfer_show', {id: transfer.id}) }}" class="btn btn-link btn-sm">Перевод</a>
                        {% else %}
                        <div class="dropdown position-static {{ loop.last ? 'dropup' : '' }}">
                            <button type="button" class="btn btn-ghost-secondary btn-icon btn-sm" data-bs-toggle="dropdown" aria-haspopup="menu" aria-expanded="false" aria-label="Действия с операцией">
                                <i class="ti ti-dots" aria-hidden="true"></i>
                            </button>

                            <div class="dropdown-menu dropdown-menu-end">
                                <a class="dropdown-item"
                                 href="{{ path('cash_transaction_edit', query|merge({'id': tx.id})) }}">
                                <i class="ti ti-pencil me-2" aria-hidden="true"></i> Редактировать
                                </a>

                                <button type="button"
                                      class="dropdown-item js-auto-rule"
                                      data-transaction-id="{{ tx.id }}"
                                      data-url="{{ path('cash_transaction_auto_rule_match_one', {transactionId: tx.id}) }}"
                                      data-bs-toggle="modal"
                                      data-bs-target="#autoRuleModal">
                                <i class="ti ti-settings-automation me-2" aria-hidden="true"></i> Автоправило
                                </button>

                                <a class="dropdown-item"
                                   href="{{ path('cash_transaction_auto_rule_new', {fromTransaction: tx.id}) }}">
                                <i class="ti ti-wand me-2" aria-hidden="true"></i> Создать правило из операции
                                </a>

                                {% if not tx.isTransfer %}
                                  {% set createFromDisabled = tx.isHasViolatedDocument or tx.remainingAmount <= 0 %}
                                  <button type="button"
                                          class="dropdown-item d-flex align-items-center gap-2 js-create-from {{ createFromDisabled ? 'disabled' : '' }}"
                                          data-transaction-id="{{ tx.id }}"
                                          data-url="{{ path('cash_transaction_create_from', {id: tx.id}) }}"
                                          {% if createFromDisabled %}
                                            title="{{ tx.isHasViolatedDocument ? 'Сначала исправьте маппинг категорий ОПиУ' : 'Транзакция уже полностью разнесена' }}"
                                            disabled
                                          {% endif %}>
                                    <i class="ti ti-copy" aria-hidden="true"></i> Создать на основании
                                  </button>
                                {% endif %}

                                <div class="dropdown-divider"></div>

                                <button type="button"
                                      class="dropdown-item text-danger"
                                      data-bs-toggle="modal"
                                      data-bs-target="#delete-modal-{{ tx.id }}">
                                <i class="ti ti-trash me-2" aria-hidden="true"></i> Удалить
                                </button>
                            </div>
                        </div>

                      {{ include('transaction/_delete_modal.html.twig', {tx: tx}) }}
                        {% endif %}
                    </td>
                </tr>
            {% endfor %}
            </tbody>
        </table>
    </div>
    {% if totalFound > 0 %}
        <div class="card-footer d-flex align-items-center">
            {% include 'partials/_pagination.html.twig' with {pager: pager} %}
        </div>
    {% endif %}
</div>

<div class="modal fade" id="bulkDeleteModal" tabindex="-1" aria-hidden="true">
  <div class="modal-dialog modal-dialog-centered" role="document">
    <div class="modal-content">
      <div class="modal-header">
        <h5 class="modal-title">
          <i class="ti ti-alert-triangle text-warning me-2"></i>
          Удалить выбранные транзакции?
        </h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Закрыть"></button>
      </div>
      <div class="modal-body">
        <p>Выбрано транзакций: <strong id="bulk-delete-modal-count">0</strong>.</p>
        <p class="mb-0 text-muted">
          Транзакции будут перемещены во вкладку «Удалённые». При необходимости их можно восстановить.
        </p>
      </div>
      <div class="modal-footer">
        <button type="button" class="btn" data-bs-dismiss="modal">Отмена</button>
        <form method="post"
              action="{{ path('cash_transaction_bulk_delete', app.request.query.all) }}"
              id="bulk-delete-form">
          <input type="hidden" name="_token" value="{{ csrf_token('cash_transaction_bulk_delete') }}">
          <div id="bulk-delete-transaction-ids"></div>
          <button type="submit" class="btn btn-danger">Удалить</button>
        </form>
      </div>
    </div>
  </div>
</div>

{{ include('transaction/_filters.html.twig') }}

<div class="modal fade" id="autoRuleModal" tabindex="-1" aria-hidden="true">
  <div class="modal-dialog modal-dialog-scrollable">
    <div class="modal-content">
      <div class="modal-header">
        <h5 class="modal-title">Автоправило</h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Закрыть"></button>
      </div>
      <div class="modal-body" id="autoRuleModalBody">
        <div class="text-muted">Загрузка…</div>
      </div>
    </div>
  </div>
</div>

<div class="modal fade" id="createFromWarningModal"
     tabindex="-1" aria-hidden="true">
  <div class="modal-dialog">
    <div class="modal-content">
      <div class="modal-header">
        <h5 class="modal-title">
          <i class="ti ti-alert-triangle text-warning me-2"></i>
          Создание без маппинга категории ОПиУ
        </h5>
        <button type="button" class="btn-close"
                data-bs-dismiss="modal"></button>
      </div>
      <div class="modal-body">
        <p id="createFromWarningBody" class="mb-0"></p>
      </div>
      <div class="modal-footer">
        <button type="button" class="btn"
                data-bs-dismiss="modal">Отмена</button>
        <form id="createFromConfirmForm" method="post" class="d-inline">
          <input type="hidden" name="_token" id="createFromCsrfToken">
          <input type="hidden" name="confirmed" value="1">
          <button type="submit" class="btn btn-warning">
            Продолжить
          </button>
        </form>
      </div>
    </div>
  </div>
</div>

{% endblock %}

{% block scripts %}
    {{ parent() }}
    <script>
    (function () {
      const selectAll = document.getElementById('cash-transactions-select-all');
      const rowCheckboxes = Array.from(document.querySelectorAll('.js-cash-transaction-select'));
      const deleteButton = document.getElementById('bulk-delete-button');
      const deleteButtonLabel = document.getElementById('bulk-delete-button-label');
      const modal = document.getElementById('bulkDeleteModal');
      const modalCount = document.getElementById('bulk-delete-modal-count');
      const form = document.getElementById('bulk-delete-form');
      const idsContainer = document.getElementById('bulk-delete-transaction-ids');
      const summaryBar = document.getElementById('cash-transactions-summary');
      const selectionBar = document.getElementById('cash-transactions-selection');
      const selectionCount = document.getElementById('cash-transactions-selection-count');
      const clearSelection = document.getElementById('cash-transactions-clear-selection');

      if (!selectAll || !deleteButton || !deleteButtonLabel || !modal || !modalCount || !form || !idsContainer) {
        return;
      }

      function selectedCheckboxes() {
        return rowCheckboxes.filter(checkbox => checkbox.checked);
      }

      function renderSelection() {
        const selectedCount = selectedCheckboxes().length;
        selectAll.checked = rowCheckboxes.length > 0 && selectedCount === rowCheckboxes.length;
        selectAll.indeterminate = selectedCount > 0 && selectedCount < rowCheckboxes.length;
        deleteButton.disabled = selectedCount === 0;
        deleteButtonLabel.textContent = selectedCount > 0 ? `Удалить (${selectedCount})` : 'Удалить';
        modalCount.textContent = String(selectedCount);
        // Панель выбора заменяет строку «Найдено N», выбранные строки подсвечены (DS-Table).
        if (summaryBar && selectionBar && selectionCount) {
          summaryBar.hidden = selectedCount > 0;
          selectionBar.hidden = selectedCount === 0;
          selectionCount.textContent = `Выбрано: ${selectedCount}`;
        }
        rowCheckboxes.forEach(checkbox => {
          checkbox.closest('tr')?.classList.toggle('table-active', checkbox.checked);
        });
      }

      function renderHiddenIds() {
        idsContainer.replaceChildren(...selectedCheckboxes().map(checkbox => {
          const input = document.createElement('input');
          input.type = 'hidden';
          input.name = 'transaction_ids[]';
          input.value = checkbox.value;

          return input;
        }));
      }

      selectAll.addEventListener('change', function () {
        rowCheckboxes.forEach(checkbox => {
          checkbox.checked = selectAll.checked;
        });
        renderSelection();
      });
      rowCheckboxes.forEach(checkbox => checkbox.addEventListener('change', renderSelection));
      clearSelection?.addEventListener('click', function () {
        rowCheckboxes.forEach(checkbox => {
          checkbox.checked = false;
        });
        renderSelection();
      });
      modal.addEventListener('show.bs.modal', renderHiddenIds);
      form.addEventListener('submit', renderHiddenIds);
      renderSelection();
    }());
    </script>
    <script>
    document.addEventListener('click', async (e) => {
      const btn = e.target.closest('.js-auto-rule');
      if (!btn) return;

      e.preventDefault();
      const url = btn.dataset.url;
      const modalEl = document.getElementById('autoRuleModal');
      const bodyEl  = document.getElementById('autoRuleModalBody');

      bodyEl.innerHTML = '<div class="text-muted">Загрузка…</div>';

      // Показ модалки (Tabler/Bootstrap 5)
      const modal = window.bootstrap?.Modal?.getOrCreateInstance(modalEl);
      modal?.show();

      try {
        const html = await fetch(url, {headers: {'X-Requested-With':'XMLHttpRequest'}}).then(r => r.text());
        bodyEl.innerHTML = html;
      } catch(err) {
        bodyEl.innerHTML = '<div class="text-danger">Ошибка загрузки</div>';
      }
    });

    // Обработка submit «Применить» внутри модалки (AJAX). Регистрируется ОДИН раз: раньше обработчик
    // навешивался заново на каждый клик по .js-auto-rule, и после повторных открытий модалки один submit
    // запускал сразу несколько POST по одной форме (GlitchTip #414, uniq_cts_tx_category).
    document.addEventListener('submit', async (ev) => {
      const f = ev.target;
      if (!(f instanceof HTMLFormElement) || f.id !== 'autoRuleApplyForm') return;
      ev.preventDefault();

      // Повторный submit, пока первый запрос в полёте (двойной клик, Enter), игнорируем.
      if (f.dataset.submitting === '1') return;
      f.dataset.submitting = '1';
      f.querySelectorAll('[type="submit"]').forEach(button => { button.disabled = true; });

      const bodyEl = document.getElementById('autoRuleModalBody');

      try {
        const formData = new FormData(f);
        const res = await fetch(f.action, { method: 'POST', body: formData, headers: {'X-Requested-With': 'XMLHttpRequest'}});
        const data = await res.json();

        if (data.ok) {
          const alert = document.createElement('div');
          alert.className = 'alert alert-success mb-2';
          alert.textContent = `Применено: ${data.changed ? 'да' : 'без изменений'}`;

          const details = document.createElement('div');
          details.append('Правило: ');
          const ruleName = document.createElement('strong');
          ruleName.textContent = data.ruleName ?? '';
          details.append(ruleName, ` (${data.action ?? ''})`);

          const actions = document.createElement('div');
          actions.className = 'mt-3 text-end';
          const closeButton = document.createElement('button');
          closeButton.type = 'button';
          closeButton.className = 'btn btn-primary';
          closeButton.dataset.bsDismiss = 'modal';
          closeButton.textContent = 'Закрыть';
          actions.append(closeButton);

          bodyEl.replaceChildren(alert, details, actions);
          return;
        }

        const alert = document.createElement('div');
        alert.className = 'alert alert-warning mb-2';
        alert.textContent = data.message ?? 'Не найдено';

        const actions = document.createElement('div');
        actions.className = 'mt-3 text-end';
        const closeButton = document.createElement('button');
        closeButton.type = 'button';
        closeButton.className = 'btn btn-secondary';
        closeButton.dataset.bsDismiss = 'modal';
        closeButton.textContent = 'Закрыть';
        actions.append(closeButton);

        bodyEl.replaceChildren(alert, actions);
      } catch {
        const alert = document.createElement('div');
        alert.className = 'alert alert-danger mb-2';
        alert.textContent = 'Не удалось обработать запрос. Попробуйте ещё раз.';

        const actions = document.createElement('div');
        actions.className = 'mt-3 text-end';
        const closeButton = document.createElement('button');
        closeButton.type = 'button';
        closeButton.className = 'btn btn-secondary';
        closeButton.dataset.bsDismiss = 'modal';
        closeButton.textContent = 'Закрыть';
        actions.append(closeButton);

        bodyEl.replaceChildren(alert, actions);
      }
    });
    </script>
    <script>
    (function () {
      const csrfContainer = document.querySelector('.cashflow-ops');
      const csrfToken = csrfContainer ? csrfContainer.dataset.csrfToken : '';

      // --- helpers ---

      function showFlash(message, type = 'success') {
        const card = document.querySelector('.cashflow-ops');
        if (!card) return;
        card.parentElement.querySelectorAll('.alert.js-create-from-flash')
          .forEach(el => el.remove());
        const div = document.createElement('div');
        div.className = 'alert alert-' + type + ' alert-dismissible fade show mb-3 js-create-from-flash';
        const text = document.createElement('span');
        text.textContent = message;
        const closeBtn = document.createElement('button');
        closeBtn.type = 'button';
        closeBtn.className = 'btn-close';
        closeBtn.setAttribute('data-bs-dismiss', 'alert');
        div.appendChild(text);
        div.appendChild(closeBtn);
        card.before(div);
      }

      function updateRowIcon(txId, state) {
        const td = document.querySelector('[data-tx-id="' + txId + '"]');
        if (!td) return;
        if (state === 'success') {
          td.innerHTML = '<i class="ti ti-file-check text-success"'
            + ' title="Документы ОПиУ созданы на всю сумму"></i>';
        } else if (state === 'warning') {
          td.innerHTML = '<i class="ti ti-alert-triangle text-warning"'
            + ' title="Документ создан без полного маппинга категорий ОПиУ"></i>';
        }
      }

      function showCreateFromModal() {
        const modalEl = document.getElementById('createFromWarningModal');
        if (!modalEl) return;
        modalEl.classList.add('show');
        modalEl.style.display = 'block';
        document.body.classList.add('modal-open');
        if (!document.getElementById('createFromBackdrop')) {
          const backdrop = document.createElement('div');
          backdrop.className = 'modal-backdrop fade show';
          backdrop.id = 'createFromBackdrop';
          document.body.appendChild(backdrop);
        }
      }

      function hideCreateFromModal() {
        const modalEl = document.getElementById('createFromWarningModal');
        if (!modalEl) return;
        modalEl.classList.remove('show');
        modalEl.style.display = '';
        document.body.classList.remove('modal-open');
        document.getElementById('createFromBackdrop')?.remove();
      }

      document.querySelectorAll(
        '#createFromWarningModal [data-bs-dismiss="modal"]'
      ).forEach(el => el.addEventListener('click', hideCreateFromModal));

      function disableCreateFromButton(txId) {
        const btn = document.querySelector(
          '.js-create-from[data-transaction-id="' + txId + '"]'
        );
        if (btn) {
          btn.classList.add('disabled');
          btn.disabled = true;
        }
      }

      // --- клик "Создать на основании" (event delegation) ---

      document.addEventListener('click', async function (e) {
        const btn = e.target.closest('.js-create-from');
        if (!btn || btn.classList.contains('disabled')) return;
        e.preventDefault();

        // Блокируем немедленно, до запроса — защита от двойного клика
        btn.classList.add('disabled');
        btn.disabled = true;

        const url  = btn.dataset.url;
        const txId = btn.dataset.transactionId;

        let data;
        try {
          const res = await fetch(url, {
            method: 'POST',
            headers: { 'X-Requested-With': 'XMLHttpRequest' },
            body: new URLSearchParams({ _token: csrfToken, confirmed: '0' }),
          });
          data = await res.json();
        } catch (err) {
          btn.classList.remove('disabled');
          btn.disabled = false;
          showFlash('Ошибка: не удалось выполнить запрос.', 'danger');
          return;
        }

        if (data.error) {
          btn.classList.remove('disabled');
          btn.disabled = false;
          showFlash('Ошибка: ' + data.message, 'danger');
          return;
        }

        if (data.needsConfirmation) {
          // Документ ещё не создан — разблокируем кнопку, чтобы пользователь
          // мог повторить действие если закроет модалку без подтверждения
          btn.classList.remove('disabled');
          btn.disabled = false;
          document.getElementById('createFromWarningBody').textContent =
            data.warningMessage;
          document.getElementById('createFromConfirmForm').action = url;
          document.getElementById('createFromCsrfToken').value = csrfToken;
          document.getElementById('createFromConfirmForm')
            .dataset.txId = txId;
          showCreateFromModal();
          return;
        }

        // Сценарий A — тихое создание
        if (data.success) {
          showFlash(data.flash ?? 'Документ ОПиУ создан.');
          updateRowIcon(txId, 'success');
          disableCreateFromButton(txId);
        }
      });

      // --- submit формы подтверждения (сценарий B) ---

      document.getElementById('createFromConfirmForm')
        .addEventListener('submit', async function (e) {
          e.preventDefault();
          const form = e.target;
          const txId = form.dataset.txId;

          let data;
          try {
            const res = await fetch(form.action, {
              method: 'POST',
              headers: { 'X-Requested-With': 'XMLHttpRequest' },
              body: new FormData(form),
            });
            data = await res.json();
          } catch (err) {
            hideCreateFromModal();
            showFlash('Ошибка: не удалось создать документ.', 'danger');
            return;
          }

          hideCreateFromModal();

          if (data.error) {
            showFlash('Ошибка: ' + data.message, 'danger');
            return;
          }

          if (data.redirect) {
            updateRowIcon(txId, 'warning');
            disableCreateFromButton(txId);
            window.open(data.redirect, '_blank');
          }
        });

    }());
    </script>
{% endblock %}
