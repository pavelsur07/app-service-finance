<div class="modal fade" id="delete-modal-{{ tx.id }}" tabindex="-1" aria-hidden="true" aria-labelledby="delete-modal-{{ tx.id }}-title">
    <div class="modal-dialog modal-dialog-centered" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="delete-modal-{{ tx.id }}-title">Удалить операцию?</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Закрыть"></button>
            </div>
            <div class="modal-body">
                {# Удаление мягкое (DeleteCashTransactionAction → markDeleted): операцию можно восстановить. #}
                <p class="mb-0 text-secondary">Операция будет перемещена во вкладку «Удалённые». При необходимости её можно восстановить.</p>
            </div>
            <div class="modal-footer">
                <form method="post" action="{{ path('cash_transaction_delete', {id: tx.id}) }}">
                    <input type="hidden" name="_token" value="{{ csrf_token('tx_delete' ~ tx.id) }}">
                    <button type="button" class="btn" data-bs-dismiss="modal">Отмена</button>
                    <button type="submit" class="btn btn-danger">Удалить</button>
                </form>
            </div>
        </div>
    </div>
</div>
