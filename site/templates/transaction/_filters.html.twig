{# «Ещё фильтры» операций ДДС — offcanvas по docs/design-system/screens/Filters.dc.html.
   Здесь только редкое из того, что умеет CashTransactionFilters: сумма и валюта. Остальные параметры
   (период, счёт, статья, контрагент, направление, поиск) — в строке фильтров (_filter_bar.html.twig);
   форма несёт их скрытыми полями, чтобы «Применить» их не сбрасывало. Имена полей не менять. #}
{% set moreKeys = ['amountMin', 'amountMax', 'currency'] %}
<div class="offcanvas offcanvas-end vf-ops-filters" tabindex="-1" id="transaction-filters-offcanvas" aria-labelledby="transaction-filters-offcanvas-label">
    <div class="offcanvas-header">
        <h2 class="offcanvas-title" id="transaction-filters-offcanvas-label">Ещё фильтры</h2>
        <button type="button" class="btn-close" data-bs-dismiss="offcanvas" aria-label="Закрыть"></button>
    </div>
    <div class="offcanvas-body">
        <form method="get" action="{{ path('cash_transaction_index') }}" id="filter-form" class="d-flex flex-column h-100">
            {% for k, v in baseQuery|filter((v, k) => k not in moreKeys) %}
                <input type="hidden" name="{{ k }}" value="{{ v }}">
            {% endfor %}
            <div class="vf-ops-filters__scroll">
                <p class="vf-ops-filters__lead">Период, счёт, статья, контрагент и направление — в панели над таблицей. Здесь только то, что нужно реже.</p>

                <section class="vf-ops-filters__section" aria-labelledby="filter-section-amount">
                    <div class="vf-ops-label" id="filter-section-amount">Сумма</div>
                    <div class="row g-3">
                        <div class="col-6">
                            <label class="form-label" for="filter-amount-min">От</label>
                            <input type="number" step="0.01" min="0" inputmode="decimal" id="filter-amount-min" name="amountMin" value="{{ filters.amountMin ?? '' }}" class="form-control vf-num" placeholder="0,00" />
                        </div>
                        <div class="col-6">
                            <label class="form-label" for="filter-amount-max">До</label>
                            <input type="number" step="0.01" min="0" inputmode="decimal" id="filter-amount-max" name="amountMax" value="{{ filters.amountMax ?? '' }}" class="form-control vf-num" placeholder="0,00" />
                        </div>
                    </div>
                    <div class="vf-ops-filters__hint">Сумма по модулю: расходы ищутся без знака минус</div>
                </section>

                <section class="vf-ops-filters__section" aria-labelledby="filter-section-currency">
                    <div class="vf-ops-label" id="filter-section-currency">Валюта операции</div>
                    <div class="vf-ops-choice" id="filter-currency" role="radiogroup" aria-labelledby="filter-section-currency">
                        <input type="radio" class="btn-check" name="currency" id="filter-currency-all" value=""{% if not filters.currency %} checked{% endif %}>
                        <label for="filter-currency-all">Все</label>
                        {% for currency in currencies %}
                            <input type="radio" class="btn-check" name="currency" id="filter-currency-{{ currency.value|lower }}" value="{{ currency.value }}"{% if filters.currency == currency.value %} checked{% endif %}>
                            <label for="filter-currency-{{ currency.value|lower }}">{{ currency.value }}</label>
                        {% endfor %}
                    </div>
                    {# Подсказка эталона про «рубли вторым значением» неверна: суммы не пересчитываются. #}
                    <div class="vf-ops-filters__hint">Суммы показываются в валюте операции, без пересчёта.</div>
                </section>
            </div>

            <div class="vf-ops-filters__footer">
                <a href="{{ path('cash_transaction_index', baseQuery|filter((v, k) => k not in moreKeys)) }}" class="btn">Сбросить</a>
                <button type="submit" class="btn btn-primary">Применить</button>
            </div>
        </form>
    </div>
</div>
