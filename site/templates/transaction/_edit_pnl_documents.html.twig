{# Документы ОПиУ на основании операции (страница «Операция ДДС»). #}
{% if pnlDocuments is not empty %}
    <div class="table-responsive">
        <table class="table card-table align-middle">
            <thead>
                <tr>
                    <th class="text-nowrap">Номер / дата</th>
                    <th>Описание</th>
                    {# Документ ОПиУ копирует сумму операции без пересчёта — валюта та же. #}
                    <th class="text-end text-nowrap">Сумма{% if tx.currency == 'RUB' %}, ₽{% endif %}</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                {% for document in pnlDocuments %}
                    <tr>
                        <td class="text-nowrap">
                            <div class="fw-semibold">{{ document.number ?: '—' }}</div>
                            <div class="text-muted">{{ document.date|date('d.m.Y') }}</div>
                        </td>
                        <td>
                            <div class="fw-semibold">{{ document.counterparty ? document.counterparty.name : '—' }}</div>
                            <div class="text-muted">{{ document.description ?: '—' }}</div>
                        </td>
                        <td class="text-end fw-semibold">{{ document.totalAmount|vf_amount(currency: tx.currency) }}</td>
                        <td class="text-end">
                            <a href="{{ path('document_edit', {id: document.id}) }}" class="btn btn-link">Открыть</a>
                        </td>
                    </tr>
                {% endfor %}
            </tbody>
        </table>
    </div>
{% else %}
    <p class="dds-card__empty">Документы ОПиУ на основании этой операции ещё не созданы.</p>
{% endif %}
