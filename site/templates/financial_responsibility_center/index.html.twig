{% extends 'base.html.twig' %}
{% block title %}ЦФО{% endblock %}

{% block body %}
    <div class="page-header d-print-none">
        <div class="container-xl">
            <div class="row g-2 align-items-center">
                <div class="col">
                    <div class="page-pretitle">Справочники</div>
                    <h2 class="page-title">ЦФО</h2>
                </div>
                <div class="col-auto ms-auto">
                    <a href="{{ path('financial_responsibility_center_new') }}" class="btn btn-primary">+ Добавить ЦФО</a>
                </div>
            </div>
        </div>
    </div>

    <div class="container-xl mt-3">
        <div class="card">
            <div class="card-body">
                <form method="get" class="row g-2 mb-3">
                    <div class="col-auto">
                        <div class="form-check mt-2">
                            <input class="form-check-input" type="checkbox" name="show_archived" value="1" id="show_archived" {% if show_archived %}checked{% endif %}>
                            <label class="form-check-label" for="show_archived">Показывать архив</label>
                        </div>
                    </div>
                    <div class="col-auto">
                        <button class="btn btn-secondary" type="submit">Применить</button>
                    </div>
                </form>

                <div class="table-responsive">
                    <table class="table table-vcenter">
                        <thead>
                            <tr>
                                <th>Наименование</th>
                                <th>Статус</th>
                                <th class="text-end">Действия</th>
                            </tr>
                        </thead>
                        <tbody>
                        {% for item in items %}
                            <tr>
                                <td>
                                    {{ item.name }}
                                    {% if item.system %}<span class="badge bg-secondary-lt ms-1">Системный</span>{% endif %}
                                </td>
                                <td>{{ item.status.value == 'active' ? 'Активен' : 'В архиве' }}</td>
                                <td class="text-end">
                                    <a href="{{ path('financial_responsibility_center_edit', {id: item.id}) }}" class="btn btn-sm btn-outline-primary">Настроить</a>
                                    {% if not item.system and item.status.value == 'active' %}
                                        <form method="post" action="{{ path('financial_responsibility_center_archive', {id: item.id}) }}" class="d-inline" onsubmit="return confirm('Архивировать ЦФО?');">
                                            <input type="hidden" name="_token" value="{{ csrf_token('archive' ~ item.id) }}">
                                            <input type="hidden" name="version" value="{{ item.version }}">
                                            <button class="btn btn-sm btn-danger" type="submit">Архивировать</button>
                                        </form>
                                    {% endif %}
                                </td>
                            </tr>
                        {% else %}
                            <tr><td colspan="3" class="text-center text-muted">ЦФО не найдены</td></tr>
                        {% endfor %}
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
{% endblock %}
