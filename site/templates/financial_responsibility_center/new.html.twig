{% extends 'base.html.twig' %}
{% block title %}Новый ЦФО{% endblock %}

{% block body %}
    {% embed 'partials/_page_header.html.twig' with {title: 'Новый ЦФО', pretitle: 'Справочники · ЦФО'} %}
        {% block actions %}
            <a href="{{ path('financial_responsibility_center_index') }}" class="btn btn-ghost-secondary">К списку</a>
        {% endblock %}
    {% endembed %}

    <div class="container-xl mt-3">
        <div class="card">
            <div class="card-header"><h3 class="card-title">Основные данные</h3></div>
            <div class="card-body">
                {{ form_start(form) }}
                {{ form_errors(form) }}
                {{ form_row(form.name) }}
                {{ form_row(form.sort) }}
                {{ form_rest(form) }}
                <button class="btn btn-primary" type="submit">Сохранить</button>
                {{ form_end(form) }}
            </div>
        </div>
    </div>
{% endblock %}
