{% if app.user %}
    {% set activeCompanyId = app.session.get('active_company_id') %}
    <form data-autosubmit action="{{ path('company_set_active') }}" method="post" class="ms-3">
        <select name="company_id" class="form-select">
            {% for company in app.user.companies|filter(company => not company.deletionRequested) %}
                <option value="{{ company.id }}" {% if company.id == activeCompanyId %}selected{% endif %}>{{ company.name }}</option>
            {% endfor %}
        </select>
    </form>
{% endif %}
