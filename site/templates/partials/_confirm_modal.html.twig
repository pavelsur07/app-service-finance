{#
  Диалог подтверждения (DS-Feedback): один на страницу, а не копия на строку.
  Кнопка-триггер: data-bs-toggle="modal" data-bs-target="#{{ id }}" и
    data-confirm-action   URL формы (POST)
    data-confirm-token    CSRF-токен этого действия
    data-confirm-title    заголовок («Отправить в архив?»)
    data-confirm-body     пояснение
    data-confirm-submit   подпись кнопки («В архив»)
    data-confirm-variant  danger — деструктивное действие (красная кнопка), иначе Action blue
    data-confirm-blocked  true — действие запрещено: заголовок цвета опасности, кнопки действия нет
    data-confirm-link-href, data-confirm-link-label — необязательная ссылка-выход («Показать операции»)
    data-confirm-links    JSON-список ссылок-выходов [{"href": "...", "label": "..."}] — под пояснением,
                          когда выходов несколько (у каждой причины запрета свой)
  Текст подставляет assets/confirm_modal.js через textContent.
  Параметры: id (обязателен).
#}
<div class="modal fade vf-confirm" id="{{ id }}" tabindex="-1" aria-hidden="true" aria-labelledby="{{ id }}-title" aria-describedby="{{ id }}-body" data-confirm-modal>
    <div class="modal-dialog modal-dialog-centered vf-confirm__dialog" role="document">
        <div class="modal-content">
            <form method="post" action="" data-confirm-form>
                <input type="hidden" name="_token" value="" data-confirm-token>
                <div class="vf-confirm__head">
                    <h2 class="vf-confirm__title" id="{{ id }}-title" data-confirm-title>Подтвердите действие</h2>
                </div>
                <p class="vf-confirm__body" id="{{ id }}-body" data-confirm-body></p>
                <ul class="vf-confirm__links" data-confirm-links hidden></ul>
                <div class="vf-confirm__footer">
                    <a class="btn" href="#" data-confirm-link hidden></a>
                    <button type="button" class="btn" data-bs-dismiss="modal" data-confirm-cancel>Отмена</button>
                    <button type="submit" class="btn btn-primary" data-confirm-submit disabled>Подтвердить</button>
                </div>
            </form>
        </div>
    </div>
</div>
