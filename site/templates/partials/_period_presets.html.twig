{#
  Пресеты периода DS «Ваш Финдир» для подённых фильтров.
  Даты считает сервер (часовой пояс приложения); «Этот …» и «Квартал» — от начала периода по сегодня.

  Кнопки, заполняющие поля формы (клик — assets/legacy-app.js):
    {% include 'partials/_period_presets.html.twig' with {from: '#filter_date_from', to: '#filter_date_to'} only %}

  Ссылки-сегменты, работают без JS: пресет — переход на route с dateFrom/dateTo поверх params;
  активный — тот, чей период совпадает с current_from/current_to (строки Y-m-d).
    {% include 'partials/_period_presets.html.twig' with {route: 'x', params: {…}, current_from: '…', current_to: '…', class: '…'} only %}
#}
{% set today = date('today') %}
{% set quarter_month = ((today|date('n') - 1) // 3) * 3 + 1 %}
{% set presets = [
    {label: 'Вчера', from: date('yesterday'), to: date('yesterday')},
    {label: 'Эта неделя', from: date('monday this week'), to: today},
    {label: 'Прошлая неделя', from: date('monday last week'), to: date('sunday last week')},
    {label: 'Этот месяц', from: date('first day of this month'), to: today},
    {label: 'Прошлый месяц', from: date('first day of last month'), to: date('last day of last month')},
    {label: 'Квартал', from: date(today|date('Y') ~ '-' ~ '%02d'|format(quarter_month) ~ '-01'), to: today},
] %}
{% if route is defined %}
    <div class="{{ class ?? '' }}" role="group" aria-label="Период">
        {% for preset in presets %}
            {% set preset_from = preset.from|date('Y-m-d') %}
            {% set preset_to = preset.to|date('Y-m-d') %}
            {% set active = preset_from == (current_from ?? null) and preset_to == (current_to ?? null) %}
            <a href="{{ path(route, (params ?? {})|merge({dateFrom: preset_from, dateTo: preset_to})) }}"
               title="{{ preset.from|date('d.m.Y') }} — {{ preset.to|date('d.m.Y') }}"
               {% if active %}class="active" aria-current="true"{% endif %}>{{ preset.label }}</a>
        {% endfor %}
    </div>
{% else %}
    <div class="d-flex flex-wrap gap-2" data-period-presets data-period-from-input="{{ from }}" data-period-to-input="{{ to }}">
        {% for preset in presets %}
            <button type="button" class="btn btn-outline-secondary" data-period-from="{{ preset.from|date('Y-m-d') }}" data-period-to="{{ preset.to|date('Y-m-d') }}">{{ preset.label }}</button>
        {% endfor %}
    </div>
{% endif %}
