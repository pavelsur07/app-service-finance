{#
  Flash легаси-shell'а (_layout/legacy): единственное место, где легаси читает app.flashes.
  Читаются только известные label — служебные ключи (invite_token …) страница забирает сама.
  Маппинг label → variant тот же, что в admin/_toasts и app/_ui/_flash. Показ тостов — assets/legacy-app.js.
#}
{% set labelVariants = {success: 'success', error: 'danger', danger: 'danger', warning: 'warning', alert: 'warning', notice: 'info', info: 'info'} %}
{% set variantIcons = {success: 'ti-check', danger: 'ti-alert-circle', warning: 'ti-alert-triangle', info: 'ti-info-circle'} %}

{% set flashMessages = [] %}
{% for label, variant in labelVariants %}
    {% for message in app.flashes(label) %}
        {% set flashMessages = flashMessages|merge([{type: variant, message: message}]) %}
    {% endfor %}
{% endfor %}

{% if flashMessages is not empty %}
    <div class="toast-container position-fixed top-0 end-0 p-3">
        {% for flash in flashMessages %}
            <div class="toast text-bg-{{ flash.type }}" role="alert" aria-live="assertive" aria-atomic="true" data-bs-delay="5000" data-bs-autohide="true">
                <div class="toast-body d-flex align-items-center gap-2">
                    <span class="toast-icon"><i class="ti {{ variantIcons[flash.type] }}"></i></span>
                    <span>{{ flash.message }}</span>
                    <button type="button" class="btn-close btn-close-white ms-auto" data-bs-dismiss="toast" aria-label="Закрыть"></button>
                </div>
            </div>
        {% endfor %}
    </div>
{% endif %}
