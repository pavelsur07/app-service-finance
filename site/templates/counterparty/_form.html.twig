{#
  Форма контрагента (DS-Controls): карточка ≈640px, поля колонкой через form_row темы
  bootstrap_5_layout (label, подсказка help, ошибка под полем), «Отмена» и «Сохранить» в подвале.
  Имена полей, id и CSRF — из CounterpartyType, разметка полей не копируется.
  Параметры: form, title, current (крошка), item (только edit).
#}
<div class="vf-page-head">
    <div class="vf-page-head__title">
        <nav aria-label="Путь">
            <ol class="breadcrumb">
                <li class="breadcrumb-item">Справочники</li>
                <li class="breadcrumb-item"><a href="{{ path('counterparty_index') }}">Контрагенты</a></li>
                <li class="breadcrumb-item active" aria-current="page">{{ current }}</li>
            </ol>
        </nav>
        <h1>
            {{ title }}
            {% if item is defined and item and item.isArchived %}
                <span class="badge bg-secondary-lt vf-status align-middle ms-2">В архиве</span>
            {% endif %}
        </h1>
    </div>
</div>

{{ form_start(form, {attr: {class: 'card vf-form mb-4'}}) }}
    <div class="card-body">
        {{ form_errors(form) }}
        {{ form_row(form.name, {attr: {autocomplete: 'off'}}) }}
        {# Отображаемое название (docs/plan/counterparty-display-name.md, этап 5): в списках и выборе
           показывается оно, а не наименование выше. Ручное смена наименования не меняет. #}
        {% if item is defined and item and item.displayName and item.displayName != item.name %}
            {% set manual = item.displayNameSource and item.displayNameSource.value == 'manual' %}
            <div class="alert alert-info mb-0" role="note">
                В списках и при выборе отображается как <strong>{{ item.displayName }}</strong>
                ({{ manual ? 'задано вручную' : 'по правилам' }}).
                {% if manual %}
                    Изменение наименования его не поменяет — вернуть исходное можно в
                    <a href="{{ path('counterparty_index') }}">списке контрагентов</a>.
                {% else %}
                    После изменения наименования оно сбросится и будет пересчитано при следующей нормализации.
                {% endif %}
            </div>
        {% endif %}
        {{ form_row(form.inn, {attr: {inputmode: 'numeric', autocomplete: 'off'}}) }}
        {{ form_row(form.kpp, {attr: {inputmode: 'numeric', autocomplete: 'off'}}) }}
        {{ form_row(form.type) }}
        {{ form_rest(form) }}
    </div>
    <div class="card-footer">
        <a href="{{ path('counterparty_index') }}" class="btn">Отмена</a>
        <button type="submit" class="btn btn-primary">Сохранить</button>
    </div>
{{ form_end(form) }}
