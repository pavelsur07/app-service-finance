{% extends 'marketplace/layout.html.twig' %}

{% set active_tab = 'marketplace' %}

{% block stylesheets %}
    {{ parent() }}
    {{ vite_entry_link_tags('marketplace_coverage') }}
{% endblock %}

{% block tab_content %}
    <div class="p-3">

        {# Покрытие загрузки финансовых отчётов WB: календарь месяца, строки — дни недели, колонки — недели #}
        {% include 'marketplace/_wb_coverage.html.twig' with {wbFinanceSyncCalendar: wbFinanceSyncCalendar} only %}

        {# История синхронизаций #}
        {% include 'marketplace/_documents.html.twig' with {rawDocumentsPager: rawDocumentsPager, selectedMarketplace: selectedMarketplace, availableMarketplaces: availableMarketplaces} only %}

    </div>
{% endblock %}

{% block modals %}
    {# Modal: Подтверждение применения выручки из реализации #}
    {% include 'marketplace/_modal_apply_realization.html.twig' only %}

    {# Modal: Пакетная обработка за месяц #}
    {% include 'marketplace/_modal_bulk_process.html.twig' with {availableMarketplaces: availableMarketplaces} only %}
{% endblock %}
