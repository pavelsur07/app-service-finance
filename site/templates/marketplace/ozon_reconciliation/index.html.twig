{% extends 'marketplace/layout.html.twig' %}

{% block title %}Сверка с Ozon{% endblock %}

{% block tab_content %}
    <div class="p-3" data-testid="ozon-reconciliation">
        <form method="get" class="row g-2 align-items-end mb-3">
            <div class="col-auto">
                <label class="form-label" for="ozon-reconciliation-month">Месяц</label>
                <select class="form-select" id="ozon-reconciliation-month" name="month" onchange="this.form.submit()">
                    {% for value, label in months %}
                        <option value="{{ value }}" {{ value == month ? 'selected' : '' }}>{{ label }}</option>
                    {% endfor %}
                </select>
            </div>
        </form>

        {% if view is null %}
            <div class="alert alert-info" data-testid="ozon-reconciliation-empty">
                Сверка за {{ month_label }} ещё не выполнялась.
            </div>
        {% else %}
            <p data-testid="ozon-reconciliation-summary">{{ view.status.label }} · расхождений: {{ view.mismatchCount }}</p>
        {% endif %}

        <form method="post" action="{{ path('marketplace_ozon_reconciliation_run') }}">
            <input type="hidden" name="_token" value="{{ csrf_token('marketplace_ozon_reconciliation_run') }}">
            <input type="hidden" name="month" value="{{ month }}">
            <button type="submit" class="btn btn-primary">Выполнить сверку</button>
        </form>
    </div>
{% endblock %}
