{% extends 'marketplace/layout.html.twig' %}

{% set active_tab = 'cost_pl_mapping' %}

{% block tab_content %}
    <div class="p-3">

        <form method="get" action="{{ path('marketplace_cost_pl_mapping_index') }}"
              class="mb-4 d-flex align-items-end gap-3" data-autosubmit>
            <div>
                <label class="form-label">Маркетплейс</label>
                <select name="marketplace" class="form-select w-auto" data-marketplace-select>
                    <option value="">Все маркетплейсы</option>
                    {% for mp in available_marketplaces %}
                        <option value="{{ mp.value }}"
                            {{ selected_marketplace == mp.value ? 'selected' : '' }}>
                            {{ mp.value|upper }}
                        </option>
                    {% endfor %}
                </select>
            </div>
            <button type="button"
                    class="btn btn-outline-primary"
                    data-default-mapping-open
                    data-bs-toggle="modal"
                    data-bs-target="#modal-default-cost-mapping">
                Настроить базовый маппинг
            </button>
        </form>

        {% set can_write = is_granted(constant('App\\Company\\Security\\ModuleAccess::MARKETPLACE_WRITE')) %}
        {% if rows is empty %}
            <div class="alert alert-info">
                Нет категорий затрат. Загрузите затраты из маркетплейса.
            </div>
        {% else %}
            <div class="card">
                <div class="table-responsive">
                    <table class="table table-vcenter card-table">
                        <thead>
                        <tr>
                            <th>Категория затрат</th>
                            <th>Маркетплейс</th>
                            <th>Категория ОПиУ</th>
                            <th class="text-center">Включить в ОПиУ</th>
                            <th>Порядок</th>
                            <th></th>
                        </tr>
                        </thead>
                        <tbody>
                        {% for row in rows %}
                            <tr data-mapping-row
                                data-update-url="{{ path('marketplace_cost_pl_mapping_update', {costCategoryId: row.costCategoryId}) }}"
                                data-name="{{ row.name }}"
                                data-pl-category-id="{{ row.plCategoryId ?? '' }}"
                                data-include-in-pl="{{ row.includeInPl ? '1' : '0' }}"
                                data-sort-order="{{ row.sortOrder }}">
                                <td>
                                    <div class="fw-medium">{{ row.name }}</div>
                                    {% if row.code %}
                                        <div class="text-muted small">{{ row.code }}</div>
                                    {% endif %}
                                </td>
                                <td>
                                    <span class="badge bg-azure-lt">{{ row.marketplace|upper }}</span>
                                </td>
                                <td data-cell-pl>
                                    {% if row.plCategoryId is null %}
                                        <span class="text-muted">— не задана —</span>
                                    {% else %}
                                        {{ pl_category_names[row.plCategoryId] ?? 'Статья ОПиУ не найдена' }}
                                    {% endif %}
                                </td>
                                <td class="text-center" data-cell-include>
                                    {% if row.includeInPl %}
                                        <span class="badge bg-green-lt">Да</span>
                                    {% else %}
                                        <span class="badge bg-secondary-lt">Нет</span>
                                    {% endif %}
                                </td>
                                <td data-cell-sort>{{ row.sortOrder }}</td>
                                <td class="text-end text-nowrap">
                                    {% if can_write %}
                                    <button type="button"
                                            class="btn btn-sm"
                                            data-bs-toggle="modal"
                                            data-bs-target="#modal-edit-cost-mapping">
                                        Изменить
                                    </button>
                                    {% if not row.isSystem %}
                                        <button type="button"
                                                class="btn btn-sm btn-ghost-danger"
                                                data-bs-toggle="modal"
                                                data-bs-target="#modal-delete-cost-category"
                                                data-url="{{ path('marketplace_cost_pl_mapping_delete_category', {id: row.costCategoryId}) }}"
                                                data-name="{{ row.name }}">
                                            Удалить
                                        </button>
                                    {% endif %}
                                    {% endif %}
                                </td>
                            </tr>
                        {% endfor %}
                        </tbody>
                    </table>
                </div>
            </div>
        {% endif %}

    </div>

    {# Modal: Изменить маппинг одной категории затрат — select статей ОПиУ один на страницу #}
    <div class="modal modal-blur fade" id="modal-edit-cost-mapping" tabindex="-1" role="dialog" aria-hidden="true" data-edit-mapping-modal>
        <div class="modal-dialog modal-dialog-centered" role="document">
            <div class="modal-content">
                <form data-edit-mapping-form
                      data-csrf-token="{{ csrf_token(constant('App\\Marketplace\\Controller\\CostPLMappingUpdateController::CSRF_TOKEN_ID')) }}">
                    <div class="modal-header">
                        <h5 class="modal-title">Маппинг: <span data-edit-mapping-name></span></h5>
                        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                    </div>
                    <div class="modal-body">
                        <div class="alert alert-danger d-none" data-edit-mapping-error></div>
                        <div class="alert alert-warning d-none" data-edit-mapping-dangling>
                            Текущая статья ОПиУ не найдена. Выберите статью, иначе при сохранении привязка будет снята.
                        </div>
                        <div class="mb-3">
                            <label class="form-label" for="edit-mapping-pl">Категория ОПиУ</label>
                            <select id="edit-mapping-pl" class="form-select" data-edit-mapping-pl>
                                <option value="">— не задана —</option>
                                {% for plCat in pl_categories %}
                                    <option value="{{ plCat.id }}" data-name="{{ plCat.name }}">{{ plCat.indentedName }}</option>
                                {% endfor %}
                            </select>
                        </div>
                        <div class="mb-3">
                            <label class="form-check">
                                <input type="checkbox" class="form-check-input" data-edit-mapping-include>
                                <span class="form-check-label">Включить в ОПиУ</span>
                            </label>
                        </div>
                        <div>
                            <label class="form-label" for="edit-mapping-sort">Порядок</label>
                            <input type="number" id="edit-mapping-sort" class="form-control" data-edit-mapping-sort min="{{ constant('App\\Marketplace\\Entity\\MarketplaceCostPLMapping::SORT_ORDER_MIN') }}" max="{{ constant('App\\Marketplace\\Entity\\MarketplaceCostPLMapping::SORT_ORDER_MAX') }}" step="1" required>
                        </div>
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn" data-bs-dismiss="modal">Отмена</button>
                        <button type="submit" class="btn btn-primary" data-edit-mapping-submit>Сохранить</button>
                    </div>
                </form>
            </div>
        </div>
    </div>

    {% include 'marketplace/cost_pl_mapping/_default_mapping_modal.html.twig' %}

    {# Modal: Удалить категорию затрат #}
    <div class="modal modal-blur fade" id="modal-delete-cost-category" tabindex="-1" role="dialog" aria-hidden="true" data-delete-cost-category-modal>
        <div class="modal-dialog modal-dialog-centered" role="document">
            <div class="modal-content">
                <form method="post" data-delete-cost-category-form>
                    <input type="hidden" name="_token" value="{{ csrf_token(constant('App\\Marketplace\\Controller\\CostCategoryDeleteController::CSRF_TOKEN_ID')) }}">
                    <input type="hidden" name="marketplace" value="{{ selected_marketplace ?? '' }}">
                    <div class="modal-header">
                        <h5 class="modal-title">Удалить категорию затрат</h5>
                        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                    </div>
                    <div class="modal-body">
                        <div class="alert alert-warning" role="alert">
                            <div class="d-flex">
                                <div>
                                    <svg xmlns="http://www.w3.org/2000/svg" class="icon alert-icon" width="24" height="24" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" fill="none" stroke-linecap="round" stroke-linejoin="round"><path stroke="none" d="M0 0h24v24H0z" fill="none"/><path d="M12 9v4" /><path d="M10.363 3.591l-8.106 13.534a1.914 1.914 0 0 0 1.636 2.871h16.214a1.914 1.914 0 0 0 1.636 -2.87l-8.106 -13.536a1.914 1.914 0 0 0 -3.274 0z" /><path d="M12 16h.01" /></svg>
                                </div>
                                <div>
                                    <h4 class="alert-title">Внимание!</h4>
                                    <div class="text-muted">
                                        Категория затрат <strong data-delete-cost-category-name></strong> будет удалена.
                                        Привязка к категории ОПиУ также будет снята. Продолжить?
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn" data-bs-dismiss="modal">Отмена</button>
                        <button type="submit" class="btn btn-danger">Удалить</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
{% endblock %}
