{% extends 'marketplace/layout.html.twig' %}

{% set active_tab = 'month_close' %}

{% block tab_content %}
    <div class="p-3" data-month-close
         data-preflight-url="{{ path('marketplace_month_close_preflight') }}"
         data-rebuild-url="{{ path('marketplace_month_preliminary_rebuild') }}">

        {% include 'marketplace/month_close/_filters.html.twig' with {available_marketplaces: available_marketplaces, marketplace: marketplace, year: year, month: month} only %}

        {# Этапы закрытия #}
        <div class="row g-3 mb-4">
            {% for stage in stages %}
                {% include 'marketplace/month_close/_stage.html.twig' with {stage: stage, month_close: month_close, marketplace: marketplace, year: year, month: month, is_current_month: is_current_month} only %}
            {% endfor %}
        </div>

        {% include 'marketplace/month_close/_history.html.twig' with {history: history, marketplace: marketplace} only %}

    </div>
{% endblock %}

{% block modals %}
    {% include 'partials/_confirm_modal.html.twig' with {id: 'month-close-confirm'} only %}
{% endblock %}
