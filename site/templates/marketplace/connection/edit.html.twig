{% extends 'marketplace/layout.html.twig' %}

{% set active_tab = 'connections' %}

{% block tab_content %}
    <div class="container-xl">
        <div class="page-header">
            <div class="row align-items-center">
                <div class="col-auto">
                    <h2 class="page-title">
                        Настройки — {{ connection.marketplace.displayName }}
                    </h2>
                </div>
            </div>
        </div>

        <div class="card mb-3">
            <div class="card-body">
                <form method="POST" action="{{ path('marketplace_connection_edit', {id: connection.id}) }}">
                    <input type="hidden" name="_token" value="{{ csrf_token('marketplace_connection_edit' ~ connection.id) }}">

                    <div class="mb-3">
                        <label class="form-label">Проект ОПиУ</label>
                        <select name="project_direction_id" class="form-select">
                            <option value="">— Без проекта</option>
                            {% for project in project_directions %}
                                <option value="{{ project.id }}"
                                        {% if connection.projectDirectionId == project.id %}selected{% endif %}>
                                    {{ project.indentedName }}
                                </option>
                            {% endfor %}
                        </select>
                        <small class="text-muted">
                            Проект будет проставлен в документ ОПиУ и все его строки при закрытии месяца.
                        </small>
                    </div>

                    <div class="form-footer">
                        <button type="submit" class="btn btn-primary">Сохранить</button>
                        <a href="{{ path('marketplace_connections_index') }}" class="btn btn-link">Отмена</a>
                    </div>

                </form>
            </div>
        </div>

        {% if can_update_api_key %}
            <div class="card">
                <div class="card-header">
                    <h3 class="card-title">Обновление API-ключа</h3>
                </div>
                <div class="card-body">
                    <form method="POST" action="{{ path('marketplace_connection_api_key_update', {id: connection.id}) }}">
                        <input type="hidden" name="_token" value="{{ csrf_token('marketplace_connection_api_key_update' ~ connection.id) }}">

                        {% if connection.marketplace.value == 'ozon' %}
                            <div class="mb-3">
                                <label class="form-label">Client-Id магазина</label>
                                <input type="text" class="form-control" value="{{ connection.clientId }}" readonly>
                                <small class="text-muted">Client-Id и идентификатор подключения не изменятся.</small>
                            </div>
                        {% endif %}

                        <div class="mb-3">
                            <label class="form-label required" for="marketplace-api-key">Новый API-ключ</label>
                            <input type="password"
                                   name="api_key"
                                   id="marketplace-api-key"
                                   class="form-control"
                                   autocomplete="new-password"
                                   required>
                            <small class="text-muted">
                                Ключ будет сохранён только после успешной проверки. Текущий ключ не отображается.
                            </small>
                        </div>

                        <div class="form-footer">
                            <button type="submit" class="btn btn-primary">Проверить и обновить</button>
                        </div>
                    </form>
                </div>
            </div>
        {% endif %}
    </div>
{% endblock %}
