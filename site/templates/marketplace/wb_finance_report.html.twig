{% extends 'marketplace/layout.html.twig' %}

{% block title %}Финансовый отчёт WB по загруженным данным{% endblock %}

{% block tab_content %}
    <div class="p-3 p-md-4">
        <div class="d-flex flex-column flex-md-row align-items-md-center justify-content-between gap-3 mb-3">
            <div>
                <h3 class="card-title mb-1">Контроль финансового отчёта WB</h3>
                <div class="text-secondary">
                    Агрегация загруженных raw-строк. Транзакции системы не используются.
                </div>
            </div>
            {% if report %}
                <a
                    class="btn btn-outline-primary"
                    href="{{ path('marketplace_wb_finance_report_csv', filters) }}"
                >
                    Скачать CSV
                </a>
            {% endif %}
        </div>

        {% include 'marketplace/wb_finance_report/_filters.html.twig' with {filters: filters} only %}

        {% if filter_error %}
            <div class="alert alert-danger" role="alert">
                <div class="fw-semibold">Не удалось сформировать отчёт</div>
                <div>{{ filter_error }}</div>
            </div>
        {% endif %}

        {% if report %}
            {% include 'marketplace/wb_finance_report/_summary.html.twig' with {report: report} only %}

            {% include 'marketplace/wb_finance_report/_articles.html.twig' with {report: report} only %}

            {% include 'marketplace/wb_finance_report/_deductions.html.twig' with {report: report} only %}

            {% include 'marketplace/wb_finance_report/_products.html.twig' with {report: report, product_status_labels: product_status_labels} only %}

            <div class="row row-cards mb-3">
                <div class="col-xl-7">
                    {% include 'marketplace/wb_finance_report/_reports.html.twig' with {report: report, filters: filters} only %}
                </div>

                <div class="col-xl-5">
                    {% include 'marketplace/wb_finance_report/_quality.html.twig' with {report: report} only %}
                </div>
            </div>

            {% include 'marketplace/wb_finance_report/_operations.html.twig' with {report: report} only %}

            {% include 'marketplace/wb_finance_report/_coverage.html.twig' with {report: report} only %}
        {% endif %}
    </div>
{% endblock %}
