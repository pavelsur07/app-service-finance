{% extends 'marketplace/layout.html.twig' %}

{% set active_tab = 'pl_mappings' %}
{% set isOzon = marketplaceFilterValue == 'ozon' %}

{% block tab_content %}
    <div class="card-header">
        <div class="row align-items-center w-100">
            <div class="col">
                <h3 class="card-title">{{ isOzon ? 'Настройка статей Ozon' : 'Маппинг ОПиУ (' ~ (operationType == 'sale' ? 'Продажи' : 'Возвраты') ~ ')' }}</h3>
                <div class="text-muted small">
                    {% if isOzon %}
                        Выберите, в какие статьи ОПиУ попадут продажи и возвраты до и после скидки Ozon.
                    {% else %}
                        Настройка правил AmountSource → Категория ОПиУ. Важно: активным может быть только одно правило на источник суммы.
                    {% endif %}
                </div>
            </div>
            <div class="col-auto ms-auto">
                <a href="#" class="btn btn-primary btn-sm" data-bs-toggle="modal" data-bs-target="#modal-add-mapping">
                    <svg xmlns="http://www.w3.org/2000/svg" class="icon" width="24" height="24" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" fill="none" stroke-linecap="round" stroke-linejoin="round"><path stroke="none" d="M0 0h24v24H0z" fill="none"/><line x1="12" y1="5" x2="12" y2="19" /><line x1="5" y1="12" x2="19" y2="12" /></svg>
                    {{ isOzon ? 'Добавить настройку' : 'Добавить правило' }}
                </a>
            </div>
        </div>
    </div>

    <div class="card-body border-bottom">
        {% if isOzon %}
            {% include 'marketplace/pl_mappings/_ozon_status.html.twig' %}
        {% endif %}
        {% include 'marketplace/pl_mappings/_filters.html.twig' with {
            operationType: operationType,
            marketplaceFilterValue: marketplaceFilterValue,
            availableMarketplaces: availableMarketplaces,
            missingAmountSources: missingAmountSources,
            isOzon: isOzon,
            ozonMarketplace: ozonMarketplace,
        } only %}
    </div>

    {% include 'marketplace/pl_mappings/_table.html.twig' with {
        mappings: mappings,
        marketplaceFilterValue: marketplaceFilterValue,
        isOzon: isOzon,
        operationType: operationType,
        plCategories: plCategories,
        projectDirections: projectDirections,
    } only %}

    {% if isOzon and ozon.conflicts is not empty %}
        {% include 'marketplace/pl_mappings/_ozon_repair_modal.html.twig' %}
    {% endif %}

    {% include 'marketplace/pl_mappings/_modal_add.html.twig' with {
        isOzon: isOzon,
        operationType: operationType,
        marketplaceFilterValue: marketplaceFilterValue,
        availableMarketplaces: availableMarketplaces,
        amountSources: amountSources,
        ozonMarketplace: ozonMarketplace,
        plCategories: plCategories,
        projectDirections: projectDirections,
    } only %}

    {% if marketplaceFilterValue != 'all' %}
        {% include 'marketplace/pl_mappings/_default_mapping_modal.html.twig' %}
    {% endif %}
{% endblock %}
