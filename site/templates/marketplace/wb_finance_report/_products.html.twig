{# «Товары и себестоимость»: KPI по SKU, предупреждения, таблица товаров. Параметры: report, product_status_labels. #}
{% import 'marketplace/wb_finance_report/_macros.html.twig' as report_ui %}
<div id="wb-product-costs" class="card mb-3">
    <div class="card-header">
        <div>
            <h4 class="card-title mb-1">Товары и себестоимость</h4>
            <div class="text-secondary small">
                Результат = товарное «К перечислению» − нетто-себестоимость.
                Это не чистая прибыль: логистика, хранение, штрафы и другие нетоварные расходы WB
                по SKU не распределяются.
            </div>
        </div>
    </div>

    {% if report.products is empty %}
        <div class="card-body text-center text-secondary py-5">
            Для выбранных фильтров нет товарных продаж или возвратов.
        </div>
    {% else %}
        <div class="card-body border-bottom">
            <div class="row row-cards">
                <div class="col-sm-6 col-xl-4">
                    <div class="card h-100">
                        <div class="card-body">
                            <div class="text-secondary mb-1">Варианты SKU</div>
                            <div class="h2 mb-0">{{ report.product_summary.sku_count|vf_number }}</div>
                            <div class="text-secondary small">
                                Сопоставлено:
                                {{ report.product_summary.mapped_sku_count|vf_number }},
                                без пары:
                                {{ report.product_summary.unmapped_sku_count|vf_number }},
                                конфликтов:
                                {{ report.product_summary.conflict_sku_count|vf_number }}
                            </div>
                        </div>
                    </div>
                </div>
                <div class="col-sm-6 col-xl-4">
                    <div class="card h-100">
                        <div class="card-body">
                            <div class="text-secondary mb-1">Товары, шт.</div>
                            <div class="h2 mb-0">{{ report.product_summary.net_quantity|vf_number }}</div>
                            <div class="text-secondary small">
                                Продано: {{ report.product_summary.sold_quantity|vf_number }},
                                возвращено: {{ report.product_summary.returned_quantity|vf_number }}
                            </div>
                        </div>
                    </div>
                </div>
                <div class="col-sm-6 col-xl-4">
                    <div class="card h-100">
                        <div class="card-body">
                            <div class="text-secondary mb-1">Продажи без СПП (нетто)</div>
                            <div class="h2 mb-0">{{ report_ui.money(report.product_summary.net_sales_without_spp_minor) }}</div>
                            <div class="text-secondary small">
                                С СПП: {{ report_ui.money(report.product_summary.net_sales_with_spp_minor) }}
                            </div>
                            <div class="text-secondary small">
                                Сверка со статьями:
                                <span class="{{ report.product_summary.sales_reconciliation_minor != 0 ? 'text-danger' : '' }}">
                                    {{ report_ui.money(report.product_summary.sales_reconciliation_minor) }}
                                </span>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="col-sm-6 col-xl-4">
                    <div class="card h-100">
                        <div class="card-body">
                            <div class="text-secondary mb-1">К перечислению за товар (по SKU)</div>
                            <div class="h2 mb-0">{{ report_ui.money(report.product_summary.for_pay_minor) }}</div>
                            <div class="text-secondary small">
                                Не распределено по SKU:
                                {{ report_ui.money(report.product_summary.unallocated_for_pay_minor) }}
                            </div>
                        </div>
                    </div>
                </div>
                <div class="col-sm-6 col-xl-4">
                    <div class="card h-100">
                        <div class="card-body">
                            <div class="text-secondary mb-1">Нетто-себестоимость</div>
                            <div class="h2 mb-0">{{ report_ui.money(report.product_summary.net_cost_minor) }}</div>
                            <div class="text-secondary small">
                                Покрытие:
                                {{ report_ui.percent(report.product_summary.cost_coverage_percent) }};
                                без цены:
                                {{ report.product_summary.missing_cost_quantity|vf_number }} шт.
                            </div>
                        </div>
                    </div>
                </div>
                <div class="col-sm-6 col-xl-4">
                    <div class="card h-100 {{ report.product_summary.result_minor is not null ? 'border-primary' : 'border-warning' }}">
                        <div class="card-body">
                            <div class="text-secondary mb-1">Результат до общих расходов WB</div>
                            {% if report.product_summary.result_minor is not null %}
                                <div class="h2 mb-0">
                                    {{ report_ui.money(report.product_summary.result_minor) }}
                                </div>
                                <div class="text-secondary small">
                                    Рентабельность к продажам без СПП:
                                    {{ report_ui.percent(report.product_summary.profitability_percent) }}
                                </div>
                            {% else %}
                                <div class="h2 mb-0 text-warning">—</div>
                                <div class="text-secondary small">
                                    Рассчитано SKU:
                                    {{ report.product_summary.complete_cost_sku_count|vf_number }}
                                    из {{ report.product_summary.sku_count|vf_number }};
                                    известная часть:
                                    {{ report_ui.money(report.product_summary.known_result_minor) }}
                                </div>
                            {% endif %}
                        </div>
                    </div>
                </div>
            </div>
        </div>
    {% endif %}

    {% if report.product_summary.missing_cost_quantity > 0 or report.product_summary.unmapped_sku_count > 0 or report.product_summary.conflict_sku_count > 0 or report.product_summary.fallback_cost_quantity > 0 or report.product_summary.unallocated_for_pay_minor != 0 or report.product_summary.sales_reconciliation_minor != 0 %}
        <div class="card-body border-top">
            <div class="d-flex flex-column gap-3">
            {% if report.product_summary.missing_cost_quantity > 0 or report.product_summary.unmapped_sku_count > 0 or report.product_summary.conflict_sku_count > 0 %}
                <div class="alert alert-warning mb-0" role="status">
                    Общий результат недостоверен, пока не заполнена себестоимость для
                    {{ report.product_summary.missing_cost_quantity|vf_number }} шт.
                    {% if report.product_summary.unmapped_sku_count > 0 %}
                        Не сопоставлено SKU:
                        {{ report.product_summary.unmapped_sku_count|vf_number }}.
                    {% endif %}
                    {% if report.product_summary.conflict_sku_count > 0 %}
                        Конфликтов идентификаторов:
                        {{ report.product_summary.conflict_sku_count|vf_number }}.
                    {% endif %}
                </div>
            {% endif %}

            {% if report.product_summary.fallback_cost_quantity > 0 %}
                <div class="alert alert-info mb-0" role="status">
                    Для
                    {{ report.product_summary.fallback_cost_quantity|vf_number }} шт.
                    использована самая ранняя
                    доступная себестоимость по правилу fallback.
                </div>
            {% endif %}

            {% if report.product_summary.unallocated_for_pay_minor != 0 %}
                <div class="alert alert-secondary mb-0" role="status">
                    {{ report_ui.money(report.product_summary.unallocated_for_pay_minor) }}
                    товарного «К перечислению» не распределено по SKU.
                    Это корректировки без товарной строки, они сохранены в общих итогах отчёта.
                </div>
            {% endif %}

            {% if report.product_summary.sales_reconciliation_minor != 0 %}
                <div class="alert alert-danger mb-0" role="alert">
                    Расхождение продаж между общими статьями и строками SKU:
                    {{ report_ui.money(report.product_summary.sales_reconciliation_minor) }}.
                    Проверьте исключённые и неклассифицированные raw-строки.
                </div>
            {% endif %}
            </div>
        </div>
    {% endif %}

    {% include 'marketplace/wb_finance_report/_products_table.html.twig' with {report: report, product_status_labels: product_status_labels} only %}
</div>
