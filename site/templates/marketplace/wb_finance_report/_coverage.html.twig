{# «Покрытие загрузки» по дням. Параметры: report. #}
<details class="card" {{ report.coverage.days_with_status < report.coverage.expected_days ? 'open' : '' }}>
    <summary class="card-header cursor-pointer">
        <span class="card-title">
            Покрытие загрузки: {{ report.coverage.days_with_status }} из {{ report.coverage.expected_days }} дней
        </span>
    </summary>
    <div class="table-responsive">
        <table class="table table-vcenter card-table">
            <thead>
            <tr>
                <th>Дата</th>
                <th>Статус</th>
                <th class="text-end">Строк по статусу</th>
                <th>Последнее обновление</th>
                <th></th>
            </tr>
            </thead>
            <tbody>
            {% for day in report.coverage.days %}
                <tr>
                    <td class="text-nowrap">{{ day.date|date('d.m.Y') }}</td>
                    <td>
                        <span class="badge bg-{{ day.status_tone }}">{{ day.status_label }}</span>
                        {% if day.fallback_raw_document %}
                            <div class="text-secondary small mt-1">В отчёте учтены ранее загруженные данные дня</div>
                        {% endif %}
                        {% if day.last_error_message %}
                            <div class="text-danger small mt-1">{{ day.last_error_message|slice(0, 160) }}</div>
                        {% endif %}
                    </td>
                    <td class="text-end">{{ day.records_count|vf_number }}</td>
                    <td class="text-secondary text-nowrap">
                        {{ day.updated_at ? day.updated_at|date('d.m.Y H:i', 'Europe/Moscow') : '—' }}
                    </td>
                    <td class="text-end">
                        {% if day.raw_document_id %}
                            <a
                                href="{{ path('marketplace_raw_view', {id: day.raw_document_id}) }}"
                                class="btn btn-sm btn-ghost-primary"
                                target="_blank"
                                rel="noopener"
                            >JSON</a>
                        {% endif %}
                    </td>
                </tr>
            {% endfor %}
            </tbody>
        </table>
    </div>
</details>
