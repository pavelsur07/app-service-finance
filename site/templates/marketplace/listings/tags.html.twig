{% extends 'inventory/layout.html.twig' %}

{% block tab_content %}
    {# Адреса API — на корне; переименование — path() с плейсхолдером-UUID (requirements не примут '__ID__').
       Токен нужен диалогу подтверждения как условие открытия: его форма не отправляется, запрос JSON шлёт модуль. #}
    {% set confirm_token = csrf_token('listing_tags') %}
    <div class="container-xl py-4" data-listing-tags
         data-create-url="{{ path('api_marketplace_listing_tags_create') }}"
         data-rename-url="{{ path('api_marketplace_listing_tags_rename', {tagId: '00000000-0000-0000-0000-000000000000'}) }}"
         data-merge-url="{{ path('api_marketplace_listing_tags_merge') }}"
         data-confirm-target="#tags-confirm"
         data-confirm-token="{{ confirm_token }}"
         data-name-max-length="{{ constant('App\\Marketplace\\Entity\\MarketplaceListingTag::NAME_MAX_LENGTH') }}"
         data-tags="{{ tags|json_encode|e('html_attr') }}">

        <div class="d-flex align-items-center gap-3 mb-3 flex-wrap">
            <h3 class="mb-0 me-auto">Управление тегами</h3>
            <button type="button" class="btn btn-primary" data-bs-toggle="modal" data-bs-target="#createTagModal">
                Добавить
            </button>
        </div>

        <div class="card">
            {% if tags is empty %}
                <div class="card-body">
                    <div class="empty">
                        <p class="empty-title">Тегов пока нет</p>
                        <p class="empty-subtitle text-muted">
                            Нажмите «Добавить» или создайте тег на странице листингов: выделите строки и введите название в панели.
                        </p>
                    </div>
                </div>
            {% else %}
                <div class="table-responsive">
                    <table class="table card-table table-vcenter">
                        <thead>
                        <tr>
                            <th>Тег</th>
                            <th class="text-end w-1">Листингов</th>
                            <th class="w-1"></th>
                        </tr>
                        </thead>
                        <tbody>
                        {% for tag in tags %}
                            <tr data-tag-id="{{ tag.id }}" data-tag-name="{{ tag.name }}">
                                <td class="tag-cell" data-tag-cell>
                                    <span class="tag-chip tag-name">{{ tag.name }}</span>
                                </td>
                                <td class="text-end">{{ tag.listingsCount }}</td>
                                <td>
                                    <div class="d-flex justify-content-end gap-1">
                                        <button type="button" class="btn btn-sm btn-ghost-secondary" data-rename-tag>
                                            Переименовать
                                        </button>
                                        <div class="dropdown">
                                            <button type="button" class="btn btn-sm btn-ghost-secondary dropdown-toggle"
                                                    data-bs-toggle="dropdown" aria-expanded="false"
                                                    {{ tags|length < 2 ? 'disabled' : '' }}>
                                                Слить в…
                                            </button>
                                            {# Пункты-цели строит модуль из data-tags. #}
                                            <div class="dropdown-menu dropdown-menu-end" data-merge-menu></div>
                                        </div>
                                        <button type="button" class="btn btn-sm btn-ghost-danger" data-delete-tag
                                                data-bs-toggle="modal" data-bs-target="#tags-confirm"
                                                data-confirm-action="{{ path('api_marketplace_listing_tags_delete', {tagId: tag.id}) }}"
                                                data-confirm-token="{{ confirm_token }}"
                                                data-confirm-title="Удалить тег «{{ tag.name }}»?"
                                                data-confirm-body="{{ tag.listingsCount > 0 ? 'Тег снимется с ' ~ tag.listingsCount ~ ' листинг(ов).' : '' }}"
                                                data-confirm-submit="Удалить"
                                                data-confirm-variant="danger">
                                            Удалить
                                        </button>
                                    </div>
                                </td>
                            </tr>
                        {% endfor %}
                        </tbody>
                    </table>
                </div>
            {% endif %}
        </div>
    </div>
{% endblock %}

{% block modals %}
    <div class="modal modal-blur fade" id="createTagModal" tabindex="-1" role="dialog" aria-labelledby="createTagModalTitle" data-create-tag-modal>
        <div class="modal-dialog modal-dialog-centered modal-sm" role="document">
            <form class="modal-content" novalidate>
                <div class="modal-header">
                    <h5 class="modal-title" id="createTagModalTitle">Новый тег</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Закрыть"></button>
                </div>
                <div class="modal-body">
                    <label class="form-label" for="createTagName">Название</label>
                    <input type="text" class="form-control" id="createTagName" name="name"
                           maxlength="{{ constant('App\\Marketplace\\Entity\\MarketplaceListingTag::NAME_MAX_LENGTH') }}"
                           autocomplete="off" required>
                    <div class="invalid-feedback"></div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-link link-secondary" data-bs-dismiss="modal">Отмена</button>
                    <button type="submit" class="btn btn-primary">Создать</button>
                </div>
            </form>
        </div>
    </div>

    {% include 'partials/_confirm_modal.html.twig' with {id: 'tags-confirm'} only %}
{% endblock %}
