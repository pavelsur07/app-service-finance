{% extends 'inventory/layout.html.twig' %}

{% block tab_content %}
    {# Обычные формы с CSRF: создание, переименование в строке, удаление через диалог.
       Используемую категорию удалить нельзя — диалог в blocked-режиме со ссылкой на её листинги. #}
    {% set token = csrf_token('listing_categories') %}
    {% set max_length = constant('App\\Marketplace\\Entity\\MarketplaceListingCategory::NAME_MAX_LENGTH') %}
    <div class="container-xl py-4" data-testid="listing-categories">
        <div class="d-flex align-items-center gap-3 mb-3 flex-wrap">
            <h3 class="mb-0 me-auto">Категории листингов</h3>
            <form method="post" action="{{ path('marketplace_listing_categories_create') }}" class="d-flex gap-2">
                <input type="hidden" name="_token" value="{{ token }}">
                <input type="text" class="form-control" name="name" maxlength="{{ max_length }}" required
                       placeholder="Новая категория" aria-label="Название новой категории" autocomplete="off">
                <button type="submit" class="btn btn-primary">Добавить</button>
            </form>
        </div>
        <p class="text-secondary small">
            У листинга может быть только одна категория, поэтому суммы по категориям в отчётах складываются в итог.
            Назначить категорию можно в реестре: отметьте строки и выберите категорию в панели над таблицей.
        </p>

        <div class="card">
            {% if categories is empty %}
                <div class="card-body">
                    {% include 'partials/_empty.html.twig' with {title: 'Категорий пока нет', hint: 'Введите название и нажмите «Добавить».'} only %}
                </div>
            {% else %}
                <div class="table-responsive">
                    <table class="table card-table table-vcenter">
                        <thead>
                        <tr>
                            <th>Категория</th>
                            <th class="text-end w-1">Листингов</th>
                            <th class="w-1"></th>
                        </tr>
                        </thead>
                        <tbody>
                        {% for category in categories %}
                            <tr>
                                <td>
                                    <form method="post" action="{{ path('marketplace_listing_categories_rename', {categoryId: category.id}) }}"
                                          class="d-flex gap-2">
                                        <input type="hidden" name="_token" value="{{ token }}">
                                        <input type="text" class="form-control form-control-sm u-max-w-320" name="name"
                                               value="{{ category.name }}" maxlength="{{ max_length }}" required
                                               aria-label="Название категории {{ category.name }}">
                                        <button type="submit" class="btn btn-sm btn-ghost-secondary">Сохранить</button>
                                    </form>
                                </td>
                                <td class="text-end">
                                    <a href="{{ path('marketplace_listings_index', {category: category.id}) }}">{{ category.listingsCount|vf_number }}</a>
                                </td>
                                <td>
                                    {# Диалогу нужны адрес и токен даже в blocked-режиме — без них он не откроется. #}
                                    <button type="button" class="btn btn-sm btn-ghost-danger"
                                            data-bs-toggle="modal" data-bs-target="#categories-confirm"
                                            data-confirm-action="{{ path('marketplace_listing_categories_delete', {categoryId: category.id}) }}"
                                            data-confirm-token="{{ token }}"
                                            {% if category.listingsCount > 0 %}
                                            data-confirm-blocked="true"
                                            data-confirm-title="Категорию «{{ category.name }}» удалить нельзя"
                                            data-confirm-body="Она назначена {{ category.listingsCount|vf_number }} листинг(ам). Сначала снимите или замените её в реестре."
                                            data-confirm-link-href="{{ path('marketplace_listings_index', {category: category.id}) }}"
                                            data-confirm-link-label="Показать листинги"
                                            {% else %}
                                            data-confirm-title="Удалить категорию «{{ category.name }}»?"
                                            data-confirm-submit="Удалить"
                                            data-confirm-variant="danger"
                                            {% endif %}>
                                        Удалить
                                    </button>
                                </td>
                            </tr>
                        {% endfor %}
                        </tbody>
                    </table>
                </div>
            {% endif %}
        </div>
    </div>
{% endblock %}

{% block modals %}
    {% include 'partials/_confirm_modal.html.twig' with {id: 'categories-confirm'} only %}
{% endblock %}
