{% extends 'marketplace/layout.html.twig' %}

{% set active_tab = 'connections' %}

{% block tab_content %}
    <div class="p-3" data-marketplace-connections>

        {% if needsPlExtension is defined and needsPlExtension %}
            <div class="alert alert-warning" data-pl-extension-hint>
                В дереве ОПиУ профиля «Базовый» нет статей маркетплейса — затраты и продажи маркетплейса не попадут
                в отчёт. <a href="{{ path('pl_category_import', {source: 'marketplace'}) }}">Добавить статьи маркетплейса</a>
            </div>
        {% endif %}

        {# Подключения #}
        <div class="card mb-3">
            <div class="card-header">
                <h3 class="card-title">Активные подключения</h3>
                <div class="card-actions">
                    <a href="#" class="btn btn-primary btn-sm" data-bs-toggle="modal" data-bs-target="#modal-add-connection">
                        <svg xmlns="http://www.w3.org/2000/svg" class="icon" width="24" height="24" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" fill="none" stroke-linecap="round" stroke-linejoin="round"><path stroke="none" d="M0 0h24v24H0z" fill="none"/><line x1="12" y1="5" x2="12" y2="19" /><line x1="5" y1="12" x2="19" y2="12" /></svg>
                        Добавить подключение
                    </a>
                </div>
            </div>
            <div class="card-body">
                {% if connections is empty %}
                    {% embed 'partials/_empty.html.twig' with {title: 'Нет активных подключений', hint: 'Добавьте подключение к маркетплейсу для начала работы'} %}
                        {% block icon %}
                            <svg xmlns="http://www.w3.org/2000/svg" class="icon" width="24" height="24" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" fill="none" stroke-linecap="round" stroke-linejoin="round"><path stroke="none" d="M0 0h24v24H0z" fill="none"/><circle cx="7" cy="18" r="2" /><circle cx="7" cy="6" r="2" /><circle cx="17" cy="12" r="2" /><line x1="7" y1="8" x2="7" y2="16" /><path d="M7 8a4 4 0 0 0 4 4h4" /></svg>
                        {% endblock %}
                    {% endembed %}
                {% else %}
                    {% include 'marketplace/connections/_list.html.twig' with {connections: connections} only %}
                {% endif %}
            </div>
        </div>

    </div>
{% endblock %}

{% block modals %}
    {# Modal: Добавить подключение #}
    {% include 'marketplace/connections/_modal_add.html.twig' with {availableMarketplaces: availableMarketplaces} only %}

    {# Modal: Синхронизация за период #}
    {% include 'marketplace/connections/_modal_sync_period.html.twig' only %}

    {# Modal: Подтверждение загрузки реализации Ozon #}
    {% include 'marketplace/connections/_modal_sync_realization.html.twig' only %}

    {# Modal: Переобработка за период #}
    {% include 'marketplace/connections/_modal_reprocess.html.twig' only %}

    {# Modal: Подтверждение удаления подключения #}
    {% include 'marketplace/connections/_modal_delete.html.twig' only %}
{% endblock %}
