{% extends 'marketplace/layout.html.twig' %}

{% block title %}Предпросмотр ОПиУ{% endblock %}

{% block tab_content %}
    {% set base_query = filter.toQuery() %}
    <div class="p-3" data-testid="pl-preview">
        <p class="text-secondary mb-3">
            Каким будет ОПиУ, если провести данные маркетплейсов за период по текущим правилам маппинга.
            Предпросмотр ничего не записывает: документы ОПиУ создаёт только закрытие месяца.
        </p>

        {% set projects_mode = filter.mode.value == 'projects' %}
        {% include 'marketplace/pl_preview/_filters.html.twig' with {
            filter: filter,
            marketplaces: marketplaces,
            tags: tags,
            projects: projects,
            projects_mode: projects_mode,
            base_query: base_query,
            report: report,
        } only %}

        {% if error is not null %}
            <div class="alert alert-danger" role="alert" data-testid="pl-preview-error">{{ error }}</div>
        {% elseif report is not null %}
            {% for warning in report.warnings %}
                {% if loop.first %}<div class="alert alert-warning" data-testid="pl-preview-warnings"><ul class="mb-0">{% endif %}
                <li>{{ warning }}</li>
                {% if loop.last %}</ul></div>{% endif %}
            {% endfor %}

            {% if report.tagsOverlap %}
                <p class="text-secondary small mb-2" data-testid="pl-preview-overlap">
                    Листинг с несколькими тегами входит в каждый из них полной суммой — сумма колонок тегов не равна «Итого».
                </p>
            {% endif %}

            {% if report.adReconciliation is not empty %}
                {% set ad_labels = {ozon: 'Ozon (клики)', wildberries: 'WB («Продвижение»)'} %}
                <p class="text-secondary small mb-2" data-testid="pl-preview-ads-note">
                    Реклама {{ report.adReconciliation|map(a => ad_labels[a.marketplace.value] ?? a.marketplace.displayName)|join(' и ') }}
                    {% if projects_mode %}
                        в колонках проектов и в «Итого» — по учёту, на проект подключения маркетплейса.
                    {% else %}
                        в колонках тегов — по рекламной статистике; реклама без товара и разница с учётом — в «Общих».
                        «Итого» — по учёту.
                    {% endif %}
                </p>
            {% endif %}

            {% include 'marketplace/pl_preview/_table.html.twig' with {report: report, filter: filter} only %}

            {% include 'marketplace/pl_preview/_not_in_pl.html.twig' with {report: report} only %}

            {% include 'marketplace/pl_preview/_reconciliation.html.twig' with {report: report} only %}
        {% endif %}
    </div>
{% endblock %}
