{% extends 'inventory/layout.html.twig' %}

{% set active_tab = 'inventory' %}

{% block tab_content %}
    <div class="p-3" data-marketplace-inventory>

        {% include 'marketplace/inventory/_toolbar.html.twig' with {marketplace: marketplace, search: search} only %}


        {# Виджет статуса последних задач #}
        {% include 'marketplace/inventory/_jobs.html.twig' with {job_logs: job_logs} only %}

        {% include 'marketplace/inventory/_table.html.twig' with {pager: pager, marketplace: marketplace, search: search} only %}
    </div>

    {# Modal: Установить себестоимость вручную #}
    {% include 'marketplace/inventory/_modal_set_cost.html.twig' only %}

    {# Modal: Загрузить себестоимость из файла #}
    {% include 'marketplace/inventory/_modal_import_cost.html.twig' with {marketplace: marketplace} only %}
{% endblock %}
