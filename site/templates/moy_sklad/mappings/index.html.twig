{% extends 'moy_sklad/layout.html.twig' %}

{% block title %}МойСклад — Маппинг {{ providerName }}{% endblock %}
{% block integration_title %}Маппинг {{ providerName }}{% endblock %}

{% block integration_content %}
    <section data-mapping-provider="{{ mappingMarketplace }}" data-connection-id="{{ mappingConnectionId }}">
        <p class="text-secondary">{{ connection.name }} · Выберите позицию МойСклад для каждого листинга.</p>
        {% if not catalogReady %}
            <div class="alert alert-info" data-catalog-not-ready>Для назначения связей включите подключение и загрузите товары и модификации. <a href="{{ path('moysklad_connections_index') }}">Перейти к подключениям</a></div>
        {% endif %}
        <form method="get" class="mb-3">
            <label for="mapping-listings-search" class="form-label">Название, артикул продавца или SKU</label>
            <div class="input-group">
                <input id="mapping-listings-search" class="form-control" type="search" name="q" value="{{ q }}" maxlength="100">
                <button class="btn" type="submit">Найти</button>
            </div>
        </form>
        <div class="card">
            <div class="table-responsive">
                <table class="table table-vcenter card-table">
                    <thead><tr><th>Листинг {{ providerName }}</th><th>Размер</th><th>Артикул продавца</th><th>Позиция МойСклад</th><th>Статус</th><th>Действия</th></tr></thead>
                    <tbody>
                        {% for listing in listingsPage.items %}
                            {% set state = states[listing.id] %}
                            <tr data-listing-id="{{ listing.id }}">
                                <td class="text-break">{{ listing.title ?? listing.sku }}<div class="text-secondary">{{ listing.sku }}</div>{% if not listing.isActive %}<span class="badge bg-secondary-lt">Неактивен</span>{% endif %}</td>
                                <td>{{ listing.size ?? '—' }}</td>
                                <td class="text-break">{{ listing.supplierSku ?? '—' }}</td>
                                <td class="text-break">{% if state.target %}{{ state.target.name }}<div class="text-secondary">{{ state.target.typeLabel }} · {{ state.target.article ?? state.target.code ?? '—' }}</div>{% else %}—{% endif %}</td>
                                <td>{{ state.statusLabel }}{% if state.status == 'needs_review' %}<div class="text-secondary">{{ state.reasonLabel }}</div>{% endif %}</td>
                                <td>
                                    <a class="btn btn-sm" href="{{ path('moysklad_listing_mapping_edit', {connectionId: mappingConnectionId, marketplace: mappingMarketplace, listingId: listing.id}) }}">{{ is_granted('module.marketplace.write') ? 'Выбрать' : 'Просмотр' }}</a>
                                    {% if state.revision > 0 %}<a class="btn btn-sm" href="{{ path('moysklad_listing_mapping_history', {connectionId: mappingConnectionId, marketplace: mappingMarketplace, listingId: listing.id}) }}">История</a>{% endif %}
                                </td>
                            </tr>
                        {% else %}
                            <tr><td colspan="6" class="text-secondary text-center py-4">Листинги не найдены. Проверьте поиск или загрузите каталог маркетплейса.</td></tr>
                        {% endfor %}
                    </tbody>
                </table>
            </div>
            <div class="card-footer">
                {% include 'partials/_pagination.html.twig' with {page: listingsPage.page, total: listingsPage.totalItems, perPage: listingsPage.perPage, route: 'moysklad_listing_mappings', params: {connectionId: mappingConnectionId, marketplace: mappingMarketplace, q: q}} only %}
            </div>
        </div>
    </section>
{% endblock %}
