{% extends 'moy_sklad/layout.html.twig' %}

{# Одна таблица: очередь по последней диагностике или «Все листинги» (docs/tasks/moysklad-mappings-ui/plan.md). #}
{% block title %}МойСклад — Маппинг {{ providerName }}{% endblock %}
{% block integration_title %}Маппинг {{ providerName }}{% endblock %}

{% set canWrite = is_granted('module.marketplace.write') %}
{% set routeParams = {connectionId: mappingConnectionId, marketplace: mappingMarketplace} %}
{% set keepParams = routeParams|merge({sizeCharacteristicId: selectedCharacteristicId ?? '', char_q: charQ, char_page: characteristicsPage.page}) %}
{% set hiddenParams = keepParams|filter((v, k) => k not in ['connectionId', 'marketplace']) %}
{% set completed = diagnostics.completedRun %}

{% block page_actions %}
    <div class="col-auto ms-auto d-print-none">
        <div class="btn-list">
            {% if canWrite %}
                <form method="post" action="{{ path('moysklad_mapping_diagnostics_refresh', routeParams) }}" data-diagnostic-refresh>
                    <input type="hidden" name="_token" value="{{ csrf_token('moysklad_mapping_diagnostics' ~ mappingCompanyId ~ mappingConnectionId ~ mappingMarketplace) }}">
                    <input type="hidden" name="runId" value="{{ diagnosticRequestId }}">
                    <input type="hidden" name="diagnosticSizeCharacteristicId" value="{{ selectedCharacteristicId ?? '' }}">
                    <button class="btn" type="submit"><i class="ti ti-refresh me-1" aria-hidden="true"></i>Обновить диагностику</button>
                </form>
            {% endif %}
            {% if view == 'all' %}
                {{ form_start(previewForm, {attr: {'data-automatic-preview': ''}}) }}
                {{ form_widget(previewForm.sizeCharacteristicId, {attr: {hidden: true}}) }}
                <button class="btn btn-primary" type="submit"><i class="ti ti-wand me-1" aria-hidden="true"></i>Подобрать на странице</button>
                {{ form_end(previewForm) }}
            {% endif %}
        </div>
    </div>
{% endblock %}

{% block integration_content %}
    <section data-mapping-provider="{{ mappingMarketplace }}" data-connection-id="{{ mappingConnectionId }}" data-mapping-view="{{ view }}">
        <p class="text-secondary mb-3">{{ connection.name }} · сопоставьте листинги {{ providerName }} с позициями МойСклад.</p>
        {% if not catalogReady %}
            <div class="alert alert-info" data-catalog-not-ready>Для назначения связей включите подключение и загрузите товары и модификации. <a href="{{ path('moysklad_connections_index') }}">Перейти к подключениям</a></div>
        {% endif %}
        {% include 'moy_sklad/mappings/_diagnostic_status.html.twig' with {report: diagnostics} only %}
        {% include 'moy_sklad/mappings/_settings.html.twig' with {
            marketplace: mappingMarketplace, connectionId: mappingConnectionId, companyId: mappingCompanyId, settings: mappingSettings, canWrite: canWrite,
            choices: diagnosticCharacteristicChoices, selected: selectedCharacteristicId, charQ: charQ, charPage: characteristicsPage,
            keep: {view: view, q: q, page: listingsPage.page, diag_status: diagStatus, diag_reason: diagReason, diag_manual: diagManual},
        } only %}

        <div class="card vf-card" data-mapping-registry>
            <div class="card-header" data-mapping-view-tabs>
                {% if completed %}
                    {% set counts = completed.counts %}
                    {% set queue = keepParams|merge({view: 'queue'}) %}
                    {% set noFilter = diagStatus == '' and diagReason == '' %}
                    {% include 'partials/_tabs.html.twig' with {class: 'card-header-tabs', tabs: [
                        {label: 'Все листинги', href: path('moysklad_listing_mappings', keepParams|merge({view: 'all'})), active: view == 'all', count: listingsPage.totalItems},
                        {label: 'Требует внимания', href: path('moysklad_listing_mappings', queue|merge({diag_manual: '1'})), active: view == 'queue' and noFilter and diagManual == '1', count: counts.manual_review ?? 0, warn: true},
                        {label: 'Предложения', href: path('moysklad_listing_mappings', queue|merge({diag_status: 'ready', diag_manual: ''})), active: view == 'queue' and diagStatus == 'ready' and diagReason == '' and diagManual == '', count: counts.ready ?? 0},
                        {label: 'Несколько кандидатов', href: path('moysklad_listing_mappings', queue|merge({diag_reason: 'duplicate', diag_manual: ''})), active: view == 'queue' and diagStatus == '' and diagReason == 'duplicate' and diagManual == '', count: counts.reason_duplicate ?? 0},
                        {label: 'Размер', href: path('moysklad_listing_mappings', queue|merge({diag_reason: 'size', diag_manual: ''})), active: view == 'queue' and diagStatus == '' and diagReason == 'size' and diagManual == '', count: counts.reason_size ?? 0},
                        {label: 'Комплектация', href: path('moysklad_listing_mappings', queue|merge({diag_reason: 'package_review', diag_manual: ''})), active: view == 'queue' and diagStatus == '' and diagReason == 'package_review' and diagManual == '', count: counts.reason_package_review ?? 0},
                        {label: 'Нет совпадений', href: path('moysklad_listing_mappings', queue|merge({diag_reason: 'no_match', diag_manual: ''})), active: view == 'queue' and diagStatus == '' and diagReason == 'no_match' and diagManual == '', count: counts.reason_no_match ?? 0},
                    ]} only %}
                {% else %}
                    {% include 'partials/_tabs.html.twig' with {class: 'card-header-tabs', tabs: [
                        {label: 'Все листинги', href: path('moysklad_listing_mappings', keepParams|merge({view: 'all'})), active: true, count: listingsPage.totalItems},
                    ]} only %}
                {% endif %}
            </div>

            <div class="vf-ops-filterbar d-print-none">
                <div class="vf-ops-filterbar__row">
                    {% if view == 'all' %}
                        <form method="get" class="vf-ops-search" role="search">
                            {% for k, v in hiddenParams %}<input type="hidden" name="{{ k }}" value="{{ v }}">{% endfor %}
                            <input type="hidden" name="view" value="all">
                            <button type="submit" class="vf-ops-search__submit" aria-label="Найти"><i class="ti ti-search" aria-hidden="true"></i></button>
                            <input id="mapping-listings-search" class="form-control" type="search" name="q" value="{{ q }}" maxlength="100" placeholder="Название, артикул продавца или SKU" aria-label="Название, артикул продавца или SKU">
                        </form>
                        <span class="vf-ops-filterbar__count" role="status">Листингов: {{ listingsPage.totalItems|vf_number }}</span>
                    {% else %}
                        <form method="get" class="d-flex flex-wrap align-items-center gap-2" data-diagnostic-filters>
                            {% for k, v in hiddenParams %}<input type="hidden" name="{{ k }}" value="{{ v }}">{% endfor %}
                            <input type="hidden" name="view" value="queue">
                            <label class="visually-hidden" for="diagnostic-status">Состояние</label>
                            <select id="diagnostic-status" name="diag_status" class="form-select form-select-sm w-auto mw-100"><option value="">Все состояния</option>{% for status in diagnosticStatuses %}<option value="{{ status.value }}"{% if diagStatus == status.value %} selected{% endif %}>{{ status.label }}</option>{% endfor %}</select>
                            <label class="visually-hidden" for="diagnostic-reason">Причина</label>
                            <select id="diagnostic-reason" name="diag_reason" class="form-select form-select-sm w-auto mw-100"><option value="">Все причины</option>{% for reason in diagnosticReasons %}<option value="{{ reason.value }}"{% if diagReason == reason.value %} selected{% endif %}>{{ reason.label }}</option>{% endfor %}</select>
                            <label class="visually-hidden" for="diagnostic-manual">Ручная проверка</label>
                            <select id="diagnostic-manual" name="diag_manual" class="form-select form-select-sm w-auto mw-100"><option value="">Все строки</option><option value="1"{% if diagManual == '1' %} selected{% endif %}>Требует проверки</option><option value="0"{% if diagManual == '0' %} selected{% endif %}>Не требует проверки</option></select>
                            <button class="btn btn-sm" type="submit">Применить</button>
                        </form>
                        <span class="vf-ops-filterbar__count" role="status">Найдено: {{ diagnostics.totalItems|vf_number }}</span>
                    {% endif %}
                </div>
            </div>

            <div class="table-responsive">
                <table class="table table-vcenter card-table vf-table vf-mapping-table" data-mapping-table>
                    <thead>
                        <tr>
                            <th scope="col" class="vf-mapping-table__listing">Листинг {{ providerName }}</th>
                            <th scope="col" class="vf-mapping-table__article" title="Артикул продавца">Артикул</th>
                            <th scope="col" class="vf-mapping-table__target">Позиция МойСклад</th>
                            <th scope="col" class="vf-mapping-table__status">Статус</th>
                            <th scope="col" class="vf-mapping-table__actions"><span class="visually-hidden">Действия</span></th>
                        </tr>
                    </thead>
                    <tbody>
                        {% if view == 'queue' %}
                            {% for row in diagnostics.rows %}
                                {% include 'moy_sklad/mappings/_row.html.twig' with {listing: row.source, state: states[row.listingId], diagnostic: row, routeParams: routeParams, canWrite: canWrite} only %}
                            {% else %}
                                <tr><td colspan="5" class="vf-ops-empty"><div class="vf-ops-empty__title">{{ completed.total == 0 ? 'В кабинете пока нет листингов' : 'Здесь пусто' }}</div><div class="vf-ops-empty__hint">{{ completed.total == 0 ? 'Загрузите каталог маркетплейса.' : 'По выбранному фильтру строк нет.' }}</div></td></tr>
                            {% endfor %}
                        {% else %}
                            {% for listing in listingsPage.items %}
                                {% include 'moy_sklad/mappings/_row.html.twig' with {listing: listing, state: states[listing.id], diagnostic: null, routeParams: routeParams, canWrite: canWrite} only %}
                            {% else %}
                                <tr><td colspan="5" class="vf-ops-empty"><div class="vf-ops-empty__title">Листинги не найдены</div><div class="vf-ops-empty__hint">Проверьте поиск или загрузите каталог маркетплейса.</div></td></tr>
                            {% endfor %}
                        {% endif %}
                    </tbody>
                </table>
            </div>
            <div class="card-footer" data-mapping-pagination>
                {% if view == 'queue' %}
                    {% include 'partials/_pagination.html.twig' with {page: diagnostics.page, total: diagnostics.totalItems, perPage: diagnostics.perPage, route: 'moysklad_listing_mappings', params: keepParams|merge({view: 'queue', diag_status: diagStatus, diag_reason: diagReason, diag_manual: diagManual}), pageParam: 'diag_page'} only %}
                {% else %}
                    {% include 'partials/_pagination.html.twig' with {page: listingsPage.page, total: listingsPage.totalItems, perPage: listingsPage.perPage, route: 'moysklad_listing_mappings', params: keepParams|merge({view: 'all', q: q})} only %}
                {% endif %}
            </div>
        </div>
    </section>
{% endblock %}
