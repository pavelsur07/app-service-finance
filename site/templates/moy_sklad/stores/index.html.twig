{% extends 'moy_sklad/layout.html.twig' %}

{% set storesConnectionId = connection.id %}
{% set canWrite = is_granted('module.marketplace.write') and financeRead %}

{% block integration_title %}Склады{% endblock %}

{% block integration_lead %}
    <p class="text-secondary mb-0">Назначьте каждому складу счёт Баланса: остаток склада по себестоимости МойСклад записывается в этот счёт каждый день.</p>
{% endblock %}

{% block integration_content %}
    {% set settingsReady = financeRead and book.initialized and settings and settings.enabled and settings.counterAccountId %}
    <details class="card mb-3" data-store-balance-settings{% if not settingsReady %} open{% endif %}>
        <summary class="card-header">
            <h2 class="card-title">Запись в Баланс</h2>
            {% if settingsReady %}
                <span class="ms-2 text-secondary small" data-store-balance-settings-summary>Проводится каждый день в 23:30 · корр. счёт {{ accountsById[settings.counterAccountId] is defined ? accountsById[settings.counterAccountId].label : 'в архиве' }} · Изменить</span>
            {% endif %}
        </summary>
        <div class="card-body">
            {% if not financeRead %}
                <p class="text-secondary mb-0" data-store-balance-no-finance>Счета Баланса видны пользователям с доступом к финансам компании.</p>
            {% else %}
            {% if not book.initialized %}
                <div class="alert alert-warning" role="alert" data-store-balance-book-not-started>
                    Учёт в Балансе не начат: остатки складов считаются, но в Баланс не проводятся. <a href="{{ path('balance_index') }}">Открыть Баланс</a>
                </div>
            {% endif %}
            <form method="post" action="{{ path('moysklad_store_balance_settings', {connectionId: connection.id}) }}" class="row g-3 align-items-end">
                <input type="hidden" name="_token" value="{{ csrf_token(csrfId) }}">
                <input type="hidden" name="filter" value="{{ filter }}">
                <div class="col-md-6">
                    <label class="form-label" for="store-balance-counter">Корреспондирующий счёт изменения остатков</label>
                    <select id="store-balance-counter" name="counterAccountId" class="form-select"{% if not canWrite %} disabled{% endif %}>
                        <option value="">— не выбран —</option>
                        {% for account in accounts %}
                            <option value="{{ account.id }}"{% if settings and settings.counterAccountId == account.id %} selected{% endif %}>{{ account.label }}</option>
                        {% endfor %}
                    </select>
                    <p class="form-hint">Рост остатка склада увеличивает этот счёт (пассив) или уменьшает его (актив).</p>
                </div>
                <div class="col-md-3">
                    <label class="form-check">
                        <input class="form-check-input" type="checkbox" name="enabled" value="1"{% if settings and settings.enabled %} checked{% endif %}{% if not canWrite %} disabled{% endif %}>
                        <span class="form-check-label">Проводить каждый день в 23:30</span>
                    </label>
                </div>
                <div class="col-md-3">
                    {% if canWrite %}<button class="btn btn-primary" type="submit">Сохранить</button>{% endif %}
                </div>
            </form>
            {% if run %}
                <p class="mt-3 mb-0" data-store-balance-run>
                    Последняя попытка оценки, снимок на {{ run.date|date('d.m.Y') }}: <span class="badge bg-{{ run.tone }}-lt">{{ run.label }}</span>
                    {% if run.error %}<span class="text-danger">{{ run.error }}</span>{% endif %}
                </p>
            {% else %}
                <p class="mt-3 mb-0 text-secondary">Оценки ещё не было: она запускается после загрузки остатков, когда хотя бы одному складу назначен счёт.</p>
            {% endif %}
            {% endif %}
        </div>
    </details>

    {% set filterLabels = {todo: 'Требуют решения', linked: 'Назначены', excluded: 'Не учитываются', all: 'Все'} %}
    <nav class="vf-seg mb-3" aria-label="Фильтр складов">
        {% for key, label in filterLabels %}
            <a href="{{ path('moysklad_stores', {connectionId: connection.id, filter: key}) }}" data-store-filter="{{ key }}"{% if filter == key %} class="active" aria-current="page"{% endif %}>{{ label }} · {{ counts[key] }}</a>
        {% endfor %}
    </nav>

    {% set statusBadges = {
        todo: ['Не назначен', 'secondary'],
        suggested: ['Предложено', 'azure'],
        unsure: ['Проверьте', 'warning'],
        linked: ['Назначен', 'green'],
        excluded: ['Не учитывается', 'secondary'],
    } %}
    {% set prefilled = stores|filter(store => store.value != store.was)|length %}
    <form method="post" action="{{ path('moysklad_store_balance_links', {connectionId: connection.id}) }}" data-store-links data-controller="store-links">
        <input type="hidden" name="_token" value="{{ csrf_token(csrfId) }}">
        <input type="hidden" name="filter" value="{{ filter }}">
        <div class="card mb-3">
            <div class="table-responsive">
                <table class="table table-vcenter card-table" data-store-balance-table>
                    <thead>
                        <tr><th>Склад</th><th>Счёт Баланса</th><th class="text-end" data-store-balance-valued-date>Остаток по себестоимости{% if valuedDate %} на {{ valuedDate|date('d.m.Y') }}{% endif %}</th></tr>
                    </thead>
                    <tbody>
                        {% for store in stores %}
                            {% set badge = statusBadges[store.status] %}
                            {% set suggestion = store.suggestion %}
                            <tr data-store="{{ store.externalId }}" data-store-links-target="row"{% if store.value != store.was %} class="table-active"{% endif %}>
                                <td>
                                    <div class="text-break">{{ store.name }}</div>
                                    {% if store.pathName %}<div class="text-secondary small">{{ store.pathName }}</div>{% endif %}
                                    <span class="badge bg-{{ badge[1] }}-lt mt-1" data-store-status="{{ store.status }}">{{ badge[0] }}{% if suggestion %} · {{ suggestion.source == 'ai' ? 'ИИ' : 'правило' }}{% endif %}</span>
                                </td>
                                <td>
                                    {% if canWrite %}
                                        <input type="hidden" name="links[{{ store.externalId }}][was]" value="{{ store.was }}">
                                        <select name="links[{{ store.externalId }}][target]" class="form-select form-select-sm" data-was="{{ store.was }}" data-action="store-links#refresh" aria-label="Счёт Баланса для склада {{ store.name }}">
                                            <option value="">— не назначен —</option>
                                            <option value="excluded"{% if store.value == 'excluded' %} selected{% endif %}>Не учитывать</option>
                                            {% for groupLabel, groupAccounts in accountGroups %}
                                                <optgroup label="{{ groupLabel }}">
                                                    {% for account in groupAccounts %}
                                                        <option value="{{ account.id }}"{% if store.value == account.id %} selected{% endif %}>{{ groupLabel == 'Запасы' ? account.name : account.label }}</option>
                                                    {% endfor %}
                                                </optgroup>
                                            {% endfor %}
                                            {% if store.accountId and accountsById[store.accountId] is not defined %}
                                                <option value="{{ store.accountId }}" selected>Счёт в архиве или удалён</option>
                                            {% endif %}
                                        </select>
                                    {% elseif store.excluded %}
                                        Не учитывать
                                    {% elseif not financeRead %}
                                        {{ store.accountId ? 'Назначен' : '—' }}
                                    {% else %}
                                        {{ store.accountId and accountsById[store.accountId] is defined ? accountsById[store.accountId].label : '—' }}
                                    {% endif %}
                                    {% if suggestion %}
                                        <div class="mt-1 small" data-store-suggestion="{{ suggestion.target }}">
                                            {% if not suggestion.confident %}<span class="text-warning">ИИ предлагает «{{ suggestion.label }}» — проверьте и выберите вручную.</span>{% endif %}
                                            <span class="text-secondary">{{ suggestion.reason }}</span>
                                            {% if suggestion.warning %}<div class="text-warning" data-store-suggestion-warning>{{ suggestion.warning }}</div>{% endif %}
                                        </div>
                                    {% endif %}
                                    {% if financeRead and store.accountId and accountsById[store.accountId] is not defined %}<div class="text-danger small">Счёт в архиве или удалён — выберите другой.</div>{% endif %}
                                </td>
                                <td class="text-end{% if not store.amountMinor %} text-secondary{% endif %}">
                                    {{ store.amountMinor|vf_minor|vf_amount }}
                                    {% if store.missing > 0 %}<div class="text-danger small">Нет в отчёте себестоимости: {{ store.missing|vf_number }} поз. — счёт не проводится</div>{% endif %}
                                    {% if store.unpriced > 0 %}<div class="text-warning small">Без себестоимости: {{ store.unpriced|vf_number }} поз.</div>{% endif %}
                                </td>
                            </tr>
                        {% else %}
                            <tr><td colspan="3" class="text-secondary">{{ counts.all == 0 ? 'Склады ещё не загружены: запустите загрузку остатков в подключении.' : 'В этой вкладке складов нет.' }}</td></tr>
                        {% endfor %}
                    </tbody>
                </table>
            </div>
        </div>
        {% if canWrite and stores is not empty %}
            <div class="sticky-bottom bg-body border-top shadow-sm px-3 py-2 mb-3 d-flex flex-wrap align-items-center gap-2" data-store-links-bar>
                <button class="btn btn-primary" type="submit" data-store-links-save data-store-links-target="save">Сохранить&nbsp;·&nbsp;<span data-store-links-target="count">{{ prefilled }}</span></button>
                <button class="btn" type="reset" data-action="store-links#reset">Сбросить</button>
                <span class="text-secondary small">Подсвечены строки, которые будут записаны; подставленные предложения тоже. Склад, изменённый в другом окне, не перезаписывается.</span>
            </div>
        {% endif %}
    </form>

    {% if totals is not empty %}
        <div class="card" data-store-balance-totals>
            <div class="card-header"><h2 class="card-title">Итог по счетам Баланса</h2></div>
            <div class="table-responsive">
                <table class="table table-vcenter card-table">
                    <thead><tr><th>Счёт</th><th class="text-end">Сумма складов</th><th>Проводка</th></tr></thead>
                    <tbody>
                        {% for accountId, total in totals %}
                            <tr>
                                <td>{{ accountsById[accountId] is defined ? accountsById[accountId].label : 'Счёт в архиве или удалён' }}</td>
                                <td class="text-end">{{ total|vf_minor|vf_amount }}</td>
                                <td>
                                    {% if postings[accountId] is defined %}
                                        {% set posting = postings[accountId] %}
                                        <span class="badge bg-{{ posting.tone }}-lt">{{ posting.label }}</span> <span class="text-secondary small">{{ posting.date|date('d.m.Y') }}</span>
                                        {% if posting.reason %}<div class="text-secondary small">{{ posting.reason }}</div>{% endif %}
                                    {% else %}
                                        <span class="text-secondary">—</span>
                                    {% endif %}
                                </td>
                            </tr>
                        {% endfor %}
                    </tbody>
                </table>
            </div>
        </div>
    {% endif %}
{% endblock %}
