<div class="card">
    <div class="card-header">
        <h2 class="card-title">{{ isEdit ? 'Изменить название подключения' : 'Новое подключение' }}</h2>
    </div>
    <div class="card-body">
        {{ form_start(form, {attr: isEdit ? {} : {'data-moysklad-check': ''}}) }}
        {{ form_errors(form) }}
        <div class="mb-3">{{ form_row(form.name) }}</div>
        {% if not isEdit %}
            {% include 'moy_sklad/connections/_token_help.html.twig' %}
            <div class="mb-3">{{ form_row(form.token, {attr: {autocomplete: 'new-password', spellcheck: 'false'}}) }}</div>
            <p class="text-secondary">Подключение появится после успешной проверки доступа. Аккаунт МойСклад можно закрепить только за одной компанией.</p>
        {% endif %}
        <div class="d-flex flex-wrap gap-2 mt-3">
            <button type="submit" class="btn btn-primary">{{ isEdit ? 'Сохранить' : 'Проверить и подключить' }}</button>
            <a href="{{ path('moysklad_connections_index') }}" class="btn">Отмена</a>
        </div>
        {{ form_end(form) }}
    </div>
</div>
