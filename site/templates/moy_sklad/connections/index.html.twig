{% extends 'moy_sklad/layout.html.twig' %}

{% block page_actions %}
    {% if is_granted('module.marketplace.write') %}
        <div class="col-12 col-md-auto">
            <a href="{{ path('moysklad_connections_create') }}" class="btn btn-primary">Добавить подключение</a>
        </div>
    {% endif %}
{% endblock %}

{% block integration_content %}
    <p class="text-secondary">Подключите аккаунты МойСклад вашей компании. После проверки можно загрузить контрагентов, товары и модификации.</p>
    {% if pager.nbResults == 0 %}
        <div class="card">
            <div class="card-body empty">
                <h2 class="empty-title">Подключения пока не созданы</h2>
                <p class="empty-subtitle text-secondary">Для подключения понадобится токен пользователя МойСклад.</p>
            </div>
        </div>
    {% else %}
        <div class="row row-cards mb-3">
            {% for connection in connections %}
                {% set status = connection.checkStatus.value %}
                {% set sync = syncStatuses[connection.id] ?? null %}
                {% set product_sync = productSyncStatuses[connection.id] ?? null %}
                {% set variant_sync = variantSyncStatuses[connection.id] ?? null %}
                {% set store_sync = storeSyncStatuses[connection.id] ?? null %}
                {% set stock_sync = stockSyncStatuses[connection.id] ?? null %}
                {% set stock_snapshot = stockSnapshots[connection.id] ?? null %}
                {% set error_labels = {'auth': 'Проверьте токен', 'forbidden': 'Недостаточно прав', 'rate_limited': 'Лимит запросов МойСклад', 'temporary': 'МойСклад временно недоступен', 'invalid_request': 'Ошибка запроса', 'invalid_response': 'Некорректный ответ МойСклад', 'internal': 'Ошибка сохранения'} %}
                <div class="col-12 col-xl-6">
                    <section class="card h-100" aria-labelledby="connection-title-{{ connection.id }}">
                        <div class="card-header flex-wrap gap-2">
                            <h2 class="card-title text-break" id="connection-title-{{ connection.id }}">{{ connection.name }}</h2>
                            {% if not connection.isActive %}
                                <span class="badge bg-secondary-lt">Отключено</span>
                            {% elseif status == 'connected' and connection.accountId %}
                                <span class="badge bg-success-lt">Подключено</span>
                            {% elseif status == 'unverified' or not connection.accountId %}
                                <span class="badge bg-warning-lt">Требуется проверка</span>
                            {% else %}
                                <span class="badge bg-warning-lt">Ошибка проверки</span>
                            {% endif %}
                        </div>
                        <div class="card-body">
                            <dl class="row mb-0">
                                <dt class="col-sm-5">Аккаунт МойСклад</dt>
                                <dd class="col-sm-7 text-break">{{ connection.accountId ?? 'Не подтверждён' }}</dd>
                                <dt class="col-sm-5">Последняя проверка</dt>
                                <dd class="col-sm-7">{{ connection.lastCheckedAt ? connection.lastCheckedAt|date('d.m.Y H:i:s') : 'Ещё не выполнялась' }}</dd>
                                <dt class="col-sm-5">Успешная проверка</dt>
                                <dd class="col-sm-7">{{ connection.lastSuccessfulCheckAt ? connection.lastSuccessfulCheckAt|date('d.m.Y H:i:s') : 'Ещё не выполнялась' }}</dd>
                                <dt class="col-sm-5">Последний полный проход</dt>
                                <dd class="col-sm-7">{{ sync and sync.lastCompletedAt ? sync.lastCompletedAt|date('d.m.Y H:i:s') : 'Ещё не выполнялся' }}</dd>
                            </dl>
                            {% if sync and sync.status %}
                                <div class="mt-3">
                                    <div>Загрузка контрагентов:
                                        {% if sync.status == 'running' %}Выполняется
                                        {% elseif sync.status == 'succeeded' %}Успешно
                                        {% else %}Ошибка{% endif %}
                                    </div>
                                    <div class="text-secondary">Начало: {{ sync.startedAt|date('d.m.Y H:i:s') }}{% if sync.finishedAt %} · Завершение: {{ sync.finishedAt|date('d.m.Y H:i:s') }}{% endif %}</div>
                                    <div class="text-secondary">Обработано: {{ sync.processed }} · Создано: {{ sync.created }} · Обновлено: {{ sync.updated }} · Без изменений: {{ sync.unchanged }}</div>
                                    {% if sync.status == 'failed' %}
                                        <div class="text-danger">{{ error_labels[sync.errorCategory] ?? 'Ошибка загрузки' }}</div>
                                    {% endif %}
                                    <details class="mt-2">
                                        <summary>История запусков (последние 5)</summary>
                                        <ul class="list-unstyled mt-2 mb-0">
                                            {% for item in sync.history %}
                                                <li class="mb-1">{{ item.startedAt|date('d.m.Y H:i:s') }} —
                                                    {% if item.status == 'running' %}Выполняется{% elseif item.status == 'succeeded' %}Успешно{% else %}{{ error_labels[item.errorCategory] ?? 'Ошибка загрузки' }}{% endif %};
                                                    обработано {{ item.processed }}, создано {{ item.created }}, обновлено {{ item.updated }}, без изменений {{ item.unchanged }}
                                                </li>
                                            {% endfor %}
                                        </ul>
                                    </details>
                                </div>
                            {% else %}
                                <p class="text-secondary mt-3 mb-0">Загрузка контрагентов ещё не запускалась.</p>
                            {% endif %}
                            {% for stream in [{label: 'Товары', sync: product_sync}, {label: 'Модификации', sync: variant_sync}] %}
                                {% set stream_sync = stream.sync %}
                                <div class="mt-3">
                                    <div>{{ stream.label }}:
                                        {% if not stream_sync or not stream_sync.status %}Ещё не загружались
                                        {% elseif stream_sync.status == 'running' %}Выполняется
                                        {% elseif stream_sync.status == 'succeeded' %}Успешно
                                        {% else %}Ошибка{% endif %}
                                    </div>
                                    {% if stream_sync and stream_sync.status %}
                                        <div class="text-secondary">Обработано: {{ stream_sync.processed }} · Создано: {{ stream_sync.created }} · Обновлено: {{ stream_sync.updated }} · Без изменений: {{ stream_sync.unchanged }}</div>
                                        <div class="text-secondary">Последний полный проход: {{ stream_sync.lastCompletedAt ? stream_sync.lastCompletedAt|date('d.m.Y H:i:s') : 'Ещё не выполнялся' }}</div>
                                        {% if stream_sync.status == 'failed' %}<div class="text-danger">{{ error_labels[stream_sync.errorCategory] ?? 'Ошибка загрузки' }}</div>{% endif %}
                                        <details class="mt-2">
                                            <summary>История запусков {{ stream.label|lower }} (последние 5)</summary>
                                            <ul class="list-unstyled mt-2 mb-0">
                                                {% for item in stream_sync.history %}
                                                    <li>{{ item.startedAt|date('d.m.Y H:i:s') }} — {% if item.status == 'running' %}Выполняется{% elseif item.status == 'succeeded' %}Успешно{% else %}{{ error_labels[item.errorCategory] ?? 'Ошибка загрузки' }}{% endif %}; обработано {{ item.processed }}</li>
                                                {% endfor %}
                                            </ul>
                                        </details>
                                    {% endif %}
                                </div>
                            {% endfor %}
                            {% for stream in [{key: 'store', label: 'Склады', sync: store_sync}, {key: 'stock', label: 'Остатки', sync: stock_sync}] %}
                                {% set stream_sync = stream.sync %}
                                <section class="mt-3" data-sync-stream="{{ stream.key }}" aria-labelledby="{{ stream.key }}-sync-title-{{ connection.id }}">
                                    <h3 class="card-title mb-1" id="{{ stream.key }}-sync-title-{{ connection.id }}">{{ stream.label }}</h3>
                                    {% if not stream_sync or not stream_sync.status %}
                                        <p class="text-secondary mb-1">Ещё не запускалось.</p>
                                    {% else %}
                                        <div>
                                            {% if stream_sync.status == 'running' %}Выполняется
                                            {% elseif stream_sync.status == 'succeeded' %}Успешно
                                            {% else %}Ошибка{% endif %}
                                        </div>
                                        <div class="text-secondary">Начало: {{ stream_sync.startedAt|date('d.m.Y H:i:s') }}{% if stream_sync.finishedAt %} · Завершение: {{ stream_sync.finishedAt|date('d.m.Y H:i:s') }}{% endif %}</div>
                                        <div class="text-secondary">Обработано: {{ stream_sync.processed }} · Создано: {{ stream_sync.created }} · Обновлено: {{ stream_sync.updated }} · Без изменений: {{ stream_sync.unchanged }}</div>
                                        {% if stream_sync.status == 'failed' %}
                                            <div class="text-danger">{{ error_labels[stream_sync.errorCategory] ?? 'Ошибка загрузки' }}</div>
                                        {% endif %}
                                    {% endif %}
                                    <div class="text-secondary">Последний успешный проход: {{ stream_sync and stream_sync.lastCompletedAt ? stream_sync.lastCompletedAt|date('d.m.Y H:i:s') : 'Ещё не выполнялся' }}</div>
                                    {% if stream.key == 'stock' %}
                                        <div class="text-secondary">
                                            Последний завершённый снимок:
                                            {% if stock_snapshot %}
                                                ID: {{ stock_snapshot.id }} · Начало: {{ stock_snapshot.startedAt|date('d.m.Y H:i:s') }} · Завершение: {{ stock_snapshot.completedAt|date('d.m.Y H:i:s') }} · {{ stock_snapshot.lineCount }} строк
                                            {% else %}
                                                Ещё не создавался
                                            {% endif %}
                                        </div>
                                    {% endif %}
                                    {% if stream_sync and stream_sync.history %}
                                        <details class="mt-2">
                                            <summary>История запусков (последние 5)</summary>
                                            <ul class="list-unstyled mt-2 mb-0" data-sync-history="{{ stream.key }}">
                                                {% for item in stream_sync.history %}
                                                    <li class="mb-1">{{ item.startedAt|date('d.m.Y H:i:s') }} —
                                                        {% if item.status == 'running' %}Выполняется{% elseif item.status == 'succeeded' %}Успешно{% else %}{{ error_labels[item.errorCategory] ?? 'Ошибка загрузки' }}{% endif %};
                                                        обработано {{ item.processed }}, создано {{ item.created }}, обновлено {{ item.updated }}, без изменений {{ item.unchanged }}
                                                    </li>
                                                {% endfor %}
                                            </ul>
                                        </details>
                                    {% endif %}
                                </section>
                            {% endfor %}
                            {% if status != 'connected' %}
                                <p class="text-secondary mt-3 mb-0">{{ status == 'unverified' ? 'Требуется проверка' : connection.checkStatus.message() }}</p>
                            {% endif %}
                        </div>
                        {% if is_granted('module.marketplace.write') %}
                            <div class="card-footer">
                                <div class="d-flex flex-wrap gap-2">
                                    <form method="post" action="{{ path('moysklad_connections_check', {id: connection.id}) }}" data-moysklad-check>
                                        <input type="hidden" name="_token" value="{{ csrf_token('moysklad_check' ~ connection.id) }}">
                                        <input type="hidden" name="version" value="{{ connection.version }}">
                                        <button type="submit" class="btn btn-outline-primary">Проверить подключение</button>
                                    </form>
                                    {% if connection.isActive and status == 'connected' and connection.accountId and (not sync or sync.status != 'running') %}
                                        <form method="post" action="{{ path('moysklad_connections_sync_counterparties', {id: connection.id}) }}">
                                            <input type="hidden" name="_token" value="{{ csrf_token('moysklad_sync_counterparties' ~ connection.id) }}">
                                            <button type="submit" class="btn btn-primary">Загрузить контрагентов</button>
                                        </form>
                                    {% endif %}
                                    {% if connection.isActive and status == 'connected' and connection.accountId %}
                                        <form method="post" action="{{ path('moysklad_connections_sync_catalog', {id: connection.id}) }}">
                                            <input type="hidden" name="_token" value="{{ csrf_token('moysklad_sync_catalog' ~ connection.id) }}">
                                            <button type="submit" class="btn btn-primary">{{ (product_sync and product_sync.status == 'running') or (variant_sync and variant_sync.status == 'running') ? 'Проверить и повторить загрузку' : 'Загрузить товары и модификации' }}</button>
                                            {% if (product_sync and product_sync.status == 'running') or (variant_sync and variant_sync.status == 'running') %}
                                                <small class="text-secondary d-block">Уже выполняется. Повторный запрос будет пропущен, если загрузка ещё активна.</small>
                                            {% endif %}
                                        </form>
                                        <form method="post" action="{{ path('moysklad_connections_sync_stock', {id: connection.id}) }}">
                                            <input type="hidden" name="_token" value="{{ csrf_token('moysklad_sync_stock' ~ connection.id) }}">
                                            <button type="submit" class="btn btn-primary">{{ (store_sync and store_sync.status == 'running') or (stock_sync and stock_sync.status == 'running') ? 'Проверить и повторить загрузку складов и остатков' : 'Загрузить склады и остатки' }}</button>
                                            {% if (store_sync and store_sync.status == 'running') or (stock_sync and stock_sync.status == 'running') %}
                                                <small class="text-secondary d-block">Уже выполняется. Повторный запрос будет пропущен, если загрузка ещё активна.</small>
                                            {% endif %}
                                        </form>
                                    {% endif %}
                                    <a class="btn" href="{{ path('moysklad_connections_edit', {id: connection.id}) }}">Изменить название</a>
                                    <button type="button" class="btn" data-bs-toggle="modal" data-bs-target="#replace-token-{{ connection.id }}">Заменить токен</button>
                                    {% set operation = connection.isActive ? 'disable' : 'enable' %}
                                    <form method="post" action="{{ path('moysklad_connections_' ~ operation, {id: connection.id}) }}" {% if not connection.isActive %}data-moysklad-check{% endif %}>
                                        <input type="hidden" name="_token" value="{{ csrf_token('moysklad_' ~ operation ~ connection.id) }}">
                                        <input type="hidden" name="version" value="{{ connection.version }}">
                                        <button type="submit" class="btn">{{ connection.isActive ? 'Отключить' : 'Проверить и включить' }}</button>
                                    </form>
                                    {% if not connection.isActive %}
                                        <button type="button" class="btn btn-outline-danger" data-bs-toggle="modal" data-bs-target="#delete-connection-{{ connection.id }}">Удалить</button>
                                    {% endif %}
                                </div>
                            </div>
                        {% endif %}
                    </section>
                </div>
            {% endfor %}
        </div>
        {% include 'partials/_pagerfanta.html.twig' with {pager: pager} %}
    {% endif %}
{% endblock %}

{% block modals %}
    {% if is_granted('module.marketplace.write') %}
        {% for connection in connections %}
            <div class="modal modal-blur fade" id="replace-token-{{ connection.id }}" tabindex="-1" aria-labelledby="replace-token-title-{{ connection.id }}" aria-hidden="true">
                <div class="modal-dialog modal-dialog-centered">
                    <div class="modal-content">
                        <form method="post" action="{{ path('moysklad_connections_replace_token', {id: connection.id}) }}" data-moysklad-check>
                            <input type="hidden" name="_token" value="{{ csrf_token('moysklad_replace-token' ~ connection.id) }}">
                            <input type="hidden" name="version" value="{{ connection.version }}">
                            <div class="modal-header">
                                <h2 class="modal-title" id="replace-token-title-{{ connection.id }}">Заменить токен — {{ connection.name }}</h2>
                                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Закрыть"></button>
                            </div>
                            <div class="modal-body">
                                <p>{{ connection.accountId ? 'Новый токен будет сохранён после проверки доступа к тому же аккаунту.' : 'После успешной проверки аккаунт будет закреплён за подключением.' }} При ошибке текущий токен останется без изменений.</p>
                                {% include 'moy_sklad/connections/_token_help.html.twig' %}
                                <label class="form-label" for="replacement-token-{{ connection.id }}">Новый токен пользователя</label>
                                <input type="password" id="replacement-token-{{ connection.id }}" name="token" maxlength="8192" class="form-control" autocomplete="new-password" required spellcheck="false">
                            </div>
                            <div class="modal-footer">
                                <button type="button" class="btn" data-bs-dismiss="modal">Отмена</button>
                                <button type="submit" class="btn btn-primary">Проверить и сохранить</button>
                            </div>
                        </form>
                    </div>
                </div>
            </div>
            {% if not connection.isActive %}
                <div class="modal modal-blur fade" id="delete-connection-{{ connection.id }}" tabindex="-1" aria-labelledby="delete-title-{{ connection.id }}" aria-hidden="true">
                    <div class="modal-dialog modal-dialog-centered">
                        <div class="modal-content">
                            <form method="post" action="{{ path('moysklad_connections_delete', {id: connection.id}) }}">
                                <input type="hidden" name="_token" value="{{ csrf_token('moysklad_delete' ~ connection.id) }}">
                                <input type="hidden" name="version" value="{{ connection.version }}">
                                <div class="modal-header">
                                    <h2 class="modal-title" id="delete-title-{{ connection.id }}">Удалить подключение?</h2>
                                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Закрыть"></button>
                                </div>
                                <div class="modal-body">
                                    <p>Подключение «{{ connection.name }}» и сохранённый здесь токен будут удалены.</p>
                                    <p class="mb-0">Это не отзывает токен в МойСклад. При необходимости отзовите его в настройках МойСклад.</p>
                                </div>
                                <div class="modal-footer">
                                    <button type="button" class="btn" data-bs-dismiss="modal">Отмена</button>
                                    <button type="submit" class="btn btn-danger">Удалить подключение</button>
                                </div>
                            </form>
                        </div>
                    </div>
                </div>
            {% endif %}
        {% endfor %}
    {% endif %}
{% endblock %}
