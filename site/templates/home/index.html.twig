{% extends 'base.html.twig' %}

{% macro comparison(name, data, currency, previous_label) %}
  {% set trend_class = data.variant == 'up' ? 'text-success' : (data.variant == 'down' ? 'text-danger' : 'text-muted') %}
  <div
    class="small text-muted mt-2"
    data-dashboard-kpi-comparison="{{ name }}"
    data-comparison-state="{{ data.state }}"
    data-comparison-variant="{{ data.variant }}"
  >
    <div>{{ previous_label }}: <span title="{{ data.previous|vf_money(2, currency) }}">{{ data.previous|vf_money_short(currency) }}</span></div>
    <div class="kpi-trend {{ trend_class }}">
      {% if data.state == 'percent' %}
        {% set formatted_percent = data.percent|abs|vf_money(1) %}
        Изменение:
        {% if data.percent > 0 %}
          <span class="visually-hidden">рост на {{ formatted_percent }}%</span><span aria-hidden="true">+{{ formatted_percent }}%</span>
        {% elseif data.percent < 0 %}
          <span class="visually-hidden">снижение на {{ formatted_percent }}%</span><span aria-hidden="true">−{{ formatted_percent }}%</span>
        {% else %}
          {{ formatted_percent }}%
        {% endif %}
      {% elseif data.state == 'cross_up' %}
        Изменение: Из минуса в плюс
      {% elseif data.state == 'cross_down' %}
        Изменение: Из плюса в минус
      {% elseif data.state == 'no_base' %}
        Изменение: <span aria-hidden="true">—</span><span class="visually-hidden">Нет базы</span>
      {% endif %}
    </div>
  </div>
{% endmacro %}

{% block title %}Главная{% endblock %}

{% block importmap %}
  {{ parent() }}
  {{ vite_entry_script_tags('finance_balance_dynamics') }}
{% endblock %}

{% block stylesheets %}
  {{ parent() }}
  {{ vite_entry_link_tags('finance_balance_dynamics') }}
  <style>
    .card-title {
      font-weight: 600;
      font-size: 0.875rem;
      color: var(--vf-text-muted);
      text-transform: uppercase;
    }

    .card-body-p-0 {
      padding: 1.25rem 0 0 0 !important;
    }

    .card-body-p-0 .px-3 {
      padding-left: 1.25rem !important;
      padding-right: 1.25rem !important;
    }

    .chart-sparkline {
      width: 100% !important;
      margin-top: 15px;
    }

    .kpi-trend {
      display: inline-flex;
      align-items: center;
      gap: 0.35rem;
      font-size: 0.875rem;
      font-weight: 600;
      margin-top: 0.35rem;
    }

    .kpi-trend i {
      font-size: 1rem;
    }

    {% include 'finance/report/_filter_controls_styles.html.twig' %}

    @media (max-width: 767.98px) {
      [data-dashboard-filter-controls] .pl-preview-segmented {
        flex-wrap: wrap;
      }
    }
  </style>
{% endblock %}

{% block content %}
<div class="card pl-preview-controls-card mb-3" data-dashboard-filter-controls>
  <div class="card-body">
    <div class="pl-preview-controls-row">
      <form
        method="get"
        class="pl-preview-control-group"
        data-dashboard-activity-filter
        data-selected-activity="{{ cashflowActivity }}"
      >
        <input type="hidden" name="currency" value="{{ cashCurrency.value }}">
        <input type="hidden" name="period" value="{{ dashboardPeriodDays }}">
        <span class="pl-preview-control-label">Вид деятельности</span>
        <div class="pl-preview-segmented" role="group" aria-label="Вид деятельности">
          {% for activity, label in cashflowActivities %}
            <button
              type="submit"
              name="activity"
              value="{{ activity }}"
              class="{{ activity == cashflowActivity ? 'is-active' }}"
              aria-pressed="{{ activity == cashflowActivity ? 'true' : 'false' }}"
            >{{ label }}</button>
          {% endfor %}
        </div>
      </form>

      <form
        method="get"
        class="pl-preview-control-group"
        data-dashboard-period-filter
        data-selected-period="{{ dashboardPeriodDays }}"
      >
        <input type="hidden" name="currency" value="{{ cashCurrency.value }}">
        <input type="hidden" name="activity" value="{{ cashflowActivity }}">
        <span class="pl-preview-control-label">Период</span>
        <div class="pl-preview-segmented" role="group" aria-label="Период">
          {% for periodDays, label in dashboardPeriods %}
            <button
              type="submit"
              name="period"
              value="{{ periodDays }}"
              class="{{ periodDays == dashboardPeriodDays ? 'is-active' }}"
              aria-pressed="{{ periodDays == dashboardPeriodDays ? 'true' : 'false' }}"
            >{{ label }}</button>
          {% endfor %}
        </div>
      </form>
    </div>
  </div>
</div>

{% set kpi_currency = cashCurrency.value == 'RUB' ? '₽' : cashCurrency.value %}
<div class="row row-deck row-cards mb-4 ">
  <div class="col-sm-6 col-lg-3">
    <div class="card">
      <div class="card-body">
        <div class="subheader">Остаток на сегодня</div>
        <div class="h1 mb-0" data-dashboard-kpi="todayBalance" title="{{ kpi.todayBalance|vf_money(2, kpi_currency) }}">{{ kpi.todayBalance|vf_money_short(kpi_currency) }}</div>
        {{ _self.comparison('todayBalance', kpiComparisons.todayBalance, kpi_currency, kpiPeriodLabels.balanceComparison) }}
      </div>
    </div>
  </div>
  <div class="col-sm-6 col-lg-3">
    <div class="card">
      <div class="card-body">
        <div class="subheader" data-dashboard-kpi-period="current">Приход ({{ kpiPeriodLabels.current }})</div>
        <div class="h1 mb-0" data-dashboard-kpi="inflow30" title="{{ kpi.inflow30|vf_money(2, kpi_currency) }}">{{ kpi.inflow30|vf_money_short(kpi_currency) }}</div>
        <a href="{{ path('report_cashflow_index', cashflowReconciliationQuery) }}" data-dashboard-reconcile-link="inflow30">Сверить в ДДС</a>
        {{ _self.comparison('inflow30', kpiComparisons.inflow30, kpi_currency, kpiPeriodLabels.previous) }}
      </div>
    </div>
  </div>
  <div class="col-sm-6 col-lg-3">
    <div class="card">
      <div class="card-body">
        <div class="subheader" data-dashboard-kpi-period="current">Расход ({{ kpiPeriodLabels.current }})</div>
        <div class="h1 mb-0" data-dashboard-kpi="outflow30" title="{{ kpi.outflow30|vf_money(2, kpi_currency) }}">{{ kpi.outflow30|vf_money_short(kpi_currency) }}</div>
        <a href="{{ path('report_cashflow_index', cashflowReconciliationQuery) }}" data-dashboard-reconcile-link="outflow30">Сверить в ДДС</a>
        {{ _self.comparison('outflow30', kpiComparisons.outflow30, kpi_currency, kpiPeriodLabels.previous) }}
      </div>
    </div>
  </div>
  <div class="col-sm-6 col-lg-3">
    <div class="card">
      <div class="card-body">
        <div class="subheader" data-dashboard-kpi-period="current">Чистый поток ({{ kpiPeriodLabels.current }})</div>
        <div class="h1 mb-0" data-dashboard-kpi="netFlow30" title="{{ kpi.netFlow30|vf_money(2, kpi_currency) }}">{{ kpi.netFlow30|vf_money_short(kpi_currency) }}</div>
        <a href="{{ path('report_cashflow_index', cashflowReconciliationQuery) }}" data-dashboard-reconcile-link="netFlow30">Сверить в ДДС</a>
        {{ _self.comparison('netFlow30', kpiComparisons.netFlow30, kpi_currency, kpiPeriodLabels.previous) }}
      </div>
    </div>
  </div>
</div>

<div
  id="finance-balance-dynamics-root"
  data-endpoint="{{ path('api_finance_dashboard_balance_dynamics')|e('html_attr') }}"
  data-currency="{{ cashCurrency.value|e('html_attr') }}"
></div>




{% endblock %}

{% block javascripts %}
  {{ parent() }}
{% endblock %}
