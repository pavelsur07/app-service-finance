{% extends 'base.html.twig' %}

{% block title %}Реклама — Маркетплейсы{% endblock %}

{% block body %}
    {% include 'marketplace_ads/_tabs.html.twig' with {activeTab: 'load'} %}

    <div class="page-header d-print-none">
        <div class="container-xl">
            <div class="row g-2 align-items-center">
                <div class="col">
                    <h2 class="page-title">Реклама маркетплейсов</h2>
                </div>
                {% if is_granted('ROLE_SUPER_ADMIN') %}
                    <div class="col-auto ms-auto">
                        <a href="{{ path('marketplace_ads_admin_logs', {'lines': 500}) }}"
                           target="_blank"
                           rel="noopener"
                           class="btn btn-outline-secondary btn-sm">
                            Открыть логи
                        </a>
                    </div>
                {% endif %}
            </div>
        </div>
    </div>

    {# Адреса с id — шаблоны с плейсхолдером-UUID: path() с requirements не примет '__ID__'. #}
    <div class="page-body" data-marketplace-ads
         data-jobs-url="{{ path('marketplace_ads_load_jobs_list') }}"
         data-raw-docs-url="{{ path('marketplace_ads_raw_documents_list') }}"
         data-load-range-url="{{ path('marketplace_ads_ozon_load_range') }}"
         data-extract-url="{{ path('marketplace_ads_extract_batches', {jobId: '00000000-0000-0000-0000-000000000000'}) }}"
         data-download-url="{{ path('marketplace_ads_raw_document_download', {id: '00000000-0000-0000-0000-000000000000'}) }}"
         data-reprocess-url="{{ path('marketplace_ads_raw_documents_reprocess', {id: '00000000-0000-0000-0000-000000000000'}) }}"
         data-mark-failed-url="{{ path('marketplace_ads_admin_mark_load_job_failed', {jobId: '00000000-0000-0000-0000-000000000000'}) }}">
        <div class="container-xl">

            {# ---------- Блок «Реклама Ozon» ---------- #}
            <div class="card mb-3">
                <div class="card-header">
                    <h3 class="card-title">Реклама Ozon</h3>
                </div>
                <div class="card-body">
                    {% if not hasPerformanceConnection %}
                        <div class="alert alert-warning mb-0">
                            <div class="d-flex">
                                <div>
                                    <h4 class="alert-title">Нет подключения к Ozon Performance API</h4>
                                    <div class="text-muted">
                                        Настройте Performance-подключение на странице
                                        <a href="{{ path('marketplace_index') }}">Маркетплейсы</a>.
                                    </div>
                                </div>
                            </div>
                        </div>
                    {% else %}
                        <div class="btn-list">
                            {# Кнопка «Загрузить с начала года» временно убрана (Task-11.9a):
                               после включения 62-day guard в DispatchOzonAdLoadAction период
                               Jan 1 → yesterday превышает лимит в большинстве месяцев года
                               и возвращает 400. Multi-chunk поддержка — отдельная follow-up
                               задача, до неё остаётся только «Загрузить за период». Сам
                               endpoint `marketplace_ads_ozon_initial_load` доступен через
                               прямой API — реактивируем UI одновременно с multi-chunk. #}
                            {% if is_granted('ROLE_COMPANY_OWNER') %}
                                <button type="button" class="btn btn-primary"
                                        data-bs-toggle="modal" data-bs-target="#modal-ozon-ad-load-range">
                                    Загрузить за период
                                </button>
                            {% endif %}
                        </div>

                        {% if activeAdLoadJob is not null %}
                            <div class="mt-3"
                                 data-ad-job-id="{{ activeAdLoadJob.id }}"
                                 data-ad-job-status="{{ activeAdLoadJob.status.value }}"
                                 data-status-url="{{ path('marketplace_ads_ozon_load_job_status', {jobId: activeAdLoadJob.id}) }}">
                                {% if activeAdLoadJob.status.isTerminal %}
                                    {% if activeAdLoadJob.status.value == 'completed' %}
                                        <div class="alert alert-success mb-0 py-2">
                                            <small>Реклама Ozon загружена</small>
                                        </div>
                                    {% elseif activeAdLoadJob.status.value == 'partial_success' %}
                                        <div class="alert alert-warning mb-0 py-2">
                                            <small>Реклама Ozon загружена частично: {{ activeAdLoadJob.failureReason }}</small>
                                        </div>
                                    {% else %}
                                        <div class="alert alert-danger mb-0 py-2">
                                            <small>Ошибка загрузки: {{ activeAdLoadJob.failureReason }}</small>
                                        </div>
                                    {% endif %}
                                {% else %}
                                    <div class="d-flex align-items-center gap-2 mb-1">
                                        <span class="spinner-border spinner-border-sm text-indigo"></span>
                                        <small class="text-muted">Загрузка рекламы Ozon...</small>
                                    </div>
                                    <div class="progress mb-1" style="height:6px;">
                                        <div class="progress-bar bg-indigo" data-ad-progress-bar style="width:0%"></div>
                                    </div>
                                    <small class="text-muted" data-ad-counters>Чанков: —, Документов: —</small>
                                {% endif %}
                            </div>
                        {% endif %}
                    {% endif %}
                </div>
            </div>

            {# ---------- Блок «История загрузок» ---------- #}
            <div class="card mb-3">
                <div class="card-header">
                    <h3 class="card-title">История загрузок</h3>
                </div>
                <div class="table-responsive">
                    <table class="table card-table table-vcenter" data-ad-jobs
                           data-is-company-owner="{{ is_granted('ROLE_COMPANY_OWNER') ? '1' : '0' }}">
                        <thead>
                        <tr>
                            <th>Период</th>
                            <th>Статус</th>
                            <th>Прогресс</th>
                            <th>Создан</th>
                            <th>Завершён</th>
                            <th>Ошибка</th>
                            <th>Действия</th>
                        </tr>
                        </thead>
                        <tbody>
                        <tr><td colspan="7" class="text-center text-muted">Загрузка…</td></tr>
                        </tbody>
                    </table>
                </div>
            </div>

            {# ---------- Блок «Сырые документы» ---------- #}
            <div class="card">
                <div class="card-header">
                    <h3 class="card-title">Сырые документы</h3>
                </div>
                <div class="card-body">
                    <form class="row g-2 align-items-end mb-3" data-raw-documents-filter>
                        <div class="col-auto">
                            <label class="form-label">Дата с</label>
                            <input type="date" class="form-control" data-raw-date-from
                                   value="{{ 'now'|date_modify('-30 days')|date('Y-m-d') }}">
                        </div>
                        <div class="col-auto">
                            <label class="form-label">Дата по</label>
                            <input type="date" class="form-control" data-raw-date-to
                                   value="{{ 'now'|date('Y-m-d') }}">
                        </div>
                        <div class="col-auto">
                            <button type="submit" class="btn btn-primary">Показать</button>
                        </div>
                    </form>
                </div>
                <div class="table-responsive">
                    <table class="table card-table table-vcenter" data-ad-raw-docs>
                        <thead>
                        <tr>
                            <th>Дата отчёта</th>
                            <th>Статус</th>
                            <th>Загружен</th>
                            <th>Ошибка обработки</th>
                            <th class="w-1">Действия</th>
                        </tr>
                        </thead>
                        <tbody>
                        <tr><td colspan="5" class="text-center text-muted">Загрузка…</td></tr>
                        </tbody>
                    </table>
                </div>
            </div>

        </div>

    {# ---------- Modal: Пометить AdLoadJob как FAILED ---------- #}
    {% if is_granted('ROLE_COMPANY_OWNER') %}
        <div class="modal modal-blur fade" id="modal-mark-ad-load-job-failed" tabindex="-1" role="dialog" aria-hidden="true" data-mark-failed-modal>
            <div class="modal-dialog modal-dialog-centered" role="document">
                <div class="modal-content">
                    <div class="modal-header">
                        <h5 class="modal-title">Пометить задание как FAILED</h5>
                        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                    </div>
                    <div class="modal-body">
                        <p class="text-muted">
                            Задание будет переведено в статус FAILED. Действие необратимо.
                        </p>
                        <div class="mb-3">
                            <label class="form-label required">Причина</label>
                            <textarea class="form-control" rows="3" maxlength="1000" data-mark-failed-reason
                                      placeholder="Опишите причину ручной финализации"></textarea>
                        </div>
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn" data-bs-dismiss="modal">Отмена</button>
                        <button type="button" class="btn btn-danger" data-mark-failed-submit>
                            Пометить FAILED
                        </button>
                    </div>
                </div>
            </div>
        </div>
    {% endif %}

    {# ---------- Modal: Загрузить рекламу Ozon за произвольный период ---------- #}
    {% if hasPerformanceConnection and is_granted('ROLE_COMPANY_OWNER') %}
        <div class="modal modal-blur fade" id="modal-ozon-ad-load-range" tabindex="-1" role="dialog" aria-hidden="true" data-ozon-ad-load-range>
            <div class="modal-dialog modal-dialog-centered" role="document">
                <div class="modal-content">
                    <div class="modal-header">
                        <h5 class="modal-title">Загрузить рекламу Ozon за период</h5>
                        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                    </div>
                    <div class="modal-body">
                        <div class="mb-3">
                            <label class="form-label required">Дата начала</label>
                            <input type="date" class="form-control" required data-range-from
                                   value="{{ 'now'|date_modify('first day of last month')|date('Y-m-d') }}">
                        </div>
                        <div class="mb-3">
                            <label class="form-label required">Дата окончания</label>
                            <input type="date" class="form-control" required data-range-to
                                   value="{{ 'now'|date_modify('last day of last month')|date('Y-m-d') }}">
                        </div>
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn" data-bs-dismiss="modal">Отмена</button>
                        <button type="button" class="btn btn-primary" data-range-submit>Загрузить</button>
                    </div>
                </div>
            </div>
        </div>
    {% endif %}

    {% include 'partials/_confirm_modal.html.twig' with {id: 'ads-confirm'} only %}
    </div>
{% endblock %}
