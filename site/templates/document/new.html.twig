{% extends 'base.html.twig' %}
{# Создание и копия документа (document_new, document_copy); разметка — document/_page.html.twig. #}
{% block title %}{{ app.request.attributes.get('_route') == 'document_copy' ? 'Копия документа ОПиУ' : 'Новый документ ОПиУ' }}{% endblock %}
{% block body %}
    {% include 'document/_page.html.twig' with {form: form, item: null, transactionAllocation: null} only %}
{% endblock %}
{% block javascripts %}
    {{ parent() }}
    {% include 'document/_page_scripts.html.twig' %}
{% endblock %}
