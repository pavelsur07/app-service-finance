{% extends 'base.html.twig' %}
{% block title %}Операции ОПиУ{% endblock %}
{#{% block breadcrumbs %}
    {% include 'partials/_breadcrumbs.html.twig' with {
        breadcrumbs: [
            {'label': 'Главная', 'path': 'app_home_index'},
            {'label': 'Финансы'},
            {'label': 'Документы'}
        ]
    } %}
{% endblock %}#}
{% block body %}
    {% set typeShortLabels = {
        'DEAL_SALE': 'Сделка',
        'PAYROLL': 'Зарплата',
        'TAXES': 'Налоги',
        'LOANS': 'Кредиты',
        'OBLIGATIONS': 'Обязательства',
        'ASSETS': 'Имущество',
        'CASH': 'Касса',
        'CASHFLOW_EXPENSE': 'Расход из ДДС',
        'OTHER': 'Прочие'
    } %}
    {% set statusLabels = {
        'DRAFT': 'Черновик',
        'ACTIVE': 'Активен',
        'INACTIVE': 'Неактивен',
        'TO_DELETE': 'На удаление'
    } %}
    {% set statusClasses = {
        'DRAFT': 'bg-secondary text-white',
        'ACTIVE': 'bg-success text-white',
        'INACTIVE': 'bg-warning text-dark',
        'TO_DELETE': 'bg-danger text-white'
    } %}

    <div class="page-header d-print-none">
        <div class="row g-2 align-items-center">
            <div class="col">
                <div class="page-pretitle">Отчёт о прибылях и убытках</div>
                <h2 class="page-title">Операции ОПиУ</h2>
            </div>
            <div class="col-auto ms-auto d-print-none">
                <div class="btn-list">
                    <a href="{{ path('document_operations_export_json') }}"
                       class="btn btn-outline-secondary"
                       title="Скачать все операции ОПиУ в формате JSON"
                       download>
                        <i class="ti ti-download"></i>
                        Выгрузить JSON
                    </a>
                    <a href="{{ path('document_new') }}" class="btn btn-primary">+ Добавить документ</a>
                </div>
            </div>
        </div>
    </div>
    <div class="mt-3">
        <div class="card">
            <div class="card-header card-head d-flex align-items-center gap-3 flex-wrap">
                <ul class="nav nav-tabs card-header-tabs">
                    <li class="nav-item">
                        <a class="nav-link active" href="{{ path('document_index') }}">Операции ОПиУ</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" href="{{ path('document_deleted_index') }}">Удалённые</a>
                    </li>
                </ul>
                <button type="button"
                        class="btn ms-auto"
                        data-bs-toggle="offcanvas"
                        data-bs-target="#document-filters-offcanvas"
                        aria-controls="document-filters-offcanvas">
                    <i class="ti ti-filter"></i>
                    Фильтр
                </button>
            </div>
            <div class="table-responsive">
                <table class="table card-table align-middle">
                    <thead>
                        <tr>
                            <th class="text-nowrap">Дата</th>
                            <th>Тип</th>
                            <th class="text-nowrap">Н док.</th>
                            <th>Проект</th>
                            <th>Контрагент</th>
                            <th class="text-end text-nowrap">Доход, ₽</th>
                            <th class="text-end text-nowrap">Расход, ₽</th>
                            <th class="text-end text-nowrap">Итог, ₽</th>
                            <th></th>
                        </tr>
                    </thead>
                    <tbody>
                        {% for item in items %}
                            {% set income = 0 %}
                            {% set expense = 0 %}
                            {% for op in item.operations %}
                                {% set category = op.plCategory ?? op.category ?? null %}
                                {% set flow = category ? category.flow.value : null %}
                                {% if flow == 'INCOME' %}
                                    {% set income = income + op.amount %}
                                {% elseif flow == 'EXPENSE' %}
                                    {% set expense = expense + op.amount %}
                                {% endif %}
                            {% endfor %}
                            {% set total = income - expense %}
                            {% set deleteLabel = item.number ? '№ ' ~ item.number : (item.description ?: 'Выбранная операция') %}
                            <tr>
                                {% set statusValue = item.status.value %}
                                {% set statusLabel = statusLabels[statusValue] ?? statusValue %}
                                {% set statusClass = statusClasses[statusValue] ?? 'bg-secondary text-white' %}
                                <td class="text-nowrap">
                                    <div>{{ item.date|date('d.m.Y') }}</div>
                                    <span class="badge {{ statusClass }} mt-1">{{ statusLabel }}</span>
                                </td>
                                <td>
                                    <div class="fw-semibold">
                                        {{ typeShortLabels[item.type.value] ?? item.type.label() }}
                                        {% if item.isCreatedWithViolation %}
                                          <span class="badge bg-warning text-dark ms-1"
                                                title="Документ создан без полного маппинга категорий ОПиУ">
                                            <i class="ti ti-alert-triangle me-1"></i>Без маппинга
                                          </span>
                                        {% endif %}
                                    </div>
                                    <div class="text-muted small">{{ item.description }}</div>
                                </td>
                                <td class="text-nowrap">{{ item.number ?: '—' }}</td>
                                <td>{{ item.projectDirection ? item.projectDirection.name : '-' }}</td>
                                <td>{{ item.counterparty ? item.counterparty.name : '—' }}</td>
                                <td class="text-end text-success text-nowrap">{{ income ? income|number_format(0, ',', ' ') : '—' }}</td>
                                <td class="text-end text-danger text-nowrap">{{ expense ? expense|number_format(0, ',', ' ') : '—' }}</td>
                                <td class="text-end fw-semibold text-nowrap">{{ total ? total|number_format(0, ',', ' ') : '—' }}</td>
                                <td class="text-end text-nowrap">
                                    <div class="dropdown position-static {{ loop.last ? 'dropup' : '' }}">
                                        <button class="btn btn-link p-0 text-muted" data-bs-toggle="dropdown" aria-label="Действия">
                                            <svg xmlns="http://www.w3.org/2000/svg" class="icon" viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="2">
                                                <circle cx="5" cy="12" r="1"/>
                                                <circle cx="12" cy="12" r="1"/>
                                                <circle cx="19" cy="12" r="1"/>
                                            </svg>
                                        </button>

                                        <div class="dropdown-menu dropdown-menu-end shadow-sm">
                                            <a class="dropdown-item" href="{{ path('document_show', {'id': item.id}) }}">
                                                <i class="ti ti-eye me-2"></i> Просмотр
                                            </a>
                                            <a class="dropdown-item" href="{{ path('document_copy', {'id': item.id}) }}">
                                                <i class="ti ti-copy me-2"></i> Копировать
                                            </a>
                                            <a class="dropdown-item" href="{{ path('document_edit', {'id': item.id}) }}">
                                                <i class="ti ti-pencil me-2"></i> Редактировать
                                            </a>
                                            <div class="dropdown-divider"></div>
                                            <button type="button"
                                                    class="dropdown-item text-danger d-flex align-items-center gap-2"
                                                    data-document-delete-trigger
                                                    data-bs-toggle="modal"
                                                    data-bs-target="#document-delete-modal"
                                                    data-delete-action="{{ path('document_delete', {'id': item.id}) }}"
                                                    data-delete-token="{{ csrf_token('delete' ~ item.id) }}"
                                                    data-delete-label="{{ deleteLabel|length > 80 ? deleteLabel|slice(0, 80) ~ '…' : deleteLabel }}">
                                                <i class="ti ti-trash"></i> Удалить
                                            </button>
                                        </div>
                                    </div>
                                </td>
                            </tr>
                        {% else %}
                            <tr><td colspan="9" class="text-center">Нет данных</td></tr>
                        {% endfor %}
                    </tbody>
                </table>
            </div>
            <div class="card-footer d-flex flex-column flex-md-row align-items-center gap-2">
                <form method="get" class="d-flex align-items-center gap-2">
                    <label for="document-limit" class="form-label mb-0">Показывать по</label>
                    <select id="document-limit" name="limit" class="form-select form-select-sm" onchange="this.form.submit()">
                        {% for option in [20, 30, 50] %}
                            <option value="{{ option }}" {{ option == limit ? 'selected' : '' }}>{{ option }}</option>
                        {% endfor %}
                    </select>
                    <input type="hidden" name="page" value="1">
                </form>
                <div class="ms-md-auto w-100 w-md-auto">
                    {% include 'partials/_pagerfanta.html.twig' with { pager: pager, route: 'document_index', params: app.request.query.all|merge({'limit': limit}) } %}
                </div>
            </div>
        </div>
    </div>

    <div class="offcanvas offcanvas-end" tabindex="-1" id="document-filters-offcanvas" aria-labelledby="document-filters-offcanvas-label">
        <div class="offcanvas-header">
            <h2 class="offcanvas-title" id="document-filters-offcanvas-label">Фильтры</h2>
            <button type="button" class="btn-close" data-bs-dismiss="offcanvas" aria-label="Закрыть"></button>
        </div>
        <div class="offcanvas-body">
            <form method="get" class="d-flex flex-column gap-4">
                <input type="hidden" name="page" value="1">
                <input type="hidden" name="limit" value="{{ limit }}">

                <div class="row g-3">
                    <div class="col-12 col-sm-6">
                        <label class="form-label" for="document-filter-date-from">Дата с</label>
                        <input type="date" id="document-filter-date-from" name="dateFrom" value="{{ app.request.query.get('dateFrom') }}" class="form-control" />
                    </div>
                    <div class="col-12 col-sm-6">
                        <label class="form-label" for="document-filter-date-to">Дата по</label>
                        <input type="date" id="document-filter-date-to" name="dateTo" value="{{ app.request.query.get('dateTo') }}" class="form-control" />
                    </div>
                    <div class="col-12 col-sm-6">
                        <label class="form-label" for="document-filter-type">Тип</label>
                        <select id="document-filter-type" name="type" class="form-select">
                            <option value="">Все</option>
                            {% for value, label in typeShortLabels %}
                                <option value="{{ value }}" {% if app.request.query.get('type') == value %}selected{% endif %}>{{ label }}</option>
                            {% endfor %}
                        </select>
                    </div>
                    <div class="col-12 col-sm-6">
                        <label class="form-label" for="document-filter-status">Статус</label>
                        <select id="document-filter-status" name="status" class="form-select">
                            <option value="">Все</option>
                            {% for value, label in statusLabels %}
                                <option value="{{ value }}" {% if app.request.query.get('status') == value %}selected{% endif %}>{{ label }}</option>
                            {% endfor %}
                        </select>
                    </div>
                    <div class="col-12 col-sm-6">
                        <label class="form-label" for="document-filter-number">Номер документа</label>
                        <input type="text" id="document-filter-number" name="number" value="{{ app.request.query.get('number') }}" class="form-control" />
                    </div>
                    <div class="col-12 col-sm-6">
                        <label class="form-label" for="document-filter-counterparty">Контрагент</label>
                        <input type="text" id="document-filter-counterparty" name="counterparty" value="{{ app.request.query.get('counterparty') }}" class="form-control" />
                    </div>
                </div>

                <div class="d-grid gap-2">
                    <button type="submit" class="btn btn-primary">Применить</button>
                    <a href="{{ path('document_index', {'limit': limit}) }}" class="btn btn-outline-secondary">Сбросить</a>
                </div>
            </form>
        </div>
    </div>

    <div class="modal modal-blur fade"
         id="document-delete-modal"
         tabindex="-1"
         role="dialog"
         aria-labelledby="document-delete-modal-title"
         aria-describedby="document-delete-modal-description"
         aria-hidden="true">
        <div class="modal-dialog modal-sm modal-dialog-centered" role="document">
            <div class="modal-content">
                <form method="post" id="document-delete-form">
                    <input type="hidden" name="_token" id="document-delete-token" value="">
                    <div class="modal-header">
                        <h5 class="modal-title" id="document-delete-modal-title">Удалить операцию ОПиУ?</h5>
                        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Закрыть"></button>
                    </div>
                    <div class="modal-body" id="document-delete-modal-description">
                        Операция «<strong id="document-delete-label" class="text-break">Выбранная операция</strong>» будет перемещена
                        в раздел «Удалённые». Её можно будет восстановить.
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn" data-bs-dismiss="modal">Отмена</button>
                        <button type="submit" class="btn btn-danger" id="document-delete-submit" disabled>
                            Переместить в удалённые
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>

    <script>
        (function () {
            var modal = document.getElementById('document-delete-modal');
            var form = document.getElementById('document-delete-form');
            var token = document.getElementById('document-delete-token');
            var label = document.getElementById('document-delete-label');
            var submit = document.getElementById('document-delete-submit');
            var lastTrigger = null;

            modal.addEventListener('show.bs.modal', function (event) {
                var trigger = event.relatedTarget;
                var action = trigger && trigger.getAttribute('data-delete-action');
                var csrfToken = trigger && trigger.getAttribute('data-delete-token');

                if (!action || !csrfToken) {
                    event.preventDefault();
                    return;
                }

                form.action = action;
                token.value = csrfToken;
                label.textContent = trigger.getAttribute('data-delete-label') || 'Выбранная операция';
                submit.disabled = false;
                lastTrigger = trigger;
            });

            modal.addEventListener('hidden.bs.modal', function () {
                var dropdown = lastTrigger && lastTrigger.closest('.dropdown');
                var dropdownToggle = dropdown && dropdown.querySelector('[data-bs-toggle="dropdown"]');

                form.removeAttribute('action');
                token.value = '';
                label.textContent = 'Выбранная операция';
                submit.disabled = true;

                if (dropdownToggle) {
                    dropdownToggle.focus();
                }
                lastTrigger = null;
            });

            form.addEventListener('submit', function () {
                submit.disabled = true;
            });
        })();
    </script>
{% endblock %}
