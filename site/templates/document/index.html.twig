{% extends 'base.html.twig' %}
{% block title %}Документы ОПиУ{% endblock %}
{% block body %}
{# Эталон — docs/design-system/screens/OperationsPnl.dc.html и pnl-refs/01–02; спецификация и разрыв с моделью —
   docs/design-system/PNL-DOCUMENTS-SPEC.md; отчёт — docs/plan/ds-pnl-documents.md. Композиция и классы — «Операции ДДС».
   Итог (totals) посчитан репозиторием по всей выборке фильтра, а не по странице. #}
{% macro plural(n, one, few, many) %}{{ n % 10 == 1 and n % 100 != 11 ? one : (n % 10 in 2..4 and (n % 100 < 10 or n % 100 >= 20) ? few : many) }}{% endmacro %}
{% macro pill(label, active, id) %}
    <button type="button"
            class="vf-ops-pill{{ active ? ' active' : '' }}"
            id="{{ id }}"
            data-bs-toggle="dropdown"
            data-bs-offset="0,6"
            aria-haspopup="true"
            aria-expanded="false">
        <span class="vf-ops-pill__label">{{ label }}</span>
        <i class="ti ti-chevron-down" aria-hidden="true"></i>
    </button>
{% endmacro %}
{% macro hidden(params) %}
    {% for k, v in params %}
        <input type="hidden" name="{{ k }}" value="{{ v }}">
    {% endfor %}
{% endmacro %}
{% import _self as ui %}

{% set route = 'document_index' %}
{% set typeShortLabels = {
    'DEAL_SALE': 'Сделка',
    'PAYROLL': 'Зарплата',
    'TAXES': 'Налоги',
    'LOANS': 'Кредиты',
    'OBLIGATIONS': 'Обязательства',
    'ASSETS': 'Имущество',
    'CASH': 'Касса',
    'CASHFLOW_EXPENSE': 'Расход из ДДС',
    'OTHER': 'Прочие'
} %}
{% set statusLabels = {
    'DRAFT': 'Черновик',
    'ACTIVE': 'Активен',
    'INACTIVE': 'Неактивен',
    'TO_DELETE': 'На удаление'
} %}
{% set directionLabels = {'income': 'Доходы', 'expense': 'Расходы'} %}
{% set directionValue = filters.direction ? (filters.direction.value == 'INCOME' ? 'income' : 'expense') : null %}

{# Параметры ссылок — нормализованные фильтры из DTO: мусор из адреса в ссылки не переносится.
   page не входит — смена фильтра возвращает на первую страницу; limit — только нестандартный. #}
{% set baseQuery = {
    q: filters.q,
    dateFrom: filters.dateFrom ? filters.dateFrom|date('Y-m-d') : null,
    dateTo: filters.dateTo ? filters.dateTo|date('Y-m-d') : null,
    direction: directionValue,
    type: filters.type ? filters.type.value : null,
    projectDirection: filters.projectDirectionId,
    responsibilityCenter: filters.responsibilityCenterId,
    status: filters.status ? filters.status.value : null,
    number: filters.number,
    counterparty: filters.counterparty,
    limit: limit != 20 ? limit : null,
}|filter(v => v is not null) %}

{% set project = filters.projectDirectionId ? projectDirections|filter(p => p.id == filters.projectDirectionId)|first : null %}
{% set center = filters.responsibilityCenterId ? responsibilityCenters|filter(c => c.id == filters.responsibilityCenterId)|first : null %}
{# Подписи пилюль — строки, а не вывод макроса: макрос отдаёт уже экранированный Markup, и после
   склейки с префиксом «A&B» экранировался бы второй раз. #}
{% set clipLen = 22 %}
{# Родители — по parent уже загруженного дерева: p.children — ленивая коллекция, запрос на каждый проект. #}
{% set parentProjectIds = projectDirections|filter(p => p.parent)|map(p => p.parent.id) %}
{% set typeName = filters.type ? (typeShortLabels[filters.type.value] ?? filters.type.label()) : '' %}
{% set projectName = project ? project.name : '' %}
{% set centerName = center ? center.name : '' %}
{% set moreCount = (filters.status ? 1 : 0) + (filters.number ? 1 : 0) + (filters.counterparty ? 1 : 0) %}

{% set presetsHtml %}{% include 'partials/_period_presets.html.twig' with {
    route: route,
    params: baseQuery|filter((v, k) => k not in ['dateFrom', 'dateTo']),
    current_from: baseQuery.dateFrom ?? null,
    current_to: baseQuery.dateTo ?? null,
    class: 'vf-seg',
} only %}{% endset %}
{% set customRange = (filters.dateFrom or filters.dateTo) and 'aria-current="true"' not in (presetsHtml ~ '') %}
{% set periodLabel = (filters.dateFrom ? filters.dateFrom|date('d.m.Y') : '…') ~ ' — ' ~ (filters.dateTo ? filters.dateTo|date('d.m.Y') : '…') %}

<div class="vf-page-head">
    <div class="vf-page-head__title">
        <nav aria-label="Путь">
            <ol class="breadcrumb">
                <li class="breadcrumb-item">Доходы и расходы</li>
                <li class="breadcrumb-item active" aria-current="page">Документы ОПиУ</li>
            </ol>
        </nav>
        <h1>Документы ОПиУ</h1>
        <p class="vf-page-head__lead">Документы, из которых строится отчёт о прибылях и убытках. В одном документе может быть несколько операций: по разным статьям и проектам.</p>
    </div>
    <div class="btn-list d-print-none">
        <a href="{{ path('document_operations_export_json') }}"
           class="btn"
           title="Скачать все операции документов ОПиУ в формате JSON"
           download>
            <i class="ti ti-download me-1" aria-hidden="true"></i>
            Выгрузить JSON
        </a>
        <a href="{{ path('document_new') }}" class="btn btn-primary">
            <i class="ti ti-plus me-1" aria-hidden="true"></i>
            Добавить документ
        </a>
    </div>
</div>

<div class="card vf-card vf-docs mb-4">
    <div class="card-header">
        {% include 'document/_tabs.html.twig' with {active: 'index'} only %}
    </div>

    <div class="vf-card-bar d-print-none">
        <div class="vf-card-bar__row">
            <form method="get" action="{{ path(route) }}" class="vf-search vf-docs__search" role="search">
                {{ ui.hidden(baseQuery|filter((v, k) => k not in ['q'])) }}
                <button type="submit" class="vf-search__submit" aria-label="Найти"><i class="ti ti-search" aria-hidden="true"></i></button>
                <input type="search" name="q" value="{{ filters.q }}" class="form-control" placeholder="Описание, статья, № документа" aria-label="Поиск по описанию, статье, номеру и контрагенту">
            </form>

            {{ presetsHtml }}

            <div class="dropdown">
                <button type="button"
                        class="btn vf-ops-range{{ customRange ? ' active' : '' }}"
                        id="doc-pill-period"
                        data-bs-toggle="dropdown"
                        data-bs-auto-close="outside"
                        data-bs-offset="0,6"
                        aria-haspopup="dialog"
                        aria-expanded="false"
                        aria-label="Выбрать период{{ filters.dateFrom or filters.dateTo ? ': ' ~ periodLabel }}">
                    <i class="ti ti-calendar" aria-hidden="true"></i>
                    {{ filters.dateFrom or filters.dateTo ? periodLabel : 'Выбрать период' }}
                </button>
                <div class="dropdown-menu vf-ops-pop vf-ops-pop--sm" role="dialog" aria-labelledby="doc-pill-period">
                    <form method="get" action="{{ path(route) }}">
                        {{ ui.hidden(baseQuery|filter((v, k) => k not in ['dateFrom', 'dateTo'])) }}
                        <div class="vf-ops-pop__body vf-ops-pop__pair">
                            <div>
                                <label class="form-label" for="document-filter-date-from">Дата с</label>
                                <input type="date" id="document-filter-date-from" name="dateFrom" value="{{ baseQuery.dateFrom ?? '' }}" class="form-control">
                            </div>
                            <div>
                                <label class="form-label" for="document-filter-date-to">Дата по</label>
                                <input type="date" id="document-filter-date-to" name="dateTo" value="{{ baseQuery.dateTo ?? '' }}" class="form-control">
                            </div>
                        </div>
                        <div class="vf-ops-pop__footer">
                            {% if filters.dateFrom or filters.dateTo %}
                                <a href="{{ path(route, baseQuery|filter((v, k) => k not in ['dateFrom', 'dateTo'])) }}" class="btn btn-link">Сбросить</a>
                            {% endif %}
                            <button type="submit" class="btn btn-primary btn-sm">Применить</button>
                        </div>
                    </form>
                </div>
            </div>
        </div>

        <div class="vf-card-bar__row">
            {# Направление — по flow статей операций: «Доходы» — документы, где есть доходная операция. #}
            <div class="vf-seg" role="group" aria-label="Направление">
                {% for d in [{value: null, label: 'Все'}, {value: 'income', label: 'Доходы'}, {value: 'expense', label: 'Расходы'}] %}
                    <a href="{{ path(route, baseQuery|filter((v, k) => k not in ['direction'])|merge(d.value ? {direction: d.value} : {})) }}"
                       {% if directionValue == d.value %}class="active" aria-current="true"{% endif %}>{{ d.label }}</a>
                {% endfor %}
            </div>

            <span class="vf-caps-label vf-docs__pills-label">Фильтры</span>

            <div class="dropdown">
                {{ ui.pill(filters.type ? 'Тип: ' ~ (typeName|length > clipLen ? typeName|slice(0, clipLen - 1)|trim ~ '…' : typeName) : 'Тип', filters.type, 'doc-pill-type') }}
                <div class="dropdown-menu vf-ops-pop vf-ops-pop--sm" aria-labelledby="doc-pill-type">
                    <div class="vf-ops-pop__list">
                        <a class="dropdown-item" href="{{ path(route, baseQuery|filter((v, k) => k not in ['type'])) }}"{% if not filters.type %} aria-current="true"{% endif %}>Все типы</a>
                        {% for documentType in enum_cases('App\\Finance\\Enum\\DocumentType') %}
                            <a class="dropdown-item" href="{{ path(route, baseQuery|filter((v, k) => k not in ['type'])|merge({type: documentType.value})) }}"{% if filters.type and filters.type.value == documentType.value %} aria-current="true"{% endif %}>{{ typeShortLabels[documentType.value] ?? documentType.label() }}</a>
                        {% endfor %}
                    </div>
                </div>
            </div>

            {# Проект — у документа или у любой его операции. Родительские проекты не выбираются и в формах. #}
            <div class="dropdown">
                {{ ui.pill(project ? 'Проект: ' ~ (projectName|length > clipLen ? projectName|slice(0, clipLen - 1)|trim ~ '…' : projectName) : 'Проект', project, 'doc-pill-project') }}
                <div class="dropdown-menu vf-ops-pop vf-ops-pop--sm" aria-labelledby="doc-pill-project">
                    <div class="vf-ops-pop__list">
                        <a class="dropdown-item" href="{{ path(route, baseQuery|filter((v, k) => k not in ['projectDirection'])) }}"{% if not filters.projectDirectionId %} aria-current="true"{% endif %}>Все проекты</a>
                        {% for p in projectDirections %}
                            {# Родительский проект документу не назначается (в формах он disabled): выбор дал бы пустой список. #}
                            {% if p.id not in parentProjectIds %}
                                <a class="dropdown-item vf-ops-lvl-{{ min(p.level, 5) }}" href="{{ path(route, baseQuery|filter((v, k) => k not in ['projectDirection'])|merge({projectDirection: p.id})) }}"{% if filters.projectDirectionId == p.id %} aria-current="true"{% endif %}>{{ p.name }}</a>
                            {% else %}
                                <span class="dropdown-header vf-ops-lvl-{{ min(p.level, 5) }}">{{ p.name }}</span>
                            {% endif %}
                        {% else %}
                            <div class="vf-ops-pop__empty">Проектов нет</div>
                        {% endfor %}
                    </div>
                </div>
            </div>

            {# ЦФО — у документа или у любой его операции. В списке — активные ЦФО компании. #}
            <div class="dropdown">
                {{ ui.pill(center ? 'ЦФО: ' ~ (centerName|length > clipLen ? centerName|slice(0, clipLen - 1)|trim ~ '…' : centerName) : 'ЦФО', center or filters.responsibilityCenterId, 'doc-pill-center') }}
                <div class="dropdown-menu vf-ops-pop vf-ops-pop--sm" aria-labelledby="doc-pill-center">
                    <div class="vf-ops-pop__list">
                        <a class="dropdown-item" href="{{ path(route, baseQuery|filter((v, k) => k not in ['responsibilityCenter'])) }}"{% if not filters.responsibilityCenterId %} aria-current="true"{% endif %}>Все ЦФО</a>
                        {% for c in responsibilityCenters %}
                            <a class="dropdown-item" href="{{ path(route, baseQuery|filter((v, k) => k not in ['responsibilityCenter'])|merge({responsibilityCenter: c.id})) }}"{% if filters.responsibilityCenterId == c.id %} aria-current="true"{% endif %}>{{ c.name }}</a>
                        {% else %}
                            <div class="vf-ops-pop__empty">ЦФО нет</div>
                        {% endfor %}
                    </div>
                </div>
            </div>

            <button type="button"
                    class="vf-ops-pill{{ moreCount ? ' active' : '' }}"
                    data-bs-toggle="offcanvas"
                    data-bs-target="#document-filters-offcanvas"
                    aria-controls="document-filters-offcanvas">
                <i class="ti ti-adjustments-horizontal" aria-hidden="true"></i>
                Ещё фильтры
                {% if moreCount %}
                    <span class="vf-ops-filterbar__count">{{ moreCount }}<span class="visually-hidden"> применено</span></span>
                {% endif %}
            </button>
        </div>
    </div>

    {% set chips = [
        filters.q ? {label: 'Поиск: «' ~ filters.q ~ '»', keys: ['q']} : null,
        filters.dateFrom or filters.dateTo ? {label: 'Период: ' ~ periodLabel, keys: ['dateFrom', 'dateTo']} : null,
        directionValue ? {label: directionLabels[directionValue], keys: ['direction']} : null,
        filters.type ? {label: 'Тип: ' ~ (typeShortLabels[filters.type.value] ?? filters.type.label()), keys: ['type']} : null,
        filters.projectDirectionId ? {label: 'Проект: ' ~ (project ? project.name : 'не найден'), keys: ['projectDirection']} : null,
        filters.responsibilityCenterId ? {label: 'ЦФО: ' ~ (center ? center.name : (responsibilityCenterNames[filters.responsibilityCenterId] ?? 'не найден')), keys: ['responsibilityCenter']} : null,
        filters.status ? {label: 'Статус: ' ~ (statusLabels[filters.status.value] ?? filters.status.value), keys: ['status']} : null,
        filters.number ? {label: 'Номер: ' ~ filters.number, keys: ['number']} : null,
        filters.counterparty ? {label: 'Контрагент: ' ~ filters.counterparty, keys: ['counterparty']} : null,
    ]|filter(c => c) %}
    {% if chips is not empty %}
        <div class="vf-applied">
            <span class="vf-caps-label">Применено</span>
            {% for chip in chips %}
                <span class="vf-chip">
                    {{ chip.label }}
                    <a href="{{ path(route, baseQuery|filter((v, k) => k not in chip.keys)) }}" aria-label="Снять фильтр «{{ chip.label }}»"><i class="ti ti-x" aria-hidden="true"></i></a>
                </span>
            {% endfor %}
            <a href="{{ path(route, limit != 20 ? {limit: limit} : {}) }}" class="small fw-medium">Сбросить всё</a>
        </div>
    {% endif %}

    {% if items is not empty or filters.hasFilters %}
        <div class="vf-bar vf-docs__totals" role="status">
            <span>Найдено {{ totals.documents|vf_number }} {{ ui.plural(totals.documents, 'документ', 'документа', 'документов') }} · {{ totals.operations|vf_number }} {{ ui.plural(totals.operations, 'операция', 'операции', 'операций') }}</span>
            <span class="vf-docs__total">Доходы <strong>{{ totals.income|vf_amount(2, 'income') }}</strong></span>
            <span class="vf-docs__total">Расходы <strong>{{ totals.expense|vf_amount }}</strong></span>
            {# DS-Money: красный для сумм не используется — отрицательный результат несёт знак «−». #}
            <span class="vf-docs__total vf-docs__total--result">Результат <strong>{{ totals.result|vf_amount }} ₽</strong></span>
            {# Документы из операций ДДС в валюте несут её сумму без пересчёта: в рубли не складываются (DS-Money, «в том числе в валюте»). #}
            {% for other in totals.others %}
                <span class="vf-docs__total vf-docs__other">в валюте {{ other.currency }}: доходы {{ other.income|vf_amount(currency: other.currency) }}, расходы {{ other.expense|vf_amount(currency: other.currency) }}, результат {{ other.result|vf_amount(currency: other.currency) }}</span>
            {% endfor %}
        </div>
    {% endif %}

    {% if items is empty %}
        <div class="vf-empty">
            <span class="empty-icon" aria-hidden="true"><i class="ti {{ filters.hasFilters ? 'ti-search' : 'ti-file-invoice' }}"></i></span>
            {% if filters.hasFilters %}
                <div class="vf-empty__title">Документы не найдены</div>
                <div class="vf-empty__hint">По выбранным фильтрам ничего нет. Измените фильтры или сбросьте их.</div>
                <div class="btn-list">
                    <a href="{{ path(route, limit != 20 ? {limit: limit} : {}) }}" class="btn btn-sm">Сбросить фильтры</a>
                </div>
            {% else %}
                <div class="vf-empty__title">Документов ОПиУ пока нет</div>
                <div class="vf-empty__hint">Добавьте документ вручную или создайте его из операции ДДС.</div>
                <div class="btn-list">
                    <a href="{{ path('document_new') }}" class="btn btn-primary btn-sm"><i class="ti ti-plus me-1" aria-hidden="true"></i>Добавить документ</a>
                    <a href="{{ path('cash_transaction_index') }}" class="btn btn-sm">Операции ДДС</a>
                </div>
            {% endif %}
        </div>
    {% else %}
        <div class="table-responsive">
            <table class="table card-table vf-table vf-docs-table">
                <thead class="sticky-top">
                    <tr>
                        <th class="vf-docs-table__date">Дата</th>
                        <th>Документ</th>
                        <th class="vf-docs-col-meta">Статья ОПиУ</th>
                        <th class="vf-docs-col-meta">Проект / ЦФО</th>
                        <th class="vf-docs-col-meta">Контрагент</th>
                        <th class="text-end text-nowrap">Доход, ₽</th>
                        <th class="text-end text-nowrap">Расход, ₽</th>
                        <th class="text-end text-nowrap">Итог, ₽</th>
                        <th class="vf-actions"><span class="visually-hidden">Действия</span></th>
                    </tr>
                </thead>
                {% for item in items %}
                    {# Доход и расход строки — DocumentPlContribution (правила регистра ОПиУ, как и у итога):
                       без статьи операция не входит; у marketplace_pl — модуль суммы статьи. #}
                    {% set contribution = contributions[item.id] %}
                    {% set rowCurrency = contribution.currency %}
                    {% set categoryNames = [] %}
                    {% set projectNames = [] %}
                    {% set centerNames = [] %}
                    {% set counterpartyNames = [] %}
                    {% set uncategorized = 0 %}
                    {% for op in item.operations %}
                        {% set category = op.plCategory %}
                        {% if category %}
                            {% set categoryNames = categoryNames|merge([category.name]) %}
                        {% else %}
                            {% set uncategorized = uncategorized + 1 %}
                        {% endif %}
                        {% set opProject = op.projectDirection ?? item.projectDirection %}
                        {% if opProject %}{% set projectNames = projectNames|merge([opProject.name]) %}{% endif %}
                        {% set opCenterId = op.responsibilityCenterId ?? item.responsibilityCenterId %}
                        {% if opCenterId %}{% set centerNames = centerNames|merge([responsibilityCenterNames[opCenterId] ?? 'ЦФО не найден']) %}{% endif %}
                        {% set opCounterparty = op.counterparty ?? item.counterparty %}
                        {% if opCounterparty %}{% set counterpartyNames = counterpartyNames|merge([opCounterparty.displayName ?? opCounterparty.name]) %}{% endif %}
                    {% endfor %}
                    {% if item.operations is empty %}
                        {% if item.projectDirection %}{% set projectNames = [item.projectDirection.name] %}{% endif %}
                        {% if item.responsibilityCenterId %}{% set centerNames = [responsibilityCenterNames[item.responsibilityCenterId] ?? 'ЦФО не найден'] %}{% endif %}
                        {% if item.counterparty %}{% set counterpartyNames = [item.counterparty.displayName ?? item.counterparty.name] %}{% endif %}
                    {% endif %}
                    {% set categoryNames = categoryNames|reduce((carry, v) => v in carry ? carry : carry|merge([v]), []) %}
                    {% set projectNames = projectNames|reduce((carry, v) => v in carry ? carry : carry|merge([v]), []) %}
                    {% set centerNames = centerNames|reduce((carry, v) => v in carry ? carry : carry|merge([v]), []) %}
                    {% set counterpartyNames = counterpartyNames|reduce((carry, v) => v in carry ? carry : carry|merge([v]), []) %}
                    {% set opCount = item.operations|length %}
                    {% set statusValue = item.status.value %}
                    {% set deleteLabel = item.number ? '№ ' ~ item.number : (item.description ?: 'Выбранный документ') %}

                    {% set categoryText = categoryNames|length > 1 ? categoryNames|length ~ ' ' ~ ui.plural(categoryNames|length, 'статья', 'статьи', 'статей') : (categoryNames|first ?: null) %}
                    {% set projectText = projectNames|length > 1 ? projectNames|length ~ ' ' ~ ui.plural(projectNames|length, 'проект', 'проекта', 'проектов') : (projectNames|first ?: null) %}
                    {% set centerText = centerNames|length > 1 ? centerNames|length ~ ' ЦФО' : (centerNames|first ?: null) %}
                    {% set counterpartyText = counterpartyNames|length > 1 ? counterpartyNames|length ~ ' ' ~ ui.plural(counterpartyNames|length, 'контрагент', 'контрагента', 'контрагентов') : (counterpartyNames|first ?: null) %}
                    {% set needsCategory = uncategorized > 0 and categoryNames is empty %}

                    <tbody class="vf-doc" data-document-row="{{ item.id }}">
                        <tr>
                            <td class="vf-docs-table__date text-nowrap">{{ item.date|date('d.m.Y') }}</td>
                            <td class="vf-doc__main">
                                <div class="vf-doc__title">
                                    <a href="{{ path('document_show', {id: item.id}) }}" class="vf-strong">{{ typeShortLabels[item.type.value] ?? item.type.label() }}</a>
                                    {% if item.number %}<span class="vf-doc__number">№ {{ item.number }}</span>{% endif %}
                                    {% if item.cashTransaction %}<span class="badge vf-doc-badge">Из ДДС</span>{% endif %}
                                    {% if statusValue in ['DRAFT', 'INACTIVE'] %}<span class="badge vf-doc-badge">{{ statusLabels[statusValue] }}</span>{% endif %}
                                    {% if item.isCreatedWithViolation %}
                                        <span class="vf-ops-badge-warn" title="Документ создан без полного маппинга категорий ОПиУ">Без маппинга</span>
                                    {% endif %}
                                </div>
                                {% if item.description %}
                                    <div class="vf-sub vf-doc__desc" title="{{ item.description }}">{{ item.description }}</div>
                                {% endif %}
                                {# Узкий экран: статья, проект и контрагент — подстрокой вместо колонок. #}
                                <div class="vf-sub vf-doc__meta">
                                    {{ [needsCategory ? 'Нужно указать статью' : categoryText, projectText, centerText, counterpartyText]|filter(v => v)|join(' · ') ?: '—' }}
                                </div>
                                {% if opCount > 1 %}
                                    {# Раскрытие без JS: строки операций ниже показывает CSS, пока <details> открыт. #}
                                    <details class="vf-doc__toggle">
                                        <summary>{{ opCount }} {{ ui.plural(opCount, 'операция', 'операции', 'операций') }}</summary>
                                    </details>
                                {% endif %}
                            </td>
                            <td class="vf-docs-col-meta">
                                {% if needsCategory %}
                                    <span class="vf-ops-badge-warn">Нужно указать статью</span>
                                {% else %}
                                    {{ categoryText ?? '—' }}
                                    {% if uncategorized > 0 %}<div class="vf-sub">{{ uncategorized }} без статьи</div>{% endif %}
                                {% endif %}
                            </td>
                            <td class="vf-docs-col-meta">
                                {{ projectText ?? '—' }}
                                {% if centerText %}<div class="vf-sub">{{ centerText }}</div>{% endif %}
                            </td>
                            <td class="vf-docs-col-meta">{{ counterpartyText ?? '—' }}</td>
                            <td class="text-end text-nowrap">{{ contribution.income != '0.00' ? contribution.income|vf_amount(2, 'income', currency: rowCurrency) : '—' }}</td>
                            <td class="text-end text-nowrap">{{ contribution.expense != '0.00' ? contribution.expense|vf_amount(currency: rowCurrency) : '—' }}</td>
                            <td class="text-end text-nowrap vf-doc__total">{{ contribution.result != '0.00' ? contribution.result|vf_amount(currency: rowCurrency) : '—' }}</td>
                            <td class="vf-actions text-end">
                                <div class="dropdown">
                                    <button type="button" class="btn btn-ghost-secondary btn-icon btn-sm" data-bs-toggle="dropdown" aria-expanded="false" aria-label="Действия с документом {{ deleteLabel }}">
                                        <i class="ti ti-dots" aria-hidden="true"></i>
                                    </button>
                                    <div class="dropdown-menu dropdown-menu-end">
                                        <a class="dropdown-item" href="{{ path('document_show', {'id': item.id}) }}">
                                            <i class="ti ti-eye me-2" aria-hidden="true"></i> Просмотр
                                        </a>
                                        <a class="dropdown-item" href="{{ path('document_edit', {'id': item.id}) }}">
                                            <i class="ti ti-pencil me-2" aria-hidden="true"></i> Редактировать
                                        </a>
                                        <a class="dropdown-item" href="{{ path('document_copy', {'id': item.id}) }}">
                                            <i class="ti ti-copy me-2" aria-hidden="true"></i> Копировать
                                        </a>
                                        {% if item.cashTransaction %}
                                            <a class="dropdown-item" href="{{ path('cash_transaction_show', {'id': item.cashTransaction.id}) }}">
                                                <i class="ti ti-arrows-exchange me-2" aria-hidden="true"></i> Открыть операцию ДДС
                                            </a>
                                        {% endif %}
                                        <div class="dropdown-divider"></div>
                                        <button type="button"
                                                class="dropdown-item text-danger"
                                                data-document-delete-trigger
                                                data-bs-toggle="modal"
                                                data-bs-target="#document-delete-modal"
                                                data-delete-action="{{ path('document_delete', {'id': item.id}) }}"
                                                data-delete-token="{{ csrf_token('delete' ~ item.id) }}"
                                                data-delete-label="{{ deleteLabel|length > 80 ? deleteLabel|slice(0, 80) ~ '…' : deleteLabel }}">
                                            <i class="ti ti-trash me-2" aria-hidden="true"></i> Удалить
                                        </button>
                                    </div>
                                </div>
                            </td>
                        </tr>
                        {% if opCount > 1 %}
                            {% for op in item.operations %}
                                {% set category = op.plCategory %}
                                {% set share = contribution.operations[op.id] ?? null %}
                                {% set flow = share ? share.nature : null %}
                                {% set opProject = op.projectDirection ?? item.projectDirection %}
                                {% set opCenterId = op.responsibilityCenterId ?? item.responsibilityCenterId %}
                                {% set opCenter = opCenterId ? (responsibilityCenterNames[opCenterId] ?? 'ЦФО не найден') : null %}
                                {% set opCounterparty = op.counterparty ?? item.counterparty %}
                                <tr class="vf-doc__op">
                                    <td></td>
                                    <td>
                                        <div class="vf-sub">Операция {{ loop.index }} из {{ opCount }}</div>
                                        <div class="vf-sub vf-doc__meta">
                                            {{ [category ? category.name : 'Нужно указать статью', opProject ? opProject.name : null, opCenter, opCounterparty ? (opCounterparty.displayName ?? opCounterparty.name) : null]|filter(v => v)|join(' · ') }}
                                        </div>
                                        {% if op.comment %}<div class="vf-sub vf-doc__desc" title="{{ op.comment }}">{{ op.comment }}</div>{% endif %}
                                    </td>
                                    <td class="vf-docs-col-meta">
                                        {% if category %}{{ category.name }}{% else %}<span class="vf-ops-badge-warn">Нужно указать статью</span>{% endif %}
                                    </td>
                                    <td class="vf-docs-col-meta">
                                        {{ opProject ? opProject.name : '—' }}
                                        {% if opCenter %}<div class="vf-sub">{{ opCenter }}</div>{% endif %}
                                    </td>
                                    <td class="vf-docs-col-meta">{{ opCounterparty ? (opCounterparty.displayName ?? opCounterparty.name) : '—' }}</td>
                                    <td class="text-end text-nowrap">{{ flow == 'INCOME' ? share.amount|vf_amount(2, 'income', currency: rowCurrency) : '' }}</td>
                                    <td class="text-end text-nowrap">{{ flow == 'EXPENSE' ? share.amount|vf_amount(currency: rowCurrency) : '' }}</td>
                                    <td class="text-end text-nowrap">{% if not share %}<span class="vf-sub" title="Без статьи операция в итог не входит">{{ op.amount|vf_amount(currency: rowCurrency) }}</span>{% endif %}</td>
                                    <td></td>
                                </tr>
                            {% endfor %}
                        {% endif %}
                    </tbody>
                {% endfor %}
            </table>
        </div>
    {% endif %}

    <div class="card-footer d-flex flex-column flex-md-row align-items-center gap-2">
        <form method="get" id="document-limit-form" class="d-flex align-items-center gap-2">
            <label for="document-limit" class="form-label mb-0">Показывать по</label>
            <select id="document-limit" name="limit" class="form-select form-select-sm" onchange="this.form.submit()">
                {% for option in [20, 30, 50] %}
                    <option value="{{ option }}" {{ option == limit ? 'selected' : '' }}>{{ option }}</option>
                {% endfor %}
            </select>
            <input type="hidden" name="page" value="1">
            {# Смена размера страницы не сбрасывает фильтры: они уже нормализованы и без пустых значений. #}
            {{ ui.hidden(baseQuery|filter((v, k) => k not in ['limit'])) }}
        </form>
        <div class="ms-md-auto w-100 w-md-auto">
            {% include 'partials/_pagination.html.twig' with { pager: pager, route: route, params: baseQuery|merge({'limit': limit}) } %}
        </div>
    </div>
</div>

<div class="offcanvas offcanvas-end vf-ops-filters" tabindex="-1" id="document-filters-offcanvas" aria-labelledby="document-filters-offcanvas-label">
    <div class="offcanvas-header">
        <h2 class="offcanvas-title" id="document-filters-offcanvas-label">Ещё фильтры</h2>
        <button type="button" class="btn-close" data-bs-dismiss="offcanvas" aria-label="Закрыть"></button>
    </div>
    <form method="get" class="offcanvas-body" action="{{ path(route) }}">
        {# Остальные фильтры страницы форма несёт скрытыми полями: «Применить» не сбрасывает их. #}
        {{ ui.hidden(baseQuery|filter((v, k) => k not in ['type', 'status', 'number', 'counterparty'])) }}
        <div class="vf-ops-filters__scroll">
            <div class="vf-ops-filters__section">
                <label class="form-label" for="document-filter-type">Тип</label>
                <select id="document-filter-type" name="type" class="form-select">
                    <option value="">Все</option>
                    {# Список ведётся от самого enum: тип, добавленный в DocumentType,
                       обязан появиться и здесь, иначе отфильтровать его через интерфейс нельзя. #}
                    {% for documentType in enum_cases('App\\Finance\\Enum\\DocumentType') %}
                        <option value="{{ documentType.value }}" {% if filters.type and filters.type.value == documentType.value %}selected{% endif %}>{{ typeShortLabels[documentType.value] ?? documentType.label() }}</option>
                    {% endfor %}
                </select>
            </div>
            <div class="vf-ops-filters__section">
                <label class="form-label" for="document-filter-status">Статус</label>
                <select id="document-filter-status" name="status" class="form-select">
                    <option value="">Все</option>
                    {% for value, label in statusLabels %}
                        <option value="{{ value }}" {% if filters.status and filters.status.value == value %}selected{% endif %}>{{ label }}</option>
                    {% endfor %}
                </select>
            </div>
            <div class="vf-ops-filters__section">
                <label class="form-label" for="document-filter-number">Номер документа</label>
                <input type="text" id="document-filter-number" name="number" value="{{ filters.number }}" class="form-control">
            </div>
            <div class="vf-ops-filters__section">
                <label class="form-label" for="document-filter-counterparty">Контрагент</label>
                <input type="text" id="document-filter-counterparty" name="counterparty" value="{{ filters.counterparty }}" class="form-control">
                <div class="vf-ops-filters__hint">Часть названия контрагента документа</div>
            </div>
        </div>
        <div class="vf-ops-filters__footer">
            <a href="{{ path(route, baseQuery|filter((v, k) => k not in ['type', 'status', 'number', 'counterparty'])) }}" class="btn btn-link">Сбросить</a>
            <button type="submit" class="btn btn-primary">Применить</button>
        </div>
    </form>
</div>

<div class="modal modal-blur fade"
     id="document-delete-modal"
     tabindex="-1"
     role="dialog"
     aria-labelledby="document-delete-modal-title"
     aria-describedby="document-delete-modal-description"
     aria-hidden="true">
    <div class="modal-dialog modal-sm modal-dialog-centered" role="document">
        <div class="modal-content">
            <form method="post" id="document-delete-form">
                <input type="hidden" name="_token" id="document-delete-token" value="">
                <div class="modal-header">
                    <h5 class="modal-title" id="document-delete-modal-title">Удалить документ ОПиУ?</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Закрыть"></button>
                </div>
                <div class="modal-body" id="document-delete-modal-description">
                    Документ «<strong id="document-delete-label" class="text-break">Выбранный документ</strong>» со всеми операциями
                    будет перемещён в раздел «Удалённые». Его можно будет восстановить.
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn" data-bs-dismiss="modal">Отмена</button>
                    <button type="submit" class="btn btn-danger" id="document-delete-submit" disabled>
                        Переместить в удалённые
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

<script>
    (function () {
        var modal = document.getElementById('document-delete-modal');
        var form = document.getElementById('document-delete-form');
        var token = document.getElementById('document-delete-token');
        var label = document.getElementById('document-delete-label');
        var submit = document.getElementById('document-delete-submit');
        var lastTrigger = null;

        modal.addEventListener('show.bs.modal', function (event) {
            var trigger = event.relatedTarget;
            var action = trigger && trigger.getAttribute('data-delete-action');
            var csrfToken = trigger && trigger.getAttribute('data-delete-token');

            if (!action || !csrfToken) {
                event.preventDefault();
                return;
            }

            form.action = action;
            token.value = csrfToken;
            label.textContent = trigger.getAttribute('data-delete-label') || 'Выбранный документ';
            submit.disabled = false;
            lastTrigger = trigger;
        });

        modal.addEventListener('hidden.bs.modal', function () {
            var dropdown = lastTrigger && lastTrigger.closest('.dropdown');
            var dropdownToggle = dropdown && dropdown.querySelector('[data-bs-toggle="dropdown"]');

            form.removeAttribute('action');
            token.value = '';
            label.textContent = 'Выбранный документ';
            submit.disabled = true;

            if (dropdownToggle) {
                dropdownToggle.focus();
            }
            lastTrigger = null;
        });

        form.addEventListener('submit', function () {
            submit.disabled = true;
        });
    })();
</script>
{% endblock %}
