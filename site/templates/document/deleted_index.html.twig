{% extends 'base.html.twig' %}

{% block title %}Удалённые операции ОПиУ{% endblock %}

{% block body %}
    {% set type_short_labels = {
        'DEAL_SALE': 'Сделка',
        'PAYROLL': 'Зарплата',
        'TAXES': 'Налоги',
        'LOANS': 'Кредиты',
        'OBLIGATIONS': 'Обязательства',
        'ASSETS': 'Имущество',
        'CASH': 'Касса',
        'CASHFLOW_EXPENSE': 'Расход из ДДС',
        'OTHER': 'Прочие'
    } %}

    <div class="page-header d-print-none">
        <div class="row g-2 align-items-center">
            <div class="col">
                <div class="page-pretitle">Отчёт о прибылях и убытках</div>
                <h2 class="page-title">Удалённые операции ОПиУ</h2>
            </div>
        </div>
    </div>

    <div class="mt-3">
        <div class="card">
            <div class="card-header card-head">
                <ul class="nav nav-tabs card-header-tabs">
                    <li class="nav-item">
                        <a class="nav-link" href="{{ path('document_index') }}">Операции ОПиУ</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link active" href="{{ path('document_deleted_index') }}">Удалённые</a>
                    </li>
                </ul>
            </div>
            <div class="table-responsive">
                <table class="table card-table align-middle">
                    <thead>
                        <tr>
                            <th class="text-nowrap">Дата удаления</th>
                            <th class="text-nowrap">Дата операции</th>
                            <th>Тип</th>
                            <th class="text-nowrap">Н док.</th>
                            <th>Проект</th>
                            <th>Контрагент</th>
                            <th class="text-end text-nowrap">Доход, ₽</th>
                            <th class="text-end text-nowrap">Расход, ₽</th>
                            <th class="text-end text-nowrap">Итог, ₽</th>
                            <th class="text-end">Действия</th>
                        </tr>
                    </thead>
                    <tbody>
                        {% for item in items %}
                            {% set income = 0 %}
                            {% set expense = 0 %}
                            {% for op in item.operations %}
                                {% set category = op.plCategory ?? op.category ?? null %}
                                {% set flow = category ? category.flow.value : null %}
                                {% if flow == 'INCOME' %}
                                    {% set income = income + op.amount %}
                                {% elseif flow == 'EXPENSE' %}
                                    {% set expense = expense + op.amount %}
                                {% endif %}
                            {% endfor %}
                            {% set total = income - expense %}
                            <tr>
                                <td class="text-nowrap">{{ item.deletedAt|date('d.m.Y H:i') }}</td>
                                <td class="text-nowrap">{{ item.date|date('d.m.Y') }}</td>
                                <td>
                                    <div class="fw-semibold">{{ type_short_labels[item.type.value] ?? item.type.label() }}</div>
                                    <div class="text-muted small">{{ item.description }}</div>
                                </td>
                                <td class="text-nowrap">{{ item.number ?: '—' }}</td>
                                <td>{{ item.projectDirection ? item.projectDirection.name : '—' }}</td>
                                <td>{{ item.counterparty ? item.counterparty.name : '—' }}</td>
                                <td class="text-end text-success text-nowrap">{{ income ? income|number_format(0, ',', ' ') : '—' }}</td>
                                <td class="text-end text-danger text-nowrap">{{ expense ? expense|number_format(0, ',', ' ') : '—' }}</td>
                                <td class="text-end fw-semibold text-nowrap">{{ total ? total|number_format(0, ',', ' ') : '—' }}</td>
                                <td class="text-end">
                                    <form method="post" action="{{ path('document_restore', {'id': item.id}) }}">
                                        <input type="hidden" name="_token" value="{{ csrf_token('document_restore' ~ item.id) }}">
                                        <button type="submit" class="btn btn-outline-primary btn-sm">Восстановить</button>
                                    </form>
                                </td>
                            </tr>
                        {% else %}
                            <tr>
                                <td colspan="10" class="text-center text-muted">Нет удалённых операций ОПиУ</td>
                            </tr>
                        {% endfor %}
                    </tbody>
                </table>
            </div>
            <div class="card-footer d-flex flex-column flex-md-row align-items-center gap-2">
                <form method="get" class="d-flex align-items-center gap-2">
                    <label for="deleted-document-limit" class="form-label mb-0">Показывать по</label>
                    <select id="deleted-document-limit" name="limit" class="form-select form-select-sm" onchange="this.form.submit()">
                        {% for option in [20, 30, 50] %}
                            <option value="{{ option }}" {{ option == limit ? 'selected' : '' }}>{{ option }}</option>
                        {% endfor %}
                    </select>
                    <input type="hidden" name="page" value="1">
                </form>
                <div class="ms-md-auto w-100 w-md-auto">
                    {% include 'partials/_pagerfanta.html.twig' with {pager: pager, route: 'document_deleted_index', params: {'limit': limit}} %}
                </div>
            </div>
        </div>
    </div>
{% endblock %}
