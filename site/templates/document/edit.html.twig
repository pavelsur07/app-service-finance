{% extends 'base.html.twig' %}
{# Правка документа (document_edit); разметка — document/_page.html.twig. #}
{% block title %}Документ ОПиУ{{ item.number ? ' № ' ~ item.number : '' }}{% endblock %}
{% block body %}
