<script>
    // Страница документа ОПиУ (document/_page.html.twig). Подсказки считаются на клиенте; истина — сервер.
    document.addEventListener('DOMContentLoaded', function () {
        const form = document.querySelector('[data-document-form]');
        if (!form) {
            return;
        }
        const documentCounterpartyField = document.querySelector('[data-document-counterparty]');
        const documentProjectField = document.querySelector('[data-document-project-direction]');
        const documentResponsibilityCenterField = document.querySelector('[data-document-responsibility-center]');

        // Префилл новой операции из шапки документа: только в пустое поле.
        const prefill = function (card, source, selector) {
            if (!source || !source.value) {
                return;
            }
            const target = card.querySelector(selector);
            if (target && !target.value) {
                target.value = source.value;
                target.dispatchEvent(new Event('change', { bubbles: true }));
            }
        };

        // Значение select'а с уведомлением пикеров (виджет ЦФО, пикер проекта читают его по change).
        // Варианта нет среди option строки — не трогаем: иначе select молча сбросится в пустое.
        const setSelect = function (field, value) {
            if (!field || field.value === value) {
                return field ? field.value === value : false;
            }
            if (value !== '' && !Array.from(field.options).some(function (o) { return o.value === value; })) {
                return false;
            }
            field.value = value;
            field.dispatchEvent(new Event('change', { bubbles: true }));
            return true;
        };
        const optionText = function (field) {
            const option = field && field.selectedOptions ? field.selectedOptions[0] : null;
            return option ? option.textContent.replace(/^[\s\u00a0—-]+/, '').trim() : '';
        };

        // Проект и ЦФО шапки — значения операций по умолчанию (SPEC §4.1). Операция «наследует»,
        // пока её значение равно шапке; флагов нет — признак считается сравнением при каждой смене.
        const inherit = {
            project: { header: documentProjectField, row: '[data-operation-project-direction]', name: 'Проект', verb: 'подставлен' },
            cfo: { header: documentResponsibilityCenterField, row: '[data-operation-responsibility-center]', name: 'ЦФО', verb: 'подставлен' },
        };
        Object.keys(inherit).forEach(function (kind) {
            inherit[kind].last = inherit[kind].header ? inherit[kind].header.value : '';
        });
        const syncMarks = function (row) {
            Object.keys(inherit).forEach(function (kind) {
                const cfg = inherit[kind];
                const field = row.querySelector(cfg.row);
                const mark = row.querySelector('[data-inherit-mark="' + kind + '"]');
                if (mark) {
                    mark.hidden = !cfg.header || !field || cfg.header.value === '' || field.value === cfg.header.value;
                }
            });
        };
        const operationsWord = function (n) {
            return n % 10 === 1 && n % 100 !== 11 ? 'операции' : 'операций';
        };
        const notice = document.querySelector('[data-inherit-notice]');
        let noticeTimer = null;
        const showNotice = function (text) {
            if (!notice) {
                return;
            }
            notice.textContent = text;
            notice.hidden = false;
            clearTimeout(noticeTimer);
            noticeTimer = setTimeout(function () { notice.hidden = true; }, 8000);
        };

        // Деньги по DS-Money: неразрывные пробелы в разрядах, запятая, настоящий минус.
        const formatter = new Intl.NumberFormat('ru-RU', { minimumFractionDigits: 2, maximumFractionDigits: 2 });
        const money = function (value) {
            return formatter.format(value).replace(/[   ]/g, ' ').replace('-', '−');
        };
        // Итоги — с символом валюты всегда; остаток по основанию — как vf_amount: рубль не пишется.
        const currencyCode = form.getAttribute('data-currency') || 'RUB';
        const currencySymbol = form.getAttribute('data-currency-symbol') || '₽';
        const total = function (value) {
            return money(value) + '\u00A0' + currencySymbol;
        };
        const rest = function (value) {
            return money(value) + (currencyCode === 'RUB' ? '' : '\u00A0' + currencySymbol);
        };
        // Сумма в поле — как в DS-Money («120 000,00»); на сервер уходит без разрядов и с точкой.
        const amountNumber = function (text) {
            const raw = String(text || '').replace(/[\s\u00a0\u202f]/g, '').replace('\u2212', '-').replace(',', '.');
            return /^-?\d+(\.\d+)?$/.test(raw) ? parseFloat(raw) : null;
        };
        const parseAmount = function (input) {
            const value = amountNumber(input ? input.value : '');
            return value !== null && isFinite(value) ? value : 0;
        };
        const formatAmountInput = function (input) {
            const value = amountNumber(input.value);
            if (value !== null) {
                input.value = money(value);
            }
        };
        const flowOf = function (row) {
            const select = row.querySelector('[data-operation-category]');
            const option = select && select.selectedOptions ? select.selectedOptions[0] : null;
            return option ? option.getAttribute('data-flow') || '' : '';
        };

        const holder = form.querySelector('[data-collection-holder]');
        const addButton = form.querySelector('.add_item_link');
        const countBadge = form.querySelector('[data-operations-count]');
        const emptyState = form.querySelector('[data-operations-empty]');
        const allocation = document.querySelector('[data-allocation]');
        const available = allocation ? parseFloat(allocation.getAttribute('data-allocation-available')) : null;
        const set = function (selector, text) {
            document.querySelectorAll(selector).forEach(function (node) { node.textContent = text; });
        };

        // После неудачного сохранения на странице — отклонённые сервером правки: они тоже не сохранены.
        let dirty = !!document.querySelector('[data-error-summary]');
        let submitting = false;

        // Правила регистра ОПиУ (DocumentPlContribution): без статьи — не входит; статья без flow
        // (NONE) — по знаку суммы; обычный документ — модуль операции; marketplace_pl — модуль
        // суммы статьи (списание «−», сторно «+»).
        const isMarketplace = form.getAttribute('data-marketplace') === 'true';
        const recalc = function () {
            let income = 0;
            let expense = 0;
            let sum = 0;
            let uncategorized = 0;
            const byCategory = {};
            const rows = holder.querySelectorAll('[data-operation-row]');
            rows.forEach(function (row) {
                const amount = parseAmount(row.querySelector('[data-operation-amount]'));
                const flow = flowOf(row);
                const category = (row.querySelector('[data-operation-category]') || {}).value || '';
                const nature = flow === 'INCOME' || flow === 'EXPENSE' ? flow : (flow === 'NONE' && amount !== 0 ? (amount > 0 ? 'INCOME' : 'EXPENSE') : '');
                const label = row.querySelector('[data-operation-flow-label]');
                label.textContent = nature === 'INCOME' ? 'Доход' : (nature === 'EXPENSE' ? 'Расход' : '—');
                label.setAttribute('data-flow', nature);
                sum += amount;
                if (!category || !nature) {
                    if (amount) {
                        uncategorized += 1;
                    }
                    return;
                }
                if (isMarketplace) {
                    const key = nature + '|' + category;
                    byCategory[key] = (byCategory[key] || 0) + amount;
                } else if (nature === 'INCOME') {
                    income += Math.abs(amount);
                } else {
                    expense += Math.abs(amount);
                }
            });
            Object.keys(byCategory).forEach(function (key) {
                if (key.indexOf('INCOME|') === 0) {
                    income += Math.abs(byCategory[key]);
                } else {
                    expense += Math.abs(byCategory[key]);
                }
            });
            set('[data-total-income]', total(income));
            set('[data-total-expense]', total(expense));
            set('[data-total-result]', total(income - expense));
            const uncat = form.querySelector('[data-total-uncategorized]');
            uncat.hidden = uncategorized === 0;
            uncat.textContent = uncategorized ? uncategorized + ' без статьи — не входят в итог' : '';
            countBadge.textContent = String(rows.length);
            emptyState.hidden = rows.length > 0;
            rows.forEach(function (row, i) {
                const comment = row.querySelector('[data-operation-comment]');
                if (comment) {
                    comment.setAttribute('aria-label', 'Описание, операция ' + (i + 1));
                }
                // Единственную операцию не удалить (SPEC §5.1): документ без операций не попадёт в ОПиУ.
                const remove = row.querySelector('.remove-item');
                if (remove) {
                    remove.disabled = rows.length === 1;
                }
            });

            if (allocation && isFinite(available)) {
                const left = Math.round((available - sum) * 100) / 100;
                set('[data-allocation-rest], [data-allocation-rest-footer]', rest(left));
                document.querySelectorAll('[data-allocation-rest], [data-allocation-rest-footer]').forEach(function (node) {
                    node.classList.toggle('text-danger', left < 0);
                });
                allocation.querySelector('[data-allocation-over]').hidden = left >= 0;
                allocation.querySelector('[data-allocation-ok]').hidden = left < 0;
                allocation.querySelector('[data-allocation-ok-text]').textContent = left === 0 ? 'Всё распределено' : 'Остаток можно распределить другими документами';
                allocation.querySelector('[data-allocation-fill]').hidden = left <= 0;
                allocation.querySelector('[data-allocation-live]').hidden = !dirty;
            }
        };

        // Правка: «Сохранить» неактивна, пока нет изменений (SPEC §3). Создание — активна всегда.
        const saveButton = form.querySelector('[data-document-save]');
        if (saveButton && form.getAttribute('data-document-mode') === 'edit' && !dirty) {
            saveButton.disabled = true;
        }

        const markDirty = function () {
            if (saveButton) {
                saveButton.disabled = false;
            }
            if (dirty) {
                recalc();
                return;
            }
            dirty = true;
            const badge = document.querySelector('[data-dirty-badge]');
            if (badge) {
                badge.hidden = false;
            }
            set('[data-dirty-text]', 'Есть несохранённые изменения');
            recalc();
        };

        // Индекс новой строки — больше любого существующего: после удаления строки счёт по
        // количеству повторил бы индекс оставшейся, и две операции слились бы в одну.
        let nextIndex = 0;
        holder.querySelectorAll('[name^="document[operations]["]').forEach(function (field) {
            const match = field.name.match(/^document\[operations\]\[(\d+)\]/);
            if (match) {
                nextIndex = Math.max(nextIndex, parseInt(match[1], 10) + 1);
            }
        });

        const createRow = function () {
            const html = holder.dataset.prototype.replace(/__name__/g, String(nextIndex++));
            const template = document.createElement('template');
            template.innerHTML = html.trim();
            return template.content.firstElementChild;
        };
        // Виджеты строки (категория, ЦФО, пикеры) подключаются наблюдателем DOM после вставки —
        // фокус ставим следующей задачей, на кнопку виджета категории.
        const focusRow = function (row) {
            row.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
            setTimeout(function () {
                const target = row.querySelector('.vf-docform-op__cell--category .dds-field__main') || row.querySelector('select, input:not([type="hidden"])');
                if (target) {
                    target.focus({ preventScroll: true });
                }
            }, 0);
        };

        // Новая операция — значения шапки (проект, ЦФО; контрагент — только в пустое поле).
        // quiet — строка при открытии формы создания: не правка пользователя и без фокуса.
        const addOperation = function (amount, quiet) {
            const row = createRow();
            holder.appendChild(row);
            prefill(row, documentCounterpartyField, '[data-operation-counterparty]');
            Object.keys(inherit).forEach(function (kind) {
                const cfg = inherit[kind];
                if (cfg.header && cfg.header.value !== '') {
                    setSelect(row.querySelector(cfg.row), cfg.header.value);
                }
            });
            if (amount) {
                row.querySelector('[data-operation-amount]').value = money(amount);
            }
            syncMarks(row);
            if (quiet) {
                return;
            }
            markDirty();
            focusRow(row);
        };

        // Дубль — копия значений исходной строки, сразу под ней (SPEC §4.1 п.6).
        const duplicateOperation = function (source) {
            const row = createRow();
            source.after(row);
            ['[data-operation-category]', '[data-operation-project-direction]', '[data-operation-responsibility-center]', '[data-operation-counterparty]'].forEach(function (selector) {
                const from = source.querySelector(selector);
                const to = row.querySelector(selector);
                if (!from || !to || from.value === '') {
                    return;
                }
                // Вариант мог быть добавлен в исходную строку позже (найден поиском контрагента).
                if (!Array.from(to.options).some(function (o) { return o.value === from.value; }) && from.selectedOptions[0]) {
                    to.appendChild(from.selectedOptions[0].cloneNode(true));
                }
                setSelect(to, from.value);
            });
            ['[data-operation-amount]', '[data-operation-comment]'].forEach(function (selector) {
                const from = source.querySelector(selector);
                const to = row.querySelector(selector);
                if (from && to) {
                    to.value = from.value;
                }
            });
            syncMarks(row);
            markDirty();
            focusRow(row);
        };

        addButton.addEventListener('click', function () { addOperation(0); });
        holder.addEventListener('click', function (e) {
            const duplicateButton = e.target.closest('[data-operation-duplicate]');
            if (duplicateButton) {
                duplicateOperation(duplicateButton.closest('[data-operation-row]'));
                return;
            }
            const resetButton = e.target.closest('[data-inherit-reset]');
            if (resetButton) {
                const row = resetButton.closest('[data-operation-row]');
                const cfg = inherit[resetButton.getAttribute('data-inherit-reset')];
                setSelect(row.querySelector(cfg.row), cfg.header.value);
                syncMarks(row);
                const cell = row.querySelector(cfg.row).closest('.vf-docform-op__cell');
                const focusTarget = cell.querySelector('.dds-field__main, input:not([type="hidden"])');
                if (focusTarget) {
                    focusTarget.focus();
                }
                return;
            }
            const removeButton = e.target.closest('.remove-item');
            if (!removeButton) {
                return;
            }
            const card = removeButton.closest('.document-operation-card');
            if (card) {
                card.remove();
                markDirty();
                addButton.focus();
            }
        });
        holder.addEventListener('change', function (e) {
            const row = e.target.closest('[data-operation-row]');
            if (row) {
                syncMarks(row);
            }
        });

        // Смена Проекта/ЦФО шапки — только в наследующие операции, остальные не трогаем.
        Object.keys(inherit).forEach(function (kind) {
            const cfg = inherit[kind];
            if (!cfg.header) {
                return;
            }
            cfg.header.addEventListener('change', function () {
                const value = cfg.header.value;
                const previous = cfg.last;
                cfg.last = value;
                if (value === previous) {
                    return;
                }
                const rows = holder.querySelectorAll('[data-operation-row]');
                let applied = 0;
                rows.forEach(function (row) {
                    const field = row.querySelector(cfg.row);
                    if (field && field.value === previous && setSelect(field, value)) {
                        applied += 1;
                    }
                    syncMarks(row);
                });
                if (!rows.length) {
                    return;
                }
                const manual = rows.length - applied;
                const what = value === ''
                    ? cfg.name + ' очищен в ' + applied + ' из ' + rows.length + ' ' + operationsWord(rows.length) + '.'
                    : cfg.name + ' «' + optionText(cfg.header) + '» ' + cfg.verb + ' в ' + applied + ' из ' + rows.length + ' ' + operationsWord(rows.length) + '.';
                showNotice(what + (manual ? ' В ' + manual + ' задан вручную.' : ''));
            });
        });
        if (allocation) {
            allocation.querySelector('[data-allocation-fill]').addEventListener('click', function () {
                let sum = 0;
                holder.querySelectorAll('[data-operation-amount]').forEach(function (input) { sum += parseAmount(input); });
                const left = Math.round((available - sum) * 100) / 100;
                if (left > 0) {
                    addOperation(left);
                }
            });
        }

        const description = form.querySelector('[data-document-description]');
        const descriptionCounter = form.querySelector('[data-document-description-counter]');
        if (description && descriptionCounter) {
            description.addEventListener('input', function () {
                descriptionCounter.textContent = description.value.length + ' из 500';
            });
        }

        form.addEventListener('input', markDirty);
        form.addEventListener('change', markDirty);
        form.addEventListener('submit', function () {
            submitting = true;
            form.querySelectorAll('[data-operation-amount]').forEach(function (input) {
                const value = amountNumber(input.value);
                if (value !== null) {
                    input.value = value.toFixed(2);
                }
            });
        });
        holder.addEventListener('focusout', function (e) {
            if (e.target.matches('[data-operation-amount]')) {
                formatAmountInput(e.target);
            }
        });
        holder.querySelectorAll('[data-operation-amount]').forEach(formatAmountInput);
        document.querySelectorAll('[data-leave-safe-form]').forEach(function (f) {
            f.addEventListener('submit', function () { submitting = true; });
        });

        // Уход с несохранёнными правками: свой диалог для ссылок страницы, системный — для
        // закрытия вкладки и адресной строки (текст там задаёт браузер).
        window.addEventListener('beforeunload', function (e) {
            if (dirty && !submitting) {
                e.preventDefault();
                e.returnValue = '';
            }
        });
        const leaveModalEl = document.getElementById('document-leave-modal');
        const leaveConfirm = leaveModalEl.querySelector('[data-leave-confirm]');
        document.addEventListener('click', function (e) {
            const link = e.target.closest('a[href]');
            if (!dirty || !link || e.defaultPrevented || e.button !== 0 || e.metaKey || e.ctrlKey || e.shiftKey) {
                return;
            }
            const href = link.getAttribute('href');
            if (!href || href.charAt(0) === '#' || link.target === '_blank' || link.hasAttribute('download')
                || link.hasAttribute('data-leave-safe') || link.hasAttribute('data-bs-toggle') || link === leaveConfirm) {
                return;
            }
            e.preventDefault();
            leaveConfirm.setAttribute('href', link.href);
            bootstrap.Modal.getOrCreateInstance(leaveModalEl).show();
        });
        leaveConfirm.addEventListener('click', function () { submitting = true; });

        // После неудачного сохранения — фокус на первое невалидное поле; сводка ошибок наверху
        // ведёт ссылками к полям. Ошибка без поля (сумма против основания) — фокус на сводку.
        const summary = document.querySelector('[data-error-summary]');
        const firstInvalid = form.querySelector('.is-invalid');
        if (firstInvalid) {
            firstInvalid.scrollIntoView({ block: 'center' });
            firstInvalid.focus({ preventScroll: true });
        } else if (summary) {
            summary.focus();
        }
        if (summary) {
            summary.addEventListener('click', function (e) {
                const link = e.target.closest('a[href^="#"]');
                const target = link ? document.getElementById(link.getAttribute('href').slice(1)) : null;
                if (target) {
                    e.preventDefault();
                    target.scrollIntoView({ block: 'center' });
                    target.focus();
                }
            });
        }

        if (dirty) {
            const badge = document.querySelector('[data-dirty-badge]');
            if (badge) {
                badge.hidden = false;
            }
        }
        // Создание (SPEC §6 п.5): одна пустая операция при открытии, если сервер не вернул строк.
        if (form.getAttribute('data-document-mode') === 'new' && !holder.querySelector('[data-operation-row]')) {
            addOperation(0, true);
        }
        holder.querySelectorAll('[data-operation-row]').forEach(syncMarks);
        recalc();
    });
</script>
