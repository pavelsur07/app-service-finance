{#
  Главная кнопка статуса в шапке варианта (BUDGET-SPEC §5): черновик — «Утвердить» (акцент),
  утверждён — «Вернуть в черновик», архив — «Восстановить». Подтверждение — общий диалог.
  Недоступная кнопка неактивна; причину шапка выводит строкой под кнопками (`budget/show`).
  Параметры: version, enabled.
#}
{% set status = version.status.value %}
{% if status == 'draft' %}
    {% set b = {target: 'approved', label: 'Утвердить', title: 'Утвердить «' ~ version.name ~ '»?', body: 'Утверждённый вариант не редактируется; с ним сравнивается факт.', variant: 'btn-primary'} %}
{% elseif status == 'approved' %}
    {% set b = {target: 'draft', label: 'Вернуть в черновик', title: 'Вернуть «' ~ version.name ~ '» в черновик?', body: 'Вариант снова можно будет править; утверждённого варианта на год не останется.', variant: ''} %}
{% else %}
    {% set b = {target: 'draft', label: 'Восстановить', title: 'Восстановить «' ~ version.name ~ '»?', body: 'Вариант вернётся в черновики.', variant: ''} %}
{% endif %}
{% if enabled %}
    <button type="button" class="btn {{ b.variant }}" data-budget-status-action
            data-bs-toggle="modal" data-bs-target="#budget-confirm"
            data-confirm-action="{{ path('budget_version_status', {id: version.id, target: b.target}) }}"
            data-confirm-token="{{ csrf_token('budget_version_status' ~ version.id) }}"
            data-confirm-title="{{ b.title }}"
            data-confirm-body="{{ b.body }}"
            data-confirm-submit="{{ b.label }}">{{ b.label }}</button>
{% else %}
    <button type="button" class="btn {{ b.variant }}" disabled aria-describedby="budget-status-reason" data-budget-status-action>{{ b.label }}</button>
{% endif %}
