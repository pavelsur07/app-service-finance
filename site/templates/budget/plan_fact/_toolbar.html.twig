{#
  Панель фильтров и переключателей план–факта.
  Параметры: year, years, version, versions, archived, show, period, filter, filter_query, base_query, all, by_columns, by_rows, show_labels.
#}
{% import 'budget/plan_fact/_macros.html.twig' as macros %}
<div class="vf-card-bar d-print-none vf-pf-bar">
    <div class="vf-pf-bar__filters">
        {# Год — отдельной формой: смена года сбрасывает вариант. #}
        <form data-autosubmit method="get" action="{{ path('budget_plan_fact') }}" class="vf-pf-bar__field">
            <label class="vf-pf-bar__label" for="pf-year">Год</label>
            <select id="pf-year" name="year" class="form-select w-auto" data-pf-year>
                {% for y in years %}
                    <option value="{{ y }}"{% if y == year %} selected{% endif %}>{{ y }}</option>
                {% endfor %}
            </select>
            <noscript><button type="submit" class="btn btn-sm">Показать</button></noscript>
        </form>
        {% if version %}
            <form data-autosubmit method="get" action="{{ path('budget_plan_fact') }}" class="vf-pf-bar__group" data-budget-plan-fact-filters>
                <input type="hidden" name="year" value="{{ year }}">
                <input type="hidden" name="show" value="{{ show }}">
                <input type="hidden" name="period" value="{{ period }}">
                <div class="vf-pf-bar__field">
                    <label class="vf-pf-bar__label" for="pf-version">Вариант</label>
                    <select id="pf-version" name="version" class="form-select w-auto">
                        {% for v in versions|merge(archived) %}
                            <option value="{{ v.id }}"{% if v.id == version.id %} selected{% endif %}>{{ v.name }} · {{ v.status.value == 'approved' ? 'утверждён' : (v.status.value == 'archived' ? 'архив' : 'черновик') }}</option>
                        {% endfor %}
                    </select>
                </div>
                {{ macros.hidden(filter_query) }}
                <noscript><button type="submit" class="btn btn-sm">Показать</button></noscript>
            </form>
            {% if filter.projectOptions|length > 1 %}
                {{ macros.picker('projects', 'Проект', filter.projectLabel(), filter.projectOptions, {year: year, version: version.id, show: show, period: period}|merge(filter_query|filter((v, k) => k != 'projects')), 'Проект выбирается включая вложенные.') }}
            {% endif %}
            {% if filter.centerOptions|length > 1 %}
                {{ macros.picker('centers', 'ЦФО', filter.centerLabel(), filter.centerOptions, {year: year, version: version.id, show: show, period: period}|merge(filter_query|filter((v, k) => k != 'centers')), null) }}
            {% endif %}
            <div class="vf-seg" role="group" aria-label="Период">
                <a href="{{ path('budget_plan_fact', base_query|merge({show: show, period: 'month'})) }}"{% if period == 'month' %} class="active" aria-current="true"{% endif %}>Месяцы</a>
                <a href="{{ path('budget_plan_fact', base_query|merge({show: show, period: 'quarter'})) }}"{% if period == 'quarter' %} class="active" aria-current="true"{% endif %}>Кварталы</a>
            </div>
        {% endif %}
    </div>
    {% if version %}
        <div class="vf-pf-bar__views">
            {% if all %}
                <div class="vf-seg" role="group" aria-label="Раскладка" data-pf-layout>
                    <a href="{{ path('budget_plan_fact', base_query|merge({show: 'all', period: period, layout: 'columns'})) }}"{% if by_columns %} class="active" aria-current="true"{% endif %}>Колонками</a>
                    <a href="{{ path('budget_plan_fact', base_query|merge({show: 'all', period: period, layout: 'rows'})) }}"{% if by_rows %} class="active" aria-current="true"{% endif %}>Строками</a>
                </div>
            {% endif %}
            <div class="vf-seg" role="group" aria-label="Показатель" data-pf-show>
                {% for key, label in show_labels %}
                    <a href="{{ path('budget_plan_fact', base_query|merge({show: key, period: period})) }}"{% if key == show %} class="active" aria-current="true"{% endif %}>{{ label }}</a>
                {% endfor %}
            </div>
        </div>
    {% endif %}
</div>
