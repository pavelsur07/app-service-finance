{% extends 'settlement/layout.html.twig' %}
{% block settlement_content %}
<div class="wz-head"><h1 class="wz-title">Документы взаиморасчётов</h1>{% if canWrite and book %}<a class="btn btn-md btn-primary" href="{{ path('settlement_document_new') }}">Новый документ</a>{% endif %}</div>
<section class="card report-scroll" tabindex="0" role="region" aria-label="Список документов взаиморасчётов"><table class="t-table"><thead><tr><th scope="col">Дата / номер</th><th scope="col">Контрагент</th><th scope="col">Вид</th><th scope="col">Основание</th><th scope="col" class="t-cell--right">Сумма, ₽</th><th scope="col">Статус</th></tr></thead><tbody>
{% for document in documents %}<tr><td><a href="{{ path('settlement_document',{id:document.id}) }}">{{ document.effectiveDate|date('d.m.Y') }} · {{ document.eventSequence ? '№' ~ document.eventSequence : 'Без номера' }}</a></td><td><a href="{{ path('settlement_card',{id:document.counterpartyId}) }}">{{ labels[document.counterpartyId]|default('Контрагент недоступен') }}</a></td><td>{{ kindLabels[document.kind.value] }}</td><td>{{ document.reason }}</td><td class="t-cell--right">{{ document.amount.toDecimalString|vf_amount(2) }}</td><td>{% if reversalIds[document.id] is defined %}<a href="{{ path('settlement_document',{id:reversalIds[document.id]}) }}">Отменён</a>{% else %}{{ document.status.value == 'draft' ? 'Черновик' : 'Проведён' }}{% endif %}</td></tr>{% else %}<tr><td colspan="6">Документов пока нет. Начните с настройки учёта или создайте основание долга.</td></tr>{% endfor %}
</tbody></table></section>{% include 'app/_ui/_pagination.html.twig' with {pager:pager} %}
{% endblock %}
