{% extends 'settlement/layout.html.twig' %}
{% form_theme form 'settlement/_form_theme.html.twig' %}
{% block settlement_header %}
<div class="vf-ops-head"><h1>{{ title }}</h1></div>
{% endblock %}
{% block settlement_content %}

<section class="card-body settlement-form"><p class="text-secondary">{{ description }}</p>
    {% if relatedDocument is defined %}<p><a href="{{ path('settlement_document',{id:relatedDocument.id}) }}">Исходный документ{% if relatedDocument.eventSequence %} №{{ relatedDocument.eventSequence }}{% endif %}</a></p>{% endif %}
    {{ form_start(form) }}{{ form_errors(form) }}<fieldset aria-label="Реквизиты документа"{% if not is_granted('module.finance.write') %} disabled{% endif %}>{% include form.counterpartyId is defined ? 'settlement/_document_fields.html.twig' : 'settlement/_event_fields.html.twig' %}
    <div class="btn-list settlement-form-actions">{% if is_granted('module.finance.write') %}<button class="btn btn-primary" type="submit">{{ submitLabel }}</button>{% endif %}<a class="btn btn-outline-secondary" href="{{ path('settlement_documents') }}">К документам</a></div></fieldset>{{ form_end(form) }}
</section>
{% endblock %}
