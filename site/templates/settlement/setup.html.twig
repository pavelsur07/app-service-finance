{% extends 'settlement/layout.html.twig' %}
{% form_theme form 'settlement/_form_theme.html.twig' %}
{% block settlement_header %}
<div class="vf-ops-head"><h1>Начало учёта взаиморасчётов</h1></div>
{% endblock %}
{% block settlement_content %}

<section class="card-body settlement-form">
    <p>Учёт ведётся в рублях. На выбранную дату внесите долги и подтверждённые авансы отдельными документами начальных остатков. Старые ДДС и ОПиУ автоматически не включаются.</p>
    {% if book %}<p>Дата начала зафиксирована: {{ book.startDate|date('d.m.Y') }}. Её нельзя изменить после настройки.</p>{% endif %}
    {{ form_start(form) }}{{ form_errors(form) }}{{ form_row(form.startDate) }}
    {% if not book and is_granted('module.finance.write') %}<button class="btn btn-primary" type="submit">Сохранить дату начала</button>{% endif %}{{ form_end(form) }}
    {% if book and is_granted('module.finance.write') %}<a class="btn btn-outline-secondary" href="{{ path('settlement_document_new') }}">Ввести начальные остатки</a>{% endif %}
</section>
{% endblock %}
