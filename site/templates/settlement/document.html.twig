{% extends 'settlement/layout.html.twig' %}
{% block settlement_content %}
<div class="wz-head"><h1 class="wz-title">{{ kindLabels[document.kind.value] }}{% if document.eventSequence %} №{{ document.eventSequence }}{% endif %}</h1></div>
<section class="card"><dl><dt>Контрагент</dt><dd><a href="{{ path('settlement_card',{id:document.counterpartyId}) }}">{{ counterpartyName }}</a></dd><dt>Дата</dt><dd>{{ document.effectiveDate|date('d.m.Y') }}</dd><dt>Показатель</dt><dd>{{ bucketLabels[document.bucket.value] }}</dd><dt>Сумма</dt><dd>{{ document.amount.toDecimalString|vf_money(2,'RUB') }}</dd><dt>Срок оплаты</dt><dd>{{ document.dueDate ? document.dueDate|date('d.m.Y') : 'Не указан' }}</dd><dt>Основание / причина</dt><dd>{{ document.reason }}</dd><dt>Статус</dt><dd>{{ document.status.value == 'draft' ? 'Черновик: в остатках не учитывается' : 'Проведён' }}</dd></dl>
{% if reversal %}<p>Отменён с {{ reversal.effectiveDate|date('d.m.Y') }}. <a href="{{ path('settlement_document',{id:reversal.id}) }}">Открыть отмену</a></p>{% endif %}
{% if position %}<p>Свободный остаток сейчас: {{ position.available.toDecimalString|vf_money(2,'RUB') }}.{% if position.available.zero %} {{ document.kind.value == 'payment' ? 'Оплата полностью распределена.' : 'Остаток закрыт.' }}{% endif %}</p>{% endif %}
{% if obligationDocument %}<p><a href="{{ path('settlement_document',{id:obligationDocument}) }}">Основание задолженности</a></p>{% endif %}
{% if paymentDocument %}<p><a href="{{ path('settlement_document',{id:paymentDocument}) }}">Документ оплаты</a></p>{% endif %}
{% if document.reversedDocumentId %}<p><a href="{{ path('settlement_document',{id:document.reversedDocumentId}) }}">Исходный документ</a></p>{% endif %}
{% if document.sourceId and document.sourceType.value in ['cash','finance'] %}<p><a href="{{ path(document.sourceType.value == 'cash' ? 'cash_transaction_show' : 'document_show',{id:document.sourceId}) }}">Источник {{ document.sourceType.value == 'cash' ? 'ДДС' : 'ОПиУ' }}</a></p>{% endif %}
{% if canWrite %}<div class="wz-row-actions">
    {% if position and position.available.positive and position.bucket.value in ['advance_given','advance_received','unallocated_out','unallocated_in'] %}<a class="btn btn-md btn-secondary" href="{{ path('settlement_payment_classify',{id:position.itemId}) }}">Классификация оплаты</a>{% endif %}
    {% if document.status.value == 'draft' %}<form method="post" action="{{ path('settlement_document_post',{id:document.id}) }}"><input type="hidden" name="_token" value="{{ csrf_token('settlement_post' ~ document.id) }}"><input type="hidden" name="version" value="{{ document.version }}"><button class="btn btn-md btn-primary" type="submit">Провести документ</button></form>
    {% elseif not reversal and not document.reversedDocumentId %}<a class="btn btn-md btn-secondary" href="{{ path(allocation ? 'settlement_allocation_reverse' : 'settlement_document_reverse',{id:allocation ? allocation.id : document.id}) }}">Отменить с датой и причиной</a>{% endif %}
</div>{% endif %}</section>
{% if movements %}<section class="card report-scroll" tabindex="0" role="region" aria-label="Изменения документа"><h2>Изменения остатков</h2><table class="t-table"><thead><tr><th scope="col">Показатель</th><th scope="col" class="t-cell--right">Изменение, ₽</th></tr></thead><tbody>{% for movement in movements %}<tr><th scope="row">{{ bucketLabels[movement.bucket.value] }}</th><td class="t-cell--right">{{ movement.delta.toDecimalString|vf_amount(2,signed:true) }}</td></tr>{% endfor %}</tbody></table></section>{% endif %}
{% endblock %}
