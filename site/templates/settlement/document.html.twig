{% extends 'settlement/layout.html.twig' %}
{% block settlement_header %}
<div class="vf-ops-head"><h1>{{ kindLabels[document.kind.value] }}{% if document.eventSequence %} №{{ document.eventSequence }}{% endif %}</h1></div>
{% endblock %}
{% block settlement_content %}

<section class="card-body"><dl class="row settlement-metadata"><dt class="col-sm-4 text-secondary">Контрагент</dt><dd class="col-sm-8"><a href="{{ path('settlement_card', {id: document.counterpartyId}) }}">{{ counterpartyName }}</a></dd><dt class="col-sm-4 text-secondary">Дата</dt><dd class="col-sm-8">{{ document.effectiveDate|date('d.m.Y') }}</dd><dt class="col-sm-4 text-secondary">Показатель</dt><dd class="col-sm-8">{{ bucketLabels[document.bucket.value] }}</dd><dt class="col-sm-4 text-secondary">Сумма</dt><dd class="col-sm-8">{{ document.amount.toDecimalString|vf_money(2, 'RUB') }}</dd><dt class="col-sm-4 text-secondary">Срок оплаты</dt><dd class="col-sm-8">{{ document.dueDate ? document.dueDate|date('d.m.Y') : 'Не указан' }}</dd><dt class="col-sm-4 text-secondary">Основание / причина</dt><dd class="col-sm-8">{{ document.reason }}</dd><dt class="col-sm-4 text-secondary">Статус</dt><dd class="col-sm-8">{% include 'settlement/_status.html.twig' with {status: document.status.value, reversalUrl: reversal ? path('settlement_document', {id: reversal.id}) : null} only %}{% if document.status.value == 'draft' %}<span class="text-secondary ms-2">В остатках не учитывается</span>{% endif %}</dd></dl>
{% if reversal %}<p>Отменён с {{ reversal.effectiveDate|date('d.m.Y') }}. <a href="{{ path('settlement_document', {id: reversal.id}) }}">Открыть отмену</a></p>{% endif %}
{% if position %}<p>Свободный остаток сейчас: {{ position.available.toDecimalString|vf_money(2, 'RUB') }}.{% if position.available.zero %} {{ document.kind.value == 'payment' ? 'Оплата полностью распределена.' : 'Остаток закрыт.' }}{% endif %}</p>{% endif %}
{% if obligationDocument %}<p><a href="{{ path('settlement_document', {id: obligationDocument}) }}">Основание задолженности</a></p>{% endif %}
{% if paymentDocument %}<p><a href="{{ path('settlement_document', {id: paymentDocument}) }}">Документ оплаты</a></p>{% endif %}
{% if document.reversedDocumentId %}<p><a href="{{ path('settlement_document', {id: document.reversedDocumentId}) }}">Исходный документ</a></p>{% endif %}
{% if document.sourceId and document.sourceType.value in ['cash', 'finance'] %}<p><a href="{{ path(document.sourceType.value == 'cash' ? 'cash_transaction_show' : 'document_show', {id: document.sourceId}) }}">Источник {{ document.sourceType.value == 'cash' ? 'ДДС' : 'ОПиУ' }}</a></p>{% endif %}
{% if canWrite %}<div class="btn-list mt-4">
    {% if position and position.available.positive and position.bucket.value in ['advance_given', 'advance_received', 'unallocated_out', 'unallocated_in'] %}<a class="btn btn-outline-secondary" href="{{ path('settlement_payment_classify', {id: position.itemId}) }}">Классификация оплаты</a>{% endif %}
    {% if document.status.value == 'draft' %}<form method="post" action="{{ path('settlement_document_post', {id: document.id}) }}"><input type="hidden" name="_token" value="{{ csrf_token('settlement_post' ~ document.id) }}"><input type="hidden" name="version" value="{{ document.version }}"><button class="btn btn-primary" type="submit">Провести документ</button></form>
    {% elseif not reversal and not document.reversedDocumentId %}<a class="btn btn-outline-secondary" href="{{ path(allocation ? 'settlement_allocation_reverse' : 'settlement_document_reverse', {id: allocation ? allocation.id : document.id}) }}">Отменить с датой и причиной</a>{% endif %}
</div>{% endif %}</section>
{% if movements %}<section class="border-top"><div class="card-header"><h2 class="card-title">Изменения остатков</h2></div><div class="table-responsive" tabindex="0" role="region" aria-label="Изменения документа"><table class="table card-table table-vcenter vf-ops-table"><thead><tr><th scope="col">Показатель</th><th scope="col" class="text-end text-nowrap">Изменение, ₽</th></tr></thead><tbody>{% for movement in movements %}<tr><th scope="row">{{ bucketLabels[movement.bucket.value] }}</th><td class="text-end text-nowrap">{{ movement.delta.toDecimalString|vf_amount(2, signed:true) }}</td></tr>{% endfor %}</tbody></table></div></section>{% endif %}
{% endblock %}
