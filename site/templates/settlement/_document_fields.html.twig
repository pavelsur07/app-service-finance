<section class="dds-card" aria-labelledby="settlement-party-title"><h2 class="dds-card__title" id="settlement-party-title">Контрагент и документ</h2><div class="card-body">
    {{ form_row(form.counterpartyId) }}
    <div class="row"><div class="col-md-6">{{ form_row(form.kind) }}</div><div class="col-md-6">{{ form_row(form.bucket) }}</div></div>
</div></section>
<section class="dds-card" aria-labelledby="settlement-amount-title"><h2 class="dds-card__title" id="settlement-amount-title">Сумма и даты</h2><div class="card-body">
    <div class="row"><div class="col-md-6">{{ form_row(form.amount) }}</div><div class="col-md-6">{{ form_row(form.effectiveDate) }}</div><div class="col-md-6">{{ form_row(form.dueDate) }}</div></div>
</div></section>
<section class="dds-card" aria-labelledby="settlement-reason-title"><h2 class="dds-card__title" id="settlement-reason-title">Основание</h2><div class="card-body">{{ form_row(form.reason) }}</div></section>
