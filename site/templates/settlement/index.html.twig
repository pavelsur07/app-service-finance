{% extends 'settlement/layout.html.twig' %}
{% block settlement_content %}
<div class="wz-head"><h1 class="wz-title">Взаиморасчёты<span class="wz-sub">Долги, авансы и нераспределённые оплаты по контрагентам</span></h1>
{% if canWrite and book %}<a class="btn btn-md btn-primary" href="{{ path('settlement_document_new') }}">Новый документ</a>{% endif %}</div>
{% if not book %}
    <section class="card empty"><h2 class="empty-title">Учёт ещё не начат</h2><p class="empty-text">Укажите дату начала и внесите начальные остатки. Документы ОПиУ сами по себе не меняют задолженность.</p>
    {% if canWrite %}<a class="btn btn-md btn-primary" href="{{ path('settlement_setup') }}">Начать учёт</a>{% else %}<p>Настроить учёт может пользователь с правом изменения финансов.</p>{% endif %}</section>
{% else %}
    {% include 'settlement/_filter.html.twig' %}
    {% if report %}
        {% include 'settlement/_summary.html.twig' with {balances: report.totals.closing} only %}
        <p>Просрочено: {{ report.totals.overdue.toDecimalString|vf_money(2, 'RUB') }}. Без срока оплаты: {{ report.totals.withoutDueDate.toDecimalString|vf_money(2, 'RUB') }}. Итоги по всей выборке.</p>
        {% if report.total == 0 %}<section class="card empty"><h2 class="empty-title">Пока нет движений</h2><p class="empty-text">Создайте основание долга или включите оплату из карточки операции ДДС.</p></section>{% else %}
        <div class="card report-scroll" tabindex="0" role="region" aria-label="Остатки по контрагентам">
            <table class="t-table"><caption class="sr-only">Остатки на конец выбранного периода, рубли</caption><thead><tr><th scope="col">Контрагент</th>{% for field, label in {receivable: 'Нам должны', payable: 'К оплате', advanceGiven: 'Выданные авансы', advanceReceived: 'Полученные авансы', unallocatedOut: 'Нераспределённые выплаты', unallocatedIn: 'Нераспределённые поступления'} %}<th scope="col" class="t-cell--right">{{ label }}, ₽</th>{% endfor %}</tr></thead>
            <tbody>{% for row in report.rows %}<tr><th scope="row"><a href="{{ path('settlement_card', {id: row.counterpartyId}) }}">{{ row.counterpartyName }}</a></th>{% for field in ['receivable', 'payable', 'advanceGiven', 'advanceReceived', 'unallocatedOut', 'unallocatedIn'] %}<td class="t-cell--right">{{ attribute(row.closing, field).toDecimalString|vf_amount(2) }}</td>{% endfor %}</tr>{% endfor %}</tbody></table>
        </div>{% include 'app/_ui/_pagination.html.twig' with {pager: pager} %}
        {% endif %}
    {% endif %}
{% endif %}
{% endblock %}
