{# Блок «Консолидация» карточки компании: головная компания группы и состав из компаний кабинета (cashflow-group-chart, этап 1b). #}
{% set own = consolidation[company.id] ?? null %}
<div class="card mt-3" id="consolidation">
    <div class="card-header"><b>Консолидация</b></div>
    <div class="card-body">
        {% if own and own.companyId != own.headCompanyId %}
            <p class="mb-0">
                Входит в группу компании «{{ cabinetNames[own.headCompanyId] ?? 'другого владельца' }}».
                Состав группы меняется в настройках головной компании.
            </p>
        {% else %}
            <form method="post" action="{{ path('company_consolidation_save', {id: company.id}) }}">
                <input type="hidden" name="_token" value="{{ csrf_token('consolidation' ~ company.id) }}">
                <label class="form-check mb-2">
                    <input class="form-check-input" type="checkbox" name="enabled" value="1" {{ own ? 'checked' }}>
                    <span class="form-check-label">Головная компания группы</span>
                </label>
                <div class="form-hint mb-3">
                    Дерево статей ДДС головной компании — эталон группы. Отмеченные компании войдут в консолидированную отчётность.
                </div>
                {% set others = cabinetNames|filter((name, id) => id != company.id) %}
                {% if others is empty %}
                    <p class="text-secondary">В кабинете нет других компаний.</p>
                {% else %}
                    <div class="mb-3">
                        {% for id, name in others %}
                            {% set row = consolidation[id] ?? null %}
                            {% set foreign = row and row.headCompanyId != company.id %}
                            <label class="form-check">
                                <input class="form-check-input" type="checkbox" name="members[]" value="{{ id }}"
                                       {{ row and not foreign ? 'checked' }} {{ foreign ? 'disabled' }}>
                                <span class="form-check-label">
                                    {{ name }}
                                    {% if foreign %}
                                        <span class="text-secondary">— {{ row.companyId == row.headCompanyId ? 'головная своей группы' : 'в группе «' ~ (cabinetNames[row.headCompanyId] ?? '') ~ '»' }}</span>
                                    {% endif %}
                                </span>
                            </label>
                        {% endfor %}
                    </div>
                {% endif %}
                <button class="btn btn-primary" type="submit">Сохранить группу</button>
            </form>
        {% endif %}
    </div>
</div>
