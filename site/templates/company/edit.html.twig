{% extends 'base.html.twig' %}
{% block title %}Настройки компании · {{ company.name }}{% endblock %}

{% block content %}
<div class="vf-page-head">
    <div class="vf-page-head__title">
        <nav aria-label="Путь">
            <ol class="breadcrumb">
                <li class="breadcrumb-item">Компания и доступы</li>
                <li class="breadcrumb-item"><a href="{{ path('company_index') }}">Компании</a></li>
                <li class="breadcrumb-item active" aria-current="page">Настройки</li>
            </ol>
        </nav>
        <h1 class="text-break">{{ company.name }}</h1>
    </div>
</div>

<div class="card vf-card mb-4" data-company-edit-tabs>
    <div class="card-header">
        {% include 'partials/_tabs.html.twig' with {class: 'card-header-tabs m-0 p-0 bg-transparent', label: 'Настройки компании', tabs: [
            {label: 'Компания', pane: 'company', active: true},
            {label: 'Налоги', pane: 'taxes'},
            {label: 'Консолидация', pane: 'consolidation'},
        ]} only %}
    </div>
    <div data-company-edit-panels>
        <section id="company" class="tab-pane active" role="tabpanel" aria-labelledby="tab-company" tabindex="0">
            <div class="card-body">
                {{ form_start(form, {attr: {class: 'vf-form'}}) }}
                {{ form_errors(form) }}
                {{ form_row(form.name) }}
                {{ form_row(form.inn) }}
                {{ form_row(form.financeLockBefore) }}
                {{ form_row(form.businessProfile) }}
                <fieldset class="mb-3">
                    <legend class="form-label">Минимальный остаток</legend>
                    {{ form_errors(form.minimumBalance) }}
                    <div class="row g-2">
                        <div class="col-md-8">{{ form_row(form.minimumBalance.amount) }}</div>
                        <div class="col-md-4">{{ form_row(form.minimumBalance.currency) }}</div>
                    </div>
                </fieldset>
                <button type="submit" class="btn btn-primary">Сохранить</button>
                {{ form_end(form) }}
            </div>

            <section class="card-body border-top" aria-labelledby="balance-recalc-heading">
                <h2 id="balance-recalc-heading" class="card-title">Пересчёт остатков по операциям и счетам</h2>
                <form method="post" action="{{ path('report_account_balances_recalc') }}" class="row g-3 align-items-end">
                    <input type="hidden" name="_token" value="{{ csrf_token('recalc_balances') }}">
                    <input type="hidden" name="backDate" value="{{ 'now'|date('Y-m-d') }}">

                    <div class="col-md-4">
                        <label class="form-label" for="recalc_from">С даты</label>
                        <input type="date" id="recalc_from" name="from" class="form-control"
                               value="{{ company.financeLockBefore ? company.financeLockBefore|date('Y-m-d') : 'now'|date('Y-m-01') }}" required>
                    </div>
                    <div class="col-md-4">
                        <label class="form-label" for="recalc_to">По дату</label>
                        <input type="date" id="recalc_to" name="to" class="form-control"
                               value="{{ 'now'|date('Y-m-d') }}" required>
                    </div>
                    <div class="col-md-4">
                        <button type="submit" class="btn w-100">Пересчитать остатки</button>
                    </div>
                </form>
            </section>
        </section>

        {% include 'company/_taxes_card.html.twig' with {company: company, taxProfiles: taxProfiles, taxProfileForm: taxProfileForm} only %}
        {% include 'company/_consolidation_card.html.twig' with {company: company, consolidation: consolidation, cabinetNames: cabinetNames} only %}
    </div>
</div>
{% include 'partials/_confirm_modal.html.twig' with {id: 'company-confirm'} only %}
{% endblock %}
