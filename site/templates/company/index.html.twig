{% extends 'base.html.twig' %}
{% block title %}Компании{% endblock %}
{% block body %}
    {% embed 'partials/_page_header.html.twig' with {title: 'Компании'} %}
        {% block actions %}
            <a href="{{ path('company_new') }}" class="btn btn-primary">
                + Добавить компанию
            </a>
        {% endblock %}
    {% endembed %}
    <div class="container-xl mt-3">
        <div class="card">
            <div class="card-body">
                <table class="table table-vcenter">
                    <thead>
                    <tr>
                        <th>Наименование</th>
                        <th>Wildberries API</th>
                        <th>Ozon Seller ID</th>
                        <th>Ozon API</th>
                        <th></th>
                    </tr>
                    </thead>
                    <tbody>
                    {% for company in companies %}
                        <tr>
                            <td>
                                <a href="{{ path('company_edit', {'id': company.id}) }}">{{ company.name }}</a>
                            </td>
                            <td>
                                <span class="badge bg-red-lt">Нет</span>
                            </td>
                            <td>
                                <span class="badge bg-red-lt">Нет</span>
                            </td>
                            <td>
                                <span class="badge bg-red-lt">Нет</span>
                            </td>
                            <td>
                                <a href="{{ path('company_edit', {'id': company.id}) }}" class="btn btn-sm btn-warning">✏️</a>
                                <a href="{{ path('company_delete', {'id': company.id}) }}" class="btn btn-sm btn-danger" title="Удалить">🗑</a>
                            </td>
                        </tr>
                    {% else %}
                        <tr><td colspan="5" class="text-center">Нет компаний.</td></tr>
                    {% endfor %}
                    </tbody>
                </table>
            </div>
        </div>
        {% if deletionRequested is not empty %}
            <div class="card mt-3">
                <div class="card-header"><b>Будут удалены</b></div>
                <div class="card-body">
                    <table class="table table-vcenter">
                        <thead>
                        <tr>
                            <th>Наименование</th>
                            <th>Данные будут удалены</th>
                            <th></th>
                        </tr>
                        </thead>
                        <tbody>
                        {% for company in deletionRequested %}
                            <tr>
                                <td>{{ company.name }}</td>
                                <td>{{ company.deletionDueAt|date('d.m.Y') }}</td>
                                <td>
                                    <form method="post" action="{{ path('company_restore', {'id': company.id}) }}" style="display:inline;">
                                        <input type="hidden" name="_token" value="{{ csrf_token('restore' ~ company.id) }}">
                                        <button class="btn btn-sm btn-outline-primary">Восстановить</button>
                                    </form>
                                </td>
                            </tr>
                        {% endfor %}
                        </tbody>
                    </table>
                </div>
            </div>
        {% endif %}
    </div>
{% endblock %}
