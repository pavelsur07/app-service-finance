{# Вкладка «Налоги». Параметры: company, taxProfiles, taxProfileForm. #}
<section id="taxes" class="tab-pane" role="tabpanel" aria-labelledby="tab-taxes" tabindex="0">
    <div class="card-body">
        {% if taxProfiles is empty %}
            <p class="text-warning mb-3">
                <i class="ti ti-alert-triangle" aria-hidden="true"></i>
                Налоговый режим не выбран — НДС в операциях не выделяется.
            </p>
        {% else %}
            <div class="table-responsive mb-3" tabindex="0" role="region" aria-label="Периоды налогового режима">
                <table class="table table-vcenter vf-table">
                    <thead>
                    <tr>
                        <th scope="col">Действует</th>
                        <th scope="col">Режим налогообложения</th>
                        <th scope="col">НДС</th>
                        <th scope="col">Ставка налога</th>
                        <th scope="col" class="w-1" aria-label="Действия"></th>
                    </tr>
                    </thead>
                    <tbody>
                    {% for profile in taxProfiles %}
                        {% set next = taxProfiles[loop.index] ?? null %}
                        <tr>
                            <td>
                                {{ profile.validFrom ? 'с ' ~ profile.validFrom|date('m.Y') : 'с начала учёта' }}
                                {% if next %}<span class="text-secondary">по {{ next.validFrom|date_modify('-1 day')|date('m.Y') }}</span>{% endif %}
                            </td>
                            <td>{{ profile.taxRegime.label }}</td>
                            <td>{{ profile.vatMode.label }}</td>
                            <td>{{ profile.taxRatePercent is null ? '—' : profile.taxRatePercent|replace({'.00': '', '.': ','}) ~ '%' }}</td>
                            <td>
                                <button type="button" class="btn btn-sm btn-ghost-danger"
                                        data-bs-toggle="modal" data-bs-target="#company-confirm"
                                        data-confirm-action="{{ path('company_tax_profile_delete', {id: company.id, profileId: profile.id}) }}"
                                        data-confirm-token="{{ csrf_token('delete_tax_profile' ~ profile.id) }}"
                                        data-confirm-title="Удалить период налогового режима?"
                                        data-confirm-submit="Удалить" data-confirm-variant="danger">Удалить</button>
                            </td>
                        </tr>
                    {% endfor %}
                    </tbody>
                </table>
            </div>
        {% endif %}

        <h2 class="card-title mb-2">{{ taxProfiles is empty ? 'Указать режим' : 'Изменить с месяца' }}</h2>
        {{ form_start(taxProfileForm, {attr: {class: 'vf-form'}}) }}
        {% include 'company/_tax_profile_fields.html.twig' with {tax_form: taxProfileForm} only %}
        <div class="form-hint mb-2">
            Сохранённые операции не пересчитываются: новый режим применяется к операциям, которые создаются или изменяются после сохранения.
        </div>
        <button class="btn btn-primary" type="submit">Сохранить режим</button>
        {{ form_end(taxProfileForm) }}
    </div>
</section>
