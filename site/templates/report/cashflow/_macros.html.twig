{# Макросы отчёта ДДС: суммы, рекурсивная строка статьи, строки матрицы Проект × ЦФО. #}
{# DS-Money: приход — зелёный, расход и отрицательное сальдо — основной цвет с U+2212, ноль приглушён. #}
{% macro format_amount(value) %}
    {{ value|vf_amount(2, value > 0 ? 'income' : null) }}
{% endmacro %}

{% macro category_toggle(name) %}
    <button type="button" class="cf-toggle border-0 bg-transparent p-0 text-reset" aria-label="{{ name }}" aria-expanded="false">▶</button>
{% endmacro %}

{# drill: {base, periods, from}; base = null — суммы без ссылок. Ссылка ведёт в «Транзакции ДДС»
   с фильтрами ячейки; JS отчёта открывает её двойным кликом. #}
{% macro render_category(cat, totals, currency, periodCount, parentId, drill) %}
{% set hasChildren = cat.children|length > 0 %}
{% set hidden = cat.level >= 2 %}
<tr data-id="{{ cat.id }}" data-parent="{{ parentId }}" data-level="{{ cat.level }}"{% if hidden %} hidden{% endif %}>
    <td style="padding-left: {{ (cat.level - 1) * 20 }}px;">
        <div class="d-flex align-items-center">
            {%- if hasChildren -%}
                {{ _self.category_toggle(cat.name) }}
            {%- else -%}
                <span class="cf-toggle-spacer"></span>
            {%- endif -%}
            <span class="text-truncate" title="{{ cat.name }}">{{ cat.name }}</span>
        </div>
    </td>
    {% for i in 0..periodCount - 1 %}
        {% set val = totals[cat.id].totals[currency][i] ?? 0 %}
        {% if drill.base is not null and val != 0 %}
            {% set period = drill.periods[i] %}
            {% set href = path('cash_transaction_index', drill.base|merge({
                categoryId: cat.id,
                dateFrom: (period.start < drill.from ? drill.from : period.start)|date('Y-m-d'),
                dateTo: period.end|date('Y-m-d'),
                currency: currency
            })|merge(hasChildren ? {includeChildren: 1} : {})) %}
            <td class="text-end cf-drill" title="Двойной клик — операции"><a href="{{ href }}" class="cf-drill-link" data-cf-drill>{{ _self.format_amount(val)|raw }}</a></td>
        {% else %}
            <td class="text-end">{{ _self.format_amount(val)|raw }}</td>
        {% endif %}
    {% endfor %}
</tr>
{% for child in cat.children %}
    {{ _self.render_category(child, totals, currency, periodCount, cat.id, drill) }}
{% endfor %}
{% endmacro %}

{% macro center_label(row, centerLabels) %}
    {{ row.responsibility_center_name ?? centerLabels[row.responsibility_center_id]|default(row.responsibility_center_id) }}
{% endmacro %}

{% macro render_project_center_rows(rows, currency, periods, primary, centerLabels) %}
    {% for row in rows %}
        {% set vals = row.totals[currency]|default([]) %}
        {% if vals is not empty %}
            <tr>
                {% if primary == 'center' %}
                    <td>{{ _self.center_label(row, centerLabels) }}</td>
                    <td>{{ row.project_name }}</td>
                {% else %}
                    <td>{{ row.project_name }}</td>
                    <td>{{ _self.center_label(row, centerLabels) }}</td>
                {% endif %}
                {% for i, p in periods %}
                    <td class="text-end">{{ _self.format_amount(vals[i]|default(0))|raw }}</td>
                {% endfor %}
            </tr>
        {% endif %}
    {% endfor %}
{% endmacro %}
