{#
  Матрица Проект × ЦФО по валютам (ЦФО → проекты, Проект → ЦФО).
  Параметры: projectCenterMatrix, periods, responsibilityCenters.
#}
{% import 'report/cashflow/_macros.html.twig' as macros %}
{% set responsibilityCenterLabels = {} %}
{% for center in responsibilityCenters|default([]) %}
    {% set responsibilityCenterLabels = responsibilityCenterLabels|merge({(center.id): center.name}) %}
{% endfor %}

{% if projectCenterMatrix.rowsByCenter|default([]) is not empty %}
    {% for currency in projectCenterMatrix.currencies %}
        <div class="card mb-4">
            <div class="card-header">
                <h3 class="card-title">Матрица Проект × ЦФО: {{ currency }}</h3>
            </div>
            <div class="card-body">
                <h4>ЦФО → проекты</h4>
                <div class="table-responsive mb-4">
                    <table class="table table-sm table-bordered table-striped">
                        <thead>
                            <tr>
                                <th>ЦФО</th>
                                <th>Проект</th>
                                {% for p in periods %}
                                    <th>{{ p.label }}</th>
                                {% endfor %}
                            </tr>
                        </thead>
                        <tbody>
                            {{ macros.render_project_center_rows(projectCenterMatrix.rowsByCenter, currency, periods, 'center', responsibilityCenterLabels) }}
                        </tbody>
                    </table>
                </div>

                <h4>Проект → ЦФО</h4>
                <div class="table-responsive">
                    <table class="table table-sm table-bordered table-striped">
                        <thead>
                            <tr>
                                <th>Проект</th>
                                <th>ЦФО</th>
                                {% for p in periods %}
                                    <th>{{ p.label }}</th>
                                {% endfor %}
                            </tr>
                        </thead>
                        <tbody>
                            {{ macros.render_project_center_rows(projectCenterMatrix.rowsByProject, currency, periods, 'project', responsibilityCenterLabels) }}
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    {% endfor %}
{% endif %}
