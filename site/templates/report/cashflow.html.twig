{% extends 'base.html.twig' %}

{#{% block breadcrumbs %}
    {% include 'partials/_breadcrumbs.html.twig' with {
        breadcrumbs: [
            {'label': 'Главная', 'path': 'app_home_index'},
            {'label': 'Финансы'},
            {'label': 'Отчет ДДС', 'path': 'report_cashflow_index'}
        ]
    } %}
{% endblock %}#}

{% block content %}
{% set available_project_ids = [] %}
{% set dashboard_reconciliation = dashboardReconciliation|default(null) %}
{% set dashboard_reconciliation_active = dashboard_reconciliation is not null %}
{% set dashboard_activity_labels = {
    'operating': 'Операционная деятельность',
    'financing': 'Финансовая деятельность',
    'investing': 'Инвестиционная деятельность',
    'all': 'Все виды деятельности'
} %}
{% for project_direction in projectDirections|default([]) %}
    {% set available_project_ids = available_project_ids|merge([project_direction.id]) %}
{% endfor %}
{% set available_responsibility_center_ids = [] %}
{% for responsibility_center in responsibilityCenters|default([]) %}
    {% set available_responsibility_center_ids = available_responsibility_center_ids|merge([responsibility_center.id]) %}
{% endfor %}
{% set submitted_project_ids = selectedProjectDirectionIds ?? available_project_ids %}
{% set submitted_responsibility_center_ids = selectedResponsibilityCenterIds ?? available_responsibility_center_ids %}
{% set project_filter_tracked = not dashboard_reconciliation_active and (available_project_ids is not empty or selectedProjectDirectionIds is not null) %}
{% set responsibility_center_filter_tracked = not dashboard_reconciliation_active and (available_responsibility_center_ids is not empty or selectedResponsibilityCenterIds is not null) %}
{% set project_filter_active = not dashboard_reconciliation_active and selectedProjectDirectionIds is not null %}
{% set responsibility_center_filter_active = not dashboard_reconciliation_active and selectedResponsibilityCenterIds is not null %}
{% set filters_active = project_filter_active or responsibility_center_filter_active %}
{% set legacy_responsibility_center_filter = legacyResponsibilityCenterFilter|default(false) %}

{% set reset_state = {
    'from': date_from|date('Y-m-d'),
    'to': date_to|date('Y-m-d'),
    'group': group
} %}
{% if not dashboard_reconciliation_active and available_project_ids is not empty %}
    {% set reset_state = reset_state|merge({
        'projectFiltersPresent': 1,
        'projectDirectionIds': available_project_ids
    }) %}
{% endif %}
{% if not dashboard_reconciliation_active and available_responsibility_center_ids is not empty %}
    {% set reset_state = reset_state|merge({
        'responsibilityCenterFiltersPresent': 1,
        'responsibilityCenterIds': available_responsibility_center_ids
    }) %}
{% endif %}

{% set export_state = {
    'from': date_from|date('Y-m-d'),
    'to': date_to|date('Y-m-d'),
    'group': group
} %}
{% if dashboard_reconciliation_active %}
    {% set export_state = export_state|merge({
        'reconcile': dashboard_reconciliation.mode,
        'activity': dashboard_reconciliation.activity,
        'currency': dashboard_reconciliation.currency
    }) %}
{% elseif project_filter_tracked %}
    {% set export_state = export_state|merge({
        'projectFiltersPresent': 1,
        'projectDirectionIds': submitted_project_ids
    }) %}
{% endif %}
{% if not dashboard_reconciliation_active and legacy_responsibility_center_filter %}
    {% set export_state = export_state|merge({
        'responsibilityCenterId': selectedResponsibilityCenterId
    }) %}
{% elseif responsibility_center_filter_tracked %}
    {% set export_state = export_state|merge({
        'responsibilityCenterFiltersPresent': 1,
        'responsibilityCenterIds': submitted_responsibility_center_ids
    }) %}
{% endif %}

{% set month_names = {
    1: 'Январь', 2: 'Февраль', 3: 'Март', 4: 'Апрель',
    5: 'Май', 6: 'Июнь', 7: 'Июль', 8: 'Август',
    9: 'Сентябрь', 10: 'Октябрь', 11: 'Ноябрь', 12: 'Декабрь'
} %}
{% set from_year = date_from|date('Y') %}
{% set to_year = date_to|date('Y') %}
{% set from_month = date_from|date('n') %}
{% set to_month = date_to|date('n') %}
{% if from_year == to_year %}
    {% if from_month == to_month %}
        {% set report_period_label = month_names[from_month] ~ ' ' ~ from_year %}
    {% else %}
        {% set report_period_label = month_names[from_month] ~ ' – ' ~ month_names[to_month] ~ ' ' ~ to_year %}
    {% endif %}
{% else %}
    {% set report_period_label = month_names[from_month] ~ ' ' ~ from_year ~ ' – ' ~ month_names[to_month] ~ ' ' ~ to_year %}
{% endif %}
{% if dashboard_reconciliation_active %}
    {% set report_period_label = date_from|date('d.m.Y') ~ ' – ' ~ date_to|date('d.m.Y') %}
{% endif %}

<div class="page-header mb-3">
    <div class="row g-2 align-items-start">
        <div class="col">
            <h2 class="page-title">Отчёт о движении денежных средств</h2>
            <div class="text-secondary">{{ report_period_label }}</div>
            {% include 'company/_tax_profile_line.html.twig' %}
        </div>
        <div class="col-auto ms-auto d-print-none">
            <a
                href="{{ path('report_cashflow_export_json', export_state) }}"
                class="btn btn-outline-secondary"
                title="Скачать отчёт в формате JSON для проверки"
            >
                <i class="ti ti-download" aria-hidden="true"></i>
                JSON
            </a>
        </div>
    </div>
</div>

{% include 'report/cashflow/_filters.html.twig' with {
    date_from: date_from,
    date_to: date_to,
    group: group,
    dashboard_reconciliation_active: dashboard_reconciliation_active,
    dashboard_reconciliation: dashboard_reconciliation,
    project_filter_tracked: project_filter_tracked,
    project_filter_active: project_filter_active,
    selectedProjectDirectionIds: selectedProjectDirectionIds,
    projectDirections: projectDirections|default([]),
    responsibility_center_filter_tracked: responsibility_center_filter_tracked,
    responsibility_center_filter_active: responsibility_center_filter_active,
    selectedResponsibilityCenterIds: selectedResponsibilityCenterIds,
    selectedResponsibilityCenterId: selectedResponsibilityCenterId|default(null),
    responsibilityCenters: responsibilityCenters|default([]),
    legacy_responsibility_center_filter: legacy_responsibility_center_filter,
    filters_active: filters_active,
    reset_state: reset_state
} only %}

{% if dashboard_reconciliation_active %}
    {% include 'report/cashflow/_reconciliation.html.twig' with {
        dashboard_reconciliation: dashboard_reconciliation,
        dashboard_activity_labels: dashboard_activity_labels,
        date_from: date_from,
        date_to: date_to,
        reset_state: reset_state
    } only %}
{% endif %}

{% if filters_active %}
    <div class="alert alert-info">
        Фильтры Проекты и ЦФО применяются к операциям и строкам ДДС. Сальдо на начало и конец остаётся общим по компании, так как остатки по счетам не ведутся в этих разрезах.
    </div>
{% endif %}

{% set periodCount = periods|length %}

{% include 'report/cashflow/_table.html.twig' with {
    openings: openings,
    closings: closings,
    periods: periods,
    periodCount: periodCount,
    categories: categories,
    categoryTotals: categoryTotals
} only %}

{% include 'report/cashflow/_projects.html.twig' with {
    projectCenterMatrix: projectCenterMatrix|default(null),
    periods: periods,
    responsibilityCenters: responsibilityCenters|default([])
} only %}

{% endblock %}
