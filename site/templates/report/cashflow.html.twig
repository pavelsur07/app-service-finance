{% extends 'base.html.twig' %}

{% block stylesheets %}
    {{ parent() }}
    <style>
        /* Таблица ДДС: «Категория» закреплена слева, столбцы периодов фиксированной ширины.
           Селекторы .table.cf-table — чтобы правила не перебивались .table из app.css, который грузится ниже. */
        .table.cf-table {
            --cf-col-name: 280px;
            --cf-col-period: 120px;
            /* table-layout: fixed работает только при определённой ширине таблицы;
               при width:auto браузер молча откатывается на auto-раскладку.
               Ширину даёт .table (width:100%), а min-width задаётся инлайном по числу периодов. */
            table-layout: fixed;
        }
        .table.cf-table th,
        .table.cf-table td {
            white-space: nowrap;
        }
        .table.cf-table col.cf-col-name { width: var(--cf-col-name); }
        .table.cf-table col.cf-col-period { width: var(--cf-col-period); }
        .table.cf-table th:first-child,
        .table.cf-table td:first-child {
            position: sticky;
            left: 0;
            z-index: 2;
            background: var(--tblr-bg-surface);
            /* при border-collapse граница залипшей ячейки не рисуется поверх уезжающих — подменяем тенью */
            box-shadow: inset -1px 0 0 var(--tblr-border-color);
        }
        .table.cf-table .cf-toggle,
        .table.cf-table .cf-toggle-spacer {
            flex: none;
            width: 16px;
            margin-right: 4px;
            text-align: center;
        }
        .table.cf-table .cf-toggle { cursor: pointer; }

        {% include 'finance/report/_filter_controls_styles.html.twig' %}
    </style>
{% endblock %}

{#{% block breadcrumbs %}
    {% include 'partials/_breadcrumbs.html.twig' with {
        breadcrumbs: [
            {'label': 'Главная', 'path': 'app_home_index'},
            {'label': 'Финансы'},
            {'label': 'Отчет ДДС', 'path': 'report_cashflow_index'}
        ]
    } %}
{% endblock %}#}

{% block content %}
{% set available_project_ids = [] %}
{% for project_direction in projectDirections|default([]) %}
    {% set available_project_ids = available_project_ids|merge([project_direction.id]) %}
{% endfor %}
{% set available_responsibility_center_ids = [] %}
{% for responsibility_center in responsibilityCenters|default([]) %}
    {% set available_responsibility_center_ids = available_responsibility_center_ids|merge([responsibility_center.id]) %}
{% endfor %}
{% set submitted_project_ids = selectedProjectDirectionIds ?? available_project_ids %}
{% set submitted_responsibility_center_ids = selectedResponsibilityCenterIds ?? available_responsibility_center_ids %}
{% set project_filter_tracked = available_project_ids is not empty or selectedProjectDirectionIds is not null %}
{% set responsibility_center_filter_tracked = available_responsibility_center_ids is not empty or selectedResponsibilityCenterIds is not null %}
{% set project_filter_active = selectedProjectDirectionIds is not null %}
{% set responsibility_center_filter_active = selectedResponsibilityCenterIds is not null %}
{% set filters_active = project_filter_active or responsibility_center_filter_active %}
{% set legacy_responsibility_center_filter = legacyResponsibilityCenterFilter|default(false) %}

{% set reset_state = {
    'from': date_from|date('Y-m-d'),
    'to': date_to|date('Y-m-d'),
    'group': group
} %}
{% if available_project_ids is not empty %}
    {% set reset_state = reset_state|merge({
        'projectFiltersPresent': 1,
        'projectDirectionIds': available_project_ids
    }) %}
{% endif %}
{% if available_responsibility_center_ids is not empty %}
    {% set reset_state = reset_state|merge({
        'responsibilityCenterFiltersPresent': 1,
        'responsibilityCenterIds': available_responsibility_center_ids
    }) %}
{% endif %}

{% set export_state = {
    'from': date_from|date('Y-m-d'),
    'to': date_to|date('Y-m-d'),
    'group': group
} %}
{% if project_filter_tracked %}
    {% set export_state = export_state|merge({
        'projectFiltersPresent': 1,
        'projectDirectionIds': submitted_project_ids
    }) %}
{% endif %}
{% if legacy_responsibility_center_filter %}
    {% set export_state = export_state|merge({
        'responsibilityCenterId': selectedResponsibilityCenterId
    }) %}
{% elseif responsibility_center_filter_tracked %}
    {% set export_state = export_state|merge({
        'responsibilityCenterFiltersPresent': 1,
        'responsibilityCenterIds': submitted_responsibility_center_ids
    }) %}
{% endif %}

{% set month_names = {
    1: 'Январь', 2: 'Февраль', 3: 'Март', 4: 'Апрель',
    5: 'Май', 6: 'Июнь', 7: 'Июль', 8: 'Август',
    9: 'Сентябрь', 10: 'Октябрь', 11: 'Ноябрь', 12: 'Декабрь'
} %}
{% set from_year = date_from|date('Y') %}
{% set to_year = date_to|date('Y') %}
{% set from_month = date_from|date('n') %}
{% set to_month = date_to|date('n') %}
{% if from_year == to_year %}
    {% if from_month == to_month %}
        {% set report_period_label = month_names[from_month] ~ ' ' ~ from_year %}
    {% else %}
        {% set report_period_label = month_names[from_month] ~ ' – ' ~ month_names[to_month] ~ ' ' ~ to_year %}
    {% endif %}
{% else %}
    {% set report_period_label = month_names[from_month] ~ ' ' ~ from_year ~ ' – ' ~ month_names[to_month] ~ ' ' ~ to_year %}
{% endif %}

<div class="page-header mb-3">
    <div class="row g-2 align-items-start">
        <div class="col">
            <h2 class="page-title">Отчёт о движении денежных средств</h2>
            <div class="text-secondary">{{ report_period_label }}</div>
        </div>
        <div class="col-auto ms-auto d-print-none">
            <a
                href="{{ path('report_cashflow_export_json', export_state) }}"
                class="btn btn-outline-secondary"
                title="Скачать отчёт в формате JSON для проверки"
            >
                <i class="ti ti-download" aria-hidden="true"></i>
                JSON
            </a>
        </div>
    </div>
</div>

<div class="card pl-preview-controls-card mb-3">
    <form id="cashflow-filter-form" class="card-body" method="get">
        <input type="hidden" name="from" value="{{ date_from|date('Y-m-d') }}" data-pl-exact-from>
        <input type="hidden" name="to" value="{{ date_to|date('Y-m-d') }}" data-pl-exact-to>
        <input type="hidden" name="group" value="{{ group }}" data-pl-group>
        {% if project_filter_tracked %}
            <input type="hidden" name="projectFiltersPresent" value="1">
        {% endif %}
        {% if legacy_responsibility_center_filter %}
            <input
                type="hidden"
                name="responsibilityCenterId"
                value="{{ selectedResponsibilityCenterId }}"
                data-pl-legacy-filter="responsibility-centers"
            >
            <input
                type="hidden"
                name="responsibilityCenterFiltersPresent"
                value="1"
                data-pl-filter-marker="responsibility-centers"
                disabled
            >
        {% elseif responsibility_center_filter_tracked %}
            <input type="hidden" name="responsibilityCenterFiltersPresent" value="1">
        {% endif %}

        <div class="pl-preview-controls-row">
            <details class="pl-preview-dropdown">
                <summary class="pl-preview-period-button">
                    <i class="ti ti-calendar" aria-hidden="true"></i>
                    <span>{{ date_from|date('d.m.Y') }} — {{ date_to|date('d.m.Y') }}</span>
                    <i class="ti ti-chevron-down" aria-hidden="true"></i>
                </summary>
                <div class="pl-preview-dropdown-menu">
                    <button
                        class="pl-preview-preset"
                        type="button"
                        data-pl-period-from="{{ date('now')|date('Y') }}-01-01"
                        data-pl-period-to="{{ date('last day of this month')|date('Y-m-d') }}"
                    >С начала года</button>
                    <button
                        class="pl-preview-preset"
                        type="button"
                        data-pl-period-from="{{ date('first day of -2 months')|date('Y-m-d') }}"
                        data-pl-period-to="{{ date('last day of this month')|date('Y-m-d') }}"
                    >Последние 3 месяца</button>
                    <button
                        class="pl-preview-preset"
                        type="button"
                        data-pl-period-from="{{ date('first day of last month')|date('Y-m-d') }}"
                        data-pl-period-to="{{ date('last day of last month')|date('Y-m-d') }}"
                    >Предыдущий месяц</button>
                    <button
                        class="pl-preview-preset"
                        type="button"
                        data-pl-period-from="{{ date('first day of this month')|date('Y-m-d') }}"
                        data-pl-period-to="{{ date('last day of this month')|date('Y-m-d') }}"
                    >Текущий месяц</button>
                    <div class="pl-preview-month-range">
                        <div class="pl-preview-month-field">
                            <label for="cashflow-month-from">С</label>
                            <input
                                class="form-control"
                                id="cashflow-month-from"
                                type="month"
                                value="{{ date_from|date('Y-m') }}"
                                data-pl-month-from
                            >
                        </div>
                        <div class="pl-preview-month-field">
                            <label for="cashflow-month-to">По</label>
                            <input
                                class="form-control"
                                id="cashflow-month-to"
                                type="month"
                                value="{{ date_to|date('Y-m') }}"
                                data-pl-month-to
                            >
                        </div>
                    </div>
                </div>
            </details>

            <div class="pl-preview-control-group">
                <span class="pl-preview-control-label">Режим отображения</span>
                <div class="pl-preview-segmented" role="group" aria-label="Режим отображения">
                    <button
                        class="{{ group == 'month' ? 'is-active' }}"
                        type="button"
                        data-pl-set="group"
                        data-pl-value="month"
                    >Месяц</button>
                    <button
                        class="{{ group == 'quarter' ? 'is-active' }}"
                        type="button"
                        data-pl-set="group"
                        data-pl-value="quarter"
                    >Квартал</button>
                    <button
                        class="{{ group == 'year' ? 'is-active' }}"
                        type="button"
                        data-pl-set="group"
                        data-pl-value="year"
                    >Год</button>
                </div>
            </div>
        </div>

        <div class="pl-preview-filters-row">
            <span class="pl-preview-control-label">Фильтры:</span>

            <details class="pl-preview-dropdown">
                <summary class="pl-preview-filter-chip{{ project_filter_active ? ' is-active' }}">
                    <i class="ti ti-briefcase" aria-hidden="true"></i>
                    {% if selectedProjectDirectionIds is null %}
                        Проекты: Все
                    {% else %}
                        Проекты: {{ selectedProjectDirectionIds|length }}
                    {% endif %}
                    <i class="ti ti-chevron-down" aria-hidden="true"></i>
                </summary>
                <div class="pl-preview-dropdown-menu pl-preview-filter-menu">
                    {% for project_direction in projectDirections|default([]) %}
                        <label class="pl-preview-filter-option" for="cashflow-project-{{ project_direction.id }}">
                            <input
                                id="cashflow-project-{{ project_direction.id }}"
                                type="checkbox"
                                name="projectDirectionIds[]"
                                value="{{ project_direction.id }}"
                                data-pl-filter-input="projects"
                                {{ selectedProjectDirectionIds is null or project_direction.id in selectedProjectDirectionIds ? 'checked' }}
                            >
                            <span>{{ project_direction.name }}</span>
                        </label>
                    {% else %}
                        <div class="pl-preview-filter-menu-empty">Нет доступных проектов</div>
                    {% endfor %}
                    {% if projectDirections|default([]) is not empty %}
                        <div class="pl-preview-filter-menu-footer">
                            <button type="button" data-pl-select-all="projects">Выбрать все</button>
                        </div>
                    {% endif %}
                </div>
            </details>

            <details class="pl-preview-dropdown pl-preview-dropdown-align-end">
                <summary class="pl-preview-filter-chip{{ responsibility_center_filter_active ? ' is-active' }}">
                    <i class="ti ti-building-warehouse" aria-hidden="true"></i>
                    {% if selectedResponsibilityCenterIds is null %}
                        ЦФО: Все
                    {% else %}
                        ЦФО: {{ selectedResponsibilityCenterIds|length }}
                    {% endif %}
                    <i class="ti ti-chevron-down" aria-hidden="true"></i>
                </summary>
                <div class="pl-preview-dropdown-menu pl-preview-filter-menu">
                    {% for responsibility_center in responsibilityCenters|default([]) %}
                        <label class="pl-preview-filter-option" for="cashflow-cfo-{{ responsibility_center.id }}">
                            <input
                                id="cashflow-cfo-{{ responsibility_center.id }}"
                                type="checkbox"
                                {% if legacy_responsibility_center_filter %}
                                    data-pl-filter-name="responsibilityCenterIds[]"
                                {% else %}
                                    name="responsibilityCenterIds[]"
                                {% endif %}
                                value="{{ responsibility_center.id }}"
                                data-pl-filter-input="responsibility-centers"
                                {{ selectedResponsibilityCenterIds is null or responsibility_center.id in selectedResponsibilityCenterIds ? 'checked' }}
                            >
                            <span>{{ responsibility_center.name }}</span>
                        </label>
                    {% else %}
                        <div class="pl-preview-filter-menu-empty">Нет доступных ЦФО</div>
                    {% endfor %}
                    {% if responsibilityCenters|default([]) is not empty %}
                        <div class="pl-preview-filter-menu-footer">
                            <button type="button" data-pl-select-all="responsibility-centers">Выбрать все</button>
                        </div>
                    {% endif %}
                </div>
            </details>

            {% if filters_active %}
                <a class="pl-preview-reset" href="{{ path('report_cashflow_index', reset_state) }}">
                    <i class="ti ti-x" aria-hidden="true"></i>
                    Сбросить фильтры
                </a>
            {% endif %}
        </div>
    </form>
</div>

{% if filters_active %}
    <div class="alert alert-info">
        Фильтры Проекты и ЦФО применяются к операциям и строкам ДДС. Сальдо на начало и конец остаётся общим по компании, так как остатки по счетам не ведутся в этих разрезах.
    </div>
{% endif %}

{% set periodCount = periods|length %}
{% import _self as macros %}

{% macro format_amount(value) %}
    {% set class = value < 0 ? 'text-danger' : (value > 0 ? 'text-success' : '') %}
    {% set sign = value > 0 ? '+' : (value < 0 ? '-' : '') %}
    <span class="{{ class }}">{{ sign }}{{ value|abs|number_format(2, ',', ' ') }}</span>
{% endmacro %}

{% macro render_category(cat, totals, currency, periodCount, parentId) %}
{% set hasChildren = cat.children|length > 0 %}
{% set hidden = cat.level >= 2 %}
<tr data-id="{{ cat.id }}" data-parent="{{ parentId }}" data-level="{{ cat.level }}"{% if hidden %} style="display:none"{% endif %}>
    <td style="padding-left: {{ (cat.level - 1) * 20 }}px;">
        <div class="d-flex align-items-center">
            {%- if hasChildren -%}
                <span class="cf-toggle" data-target="{{ cat.id }}">&#9654;</span>
            {%- else -%}
                <span class="cf-toggle-spacer"></span>
            {%- endif -%}
            <span class="text-truncate" title="{{ cat.name }}">{{ cat.name }}</span>
        </div>
    </td>
    {% for i in 0..periodCount-1 %}
        {% set val = totals[cat.id].totals[currency][i] ?? 0 %}
        <td class="text-end">{{ _self.format_amount(val)|raw }}</td>
    {% endfor %}
</tr>
{% for child in cat.children %}
    {{ _self.render_category(child, totals, currency, periodCount, cat.id) }}
{% endfor %}
{% endmacro %}

{% macro center_label(row, centerLabels) %}
    {{ row.responsibility_center_name ?? centerLabels[row.responsibility_center_id]|default(row.responsibility_center_id) }}
{% endmacro %}

{% macro render_project_center_rows(rows, currency, periods, primary, centerLabels) %}
    {% for row in rows %}
        {% set vals = row.totals[currency]|default([]) %}
        {% if vals is not empty %}
            <tr>
                {% if primary == 'center' %}
                    <td>{{ _self.center_label(row, centerLabels) }}</td>
                    <td>{{ row.project_name }}</td>
                {% else %}
                    <td>{{ row.project_name }}</td>
                    <td>{{ _self.center_label(row, centerLabels) }}</td>
                {% endif %}
                {% for i, p in periods %}
                    <td class="text-end">{{ _self.format_amount(vals[i]|default(0))|raw }}</td>
                {% endfor %}
            </tr>
        {% endif %}
    {% endfor %}
{% endmacro %}

{% set responsibilityCenterLabels = {} %}
{% for center in responsibilityCenters|default([]) %}
    {% set responsibilityCenterLabels = responsibilityCenterLabels|merge({(center.id): center.name}) %}
{% endfor %}

{% for currency, values in openings %}
    <div class="card mb-4">
        <div class="table-responsive">
            <table class="table table-bordered cf-table" style="min-width: calc(var(--cf-col-name) + {{ periodCount }} * var(--cf-col-period));">
                <colgroup>
                    <col class="cf-col-name">
                    {% for p in periods %}<col class="cf-col-period">{% endfor %}
                </colgroup>
                <thead>
                    <tr>
                        <th>Категория</th>
                        {% for p in periods %}
                            <th>{{ p.label }}</th>
                        {% endfor %}
                    </tr>
                </thead>
                <tbody>
                    <tr class="fw-bold">
                        <td>Сальдо на начало</td>
                        {% for i in 0..periodCount-1 %}
                            <td class="text-end">{{ macros.format_amount(openings[currency][i])|raw }}</td>
                        {% endfor %}
                    </tr>
                    {% for cat in categories %}
                        {{ macros.render_category(cat, categoryTotals, currency, periodCount, '') }}
                    {% endfor %}
                    <tr class="fw-bold">
                        <td>Сальдо на конец</td>
                        {% for i in 0..periodCount-1 %}
                            <td class="text-end">{{ macros.format_amount(closings[currency][i])|raw }}</td>
                        {% endfor %}
                    </tr>
                </tbody>
            </table>
        </div>
    </div>
{% endfor %}

{% if projectCenterMatrix.rowsByCenter|default([]) is not empty %}
    {% for currency in projectCenterMatrix.currencies %}
        <div class="card mb-4">
            <div class="card-header">
                <h3 class="card-title">Матрица Проект × ЦФО: {{ currency }}</h3>
            </div>
            <div class="card-body">
                <h4>ЦФО → проекты</h4>
                <div class="table-responsive mb-4">
                    <table class="table table-sm table-bordered table-striped">
                        <thead>
                            <tr>
                                <th>ЦФО</th>
                                <th>Проект</th>
                                {% for p in periods %}
                                    <th>{{ p.label }}</th>
                                {% endfor %}
                            </tr>
                        </thead>
                        <tbody>
                            {{ macros.render_project_center_rows(projectCenterMatrix.rowsByCenter, currency, periods, 'center', responsibilityCenterLabels) }}
                        </tbody>
                    </table>
                </div>

                <h4>Проект → ЦФО</h4>
                <div class="table-responsive">
                    <table class="table table-sm table-bordered table-striped">
                        <thead>
                            <tr>
                                <th>Проект</th>
                                <th>ЦФО</th>
                                {% for p in periods %}
                                    <th>{{ p.label }}</th>
                                {% endfor %}
                            </tr>
                        </thead>
                        <tbody>
                            {{ macros.render_project_center_rows(projectCenterMatrix.rowsByProject, currency, periods, 'project', responsibilityCenterLabels) }}
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    {% endfor %}
{% endif %}

{% include 'finance/report/_filter_controls_script.html.twig' with {
    'reportControlsFormId': 'cashflow-filter-form'
} only %}

<script>
document.addEventListener('DOMContentLoaded', function () {
    document.querySelectorAll('.cf-toggle').forEach(function (btn) {
        btn.addEventListener('click', function () {
            var parentId = btn.getAttribute('data-target');
            var expanded = btn.textContent.trim() === '\u25BC';

            if (expanded) {
                btn.innerHTML = '&#9654;';
                hideDescendants(parentId);
            } else {
                btn.innerHTML = '&#9660;';
                showDirectChildren(parentId);
            }
        });
    });

    function showDirectChildren(parentId) {
        document.querySelectorAll('tr[data-parent="' + parentId + '"]').forEach(function (row) {
            row.style.display = '';
            var toggle = row.querySelector('.cf-toggle');
            if (toggle) {
                toggle.innerHTML = '&#9654;';
            }
        });
    }

    function hideDescendants(parentId) {
        document.querySelectorAll('tr[data-parent="' + parentId + '"]').forEach(function (row) {
            row.style.display = 'none';
            var childId = row.getAttribute('data-id');
            var toggle = row.querySelector('.cf-toggle');
            if (toggle) {
                toggle.innerHTML = '&#9654;';
            }
            hideDescendants(childId);
        });
    }
});
</script>
{% endblock %}
