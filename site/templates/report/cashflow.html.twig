{% endblock %}#}

{% block content %}
<div class="d-flex align-items-center mb-3">
    <h2 class="page-title">Отчет ДДС</h2>
</div>

<form method="get" class="row g-2 mb-3">
    <div class="col-auto">
        <input type="date" name="from" value="{{ date_from|date('Y-m-d') }}" class="form-control"/>
    </div>
    <div class="col-auto">
        <input type="date" name="to" value="{{ date_to|date('Y-m-d') }}" class="form-control"/>
    </div>
    <input type="hidden" name="group" value="{{ group }}" id="group-input"/>
    <div class="col-auto">
        <select name="responsibilityCenterId" class="form-select" aria-label="ЦФО">
            <option value="">Все ЦФО</option>
            {% for center in responsibilityCenters|default([]) %}
                <option value="{{ center.id }}" {{ selectedResponsibilityCenterId|default(null) == center.id ? 'selected' }}>{{ center.name }}</option>
            {% endfor %}
        </select>
    </div>
    <div class="col-auto">
        <div class="btn-group" role="group">
            <button type="submit" class="btn btn-outline-primary {% if group == 'day' %}active{% endif %}" onclick="document.getElementById('group-input').value='day'">По дням</button>
            <button type="submit" class="btn btn-outline-primary {% if group == 'week' %}active{% endif %}" onclick="document.getElementById('group-input').value='week'">По неделям</button>
            <button type="submit" class="btn btn-outline-primary {% if group == 'month' %}active{% endif %}" onclick="document.getElementById('group-input').value='month'">По месяцам</button>
            <button type="submit" class="btn btn-outline-primary {% if group == 'quarter' %}active{% endif %}" onclick="document.getElementById('group-input').value='quarter'">По кварталам</button>
            <button type="submit" class="btn btn-outline-primary {% if group == 'year' %}active{% endif %}" onclick="document.getElementById('group-input').value='year'">По годам</button>
        </div>
    </div>
    <div class="col-auto">
        <button type="submit" class="btn btn-primary">Показать</button>
        <a href="{{ path('report_cashflow_export_json', app.request.query.all) }}" class="btn btn-outline-secondary">JSON</a>
    </div>
</form>

{% if selectedResponsibilityCenterId|default(null) %}
    <div class="alert alert-info">
        Фильтр ЦФО применяется к операциям и строкам ДДС. Сальдо на начало и конец остаётся общим по компании, так как остатки по счетам не ведутся в разрезе ЦФО.
    </div>
{% endif %}

{% set periodCount = periods|length %}
{% import _self as macros %}

{% macro format_amount(value) %}
    {% set class = value < 0 ? 'text-danger' : (value > 0 ? 'text-success' : '') %}
    {% set sign = value > 0 ? '+' : (value < 0 ? '-' : '') %}
    <span class="{{ class }}">{{ sign }}{{ value|abs|number_format(2, ',', ' ') }}</span>
{% endmacro %}

{% macro render_category(cat, totals, currency, periodCount, parentId) %}
{% set hasChildren = cat.children|length > 0 %}
{% set hidden = cat.level >= 2 %}
<tr data-id="{{ cat.id }}" data-parent="{{ parentId }}" data-level="{{ cat.level }}"{% if hidden %} style="display:none"{% endif %}>
    <td style="padding-left: {{ (cat.level - 1) * 20 }}px;">
        <div class="d-flex align-items-center">
            {%- if hasChildren -%}
                <span class="cf-toggle" data-target="{{ cat.id }}">&#9654;</span>
            {%- else -%}
                <span class="cf-toggle-spacer"></span>
            {%- endif -%}
            <span class="text-truncate" title="{{ cat.name }}">{{ cat.name }}</span>
        </div>
    </td>
    {% for i in 0..periodCount-1 %}
        {% set val = totals[cat.id].totals[currency][i] ?? 0 %}
        <td class="text-end">{{ _self.format_amount(val)|raw }}</td>
    {% endfor %}
</tr>
{% for child in cat.children %}
    {{ _self.render_category(child, totals, currency, periodCount, cat.id) }}
{% endfor %}
{% endmacro %}

{% macro center_label(row, centerLabels) %}
    {{ row.responsibility_center_name ?? centerLabels[row.responsibility_center_id]|default(row.responsibility_center_id) }}
{% endmacro %}

{% macro render_project_center_rows(rows, currency, periods, primary, centerLabels) %}
    {% for row in rows %}
        {% set vals = row.totals[currency]|default([]) %}
        {% if vals is not empty %}
            <tr>
                {% if primary == 'center' %}
                    <td>{{ _self.center_label(row, centerLabels) }}</td>
                    <td>{{ row.project_name }}</td>
                {% else %}
                    <td>{{ row.project_name }}</td>
                    <td>{{ _self.center_label(row, centerLabels) }}</td>
                {% endif %}
                {% for i, p in periods %}
                    <td class="text-end">{{ _self.format_amount(vals[i]|default(0))|raw }}</td>
                {% endfor %}
            </tr>
        {% endif %}
    {% endfor %}
{% endmacro %}

{% set responsibilityCenterLabels = {} %}
{% for center in responsibilityCenters|default([]) %}
    {% set responsibilityCenterLabels = responsibilityCenterLabels|merge({(center.id): center.name}) %}
{% endfor %}

{% for currency, values in openings %}
    <div class="card mb-4">
        <div class="card-header">
            <h3 class="card-title">Валюта: {{ currency }}</h3>
        </div>
        <div class="table-responsive">
            <table class="table table-bordered cf-table" style="min-width: calc(var(--cf-col-name) + {{ periodCount }} * var(--cf-col-period));">
                <colgroup>
                    <col class="cf-col-name">
                    {% for p in periods %}<col class="cf-col-period">{% endfor %}
                </colgroup>
                <thead>
                    <tr>
                        <th>Категория</th>
                        {% for p in periods %}
                            <th>{{ p.label }}</th>
                        {% endfor %}
                    </tr>
                </thead>
                <tbody>
                    <tr class="fw-bold">
                        <td>Сальдо на начало</td>
                        {% for i in 0..periodCount-1 %}
                            <td class="text-end">{{ macros.format_amount(openings[currency][i])|raw }}</td>
                        {% endfor %}
                    </tr>
                    {% for cat in categories %}
                        {{ macros.render_category(cat, categoryTotals, currency, periodCount, '') }}
                    {% endfor %}
                    <tr class="fw-bold">
                        <td>Сальдо на конец</td>
                        {% for i in 0..periodCount-1 %}
                            <td class="text-end">{{ macros.format_amount(closings[currency][i])|raw }}</td>
                        {% endfor %}
                    </tr>
                </tbody>
            </table>
        </div>
    </div>
{% endfor %}

{% if projectCenterMatrix.rowsByCenter|default([]) is not empty %}
    {% for currency in projectCenterMatrix.currencies %}
        <div class="card mb-4">
            <div class="card-header">
                <h3 class="card-title">Матрица Проект × ЦФО: {{ currency }}</h3>
            </div>
            <div class="card-body">
                <h4>ЦФО → проекты</h4>
                <div class="table-responsive mb-4">
                    <table class="table table-sm table-bordered table-striped">
                        <thead>
                            <tr>
                                <th>ЦФО</th>
                                <th>Проект</th>
                                {% for p in periods %}
                                    <th>{{ p.label }}</th>
                                {% endfor %}
                            </tr>
                        </thead>
                        <tbody>
                            {{ macros.render_project_center_rows(projectCenterMatrix.rowsByCenter, currency, periods, 'center', responsibilityCenterLabels) }}
                        </tbody>
                    </table>
                </div>

                <h4>Проект → ЦФО</h4>
                <div class="table-responsive">
                    <table class="table table-sm table-bordered table-striped">
                        <thead>
                            <tr>
                                <th>Проект</th>
                                <th>ЦФО</th>
                                {% for p in periods %}
                                    <th>{{ p.label }}</th>
                                {% endfor %}
                            </tr>
                        </thead>
                        <tbody>
                            {{ macros.render_project_center_rows(projectCenterMatrix.rowsByProject, currency, periods, 'project', responsibilityCenterLabels) }}
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    {% endfor %}
{% endif %}

<script>
document.addEventListener('DOMContentLoaded', function () {
    document.querySelectorAll('.cf-toggle').forEach(function (btn) {
        btn.addEventListener('click', function () {
            var parentId = btn.getAttribute('data-target');
            var expanded = btn.textContent.trim() === '\u25BC';

            if (expanded) {
                btn.innerHTML = '&#9654;';
                hideDescendants(parentId);
            } else {
                btn.innerHTML = '&#9660;';
                showDirectChildren(parentId);
            }
        });
    });

    function showDirectChildren(parentId) {
        document.querySelectorAll('tr[data-parent="' + parentId + '"]').forEach(function (row) {
            row.style.display = '';
            var toggle = row.querySelector('.cf-toggle');
            if (toggle) {
                toggle.innerHTML = '&#9654;';
            }
        });
    }

    function hideDescendants(parentId) {
        document.querySelectorAll('tr[data-parent="' + parentId + '"]').forEach(function (row) {
            row.style.display = 'none';
            var childId = row.getAttribute('data-id');
            var toggle = row.querySelector('.cf-toggle');
            if (toggle) {
                toggle.innerHTML = '&#9654;';
            }
            hideDescendants(childId);
        });
    }
});
</script>
{% endblock %}
