{% extends 'base.html.twig' %}
{% block title %}Отчёт о прибылях и убытках{% endblock %}

{% block stylesheets %}
    {{ parent() }}
    <style>
        /* Таблица P&L: «Строка» закреплена слева, остальные колонки фиксированной ширины и
           прокручиваются вместе с .table-responsive. Рецепт тот же, что в отчёте ДДС
           (templates/report/cashflow.html.twig).
           Селекторы .table.pl-table — чтобы правила не перебивались .table из legacy_app,
           который грузится до этого блока. */
        .table.pl-table {
            --pl-col-name: 280px;
            --pl-col-meta-code: 110px;
            --pl-col-meta-type: 120px;
            --pl-col-period: 160px;
            --pl-col-project: 200px;
            --pl-col-total: 180px;
            /* table-layout: fixed работает только при определённой ширине таблицы;
               при width:auto браузер молча откатывается на auto-раскладку.
               Ширину даёт .table (width:100%), а min-width задаётся инлайном по числу колонок. */
            table-layout: fixed;
        }
        .table.pl-table th,
        .table.pl-table td {
            white-space: nowrap;
            overflow: hidden;
            text-overflow: ellipsis;
        }
        .table.pl-table col.pl-col-name { width: var(--pl-col-name); }
        .table.pl-table col.pl-col-meta-code { width: var(--pl-col-meta-code); }
        .table.pl-table col.pl-col-meta-type { width: var(--pl-col-meta-type); }
        .table.pl-table col.pl-col-period { width: var(--pl-col-period); }
        .table.pl-table col.pl-col-project { width: var(--pl-col-project); }
        .table.pl-table col.pl-col-total { width: var(--pl-col-total); }
        /* строки данных, а не ячейка пустого состояния с colspan: её нельзя залипать целиком */
        .table.pl-table thead th:first-child,
        .table.pl-table tbody tr.pl-row > td:first-child {
            position: sticky;
            left: 0;
            z-index: 2;
            background: var(--tblr-bg-surface);
            /* при border-collapse граница залипшей ячейки не рисуется поверх уезжающих — подменяем тенью */
            box-shadow: inset -1px 0 0 var(--tblr-border-color);
        }
        .table.pl-table th.pl-cell-total,
        .table.pl-table td.pl-cell-total {
            position: sticky;
            right: 0;
            z-index: 2;
            background: var(--tblr-bg-surface);
            box-shadow: inset 1px 0 0 var(--tblr-border-color);
        }
        .table.pl-table .text-end { font-variant-numeric: tabular-nums; }
        .table.pl-table .pl-name-wrap {
            display: flex;
            align-items: center;
            overflow: hidden;
        }
        /* min-width:0 — иначе flex-элемент не сжимается и ellipsis не срабатывает */
        .table.pl-table .pl-name {
            min-width: 0;
            overflow: hidden;
            text-overflow: ellipsis;
        }
        .table.pl-table .pl-toggle {
            flex: none;
            width: 16px;
            margin-right: 4px;
            text-align: center;
        }

        {% include 'finance/report/_filter_controls_styles.html.twig' %}
    </style>
{% endblock %}

{% block body %}
    <div class="page-body">
        <div class="container-xl">
            {% set availableProjectIds = [] %}
            {% for projectDirection in projectDirections %}
                {% set availableProjectIds = availableProjectIds|merge([projectDirection.id]) %}
            {% endfor %}
            {% set availableResponsibilityCenterIds = [] %}
            {% for responsibilityCenter in responsibilityCenters %}
                {% set availableResponsibilityCenterIds = availableResponsibilityCenterIds|merge([responsibilityCenter.id]) %}
            {% endfor %}
            {# Legacy project-layout URLs never scoped columns by singular projectDirectionId. #}
            {% set uiSelectedProjectDirectionIds = layout == 'projects' and not dimensionFiltersPresent
                ? null
                : selectedProjectDirectionIds %}
            {% set submittedProjectIds = uiSelectedProjectDirectionIds ?? availableProjectIds %}
            {% set submittedResponsibilityCenterIds = selectedResponsibilityCenterIds ?? availableResponsibilityCenterIds %}
            {% set projectFilterTracked = projectDirections is not empty or selectedProjectDirectionIds is not null %}
            {% set responsibilityCenterFilterTracked = responsibilityCenters is not empty or selectedResponsibilityCenterIds is not null %}
            {% set projectFilterActive = uiSelectedProjectDirectionIds is not null %}
            {% set responsibilityCenterFilterActive = selectedResponsibilityCenterIds is not null %}
            {% set filtersActive = projectFilterActive or responsibilityCenterFilterActive or showMetaColumns %}
            {% set resetState = {
                'from': from|date('Y-m-d'),
                'to': to|date('Y-m-d'),
                'grouping': grouping,
                'layout': layout
            } %}
            {% if availableProjectIds is not empty %}
                {% set resetState = resetState|merge({
                    'projectFiltersPresent': 1,
                    'projectDirectionIds': availableProjectIds
                }) %}
            {% endif %}
            {% if availableResponsibilityCenterIds is not empty %}
                {% set resetState = resetState|merge({
                    'responsibilityCenterFiltersPresent': 1,
                    'responsibilityCenterIds': availableResponsibilityCenterIds
                }) %}
            {% endif %}

            {% set previewState = {
                'from': from|date('Y-m-d'),
                'to': to|date('Y-m-d'),
                'grouping': grouping,
                'layout': layout,
                'show_meta': showMetaColumns ? 1 : 0
            } %}
            {% if dimensionFiltersPresent %}
                {% if projectFilterTracked %}
                    {% set previewState = previewState|merge({
                        'projectFiltersPresent': 1,
                        'projectDirectionIds': submittedProjectIds
                    }) %}
                {% endif %}
                {% if responsibilityCenterFilterTracked %}
                    {% set previewState = previewState|merge({
                        'responsibilityCenterFiltersPresent': 1,
                        'responsibilityCenterIds': submittedResponsibilityCenterIds
                    }) %}
                {% endif %}
            {% else %}
                {% if selectedProjectDirectionId %}
                    {% set previewState = previewState|merge({'projectDirectionId': selectedProjectDirectionId}) %}
                {% endif %}
                {% if selectedResponsibilityCenterId %}
                    {% set previewState = previewState|merge({'responsibilityCenterId': selectedResponsibilityCenterId}) %}
                {% endif %}
            {% endif %}

            {% set monthNames = {
                1: 'Январь', 2: 'Февраль', 3: 'Март', 4: 'Апрель',
                5: 'Май', 6: 'Июнь', 7: 'Июль', 8: 'Август',
                9: 'Сентябрь', 10: 'Октябрь', 11: 'Ноябрь', 12: 'Декабрь'
            } %}
            {% set fromYear = from|date('Y') %}
            {% set toYear = to|date('Y') %}
            {% set fromMonth = from|date('n') %}
            {% set toMonth = to|date('n') %}
            {% if fromYear == toYear %}
                {% set reportPeriodLabel = fromMonth == toMonth
                    ? monthNames[fromMonth] ~ ' ' ~ fromYear
                    : monthNames[fromMonth] ~ ' – ' ~ monthNames[toMonth] ~ ' ' ~ toYear %}
            {% else %}
                {% set reportPeriodLabel = monthNames[fromMonth] ~ ' ' ~ fromYear ~ ' – ' ~ monthNames[toMonth] ~ ' ' ~ toYear %}
            {% endif %}

            <div class="page-header mb-3">
                <div class="row g-2 align-items-start">
                    <div class="col">
                        <h2 class="page-title">Отчёт о прибылях и убытках</h2>
                        <div class="text-secondary">{{ reportPeriodLabel }}</div>
                    </div>
                    <div class="col-auto ms-auto d-print-none">
                        <a
                            href="{{ path('finance_report_preview_json', previewState) }}"
                            class="btn btn-outline-secondary"
                            title="Скачать отчёт в формате JSON для проверки"
                        >
                            <i class="ti ti-download"></i>
                            JSON
                        </a>
                    </div>
                </div>
            </div>

            <div class="card pl-preview-controls-card mb-3">
                <form id="pl-preview-filter-form" class="card-body" method="get">
                    <input type="hidden" name="from" value="{{ from|date('Y-m-d') }}" data-pl-exact-from>
                    <input type="hidden" name="to" value="{{ to|date('Y-m-d') }}" data-pl-exact-to>
                    <input type="hidden" name="grouping" value="{{ grouping }}" data-pl-grouping>
                    <input type="hidden" name="layout" value="{{ layout }}" data-pl-layout>
                    {% if projectFilterTracked %}
                        <input type="hidden" name="projectFiltersPresent" value="1">
                    {% endif %}
                    {% if responsibilityCenterFilterTracked %}
                        <input type="hidden" name="responsibilityCenterFiltersPresent" value="1">
                    {% endif %}

                    <div class="pl-preview-controls-row">
                        <details class="pl-preview-dropdown">
                            <summary class="pl-preview-period-button">
                                <i class="ti ti-calendar" aria-hidden="true"></i>
                                <span>{{ from|date('d.m.Y') }} — {{ to|date('d.m.Y') }}</span>
                                <i class="ti ti-chevron-down" aria-hidden="true"></i>
                            </summary>
                            <div class="pl-preview-dropdown-menu">
                                <button
                                    class="pl-preview-preset"
                                    type="button"
                                    data-pl-period-from="{{ date('now')|date('Y') }}-01-01"
                                    data-pl-period-to="{{ date('last day of this month')|date('Y-m-d') }}"
                                >
                                    С начала года
                                </button>
                                <button
                                    class="pl-preview-preset"
                                    type="button"
                                    data-pl-period-from="{{ date('first day of -2 months')|date('Y-m-d') }}"
                                    data-pl-period-to="{{ date('last day of this month')|date('Y-m-d') }}"
                                >
                                    Последние 3 месяца
                                </button>
                                <button
                                    class="pl-preview-preset"
                                    type="button"
                                    data-pl-period-from="{{ date('first day of last month')|date('Y-m-d') }}"
                                    data-pl-period-to="{{ date('last day of last month')|date('Y-m-d') }}"
                                >
                                    Предыдущий месяц
                                </button>
                                <button
                                    class="pl-preview-preset"
                                    type="button"
                                    data-pl-period-from="{{ date('first day of this month')|date('Y-m-d') }}"
                                    data-pl-period-to="{{ date('last day of this month')|date('Y-m-d') }}"
                                >
                                    Текущий месяц
                                </button>
                                <div class="pl-preview-month-range">
                                    <div class="pl-preview-month-field">
                                        <label for="pl-preview-month-from">С</label>
                                        <input
                                            class="form-control"
                                            id="pl-preview-month-from"
                                            type="month"
                                            value="{{ from|date('Y-m') }}"
                                            data-pl-month-from
                                        >
                                    </div>
                                    <div class="pl-preview-month-field">
                                        <label for="pl-preview-month-to">По</label>
                                        <input
                                            class="form-control"
                                            id="pl-preview-month-to"
                                            type="month"
                                            value="{{ to|date('Y-m') }}"
                                            data-pl-month-to
                                        >
                                    </div>
                                </div>
                            </div>
                        </details>

                        <div class="pl-preview-control-group">
                            <span class="pl-preview-control-label">Группировка</span>
                            <div class="pl-preview-segmented{{ layout == 'projects' ? ' is-disabled' }}" role="group" aria-label="Группировка">
                                <button
                                    class="{{ grouping == 'month' ? 'is-active' }}"
                                    type="button"
                                    data-pl-set="grouping"
                                    data-pl-value="month"
                                    {% if layout == 'projects' %}disabled aria-disabled="true"{% endif %}
                                >Месяц</button>
                                <button
                                    class="{{ grouping == 'quarter' ? 'is-active' }}"
                                    type="button"
                                    data-pl-set="grouping"
                                    data-pl-value="quarter"
                                    {% if layout == 'projects' %}disabled aria-disabled="true"{% endif %}
                                >Квартал</button>
                            </div>
                        </div>

                        <div class="pl-preview-control-group">
                            <span class="pl-preview-control-label">Режим</span>
                            <div class="pl-preview-segmented" role="group" aria-label="Режим отображения">
                                <button
                                    class="{{ layout == 'periods' ? 'is-active' }}"
                                    type="button"
                                    data-pl-set="layout"
                                    data-pl-value="periods"
                                >По периодам</button>
                                <button
                                    class="{{ layout == 'projects' ? 'is-active' }}"
                                    type="button"
                                    data-pl-set="layout"
                                    data-pl-value="projects"
                                >По проектам</button>
                            </div>
                        </div>
                    </div>

                    <div class="pl-preview-filters-row">
                        <span class="pl-preview-control-label">Фильтры:</span>

                        <details class="pl-preview-dropdown">
                            <summary class="pl-preview-filter-chip{{ projectFilterActive ? ' is-active' }}">
                                <i class="ti ti-briefcase" aria-hidden="true"></i>
                                {% if uiSelectedProjectDirectionIds is null %}
                                    Проекты: Все
                                {% else %}
                                    Проекты: {{ uiSelectedProjectDirectionIds|length }}
                                {% endif %}
                                <i class="ti ti-chevron-down" aria-hidden="true"></i>
                            </summary>
                            <div class="pl-preview-dropdown-menu pl-preview-filter-menu">
                                {% for projectDirection in projectDirections %}
                                    <label class="pl-preview-filter-option" for="pl-preview-project-{{ projectDirection.id }}">
                                        <input
                                            id="pl-preview-project-{{ projectDirection.id }}"
                                            type="checkbox"
                                            name="projectDirectionIds[]"
                                            value="{{ projectDirection.id }}"
                                            data-pl-filter-input="projects"
                                            {{ uiSelectedProjectDirectionIds is null or projectDirection.id in uiSelectedProjectDirectionIds ? 'checked' }}
                                        >
                                        <span>{{ projectDirection.name }}</span>
                                    </label>
                                {% else %}
                                    <div class="pl-preview-filter-menu-empty">Нет доступных проектов</div>
                                {% endfor %}
                                {% if projectDirections is not empty %}
                                    <div class="pl-preview-filter-menu-footer">
                                        <button type="button" data-pl-select-all="projects">Выбрать все</button>
                                    </div>
                                {% endif %}
                            </div>
                        </details>

                        <details class="pl-preview-dropdown pl-preview-dropdown-align-end">
                            <summary class="pl-preview-filter-chip{{ responsibilityCenterFilterActive ? ' is-active' }}">
                                <i class="ti ti-building-warehouse" aria-hidden="true"></i>
                                {% if selectedResponsibilityCenterIds is null %}
                                    ЦФО: Все
                                {% else %}
                                    ЦФО: {{ selectedResponsibilityCenterIds|length }}
                                {% endif %}
                                <i class="ti ti-chevron-down" aria-hidden="true"></i>
                            </summary>
                            <div class="pl-preview-dropdown-menu pl-preview-filter-menu">
                                {% for responsibilityCenter in responsibilityCenters %}
                                    <label class="pl-preview-filter-option" for="pl-preview-cfo-{{ responsibilityCenter.id }}">
                                        <input
                                            id="pl-preview-cfo-{{ responsibilityCenter.id }}"
                                            type="checkbox"
                                            name="responsibilityCenterIds[]"
                                            value="{{ responsibilityCenter.id }}"
                                            data-pl-filter-input="responsibility-centers"
                                            {{ selectedResponsibilityCenterIds is null or responsibilityCenter.id in selectedResponsibilityCenterIds ? 'checked' }}
                                        >
                                        <span>{{ responsibilityCenter.name }}</span>
                                    </label>
                                {% else %}
                                    <div class="pl-preview-filter-menu-empty">Нет доступных ЦФО</div>
                                {% endfor %}
                                {% if responsibilityCenters is not empty %}
                                    <div class="pl-preview-filter-menu-footer">
                                        <button type="button" data-pl-select-all="responsibility-centers">Выбрать все</button>
                                    </div>
                                {% endif %}
                            </div>
                        </details>

                        <label class="pl-preview-meta-chip">
                            <input
                                type="checkbox"
                                name="show_meta"
                                value="1"
                                data-pl-auto-submit
                                {{ showMetaColumns ? 'checked' }}
                            >
                            <span class="pl-preview-filter-chip{{ showMetaColumns ? ' is-active' }}">
                                <i class="ti ti-code" aria-hidden="true"></i>
                                Код и тип
                            </span>
                        </label>

                        {% if filtersActive %}
                            <a
                                class="pl-preview-reset"
                                href="{{ path('finance_report_preview', resetState) }}"
                            >
                                <i class="ti ti-x" aria-hidden="true"></i>
                                Сбросить фильтры
                            </a>
                        {% endif %}
                    </div>
                </form>
            </div>

            {% if warnings is not empty %}
                <div class="alert alert-warning mb-3">
                    <strong>Предупреждения:</strong>
                    <ul class="mb-0">
                        {% for w in warnings %}<li>{{ w }}</li>{% endfor %}
                    </ul>
                </div>
            {% endif %}

            {# Ширины колонок фиксированные: table-layout:fixed + colgroup. min-width считается по
               числу колонок, иначе таблица сожмётся до контейнера вместо горизонтальной прокрутки. #}
            {% set meta_width = showMetaColumns ? ' + var(--pl-col-meta-code) + var(--pl-col-meta-type)' : '' %}
            {# Инлайн-значение — источник истины для группировки; объявление в CSS выше остаётся fallback. #}
            {% set period_col_width = grouping == 'week' ? '220px' : '160px' %}
            {% if layout == 'projects' %}
                {% set table_min_width = 'calc(var(--pl-col-name)' ~ meta_width ~ ' + ' ~ compareProjects|length ~ ' * var(--pl-col-project) + var(--pl-col-total))' %}
            {% else %}
                {% set table_min_width = 'calc(var(--pl-col-name)' ~ meta_width ~ ' + ' ~ periods|length ~ ' * var(--pl-col-period))' %}
            {% endif %}

            <div class="card">
                <div class="table-responsive">
                    {# Для этой таблицы согласован бухгалтерский формат: отрицательные значения в скобках вместо UI Kit U+2212. #}
                    <table class="table table-vcenter pl-table" style="--pl-col-period: {{ period_col_width }}; min-width: {{ table_min_width }};">
                        {% if layout == 'projects' %}
                            <colgroup>
                                <col class="pl-col-name">
                                {% if showMetaColumns %}
                                    <col class="pl-col-meta-code">
                                    <col class="pl-col-meta-type">
                                {% endif %}
                                {% for p in compareProjects %}<col class="pl-col-project">{% endfor %}
                                <col class="pl-col-total">
                            </colgroup>
                            <thead>
                            <tr>
                                <th>Строка</th>
                                {% if showMetaColumns %}
                                    <th>Код</th>
                                    <th>Тип</th>
                                {% endif %}
                                {% for p in compareProjects %}
                                    <th class="text-end" title="{{ p.name }}{% if p.isOverhead %} (Shared){% endif %}">
                                        {{ p.name }}{% if p.isOverhead %} <span class="text-muted">(Shared)</span>{% endif %}
                                    </th>
                                {% endfor %}
                                <th class="text-end pl-cell-total">Итого</th>
                            </tr>
                            </thead>
                            <tbody>
                            {% for r in rows %}
                                {# rows отсортированы depth-first, поэтому более глубокая следующая строка означает наличие вложенных строк. #}
                                {% set has_children = rows[loop.index] is defined and rows[loop.index].level > r.level %}
                                <tr class="pl-row{{ has_children ? ' fw-bold' : '' }}" data-row-id="{{ r.id }}" data-level="{{ r.level }}">
                                    <td style="padding-left: {{ (r.level - 1) * 20 }}px;">
                                        <div class="pl-name-wrap">
                                            <span class="pl-toggle"></span>
                                            <span class="pl-name" title="{{ r.name }}">{{ r.name }}</span>
                                        </div>
                                    </td>
                                    {% if showMetaColumns %}
                                        <td><code>{{ r.code ?? '—' }}</code></td>
                                        <td>{{ r.type }}</td>
                                    {% endif %}
                                    {% for p in compareProjects %}
                                        {% set cell_value = r.values[p.id] ?? '—' %}
                                        {% set cell_value = cell_value starts with '-' ? '(' ~ cell_value|slice(1) ~ ')' : cell_value %}
                                        <td class="text-end" title="{{ cell_value }}">{{ cell_value }}</td>
                                    {% endfor %}
                                    {% set total_value = r.values['_total'] ?? '—' %}
                                    {% set total_value = total_value starts with '-' ? '(' ~ total_value|slice(1) ~ ')' : total_value %}
                                    <td class="text-end fw-bold pl-cell-total" title="{{ total_value }}">{{ total_value }}</td>
                                </tr>
                            {% else %}
                                <tr>
                                    <td colspan="{{ 1 + (showMetaColumns ? 2 : 0) + compareProjects|length + 1 }}" class="text-muted">Нет строк отчёта</td>
                                </tr>
                            {% endfor %}
                            </tbody>
                        {% else %}
                            <colgroup>
                                <col class="pl-col-name">
                                {% if showMetaColumns %}
                                    <col class="pl-col-meta-code">
                                    <col class="pl-col-meta-type">
                                {% endif %}
                                {% for period in periods %}<col class="pl-col-period">{% endfor %}
                            </colgroup>
                            <thead>
                            <tr>
                                <th>Строка</th>
                                {% if showMetaColumns %}
                                    <th>Код</th>
                                    <th>Тип</th>
                                {% endif %}
                                {% for period in periods %}
                                    <th class="text-end" title="{{ period.label }}">{{ period.label }}</th>
                                {% endfor %}
                            </tr>
                            </thead>
                            <tbody>
                            {% for r in rows %}
                                {# rows отсортированы depth-first, поэтому более глубокая следующая строка означает наличие вложенных строк. #}
                                {% set has_children = rows[loop.index] is defined and rows[loop.index].level > r.level %}
                                <tr class="pl-row{{ has_children ? ' fw-bold' : '' }}" data-row-id="{{ r.id }}" data-level="{{ r.level }}">
                                    <td style="padding-left: {{ (r.level - 1) * 20 }}px;">
                                        <div class="pl-name-wrap">
                                            <span class="pl-toggle"></span>
                                            <span class="pl-name" title="{{ r.name }}">{{ r.name }}</span>
                                        </div>
                                    </td>
                                    {% if showMetaColumns %}
                                        <td><code>{{ r.code ?? '—' }}</code></td>
                                        <td>{{ r.type }}</td>
                                    {% endif %}
                                    {% for period in periods %}
                                        {% set cell_value = r.values[period.id] ?? '—' %}
                                        {% set cell_value = cell_value starts with '-' ? '(' ~ cell_value|slice(1) ~ ')' : cell_value %}
                                        <td class="text-end" title="{{ cell_value }}">{{ cell_value }}</td>
                                    {% endfor %}
                                </tr>
                            {% else %}
                                <tr>
                                    <td colspan="{{ 1 + (showMetaColumns ? 2 : 0) + periods|length }}" class="text-muted">Нет строк отчёта</td>
                                </tr>
                            {% endfor %}
                            </tbody>
                        {% endif %}
                    </table>
                </div>
            </div>
        </div>
    </div>

{% include 'finance/report/_filter_controls_script.html.twig' %}

<script>
document.addEventListener('DOMContentLoaded', function () {
    var rows = Array.from(document.querySelectorAll('tr.pl-row'));
    if (!rows.length) return;

    var childrenMap = {};
    var levelStack = [];

    rows.forEach(function (row) {
        var id = row.getAttribute('data-row-id');
        var level = parseInt(row.getAttribute('data-level'), 10);

        while (levelStack.length && levelStack[levelStack.length - 1].level >= level) {
            levelStack.pop();
        }

        var parentId = levelStack.length ? levelStack[levelStack.length - 1].id : null;

        if (parentId) {
            if (!childrenMap[parentId]) childrenMap[parentId] = [];
            childrenMap[parentId].push(id);
        }

        levelStack.push({ id: id, level: level });
    });

    rows.forEach(function (row) {
        var id = row.getAttribute('data-row-id');
        var level = parseInt(row.getAttribute('data-level'), 10);
        var toggle = row.querySelector('.pl-toggle');
        var hasChildren = childrenMap[id] && childrenMap[id].length > 0;

        if (hasChildren) {
            toggle.innerHTML = '&#9654;';
            toggle.style.cursor = 'pointer';
            toggle.setAttribute('data-target', id);
        }

        if (level >= 2) {
            row.style.display = 'none';
        }
    });

    document.addEventListener('click', function (e) {
        var toggle = e.target.closest('.pl-toggle[data-target]');
        if (!toggle) return;

        var targetId = toggle.getAttribute('data-target');
        var expanded = toggle.textContent.trim() === '\u25BC';

        if (expanded) {
            toggle.innerHTML = '&#9654;';
            hideDescendants(targetId);
        } else {
            toggle.innerHTML = '&#9660;';
            showDirectChildren(targetId);
        }
    });

    function showDirectChildren(parentId) {
        (childrenMap[parentId] || []).forEach(function (childId) {
            var row = document.querySelector('tr[data-row-id="' + childId + '"]');
            if (row) {
                row.style.display = '';
                var toggle = row.querySelector('.pl-toggle[data-target]');
                if (toggle) toggle.innerHTML = '&#9654;';
            }
        });
    }

    function hideDescendants(parentId) {
        (childrenMap[parentId] || []).forEach(function (childId) {
            var row = document.querySelector('tr[data-row-id="' + childId + '"]');
            if (row) {
                row.style.display = 'none';
                var toggle = row.querySelector('.pl-toggle[data-target]');
                if (toggle) toggle.innerHTML = '&#9654;';
            }
            hideDescendants(childId);
        });
    }
});
</script>
{% endblock %}
