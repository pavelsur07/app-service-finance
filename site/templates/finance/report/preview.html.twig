{% extends 'base.html.twig' %}

{% block title %}Отчёт о прибылях и убытках{% endblock %}

{% block body %}
    <main class="container-xl">
        {% set availableProjectIds = [] %}
        {% for projectDirection in projectDirections %}
            {% set availableProjectIds = availableProjectIds|merge([projectDirection.id]) %}
        {% endfor %}
        {% set availableResponsibilityCenterIds = [] %}
        {% for responsibilityCenter in responsibilityCenters %}
            {% set availableResponsibilityCenterIds = availableResponsibilityCenterIds|merge([responsibilityCenter.id]) %}
        {% endfor %}
        {# Legacy project-layout URLs never scoped columns by singular projectDirectionId. #}
        {% set uiSelectedProjectDirectionIds = layout == 'projects' and not dimensionFiltersPresent ? null : selectedProjectDirectionIds %}
        {% set submittedProjectIds = uiSelectedProjectDirectionIds ?? availableProjectIds %}
        {% set submittedResponsibilityCenterIds = selectedResponsibilityCenterIds ?? availableResponsibilityCenterIds %}
        {% set projectFilterTracked = projectDirections is not empty or selectedProjectDirectionIds is not null %}
        {% set responsibilityCenterFilterTracked = responsibilityCenters is not empty or selectedResponsibilityCenterIds is not null %}
        {% set projectFilterActive = uiSelectedProjectDirectionIds is not null %}
        {% set responsibilityCenterFilterActive = selectedResponsibilityCenterIds is not null %}
        {% set filtersActive = projectFilterActive or responsibilityCenterFilterActive or showMetaColumns %}
        {% set resetState = {
            'from': from|date('Y-m-d'),
            'to': to|date('Y-m-d'),
            'grouping': grouping,
            'layout': layout
        } %}
        {% if availableProjectIds is not empty %}
            {% set resetState = resetState|merge({
                'projectFiltersPresent': 1,
                'projectDirectionIds': availableProjectIds
            }) %}
        {% endif %}
        {% if availableResponsibilityCenterIds is not empty %}
            {% set resetState = resetState|merge({
                'responsibilityCenterFiltersPresent': 1,
                'responsibilityCenterIds': availableResponsibilityCenterIds
            }) %}
        {% endif %}

        {% set previewState = {
            'from': from|date('Y-m-d'),
            'to': to|date('Y-m-d'),
            'grouping': grouping,
            'layout': layout,
            'show_meta': showMetaColumns ? 1 : 0
        } %}
        {% if dimensionFiltersPresent %}
            {% if projectFilterTracked %}
                {% set previewState = previewState|merge({
                    'projectFiltersPresent': 1,
                    'projectDirectionIds': submittedProjectIds
                }) %}
            {% endif %}
            {% if responsibilityCenterFilterTracked %}
                {% set previewState = previewState|merge({
                    'responsibilityCenterFiltersPresent': 1,
                    'responsibilityCenterIds': submittedResponsibilityCenterIds
                }) %}
            {% endif %}
        {% else %}
            {% if selectedProjectDirectionId %}
                {% set previewState = previewState|merge({'projectDirectionId': selectedProjectDirectionId}) %}
            {% endif %}
            {% if selectedResponsibilityCenterId %}
                {% set previewState = previewState|merge({'responsibilityCenterId': selectedResponsibilityCenterId}) %}
            {% endif %}
        {% endif %}

        {% set monthNames = {
            1: 'Январь', 2: 'Февраль', 3: 'Март', 4: 'Апрель',
            5: 'Май', 6: 'Июнь', 7: 'Июль', 8: 'Август',
            9: 'Сентябрь', 10: 'Октябрь', 11: 'Ноябрь', 12: 'Декабрь'
        } %}
        {% set fromYear = from|date('Y') %}
        {% set toYear = to|date('Y') %}
        {% set fromMonth = from|date('n') %}
        {% set toMonth = to|date('n') %}
        {% if fromYear == toYear %}
            {% set reportPeriodLabel = fromMonth == toMonth ? monthNames[fromMonth] ~ ' ' ~ fromYear : monthNames[fromMonth] ~ ' – ' ~ monthNames[toMonth] ~ ' ' ~ toYear %}
        {% else %}
            {% set reportPeriodLabel = monthNames[fromMonth] ~ ' ' ~ fromYear ~ ' – ' ~ monthNames[toMonth] ~ ' ' ~ toYear %}
        {% endif %}

        <header class="page-header mb-3">
            <div class="row g-2 align-items-start">
                <div class="col">
                    <h2 class="page-title">Отчёт о прибылях и убытках</h2>
                    <p class="text-secondary mb-0">{{ reportPeriodLabel }}</p>
                    {% include 'company/_tax_profile_line.html.twig' %}
                </div>
                <div class="col-auto ms-auto d-print-none">
                    <div class="btn-list">
                        <a
                            href="{{ path('finance_report_preview_xlsx', previewState) }}"
                            class="btn btn-outline-secondary"
                            title="Скачать текущий отчёт в формате XLSX"
                            data-testid="btn-export-xlsx"
                        >
                            <i class="ti ti-file-spreadsheet" aria-hidden="true"></i>
                            XLSX
                        </a>
                        <a
                            href="{{ path('finance_report_preview_json', previewState) }}"
                            class="btn btn-outline-secondary"
                            title="Скачать отчёт в формате JSON для проверки"
                        >
                            <i class="ti ti-download" aria-hidden="true"></i>
                            JSON
                        </a>
                    </div>
                </div>
            </div>
        </header>

        {% include 'finance/report/preview/_filters.html.twig' with {
            from: from,
            to: to,
            grouping: grouping,
            layout: layout,
            projectFilterTracked: projectFilterTracked,
            projectFilterActive: projectFilterActive,
            uiSelectedProjectDirectionIds: uiSelectedProjectDirectionIds,
            projectDirections: projectDirections,
            responsibilityCenterFilterTracked: responsibilityCenterFilterTracked,
            responsibilityCenterFilterActive: responsibilityCenterFilterActive,
            selectedResponsibilityCenterIds: selectedResponsibilityCenterIds,
            responsibilityCenters: responsibilityCenters,
            showMetaColumns: showMetaColumns,
            filtersActive: filtersActive,
            resetState: resetState
        } only %}

        {% if warnings is not empty %}
            <div class="alert alert-warning mb-3">
                <strong>Предупреждения:</strong>
                <ul class="mb-0">
                    {% for w in warnings %}<li>{{ w }}</li>{% endfor %}
                </ul>
            </div>
        {% endif %}

        {% include 'finance/report/preview/_table.html.twig' with {
            rows: rows,
            formats: formats|default({}),
            periods: periods,
            compareProjects: compareProjects|default([]),
            layout: layout,
            grouping: grouping,
            showMetaColumns: showMetaColumns
        } only %}
    </main>

{% endblock %}
