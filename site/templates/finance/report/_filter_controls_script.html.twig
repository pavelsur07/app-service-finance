<script>
document.addEventListener('DOMContentLoaded', function () {
    var form = document.getElementById('{{ reportControlsFormId|default('pl-preview-filter-form')|e('js') }}');
    if (!form) return;

    var exactFrom = form.querySelector('[data-pl-exact-from]');
    var exactTo = form.querySelector('[data-pl-exact-to]');
    var monthFrom = form.querySelector('[data-pl-month-from]');
    var monthTo = form.querySelector('[data-pl-month-to]');

    function submitFilters() {
        if (typeof form.requestSubmit === 'function') {
            form.requestSubmit();
        } else {
            form.submit();
        }
    }

    function monthEnd(month) {
        var parts = month.split('-');
        var year = Number(parts[0]);
        var monthNumber = Number(parts[1]);
        var day = new Date(Date.UTC(year, monthNumber, 0)).getUTCDate();

        return month + '-' + String(day).padStart(2, '0');
    }

    function validMonth(month) {
        return /^\d{4}-(0[1-9]|1[0-2])$/.test(month);
    }

    function activatePluralFilter(group) {
        var legacyFilter = form.querySelector('[data-pl-legacy-filter="' + group + '"]');
        if (!legacyFilter) return;

        legacyFilter.remove();
        var marker = form.querySelector('[data-pl-filter-marker="' + group + '"]');
        if (marker) marker.disabled = false;
        form.querySelectorAll('[data-pl-filter-input="' + group + '"][data-pl-filter-name]').forEach(function (input) {
            input.name = input.getAttribute('data-pl-filter-name');
            input.removeAttribute('data-pl-filter-name');
        });
    }

    form.querySelectorAll('[data-pl-period-from][data-pl-period-to]').forEach(function (button) {
        button.addEventListener('click', function () {
            exactFrom.value = button.getAttribute('data-pl-period-from');
            exactTo.value = button.getAttribute('data-pl-period-to');
            submitFilters();
        });
    });

    monthFrom.addEventListener('change', function () {
        if (!validMonth(monthFrom.value)) return;

        exactFrom.value = monthFrom.value + '-01';
        if (exactFrom.value > exactTo.value) {
            monthTo.value = monthFrom.value;
            exactTo.value = monthEnd(monthFrom.value);
        }
        submitFilters();
    });

    monthTo.addEventListener('change', function () {
        if (!validMonth(monthTo.value)) return;

        exactTo.value = monthEnd(monthTo.value);
        if (exactTo.value < exactFrom.value) {
            monthFrom.value = monthTo.value;
            exactFrom.value = monthTo.value + '-01';
        }
        submitFilters();
    });

    form.querySelectorAll('[data-pl-set]').forEach(function (button) {
        button.addEventListener('click', function () {
            var target = button.getAttribute('data-pl-set');
            var input = form.querySelector('[data-pl-' + target + ']');
            if (!input) return;

            input.value = button.getAttribute('data-pl-value');
            submitFilters();
        });
    });

    form.querySelectorAll('[data-pl-filter-input]').forEach(function (input) {
        input.addEventListener('change', function () {
            activatePluralFilter(input.getAttribute('data-pl-filter-input'));
            submitFilters();
        });
    });

    form.querySelectorAll('[data-pl-auto-submit]').forEach(function (input) {
        input.addEventListener('change', submitFilters);
    });

    form.querySelectorAll('[data-pl-select-all]').forEach(function (button) {
        button.addEventListener('click', function () {
            var group = button.getAttribute('data-pl-select-all');
            activatePluralFilter(group);
            form.querySelectorAll('[data-pl-filter-input="' + group + '"]').forEach(function (input) {
                input.checked = true;
            });
            submitFilters();
        });
    });

    var dropdowns = Array.from(form.querySelectorAll('details.pl-preview-dropdown'));
    dropdowns.forEach(function (dropdown) {
        dropdown.addEventListener('toggle', function () {
            if (!dropdown.open) return;

            dropdowns.forEach(function (otherDropdown) {
                if (otherDropdown !== dropdown) otherDropdown.open = false;
            });
        });
    });

    document.addEventListener('click', function (event) {
        if (event.target.closest('.pl-preview-dropdown')) return;

        dropdowns.forEach(function (dropdown) {
            dropdown.open = false;
        });
    });
});
</script>
