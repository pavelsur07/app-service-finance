.pl-preview-controls-card {
    border-color: var(--vf-border);
    box-shadow: none;
}
.pl-preview-controls-card.card-body,
.pl-preview-controls-card .card-body {
    display: flex;
    flex-direction: column;
    gap: 14px;
    padding: 16px 20px;
}
.pl-preview-controls-row {
    display: flex;
    align-items: center;
    gap: 20px;
    row-gap: 12px;
    flex-wrap: wrap;
}
.pl-preview-filters-row {
    display: flex;
    align-items: center;
    gap: 10px;
    flex-wrap: wrap;
    padding-top: 14px;
    border-top: 1px solid var(--vf-border);
}
.pl-preview-control-group {
    display: flex;
    align-items: center;
    gap: 10px;
}
.pl-preview-control-label {
    color: var(--vf-text-muted);
    font-size: 12.5px;
    font-weight: 600;
    white-space: nowrap;
}
.pl-preview-dropdown {
    position: relative;
}
.pl-preview-dropdown > summary {
    list-style: none;
}
.pl-preview-dropdown > summary::-webkit-details-marker {
    display: none;
}
.pl-preview-period-button,
.pl-preview-filter-chip {
    display: flex;
    align-items: center;
    gap: 6px;
    min-height: 34px;
    padding: 7px 11px;
    border: 1px solid var(--vf-border);
    border-radius: 6px;
    background: var(--vf-surface);
    color: var(--vf-text);
    font-size: 13px;
    font-weight: 600;
    line-height: 1.2;
    cursor: pointer;
    white-space: nowrap;
}
.pl-preview-period-button:hover,
.pl-preview-period-button:focus-visible,
.pl-preview-filter-chip:hover,
.pl-preview-filter-chip:focus-visible {
    border-color: var(--vf-border-strong);
}
.pl-preview-filter-chip.is-active {
    border-color: var(--vf-primary);
    background: var(--vf-primary-lt);
    color: var(--vf-primary);
}
.pl-preview-period-button .ti,
.pl-preview-filter-chip .ti-chevron-down {
    color: var(--vf-text-muted);
}
.pl-preview-dropdown-menu {
    position: absolute;
    top: calc(100% + 6px);
    left: 0;
    z-index: 30;
    width: min(280px, calc(100vw - 32px));
    padding: 12px;
    border: 1px solid var(--vf-border);
    border-radius: 8px;
    background: var(--vf-surface);
    box-shadow: var(--vf-shadow-md);
}
.pl-preview-filter-menu {
    width: min(260px, calc(100vw - 32px));
    max-height: min(420px, calc(100vh - 120px));
    padding: 8px;
    overflow-y: auto;
}
.pl-preview-preset {
    display: block;
    width: 100%;
    padding: 7px 8px;
    border: 0;
    border-radius: 5px;
    background: transparent;
    color: var(--vf-text);
    font-size: 13px;
    text-align: left;
}
.pl-preview-preset:hover,
.pl-preview-preset:focus-visible,
.pl-preview-filter-option:hover {
    background: var(--vf-bg);
}
.pl-preview-month-range {
    display: flex;
    align-items: flex-end;
    gap: 8px;
    margin-top: 10px;
    padding-top: 10px;
    border-top: 1px solid var(--vf-border);
}
.pl-preview-month-field {
    flex: 1;
    min-width: 0;
}
.pl-preview-month-field label {
    display: block;
    margin-bottom: 4px;
    color: var(--vf-text-muted);
    font-size: 11px;
}
.pl-preview-month-field .form-control {
    min-height: 32px;
    padding: 5px 7px;
    font-size: 12.5px;
}
.pl-preview-segmented {
    display: flex;
    gap: 2px;
    padding: 3px;
    border-radius: 6px;
    background: var(--vf-bg);
}
.pl-preview-segmented button {
    padding: 5px 10px;
    border: 0;
    border-radius: 4px;
    background: transparent;
    color: var(--vf-text-muted);
    font-size: 12.5px;
    font-weight: 600;
    line-height: 1.35;
    white-space: nowrap;
}
.pl-preview-segmented button.is-active {
    background: var(--vf-surface);
    color: var(--vf-text);
    box-shadow: var(--vf-shadow-sm);
}
.pl-preview-segmented.is-disabled {
    opacity: .5;
}
.pl-preview-filter-option {
    display: flex;
    align-items: center;
    gap: 8px;
    margin: 0;
    padding: 7px 8px;
    border-radius: 5px;
    font-size: 13px;
    cursor: pointer;
}
.pl-preview-filter-option input {
    width: 14px;
    height: 14px;
    margin: 0;
    accent-color: var(--vf-primary);
    cursor: pointer;
}
.pl-preview-filter-menu-footer {
    display: flex;
    align-items: center;
    justify-content: flex-end;
    gap: 8px;
    margin-top: 6px;
    padding: 6px 8px 0;
    border-top: 1px solid var(--vf-border);
}
.pl-preview-filter-menu-footer button {
    padding: 0;
    border: 0;
    background: transparent;
    color: var(--vf-primary);
    font-size: 12.5px;
    font-weight: 600;
}
.pl-preview-filter-menu-empty {
    padding: 7px 8px;
    color: var(--vf-text-muted);
    font-size: 13px;
}
.pl-preview-meta-chip {
    position: relative;
    margin: 0;
}
.pl-preview-meta-chip input {
    position: absolute;
    width: 1px;
    height: 1px;
    opacity: 0;
}
.pl-preview-meta-chip input:focus-visible + .pl-preview-filter-chip {
    outline: 2px solid var(--vf-primary);
    outline-offset: 2px;
}
.pl-preview-reset {
    display: inline-flex;
    align-items: center;
    gap: 4px;
    padding: 0;
    border: 0;
    background: transparent;
    /* DS: сброс фильтров — не деструктивное действие, красный только для удаления. */
    color: var(--vf-primary);
    font-size: 12.5px;
    font-weight: 600;
    text-decoration: none;
}
.pl-preview-reset:hover {
    color: var(--tblr-link-hover-color);
    text-decoration: none;
}
@media (max-width: 767.98px) {
    .pl-preview-controls-card.card-body,
    .pl-preview-controls-card .card-body {
        padding: 14px;
    }
    .pl-preview-controls-row {
        align-items: flex-start;
        gap: 12px;
    }
    .pl-preview-control-group {
        flex-wrap: wrap;
    }
}
@media (min-width: 768px) {
    .pl-preview-dropdown-align-end .pl-preview-dropdown-menu {
        right: 0;
        left: auto;
    }
}
