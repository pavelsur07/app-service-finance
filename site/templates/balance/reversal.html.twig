{% extends 'balance/layout.html.twig' %}
{% form_theme form 'bootstrap_5_layout.html.twig' %}
{% block balance_content %}
    <div class="vf-page-head">
        <h1 class="page-title d-block">Сторно документа № {{ document.number }}
        </h1>
    </div>
    <section class="card vf-card mb-4"><div class="card-body">
        <p>Будет проведен документ с обратными изменениями всех счетов. Исходный документ останется в истории.</p>{{ form_start(form) }}{{ form_widget(form) }}
        <button class="btn btn-danger">Провести сторно</button>
        <a class="btn btn-outline-secondary" href="{{ path('balance_document', {id: document.id}) }}">Отмена</a>{{ form_end(form) }}
    </div></section>
{% endblock %}
