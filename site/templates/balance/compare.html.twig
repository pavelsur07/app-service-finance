{% extends 'balance/layout.html.twig' %}
{% import 'balance/_macros.html.twig' as ui %}
{% block balance_content %}
    <div class="wz-head">
        <h1 class="wz-title">Сравнение двух дат</h1>
    </div>{{ ui.period(from,to) }}
    {% if not comparison.before.initialized or not comparison.after.initialized %}
        <div class="wz-row">
            <div class="alert alert--info" role="status"><div class="a-body"><p class="a-text">На одной из выбранных дат учет еще не начат.</p></div></div>
        </div>
    {% endif %}
    <section class="card report-scroll">
        <table class="t-table">
            <thead>
                <tr>
                    <th>Счет / статья</th>
                    <th class="t-cell--right">{{ ui.col(ui.date(from), currency) }}</th>
                    <th class="t-cell--right">{{ ui.col(ui.date(to), currency) }}</th>
                    <th class="t-cell--right">{{ ui.col('Изменение', currency) }}</th>
                </tr>
            </thead>
            <tbody>
                {% for row in comparison.after.accounts %}
                    <tr>
                        <td>
                            <a href="{{ path('balance_account_card',{id:row.id,from:from,to:to}) }}">{{ row.name }}</a>
                            <p class="t-sub">{{ row.article_name }}</p>
                        </td>
                        {% for key in ['before','closing','change'] %}
                            <td class="t-cell--right">{{ ui.amount(attribute(row,key), currency) }}</td>
                        {% endfor %}
                    </tr>
                {% else %}
                    <tr>
                        <td class="t-empty" colspan="4">Нет учетных счетов.</td>
                    </tr>
                {% endfor %}
            </tbody>
        </table>
    </section>
{% endblock %}
