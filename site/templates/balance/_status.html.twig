{# Статус документа баланса (DS-Feedback): черновик — нейтральный, проведён — OK, сторнирован — Warn. #}
{% if status == 'draft' %}
    <span class="badge bg-secondary-lt">Черновик</span>
{% else %}
    <span class="badge bg-success-lt">Проведен</span>
{% endif %}
{% if reversed|default(false) %}
    <span class="badge bg-warning-lt">Сторнирован</span>
{% endif %}
