{% extends 'balance/layout.html.twig' %}
{% import 'balance/_macros.html.twig' as ui %}
{% block balance_content %}
    <div class="wz-head">
        <h1 class="wz-title">Баланс<span class="wz-sub">Состояние на конец выбранной даты</span>
        </h1>
    </div>
    <form method="get" class="wz-row wz-filters">
        <div class="form-field">
            <label class="form-label" for="balance-date">Дата</label>
            <input class="input" id="balance-date" type="date" name="date" required value="{{ date }}">
        </div>
        <div class="wz-row-actions">
            <button class="btn btn-md btn-primary">Показать</button>
        </div>
    </form>
    {% if not report.initialized %}
        <section class="card empty">
            <h2 class="empty-title">Учет не начат</h2>
            <p class="empty-text">На выбранную дату нет проведенных начальных остатков.</p>
            {% if permissions.manage %}
                <a class="btn btn-md btn-primary" href="{{ path('balance_setup') }}">Настроить учет</a>
            {% endif %}
            {% if permissions.prepare and book.currency|default(null) %}
                <a class="btn btn-md btn-secondary" href="{{ path('balance_document_new') }}">Ввести начальные остатки</a>
            {% endif %}
        </section>
    {% else %}
        {# KPI (DS-Money): сокращённо до одного знака, полная сумма — в подсказке. #}
        {% set digits = vf_currency_digits(currency) %}
        {% set symbol = vf_currency_symbol(currency) %}
        {% set mismatch = report.differenceMinor != 0 %}
        <div class="wz-row">
            {% for kpi in [
                {label: 'Актив', minor: report.assetMinor},
                {label: 'Пассив', minor: report.passiveMinor},
                {label: 'Расхождение', minor: report.differenceMinor, error: mismatch},
            ] %}
                {% set value = kpi.minor|vf_minor(digits) %}
                <section class="kpi{{ kpi.error|default(false) ? ' kpi--accent-danger' : '' }}">
                    <div class="kpi-label">{{ kpi.label }}</div>
                    <div class="kpi-value{{ kpi.error|default(false) ? ' money--error' : '' }}" title="{{ value|vf_money(digits, currency) }}">{{ value|vf_money_short(symbol) }}</div>
                    {% if kpi.error is defined %}
                        {# Ненулевое расхождение — сигнал ошибки учёта (решение Владельца №4), а не сумма-расход. #}
                        <div class="kpi-meta">{{ kpi.error ? 'Актив и пассив не равны' : 'Актив и пассив равны' }}</div>
                    {% endif %}
                </section>
            {% endfor %}
        </div>
        <div class="wz-row">
            {% for side,label in {'asset':'Актив','passive':'Пассив'} %}
                <section class="card report-scroll">
                    <h2>{{ label }}</h2>
                    <table class="t-table">
                        <thead>
                            <tr>
                                <th>Статья</th>
                                <th class="t-cell--right">{{ ui.col('Остаток', currency) }}</th>
                            </tr>
                        </thead>
                        <tbody>
                            {% for item in report.roots %}
                                {% if item.type == side %}
                                    {{ ui.tree([item], currency) }}
                                {% endif %}
                            {% endfor %}
                        </tbody>
                    </table>
                </section>
            {% endfor %}
        </div>
    {% endif %}
{% endblock %}
