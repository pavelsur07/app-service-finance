{% extends 'balance/layout.html.twig' %}
{% import 'balance/_macros.html.twig' as ui %}
{% block balance_content %}
    <div class="wz-head">
        <h1 class="wz-title">Баланс<span class="wz-sub">Состояние на конец выбранной даты</span>
        </h1>
    </div>
    <form method="get" class="wz-row">
        <div class="form-field">
            <label class="form-label" for="balance-date">Дата</label>
            <input class="input" id="balance-date" type="date" name="date" required value="{{ date }}">
        </div>
        <div>
            <button class="btn btn-md btn-primary">Показать</button>
        </div>
    </form>
    {% if not report.initialized %}
        <section class="card empty">
            <h2 class="empty-title">Учет не начат</h2>
            <p class="empty-text">На выбранную дату нет проведенных начальных остатков.</p>
            {% if permissions.manage %}
                <a class="btn btn-md btn-primary" href="{{ path('balance_setup') }}">Настроить учет</a>
            {% endif %}
            {% if permissions.prepare and book.currency|default(null) %}
                <a class="btn btn-md btn-secondary" href="{{ path('balance_document_new') }}">Ввести начальные остатки</a>
            {% endif %}
        </section>
    {% else %}
        <div class="wz-row">
            <section class="card">
                <h2>Актив</h2>
                <p>{{ report.assetMinor|format_minor_currency(currency) }}
                </p>
            </section>
            <section class="card">
                <h2>Пассив</h2>
                <p>{{ report.passiveMinor|format_minor_currency(currency) }}
                </p>
            </section>
            <section class="card">
                <h2>Расхождение</h2>
                <p>{{ report.differenceMinor|format_minor_currency(currency) }}
                </p>
            </section>
        </div>
        <div class="wz-row">
            {% for side,label in {'asset':'Актив','passive':'Пассив'} %}
                <section class="card report-scroll">
                    <h2>{{ label }}
                    </h2>
                    <table class="t-table">
                        <thead>
                            <tr>
                                <th>Статья</th>
                                <th class="t-cell--right">Остаток</th>
                            </tr>
                        </thead>
                        <tbody>
                            {% for item in report.roots %}
                                {% if item.type == side %}
                                    {{ ui.tree([item], currency) }}
                                {% endif %}
                            {% endfor %}
                        </tbody>
                    </table>
                </section>
            {% endfor %}
        </div>
    {% endif %}
{% endblock %}
