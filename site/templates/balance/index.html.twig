{% extends 'balance/layout.html.twig' %}
{% import 'balance/_macros.html.twig' as ui %}
{% block balance_content %}
    <div class="vf-page-head">
        <h1 class="page-title d-block">Баланс<span class="d-block text-secondary fs-5 fw-normal mt-1">Состояние на конец выбранной даты</span>
        </h1>
    </div>
    <form method="get" class="card vf-card mb-4"><div class="card-body row g-3 align-items-end">
        <div class="col-12 col-sm-auto">
            <label class="form-label" for="balance-date">Дата</label>
            <input class="form-control" id="balance-date" type="date" name="date" required value="{{ date }}">
        </div>
        <div class="col-auto">
            <button class="btn btn-primary">Показать</button>
        </div>
    </div></form>
    {% if not report.initialized %}
        <section class="card vf-card mb-4 empty"><div class="card-body">
            <h2 class="empty-title">Учет не начат</h2>
            <p class="empty-subtitle">На выбранную дату нет проведенных начальных остатков.</p>
            {% if permissions.manage %}
                <a class="btn btn-primary" href="{{ path('balance_setup') }}">Настроить учет</a>
            {% endif %}
            {% if permissions.prepare and book.currency|default(null) %}
                <a class="btn btn-outline-secondary" href="{{ path('balance_document_new') }}">Ввести начальные остатки</a>
            {% endif %}
        </div></section>
    {% else %}
        {# Баланс — учётный отчёт: итоги до копейки, без сокращения (решение Владельца 2026-10-12). #}
        {% set digits = vf_currency_digits(currency) %}
        {% set difference = report.differenceMinor|vf_minor(digits) %}
        {% set mismatch = report.differenceMinor != 0 %}
        <div class="balance-kpis mb-4">
            {% for kpi in [{label: 'Актив', minor: report.assetMinor}, {label: 'Пассив', minor: report.passiveMinor}] %}
                <section class="card vf-card"><div class="card-body">
                    <div class="text-secondary mb-2">{{ kpi.label }}</div>
                    <div class="h1 mb-0" data-balance-value>{{ kpi.minor|vf_minor(digits)|vf_money(digits, currency) }}</div>
                </div></section>
            {% endfor %}
            {# Ненулевое расхождение — сигнал ошибки учёта (решение Владельца №4): красным, до копейки и с пояснением. #}
            <section class="card vf-card{{ mismatch ? ' border-danger' : '' }}" data-balance-mismatch="{{ mismatch ? 'true' : 'false' }}"><div class="card-body">
                <div class="text-secondary mb-2">Расхождение</div>
                <div class="h1 mb-0{{ mismatch ? ' text-danger' : '' }}" data-balance-value>{{ difference|vf_money(digits, currency) }}</div>
                {% if not mismatch %}
                    <div class="text-secondary mt-2" data-balance-explanation>Актив и пассив равны</div>
                {% else %}
                    <div class="text-danger mt-2" data-balance-explanation>
                        {{ difference starts with '-' ? 'Пассив больше актива' : 'Актив больше пассива' }} на {{ difference|vf_money(digits, currency)|replace({'−': ''}) }}. Проверьте проведённые документы за период.
                    </div>
                {% endif %}
            </div></section>
        </div>
        <div class="balance-kpis mb-4">
            {% for side, label in {'asset': 'Актив', 'passive': 'Пассив'} %}
                <section class="card vf-card mb-4"><div class="card-body">
                    <h2 class="card-title">{{ label }}</h2>
                    <div class="table-responsive"><table class="table table-vcenter vf-table">
                        <thead>
                            <tr>
                                <th>Статья</th>
                                <th class="text-end text-nowrap">{{ ui.col('Остаток', currency) }}</th>
                            </tr>
                        </thead>
                        <tbody>
                            {% for item in report.roots %}
                                {% if item.type == side %}
                                    {{ ui.tree([item], currency) }}
                                {% endif %}
                            {% endfor %}
                        </tbody>
                    </table></div>
                </div></section>
            {% endfor %}
        </div>
    {% endif %}
{% endblock %}
