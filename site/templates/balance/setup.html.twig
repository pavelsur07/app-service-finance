{% extends 'balance/layout.html.twig' %}
{% form_theme form 'bootstrap_5_layout.html.twig' %}
{% block balance_content %}
    <div class="vf-page-head">
        <h1 class="page-title d-block">Начало учета</h1>
    </div>
    <div class="d-flex flex-wrap gap-3 mb-4">
        <section class="card vf-card mb-4"><div class="card-body">
            <p>Выберите валюту и дату, настройте статьи и счета, затем проведите начальные остатки. Стороны баланса должны быть равны.</p>
            {% if book.initialized|default(false) %}
                <p>Учет начат. Валюта и начальная дата зафиксированы.</p>
            {% endif %}
            {{ form_start(form) }}{{ form_widget(form) }}
            {% if not book.initialized|default(false) %}
                <button class="btn btn-primary">Сохранить настройки</button>
            {% endif %}
            {{ form_end(form) }}
        </div></section>
    </div>
    {% if book %}
        <p>
            <a href="{{ path('balance_audit', {type: 'book', id: book.id}) }}">История настроек учета</a>
        </p>
    {% endif %}
    <form method="post" action="{{ path('balance_structure_seed') }}">
        <input type="hidden" name="_token" value="{{ csrf_token('balance_seed') }}">
        <p>Если статей еще нет, можно создать базовую структуру. Существующие статьи не изменятся.</p>
        <button class="btn btn-outline-secondary">Создать базовую структуру</button>
    </form>
    <div class="btn-list mt-3">
        <a class="btn btn-outline-secondary" href="{{ path('balance_structure_index') }}">1. Структура статей</a>
        <a class="btn btn-outline-secondary" href="{{ path('balance_accounts') }}">2. Учетные счета</a>
        <a class="btn btn-outline-secondary" href="{{ path('balance_document_new') }}">3. Начальные остатки</a>
    </div>
{% endblock %}
