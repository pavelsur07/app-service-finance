{% extends 'balance/layout.html.twig' %}
{% import 'balance/_macros.html.twig' as ui %}
{% block balance_content %}
    <div class="vf-page-head">
        <h1 class="page-title d-block">Документ № {{ document.number }}
            <span class="d-block text-secondary fs-5 fw-normal mt-1">{% include 'balance/_status.html.twig' with {status: document.status, reversed: document.reversal_id} only %} · {{ ui.date(document.operation_date) }}</span>
        </h1>
    </div>
    <section class="card vf-card mb-4"><div class="card-body">
        <p>{{ document.reason }}
        </p>
        {% if document.original_operation_id %}
            <p>
                <a href="{{ path('balance_document', {id: document.original_operation_id}) }}">Исходный документ</a>
            </p>
        {% endif %}
        {% if document.reversal_id %}
            <p>
                <a href="{{ path('balance_document', {id: document.reversal_id}) }}">Сторнирующий документ</a>
            </p>
        {% endif %}
        <div class="table-responsive"><table class="table table-vcenter vf-table">
            <thead>
                <tr>
                    <th>Счет</th>
                    <th>Сторона</th>
                    <th>Изменение</th>
                    <th class="text-end text-nowrap">{{ ui.col('Сумма', currency) }}</th>
                </tr>
            </thead>
            <tbody>
                {% for line in document.lines %}
                    <tr>
                        <td>
                            <a href="{{ path('balance_account_card', {id: line.account_id}) }}">{{ line.account_name }}
                            </a>
                        </td>
                        <td>{{ line.type == 'asset' ? 'Актив' : 'Пассив' }}
                        </td>
                        <td>{{ line.direction == 'increase' ? 'Увеличение' : 'Уменьшение' }}
                        </td>
                        <td class="text-end text-nowrap">{{ ui.amount(line.amount, currency) }}</td>
                    </tr>
                {% else %}
                    <tr>
                        <td class="text-center text-secondary py-5" colspan="4">Начало учета с нулевыми остатками.</td>
                    </tr>
                {% endfor %}
            </tbody>
        </table></div>
        {% if document.status == 'posted' %}
            <p>Проведен {{ ui.datetime(document.posted_at) }}. Проведенные данные неизменяемы.</p>
        {% elseif permissions.post %}
            <form method="post" action="{{ path('balance_document_post', {id: document.id}) }}">
                <input type="hidden" name="_token" value="{{ csrf_token('document_post_' ~ document.id) }}">
                <input type="hidden" name="version" value="{{ document.version }}">
                {% if document.kind == 'opening' and document.lines is empty %}
                    <label class="form-check">
                        <input class="form-check-input" type="checkbox" name="confirm_zero" value="1" required> <span class="form-check-label">Подтверждаю начало учета с нулевыми остатками</span></label>
                {% endif %}
                <button class="btn btn-primary">Провести сохраненный документ</button>
            </form>
        {% endif %}
        <div class="btn-list mt-3">
            {% if permissions.post and document.status == 'posted' and document.kind != 'opening' and not document.reversal_id %}
                <a class="btn btn-danger" href="{{ path('balance_document_reverse', {id: document.id}) }}">Оформить сторно</a>
            {% endif %}
            <a class="btn btn-outline-secondary" href="{{ path('balance_audit', {type: 'operation', id: document.id}) }}">История документа</a>
            <a class="btn btn-outline-secondary" href="{{ path('balance_journal') }}">Журнал</a>
        </div>
    </div></section>
{% endblock %}
