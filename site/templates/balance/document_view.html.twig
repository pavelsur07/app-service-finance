{% extends 'balance/layout.html.twig' %}
{% block balance_content %}
    <div class="wz-head">
        <h1 class="wz-title">Документ № {{ document.number }}
            <span class="wz-sub">{{ document.status == 'posted' ? 'Проведен':'Черновик' }} · {{ document.operation_date }}
            </span>
        </h1>
    </div>
    <section class="card report-scroll">
        <p>{{ document.reason }}
        </p>
        {% if document.original_operation_id %}
            <p>
                <a href="{{ path('balance_document',{id:document.original_operation_id}) }}">Исходный документ</a>
            </p>
        {% endif %}
        {% if document.reversal_id %}
            <p>
                <a href="{{ path('balance_document',{id:document.reversal_id}) }}">Сторнирующий документ</a>
            </p>
        {% endif %}
        <table class="t-table">
            <thead>
                <tr>
                    <th>Счет</th>
                    <th>Сторона</th>
                    <th>Изменение</th>
                    <th>Сумма</th>
                </tr>
            </thead>
            <tbody>
                {% for line in document.lines %}
                    <tr>
                        <td>
                            <a href="{{ path('balance_account_card',{id:line.account_id}) }}">{{ line.account_name }}
                            </a>
                        </td>
                        <td>{{ line.type == 'asset' ? 'Актив':'Пассив' }}
                        </td>
                        <td>{{ line.direction == 'increase' ? 'Увеличение':'Уменьшение' }}
                        </td>
                        <td>{{ line.amount|format_minor_currency(currency) }}
                        </td>
                    </tr>
                {% else %}
                    <tr>
                        <td colspan="4">Начало учета с нулевыми остатками.</td>
                    </tr>
                {% endfor %}
            </tbody>
        </table>
        {% if document.status == 'posted' %}
            <p>Проведен {{ document.posted_at }}. Проведенные данные неизменяемы.</p>
        {% elseif permissions.post %}
            <form method="post" action="{{ path('balance_document_post',{id:document.id}) }}">
                <input type="hidden" name="_token" value="{{ csrf_token('document_post_'~document.id) }}">
<input type="hidden" name="version" value="{{ document.version }}">
                {% if document.kind == 'opening' and document.lines is empty %}
                    <label class="checkbox-label">
                        <input class="checkbox" type="checkbox" name="confirm_zero" value="1" required> Подтверждаю начало учета с нулевыми остатками</label>
                {% endif %}
                <button class="btn btn-md btn-primary">Провести сохраненный документ</button>
            </form>
        {% endif %}
        <div class="wz-row">
            {% if permissions.post and document.status == 'posted' and document.kind != 'opening' and not document.reversal_id %}
                <a class="btn btn-md btn-danger" href="{{ path('balance_document_reverse',{id:document.id}) }}">Оформить сторно</a>
            {% endif %}
            <a class="btn btn-md btn-secondary" href="{{ path('balance_audit',{type:'operation',id:document.id}) }}">История документа</a>
            <a class="btn btn-md btn-secondary" href="{{ path('balance_journal') }}">Журнал</a>
        </div>
    </section>
{% endblock %}
