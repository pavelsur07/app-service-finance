{% extends 'balance/layout.html.twig' %}
{% import 'balance/_macros.html.twig' as ui %}
{% form_theme form 'bootstrap_5_layout.html.twig' %}
{% block balance_content %}
    <div class="vf-page-head">
        <h1 class="page-title d-block">{{ document ? 'Черновик № ' ~ document.number : 'Новый документ' }}
        </h1>
    </div>
    {% if document.target_preparation|default(null) %}
        <section class="card vf-card mb-4"><div class="card-body">
            <p>Это корректировка до заданного остатка. Если учет изменился после расчета, обновите корректировку перед проведением.</p>
            <a class="btn btn-outline-secondary" href="{{ path('balance_account_target', {id: document.target_preparation.accountId, document: document.id}) }}">Обновить расчет остатка</a>
        </div></section>
    {% endif %}
    <section class="card vf-card mb-4"><div class="card-body">{{ form_start(form) }}{{ form_errors(form) }}{{ form_row(form.kind) }}{{ form_row(form.date) }}{{ form_row(form.reason) }}
        {% include 'balance/_document_lines.html.twig' %}
        {{ form_rest(form) }}
        <p>Черновик не меняет остатки. Сначала сохраните изменения, затем проведите документ.</p>
        <button class="btn btn-primary">Сохранить черновик</button>{{ form_end(form) }}
    </div></section>
    {% if document %}
        <div class="d-flex flex-wrap gap-3 mb-4">
            <section class="card vf-card mb-4"><div class="card-body">
                {% if permissions.post %}
                    <form method="post" action="{{ path('balance_document_post', {id: document.id}) }}">
                        <input type="hidden" name="_token" value="{{ csrf_token('document_post_' ~ document.id) }}">
                        <input type="hidden" name="version" value="{{ document.version }}">
                        {% if document.kind == 'opening' and document.lines is empty %}
                            <label class="form-check">
                                <input class="form-check-input" type="checkbox" name="confirm_zero" value="1" required> <span class="form-check-label">Подтверждаю начало учета с нулевыми остатками</span></label>
                        {% endif %}
                        <button class="btn btn-primary">Провести сохраненный документ</button>
                    </form>
                {% endif %}
                {{ ui.confirm(path('balance_document_delete', {id: document.id}), csrf_token('document_delete_' ~ document.id), 'Удалить черновик', 'Черновик будет удален. Остатки не изменятся.', {version: document.version}) }}
                <a href="{{ path('balance_audit', {type: 'operation', id: document.id}) }}">История документа</a>
            </div></section>
        </div>
    {% endif %}
{% endblock %}
