{% extends 'balance/layout.html.twig' %}
{% import 'balance/_macros.html.twig' as ui %}
{% block balance_content %}
    <div class="vf-page-head">
        <h1 class="page-title d-block">Учетные счета<span class="d-block text-secondary fs-5 fw-normal mt-1">Остатки на {{ 'now'|date('d.m.Y', 'Europe/Moscow') }}</span>
        </h1>
        {% if permissions.manage %}
            <div class="btn-list">
                <a class="btn btn-primary" href="{{ path('balance_account_new') }}">Создать счет</a>
            </div>
        {% endif %}
    </div>
    <section class="card vf-card mb-4"><div class="card-body">
        <div class="table-responsive"><table class="table table-vcenter vf-table">
            <thead>
                <tr>
                    <th>Счет</th>
                    <th>Статья</th>
                    <th class="text-end text-nowrap">{{ ui.col('Остаток', currency) }}</th>
                    <th>Правила</th>
                    <th class="text-end text-nowrap">Действия</th>
                </tr>
            </thead>
            <tbody>
                {% for item in items %}
                    <tr>
                        <td>
                            <a href="{{ path('balance_account_card', {id: item.id}) }}">{{ item.name }}</a>
                            {% if item.is_archived %} <span class="badge bg-secondary-lt">В архиве</span>{% endif %}
                            <p class="text-secondary small mb-0">{{ item.code }}</p>
                        </td>
                        <td>
                            <a href="{{ path('balance_article_card', {id: item.article_id}) }}">{{ item.article_name }}</a>
                        </td>
                        <td class="text-end text-nowrap">{{ ui.amount(item.balance, currency) }}</td>
                        <td>{{ item.allow_negative ? 'Отрицательный остаток разрешен' : 'Отрицательный остаток запрещен' }}</td>
                        <td>
                            <div class="d-flex flex-wrap gap-2">
                                {% if permissions.manage %}
                                    <a class="btn btn-sm btn-outline-secondary" href="{{ path('balance_account_edit', {id: item.id}) }}">Изменить</a>
                                    {{ ui.confirm(path('balance_account_archive', {id: item.id}), csrf_token('account_archive_' ~ item.id), item.is_archived ? 'Вернуть из архива' : 'Архивировать', 'История и остатки сохранятся.', {archive: item.is_archived ? '0' : '1'}, false) }}
                                {% endif %}
                                {% if permissions.prepare and not item.is_archived %}
                                    <a class="btn btn-sm btn-outline-secondary" href="{{ path('balance_account_target', {id: item.id}) }}">Установить остаток</a>
                                {% endif %}
                            </div>
                        </td>
                    </tr>
                {% else %}
                    <tr>
                        <td class="text-center text-secondary py-5" colspan="5">Счетов пока нет. Создайте конечную статью, затем добавьте в нее счет.</td>
                    </tr>
                {% endfor %}
            </tbody>
        </table></div>
        {{ ui.pager(pager, app.request.attributes.get('_route'), app.request.query.all) }}
    </div></section>
{% if permissions.manage %}
    <section class="card vf-card mb-4"><div class="card-body">
        <h2 class="card-title">Восстановление текущих остатков</h2>
        <p>Сохраненные остатки будут сверены с проведенными документами и восстановлены из журнала. История операций не изменится.</p>
        <form method="post" action="{{ path('balance_rebuild') }}">
            <input type="hidden" name="_token" value="{{ csrf_token('balance_rebuild') }}">
            <div class="mb-3">
                <label class="form-label" for="balance-rebuild-reason">Основание восстановления</label>
                <input class="form-control" id="balance-rebuild-reason" name="reason" required>
            </div>
            <button class="btn btn-outline-secondary">Восстановить остатки из журнала</button>
        </form>
    </div></section>
{% endif %}
{% endblock %}
