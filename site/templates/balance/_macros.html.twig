{#
  Деньги Баланса (DS-Money): учёт хранит копейки валюты книги; одна валюта на книгу,
  поэтому символ — в заголовке колонки (col), а в ячейке только число.
  signed — плюс у увеличения в списке движений; negate — уменьшение, хранящееся положительной суммой.
#}
{% macro amount(minor, currency, signed = false, negate = false) %}
    {%- set digits = vf_currency_digits(currency) -%}
    {{- minor|vf_minor(digits)|vf_amount(digits, null, signed, null, negate) -}}
{% endmacro %}
{% macro col(label, currency) %}{{ label }}, {{ vf_currency_symbol(currency) }}{% endmacro %}
{# Учётные даты приходят строкой из БД (Y-m-d, время — МСК без зоны): зону не пересчитываем. #}
{% macro date(value) %}{{ value ? value|date('d.m.Y', false) : '—' }}{% endmacro %}
{% macro datetime(value) %}{{ value ? value|date('d.m.Y H:i', false) : '—' }}{% endmacro %}
{% macro period(from, to) %}
    <form method="get" class="wz-row wz-filters">
        <div class="form-field">
            <label class="form-label" for="balance-from">С даты</label>
            <input class="input" id="balance-from" type="date" name="from" required value="{{ from }}">
        </div>
        <div class="form-field">
            <label class="form-label" for="balance-to">По дату</label>
            <input class="input" id="balance-to" type="date" name="to" required value="{{ to }}">
        </div>
        <div class="wz-row-actions">
            <button class="btn btn-md btn-primary">Показать</button>
        </div>
    </form>
{% endmacro %}
{% macro pager(pager) %}
    {% include 'app/_ui/_pagination.html.twig' with {pager: pager} only %}
{% endmacro %}
{% macro line(line) %}
    <fieldset class="card" data-balance-lines-target="row">
        <legend>Строка операции</legend>
        <div class="wz-row">{{ form_row(line.accountId) }}{{ form_row(line.direction) }}{{ form_row(line.amount) }}
        </div>
        <button class="btn btn-sm btn-danger" type="button" data-action="balance-lines#remove">Убрать строку</button>{{ form_rest(line) }}
    </fieldset>
{% endmacro %}
{% macro tree(items, currency) %}
    {% for item in items %}
        {% if item.isVisible %}
            <tr>
                <td class="t-tree{{ item.level == 1 ? ' t-tree--root' : '' }}" style="--lvl: {{ item.level - 1 }}">
                    <a href="{{ path('balance_article_card',{id:item.id}) }}">{{ item.name }}</a>
                </td>
                <td class="t-cell--right">{{ _self.amount(item.amountMinor, currency) }}</td>
            </tr>
        {% endif %}
        {{ _self.tree(item.children, currency) }}
    {% endfor %}
{% endmacro %}
