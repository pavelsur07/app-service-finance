{% extends 'balance/layout.html.twig' %}
{% form_theme form 'bootstrap_5_layout.html.twig' %}
{% block balance_content %}
    <div class="vf-page-head">
        <h1 class="page-title d-block">{{ document ? 'Обновить расчет остатка' : 'Установить остаток' }}: {{ account.name }}
        </h1>
    </div>
    <section class="card vf-card mb-4"><div class="card-body">
        <p>Текущий остаток: {{ account.balance|vf_minor(vf_currency_digits(currency))|vf_money(vf_currency_digits(currency), currency) }}. Разница на выбранную дату станет строкой корректировки. Укажите остальные изменения самостоятельно.</p>{{ form_start(form) }}{{ form_errors(form) }}{{ form_row(form.date) }}{{ form_row(form.target) }}{{ form_row(form.reason) }}
        <h2 class="card-title">Остальные строки корректировки</h2>
        <p>Предварительные итоги ниже относятся только к введенным строкам. Изменение выбранного счета будет рассчитано при сохранении.</p>
        {% include 'balance/_document_lines.html.twig' %}
        {{ form_rest(form) }}
        <button class="btn btn-primary">Подготовить корректировку</button>{{ form_end(form) }}
    </div></section>
{% endblock %}
