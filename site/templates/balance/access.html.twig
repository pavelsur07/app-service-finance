{% extends 'balance/layout.html.twig' %}
{% import 'balance/_macros.html.twig' as ui %}
{% form_theme form 'balance/_form_theme.html.twig' %}
{% block balance_content %}
    <div class="wz-head">
        <h1 class="wz-title">Права учета баланса</h1>
    </div>
    <section class="card">
        <p>Права Balance действуют вместе с финансовым доступом к компании. Владелец управляет настройками. Снятие всех флажков отзывает дополнительные права.</p>{{ form_start(form) }}{{ form_widget(form) }}
        <button class="btn btn-md btn-primary">Сохранить права</button>{{ form_end(form) }}
    </section>
    <section class="card report-scroll">
        <table class="t-table">
            <thead>
                <tr>
                    <th>Участник</th>
                    <th>Подготовка</th>
                    <th>Проведение</th>
                    <th>Закрытие</th>
<th>Переоткрытие</th>
                </tr>
            </thead>
            <tbody>
                {% for item in items %}
                    <tr>
                        <td>
                            <a href="{{ path('balance_audit',{type:'access',id:item.user_id}) }}">{{ members[item.user_id]|default('Участник больше недоступен') }}
                            </a>
                        </td>
                        <td>{{ item.can_prepare ? 'Да':'Нет' }}
                        </td>
                        <td>{{ item.can_post ? 'Да':'Нет' }}
                        </td>
                        <td>{{ item.can_manage_periods ? 'Да':'Нет' }}
                        </td>
                    </tr>
                {% else %}
                    <tr>
                        <td colspan="5">Дополнительные права не назначены.</td>
                    </tr>
                {% endfor %}
            </tbody>
        </table>
    </section>{{ ui.pager(pager) }}
{% endblock %}
