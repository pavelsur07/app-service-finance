{% extends 'balance/layout.html.twig' %}
{% import 'balance/_macros.html.twig' as ui %}
{% form_theme form 'bootstrap_5_layout.html.twig' %}
{% block balance_content %}
    <div class="vf-page-head">
        <h1 class="page-title d-block">Права учета баланса</h1>
    </div>
    <section class="card vf-card mb-4"><div class="card-body">
        <p>Права Balance действуют вместе с финансовым доступом к компании. Владелец управляет настройками. Снятие всех флажков отзывает дополнительные права.</p>{{ form_start(form) }}{{ form_widget(form) }}
        <button class="btn btn-primary">Сохранить права</button>{{ form_end(form) }}
    </div></section>
    <section class="card vf-card mb-4"><div class="card-body">
        <div class="table-responsive"><table class="table table-vcenter vf-table">
            <thead>
                <tr>
                    <th>Участник</th>
                    <th>Подготовка</th>
                    <th>Проведение</th>
                    <th>Закрытие</th>
                    <th>Переоткрытие</th>
                </tr>
            </thead>
            <tbody>
                {% for item in items %}
                    <tr>
                        <td>
                            <a href="{{ path('balance_audit', {type: 'access', id: item.user_id}) }}">{{ members[item.user_id]|default('Участник больше недоступен') }}
                            </a>
                        </td>
                        <td>{{ item.can_prepare ? 'Да' : 'Нет' }}
                        </td>
                        <td>{{ item.can_post ? 'Да' : 'Нет' }}
                        </td>
                        <td>{{ item.can_manage_periods ? 'Да' : 'Нет' }}
                        </td>
                        <td>{{ item.can_reopen_periods ? 'Да' : 'Нет' }}</td>
                    </tr>
                {% else %}
                    <tr>
                        <td class="text-center text-secondary py-5" colspan="5">Дополнительные права не назначены.</td>
                    </tr>
                {% endfor %}
            </tbody>
        </table></div>
        {{ ui.pager(pager, app.request.attributes.get('_route'), app.request.query.all) }}
    </div></section>
{% endblock %}
