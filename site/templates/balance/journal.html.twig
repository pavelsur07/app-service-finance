{% extends 'balance/layout.html.twig' %}
{% import 'balance/_macros.html.twig' as ui %}
{% block balance_content %}
    <div class="vf-page-head">
        <h1 class="page-title d-block">Документы баланса</h1>
        {% if permissions.prepare %}
            <div class="btn-list">
                <a class="btn btn-primary" href="{{ path('balance_document_new') }}">Новый документ</a>
            </div>
        {% endif %}
    </div>
    <form method="get" class="card vf-card mb-4"><div class="card-body">
        <div class="mb-3">{% include 'partials/_period_presets.html.twig' with {from: '#journal-from', to: '#journal-to'} only %}</div>
        <div class="row g-3 align-items-end">
        <div class="col-12 col-sm-6 col-lg-3">
            <label class="form-label" for="journal-search">Номер или основание</label>
            <input class="form-control" id="journal-search" name="search" value="{{ filters.search }}">
        </div>
        <div class="col-12 col-sm-6 col-lg-3">
            <label class="form-label" for="journal-status">Статус</label>
            <select class="form-select" id="journal-status" name="status">
                <option value="">Все</option>
                {% for value, label in {'draft': 'Черновик', 'posted': 'Проведен'} %}
                    <option value="{{ value }}" {{ filters.status == value ? 'selected' : '' }}>{{ label }}
                    </option>
                {% endfor %}
            </select>
        </div>
        <div class="col-12 col-sm-6 col-lg-3">
            <label class="form-label" for="journal-kind">Вид</label>
            <select class="form-select" id="journal-kind" name="kind">
                <option value="">Все</option>
                {% for value, label in {'opening': 'Начальные остатки', 'operation': 'Операция', 'correction': 'Корректировка', 'reversal': 'Сторно'} %}
                    <option value="{{ value }}" {{ filters.kind == value ? 'selected' : '' }}>{{ label }}
                    </option>
                {% endfor %}
            </select>
        </div>
        <div class="col-12 col-sm-6 col-lg-3">
            <label class="form-label" for="journal-account">Счет</label>
            <select class="form-select" id="journal-account" name="account_id">
                <option value="">Все</option>
                {% for account in accounts %}
                    <option value="{{ account.id }}" {{ filters.account_id == account.id ? 'selected' : '' }}>{{ account.name }}
                    </option>
                {% endfor %}
            </select>
        </div>
        <div class="col-12 col-sm-6 col-lg-3">
            <label class="form-label" for="journal-from">С даты</label>
            <input class="form-control" type="date" name="from" id="journal-from" value="{{ filters.from }}">
        </div>
        <div class="col-12 col-sm-6 col-lg-3">
            <label class="form-label" for="journal-to">По дату</label>
            <input class="form-control" type="date" name="to" id="journal-to" value="{{ filters.to }}">
        </div>
        <div class="col-12 col-sm-6 col-lg-3">
            <label class="form-label" for="journal-author">Автор</label>
            <select class="form-select" id="journal-author" name="author_id">
                <option value="">Все</option>
                {% for id, label in members %}
                    <option value="{{ id }}" {{ filters.author_id == id ? 'selected' : '' }}>{{ label }}
                    </option>
                {% endfor %}
            </select>
        </div>
        <div class="col-12 d-flex gap-2">
            <button class="btn btn-primary">Найти</button>
            <a class="btn btn-outline-secondary" href="{{ path('balance_journal') }}">Сбросить</a>
        </div>
    </div></div></form>
    {% set kinds = {'opening': 'Начальные остатки', 'operation': 'Операция', 'correction': 'Корректировка', 'reversal': 'Сторно'} %}
    <section class="card vf-card mb-4"><div class="card-body">
        <div class="table-responsive"><table class="table table-vcenter vf-table">
            <thead>
                <tr>
                    <th>Номер</th>
                    <th>Дата</th>
                    <th>Вид</th>
                    <th>Статус</th>
                    <th>Основание</th>
                    <th>Автор</th>
                </tr>
            </thead>
            <tbody>
                {% for item in journal.items %}
                    <tr>
                        <td>
                            <a href="{{ path('balance_document', {id: item.id}) }}">{{ item.number }}</a>
                        </td>
                        <td>{{ ui.date(item.operation_date) }}</td>
                        <td>{{ kinds[item.kind] }}</td>
                        <td>
                            {% include 'balance/_status.html.twig' with {status: item.status, reversed: item.is_reversed} only %}
                        </td>
                        <td>{{ item.reason }}</td>
                        <td>{{ members[item.author_id]|default('Бывший участник') }}</td>
                    </tr>
                {% else %}
                    <tr>
                        <td class="text-center text-secondary py-5" colspan="6">Документы не найдены.</td>
                    </tr>
                {% endfor %}
            </tbody>
        </table></div>
        {{ ui.pager(journal.pager, app.request.attributes.get('_route'), app.request.query.all) }}
    </div></section>
{% endblock %}
