{% extends 'base.html.twig' %}
{% block title %}Экономика SKU{% endblock %}

{% block stylesheets %}
    {{ parent() }}
    {{ vite_entry_link_tags('marketplace_economics') }}
{% endblock %}
{% block javascripts %}
    {{ parent() }}
    {{ vite_entry_script_tags('marketplace_economics') }}
{% endblock %}

{% macro money(minor) %}{{ minor|vf_minor(2)|vf_amount(2) }}{% endmacro %}
{% macro pct(value) %}{{ value is null ? '—' : value|vf_number(1) ~ ' %' }}{% endmacro %}
{% macro delta(current, previous) %}
    {%- if previous != 0 -%}
        <p class="text-secondary small mb-0">{{ (current - previous)|vf_minor(2)|vf_amount(2, null, true) }}{% if previous > 0 %} · {{ ((current - previous) * 100 / previous)|vf_number(1) }} %{% endif %}</p>
    {%- endif -%}
{% endmacro %}

{% block content %}
    {% import _self as ui %}
    {% set params = app.request.query.all %}
    {% set columns = [
        {key: 'revenue', label: 'Выручка', sort: 'revenue'},
        {key: 'costPrice', label: 'Себестоимость'},
        {key: 'gross', label: 'Выручка − себестоимость', sort: 'gross'},
        {key: 'commission', label: 'Комиссия'},
        {key: 'logisticsTo', label: 'Логистика туда'},
        {key: 'logisticsBack', label: 'Логистика обратно'},
        {key: 'acquiring', label: 'Эквайринг'},
        {key: 'otherMd1', label: 'Прочие СМ1'},
        {key: 'md1', label: 'СМ1', sort: 'md1'},
        {key: 'ads', label: 'Реклама', sort: 'ads'},
        {key: 'md2', label: 'СМ2', sort: 'md2'},
    ] %}
    {% if allocated %}
        {% set columns = columns|merge([{key: 'overhead', label: 'Склад и прочие МП'}, {key: 'full', label: 'СМ3', sort: 'full'}]) %}
    {% endif %}
    {% set profit = allocated ? 'full' : 'md2' %}
    {% set profit_label = allocated ? 'СМ3' : 'СМ2' %}

    <div class="vf-page-head">
        <div class="vf-page-head__title"><h1>Экономика SKU</h1></div>
        <a class="btn" href="{{ path('marketplace_analytics_unit_extended_index') }}">Открыть прежний отчёт</a>
    </div>
    <div class="card mb-3">
        <div class="card-header">
            <nav aria-label="Отчёт">
                {% include 'partials/_tabs.html.twig' with {class: 'card-header-tabs', tabs: [
                    {label: 'По SKU', href: path('marketplace_economics_sku', params), active: true},
                    {label: 'Динамика', href: path('marketplace_economics_dynamics', params|merge({sort: null, dir: null, page: null, limit: null})), active: false},
                    {label: 'Качество данных', href: path('marketplace_economics_quality'), active: false},
                ]} only %}
            </nav>
        </div>

        <form method="get" class="card-body row g-3 align-items-end">
            <div class="col-12 col-sm-6 col-lg-auto">
                <label class="form-label" for="me-from">С даты</label>
                <input class="form-control" id="me-from" type="date" name="from" required value="{{ from }}">
            </div>
            <div class="col-12 col-sm-6 col-lg-auto">
                <label class="form-label" for="me-to">По дату</label>
                <input class="form-control" id="me-to" type="date" name="to" required value="{{ to }}">
            </div>
            {% if report and report.channels|length > 1 %}
                <div class="col-12 col-sm-6 col-lg-auto">
                    <label class="form-label" for="me-channel">Канал</label>
                    <select class="form-select" id="me-channel" name="channel">
                        <option value="">Все каналы</option>
                        {% for value in report.channels %}
                            <option value="{{ value }}" {{ value == channel ? 'selected' }}>{{ constant('App\\MarketplaceEconomics\\Application\\DTO\\SkuEconomicsFilter::CHANNELS')[value] ?? value }}</option>
                        {% endfor %}
                    </select>
                </div>
            {% endif %}
            {% if report and report.connections|length > 1 %}
                <div class="col-12 col-sm-6 col-lg-auto">
                    <label class="form-label" for="me-connection">Кабинет</label>
                    <select class="form-select" id="me-connection" name="connection">
                        <option value="">Все кабинеты</option>
                        {% for ref in report.connections %}
                            <option value="{{ ref }}" {{ ref == connection ? 'selected' }}>{{ ref }}</option>
                        {% endfor %}
                    </select>
                </div>
            {% endif %}
            {% if allTags is not empty %}
                <div class="col-12 col-sm-6 col-lg-auto">
                    <label class="form-label" for="me-tags">Теги</label>
                    <select class="form-select" id="me-tags" name="tags[]" multiple size="1">
                        {% for tag in allTags %}
                            <option value="{{ tag.id }}" {{ tag.id in tagIds ? 'selected' }}>{{ tag.name }}</option>
                        {% endfor %}
                    </select>
                </div>
            {% endif %}
            <div class="col-12 col-sm-6 col-lg-auto">
                <label class="form-label" for="me-q">Поиск</label>
                <input class="form-control" id="me-q" type="search" name="q" value="{{ search }}" placeholder="SKU, артикул, название">
            </div>
            <div class="col-12 col-sm-6 col-lg-auto">
                <label class="form-label" for="me-alloc">Склад и прочие МП</label>
                <select class="form-select" id="me-alloc" name="alloc">
                    <option value="1" {{ allocated ? 'selected' }}>С разнесением</option>
                    <option value="0" {{ not allocated ? 'selected' }}>Без разнесения</option>
                </select>
            </div>
            <input type="hidden" name="sort" value="{{ sort }}">
            <input type="hidden" name="dir" value="{{ desc ? 'desc' : 'asc' }}">
            <div class="col-12 col-lg-auto d-flex flex-wrap gap-2">
                <button class="btn btn-primary">Показать</button>
                {% if report and report.hasData %}
                    <a class="btn" href="{{ path('marketplace_economics_sku', params|merge({format: 'xlsx', page: null})) }}">Скачать xlsx</a>
                {% endif %}
            </div>
        </form>
    </div>

    {% if error %}
        <div class="mb-3">
            <div class="alert alert-danger" role="alert"><div class="d-block"><p class="mb-0">{{ error }}</p></div></div>
        </div>
    {% elseif not report.hasData %}
        <div class="mb-3">
            <div class="alert alert-info" role="status"><div class="d-block"><p class="mb-0">Кабинеты компании ещё не переведены на новый контур данных. Пока пользуйтесь <a href="{{ path('marketplace_analytics_unit_extended_index') }}">прежним отчётом</a>.</p></div></div>
        </div>
    {% else %}
        <div class="mb-3">
            <p class="text-secondary small mb-0">
                Сравнение с {{ report.previousFrom|date('d.m.Y') }} – {{ report.previousTo|date('d.m.Y') }}.
                Дней в витрине: {{ report.days|vf_number }}.
                {% if report.daysWithoutCostPrice > 0 %}Дней с продажами без себестоимости: {{ report.daysWithoutCostPrice|vf_number }} — себестоимость там 0.{% endif %}
                Реклама по SKU — по долям прежнего отчёта рекламы; за последние 2 дня — предварительно.
            </p>
        </div>
        <section class="card mb-3 me-table-card" data-economics-table>
            <div class="me-table-scroll" data-economics-scroll tabindex="0" role="region" aria-label="Экономика SKU">
            <table class="table table-vcenter card-table me-table">
                <thead>
                    <tr>
                        <th>SKU</th>
                        <th class="text-end">
                            <a href="{{ path('marketplace_economics_sku', params|merge({sort: 'sales', dir: sort == 'sales' and desc ? 'asc' : 'desc', page: null})) }}">Продано, шт.</a>
                        </th>
                        {% for column in columns %}
                            <th class="text-end">
                                {% if column.sort is defined %}
                                    <a href="{{ path('marketplace_economics_sku', params|merge({sort: column.sort, dir: sort == column.sort and desc ? 'asc' : 'desc', page: null})) }}">{{ column.label }}, ₽</a>
                                {% else %}
                                    {{ column.label }}, ₽
                                {% endif %}
                            </th>
                        {% endfor %}
                        <th class="text-end">Маржинальность {{ profit_label }}, %</th>
                        <th class="text-end">ДРР, %</th>
                        <th class="text-end">СПП, ₽</th>
                    </tr>
                </thead>
                <tbody>
                    {% for row in pager.currentPageResults %}
                        {% set m = row.current %}
                        <tr>
                            <td>
                                {% if report.channels|length > 1 and row.channel %}<span class="badge bg-secondary-lt" data-channel="{{ row.channel }}">{{ constant('App\\MarketplaceEconomics\\Application\\DTO\\SkuEconomicsFilter::CHANNELS')[row.channel] ?? row.channel }}</span>{% endif %}
                                {{ row.sku }}
                                <p class="text-secondary small mb-0">{{ row.title ?? row.supplierSku ?? '' }}</p>
                            </td>
                            <td class="text-end">{{ m.salesQty|vf_number }}{% if m.returnsQty %}<p class="text-secondary small mb-0">возвр. {{ m.returnsQty|vf_number }}</p>{% endif %}</td>
                            {% for column in columns %}
                                <td class="text-end">
                                    {{ ui.money(attribute(m, column.key)) }}
                                    {% if column.key == profit %}{{ ui.delta(attribute(m, column.key), attribute(row.previous, column.key)) }}{% endif %}
                                </td>
                            {% endfor %}
                            <td class="text-end">{{ ui.pct(m.percentOfRevenue(attribute(m, profit))) }}</td>
                            <td class="text-end">{{ ui.pct(m.drr) }}</td>
                            <td class="text-end">{{ ui.money(m.spp) }}</td>
                        </tr>
                    {% else %}
                        <tr>
                            <td class="text-center text-secondary py-5" colspan="{{ columns|length + 5 }}">Нет продаж и затрат по SKU за период.</td>
                        </tr>
                    {% endfor %}
                    {% for label, m in report.unallocated is not null ? {'Нераспределено': report.unallocated, 'Итого': report.total} : {'Итого по выбранным': report.total} %}
                        <tr class="me-totals">
                            <td class="fw-semibold">{{ label }}</td>
                            <td class="text-end">{{ m.salesQty|vf_number }}</td>
                            {% for column in columns %}
                                <td class="text-end">
                                    {{ ui.money(attribute(m, column.key)) }}
                                    {% if label starts with 'Итого' and column.key == profit %}{{ ui.delta(attribute(m, column.key), attribute(report.previousTotal, column.key)) }}{% endif %}
                                </td>
                            {% endfor %}
                            <td class="text-end">{{ ui.pct(m.percentOfRevenue(attribute(m, profit))) }}</td>
                            <td class="text-end">{{ ui.pct(m.drr) }}</td>
                            <td class="text-end">{{ ui.money(m.spp) }}</td>
                        </tr>
                    {% endfor %}
                </tbody>
            </table>
            </div>
        </section>
        <div class="card card-body mt-3">
            {% include 'partials/_pagination.html.twig' with {pager: pager} only %}
        </div>
    {% endif %}
{% endblock %}
