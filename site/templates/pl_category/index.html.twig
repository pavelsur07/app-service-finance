{% macro render_items(items, usage) %}
    <ul class="pl-category-list list-unstyled mb-0">
    {% for item in items %}
        {% set has_children = item.children|length > 0 %}
        <li class="pl-category-node">
            <div class="pl-category-item d-flex align-items-center{{ item.type.value == 'KPI' ? ' pl-category-item--kpi' : '' }}">
                {% if has_children %}
                    <button class="pl-category-toggle btn btn-link btn-sm p-0 me-2 collapsed" type="button" aria-expanded="false">
                        <span class="visually-hidden">Переключить вложенные категории</span>
                    </button>
                {% else %}
                    <span class="pl-category-toggle-placeholder me-2"></span>
                {% endif %}
                <a href="{{ path('pl_category_edit', {'id': item.id}) }}" class="pl-category-link text-reset text-decoration-none flex-grow-1">{{ item.name }}</a>
                <span class="ms-auto d-inline-flex gap-1">
                    {{ include('pl_category/_delete_trigger.html.twig', {category: item, usage: usage[item.id] ?? null, class: 'btn btn-sm btn-danger', label: '🗑'}, with_context=false) }}
                </span>
            </div>
            {% if has_children %}
                <div class="pl-category-children" hidden>
                    {{ _self.render_items(item.children, usage) }}
                </div>
            {% endif %}
        </li>
    {% endfor %}
    </ul>
{% endmacro %}

{% import _self as macros %}

{% block body %}
    {% embed 'partials/_page_header.html.twig' with {title: 'Категории ОПиУ (PnL)'} %}
        {% block actions %}
            <div class="btn-list">
                <a href="{{ path('pl_category_new') }}" class="btn btn-primary">+ Добавить категорию</a>
                <a href="{{ path('pl_category_import') }}" class="btn btn-outline-secondary">Импорт категорий</a>
                <a href="{{ path('pl_category_export_json') }}" class="btn btn-outline-secondary" download>Выгрузить в файл</a>
            </div>
        {% endblock %}
    {% endembed %}
    <div class="container-xl mt-3">
        <div class="card">
            <div class="card-body">
                {{ macros.render_items(items, usage) }}
            </div>
        </div>
    </div>
    {% include 'partials/_confirm_modal.html.twig' with {id: 'pl-category-confirm'} only %}
{% endblock %}

{% block javascripts %}
    {{ parent() }}
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            document.querySelectorAll('.pl-category-toggle').forEach(function (button) {
                button.addEventListener('click', function () {
                    var node = button.closest('.pl-category-node');
                    if (!node) {
                        return;
                    }

                    var children = null;
                    for (var i = 0; i < node.children.length; i++) {
                        var child = node.children[i];
                        if (child.classList && child.classList.contains('pl-category-children')) {
                            children = child;
                            break;
                        }
                    }

                    if (!children) {
                        return;
                    }

                    var isHidden = children.hasAttribute('hidden');
                    if (isHidden) {
                        children.removeAttribute('hidden');
                    } else {
                        children.setAttribute('hidden', '');
                    }

                    button.classList.toggle('collapsed', !isHidden);
                    button.setAttribute('aria-expanded', String(isHidden));
                });
            });
        });
    </script>
{% endblock %}
