{% extends 'base.html.twig' %}

{% block title %}Редактирование категории P&L{% endblock %}

{% block body %}
    {% set income_variables = available_categories|filter(category => category.code is not empty and category.type.value == 'LEAF_INPUT' and category.flow.value == 'INCOME') %}
    {% set expense_variables = available_categories|filter(category => category.code is not empty and category.type.value == 'LEAF_INPUT' and category.flow.value == 'EXPENSE') %}
    {% set calculated_variables = available_categories|filter(category => category.code is not empty and (category.type.value != 'LEAF_INPUT' or category.flow.value == 'NONE')) %}

    <div class="page-header d-print-none">
        <div class="container-xl">
            <div class="row g-2 align-items-center">
                <div class="col">
                    <div class="page-pretitle">Справочники · Категории ОПиУ</div>
                    <h2 class="page-title">Редактирование строки ОПиУ</h2>
                </div>
                <div class="col-auto ms-auto d-print-none">
                    <div class="btn-list">
                        <a href="{{ path('pl_category_index') }}" class="btn btn-ghost-secondary d-none d-sm-inline-flex"><i class="ti ti-arrow-left me-1"></i>К списку</a>
                        <button type="submit" form="pl-category-delete-form" class="btn btn-ghost-danger"><i class="ti ti-trash me-1"></i>Удалить</button>
                        <button type="submit" form="pl-category-edit-form" class="btn btn-primary"><i class="ti ti-device-floppy me-1"></i>Сохранить</button>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="page-body">
        <div class="container-xl">
            <div class="row row-cards">
                <div class="col-lg-8">
                    {{ form_start(form, {'attr': {'id': 'pl-category-edit-form', 'class': 'card'}}) }}
                        <div class="card-header">
                            <h3 class="card-title">Основные данные</h3>
                            <div class="card-actions">
                                <span id="pl-category-type-badge" class="badge">
                                    <i class="ti me-1"></i><span></span>
                                </span>
                            </div>
                        </div>
                        <div class="card-body">
                            <div class="row g-3">
                                <div class="col-md-8">
                                    {{ form_row(form.name, {'attr': {'placeholder': 'Например, Выручка с СПП'}}) }}
                                </div>
                                <div class="col-md-4">
                                    {{ form_label(form.code, 'Код') }}
                                    <div class="input-group input-group-flat">
                                        <span class="input-group-text"><i class="ti ti-hash"></i></span>
                                        {{ form_widget(form.code, {'attr': {'class': 'form-control font-monospace', 'placeholder': 'Идентификатор'}}) }}
                                        <button type="button" class="btn" data-copy-target="#{{ form.code.vars.id }}" data-copy-feedback="copy-code-feedback" title="Скопировать код"><i class="ti ti-copy"></i></button>
                                    </div>
                                    <div id="copy-code-feedback" class="text-success small mt-1 d-none">Код скопирован</div>
                                    {{ form_errors(form.code) }}
                                    <small class="form-hint">Уникален в компании, используется в формулах.</small>
                                </div>

                                <div class="col-md-6">
                                    {{ form_row(form.parent) }}
                                    <small class="form-hint">Строка-родитель в дереве ОПиУ.</small>
                                </div>
                                <div class="col-md-3">
                                    {{ form_label(form.sortOrder) }}
                                    {{ form_widget(form.sortOrder) }}
                                    {{ form_errors(form.sortOrder) }}
                                </div>
                                <div class="col-md-3">
                                    {{ form_row(form.type) }}
                                </div>

                                <div class="col-md-6">
                                    {{ form_label(form.flow) }}
                                    <div class="form-selectgroup">
                                        {% for choice in form.flow %}
                                            <label class="form-selectgroup-item" for="{{ choice.vars.id }}">
                                                {{ form_widget(choice, {'attr': {'class': 'form-selectgroup-input'}}) }}
                                                <span class="form-selectgroup-label">
                                                    {% if choice.vars.value == 'INCOME' %}
                                                        <i class="ti ti-trending-up text-green me-1"></i>Доход
                                                    {% elseif choice.vars.value == 'EXPENSE' %}
                                                        <i class="ti ti-trending-down text-red me-1"></i>Расход
                                                    {% else %}
                                                        <i class="ti ti-minus text-secondary me-1"></i>Нейтральная
                                                    {% endif %}
                                                </span>
                                            </label>
                                        {% endfor %}
                                    </div>
                                    {{ form_errors(form.flow) }}
                                    <small class="form-hint">Составная строка может быть нейтральной.</small>
                                </div>

                                <div class="col-md-6">
                                    {{ form_row(form.expenseType, {'help': 'Доступно для строк типа «Расход».'}) }}
                                </div>

                                <div class="col-md-4">
                                    {{ form_label(form.format) }}
                                    <div class="form-selectgroup">
                                        {% for choice in form.format %}
                                            <label class="form-selectgroup-item" for="{{ choice.vars.id }}">
                                                {{ form_widget(choice, {'attr': {'class': 'form-selectgroup-input'}}) }}
                                                <span class="form-selectgroup-label">
                                                    {% if choice.vars.value == 'MONEY' %}₽{% elseif choice.vars.value == 'PERCENT' %}%{% elseif choice.vars.value == 'RATIO' %}Коэф.{% else %}Кол-во{% endif %}
                                                </span>
                                            </label>
                                        {% endfor %}
                                    </div>
                                    {{ form_errors(form.format) }}
                                </div>
                                <div class="col-md-4">
                                    {{ form_label(form.weightInParent) }}
                                    {{ form_widget(form.weightInParent) }}
                                    {{ form_errors(form.weightInParent) }}
                                    <small class="form-hint">Знак вклада в итог родителя (+1 / −1).</small>
                                </div>
                                <div class="col-md-4">
                                    {{ form_label(form.calcOrder) }}
                                    {{ form_widget(form.calcOrder) }}
                                    {{ form_errors(form.calcOrder) }}
                                    <small class="form-hint">Очередь вычисления зависимых строк.</small>
                                </div>

                                <div class="col-12">
                                    {{ form_label(form.isVisible, null, {'label_attr': {'class': 'd-block mb-2'}}) }}
                                    <label class="form-check form-switch">
                                        {{ form_widget(form.isVisible, {'attr': {'class': 'form-check-input'}}) }}
                                        <span class="form-check-label">Показывать</span>
                                    </label>
                                    {{ form_errors(form.isVisible) }}
                                </div>
                            </div>
                        </div>

                        <div class="card-body border-top">
                            <div class="d-flex align-items-center mb-2">
                                <label class="form-label mb-0">Расчёт (формула)</label>
                                <span class="ms-2 badge bg-blue-lt">для KPI / особых итогов</span>
                            </div>
                            {{ form_widget(form.formula, {'attr': {'class': 'form-control font-monospace', 'rows': 3, 'placeholder': 'Например: CM1 / REV_TOTAL_SPP * 100'}}) }}
                            {{ form_errors(form.formula) }}
                            <small id="pl-category-formula-hint" class="form-hint"></small>
                        </div>

                        <div class="card-footer d-flex align-items-center">
                            <button type="submit" form="pl-category-delete-form" class="btn btn-ghost-danger">Удалить</button>
                            <div class="btn-list ms-auto">
                                <a href="{{ path('pl_category_index') }}" class="btn">Отмена</a>
                                <button type="submit" class="btn btn-primary"><i class="ti ti-device-floppy me-1"></i>Сохранить</button>
                            </div>
                        </div>
                        {{ form_rest(form) }}
                    {{ form_end(form, {'render_rest': false}) }}
                </div>

                <div class="col-lg-4">
                    <div class="card">
                        <div class="card-header">
                            <h3 class="card-title">Переменные</h3>
                            <div class="card-actions text-secondary small">Клик — вставить в формулу</div>
                        </div>
                        <ul class="nav nav-tabs nav-fill" data-bs-toggle="tabs">
                            <li class="nav-item"><a href="#tab-income" class="nav-link active" data-bs-toggle="tab">Доходы</a></li>
                            <li class="nav-item"><a href="#tab-expense" class="nav-link" data-bs-toggle="tab">Расходы</a></li>
                            <li class="nav-item"><a href="#tab-calculated" class="nav-link" data-bs-toggle="tab">Расчётные</a></li>
                        </ul>
                        <div class="card-body">
                            <div class="tab-content">
                                <div class="tab-pane active show" id="tab-income">
                                    {% if income_variables is not empty %}
                                        <div class="d-flex flex-column gap-2">
                                            {% for category in income_variables %}
                                                <button type="button" class="btn btn-outline-green justify-content-between" data-insert-code="{{ category.code }}" data-insert-target="#{{ form.formula.vars.id }}">
                                                    <span>{{ category.name }}</span><span class="badge bg-green-lt ms-2 font-monospace small fw-semibold">{{ category.code }}</span>
                                                </button>
                                            {% endfor %}
                                        </div>
                                    {% else %}
                                        <p class="text-secondary small mb-0">Нет доступных переменных доходов.</p>
                                    {% endif %}
                                </div>
                                <div class="tab-pane" id="tab-expense">
                                    {% if expense_variables is not empty %}
                                        <div class="d-flex flex-column gap-2">
                                            {% for category in expense_variables %}
                                                <button type="button" class="btn btn-outline-red justify-content-between" data-insert-code="{{ category.code }}" data-insert-target="#{{ form.formula.vars.id }}">
                                                    <span>{{ category.name }}</span><span class="badge bg-red-lt ms-2 font-monospace small fw-semibold">{{ category.code }}</span>
                                                </button>
                                            {% endfor %}
                                        </div>
                                    {% else %}
                                        <p class="text-secondary small mb-0">Нет доступных переменных расходов.</p>
                                    {% endif %}
                                </div>
                                <div class="tab-pane" id="tab-calculated">
                                    {% if calculated_variables is not empty %}
                                        <div class="d-flex flex-column gap-2">
                                            {% for category in calculated_variables %}
                                                <button type="button" class="btn btn-outline-primary justify-content-between" data-insert-code="{{ category.code }}" data-insert-target="#{{ form.formula.vars.id }}">
                                                    <span>{{ category.name }}</span><span class="badge bg-blue-lt ms-2 font-monospace small fw-semibold">{{ category.code }}</span>
                                                </button>
                                            {% endfor %}
                                        </div>
                                    {% else %}
                                        <p class="text-secondary small mb-0">Нет доступных расчётных переменных.</p>
                                    {% endif %}
                                    <div class="hr-text hr-text-center mt-3">операторы</div>
                                    <div class="d-flex flex-wrap gap-2">
                                        {% for token, label in {' + ': '+', ' - ': '−', ' * ': '×', ' / ': '÷', '( ': '(', ' )': ')'} %}
                                            <button type="button" class="btn btn-icon" data-insert-code="{{ token }}" data-insert-target="#{{ form.formula.vars.id }}">{{ label }}</button>
                                        {% endfor %}
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <form id="pl-category-delete-form" method="post" action="{{ path('pl_category_delete', {'id': item.id}) }}" data-confirm-message="Удалить строку ОПиУ?">
        <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ item.id) }}">
    </form>
{% endblock %}

{% block javascripts %}
    {{ parent() }}
    <script>
        (function () {
            const initPlCategoryEdit = function () {
                const form = document.getElementById('pl-category-edit-form');
                if (!form || form.dataset.plCategoryEditBound === '1') {
                    return;
                }

                const type = document.getElementById('{{ form.type.vars.id }}');
                const expenseType = document.getElementById('{{ form.expenseType.vars.id }}');
                const formula = document.getElementById('{{ form.formula.vars.id }}');
                const formulaHint = document.getElementById('pl-category-formula-hint');
                const typeBadge = document.getElementById('pl-category-type-badge');
                const flowInputs = form.querySelectorAll('input[name="{{ form.flow.vars.full_name }}"]');

                const syncType = function () {
                    const isLeaf = type.value === 'LEAF_INPUT';
                    formula.disabled = isLeaf;
                    formulaHint.textContent = isLeaf
                        ? 'Формула недоступна для строк типа «Лист» — значения берутся напрямую из фактов.'
                        : 'Вставляйте коды статей ОПиУ. Пример: CM1 / REV_TOTAL_SPP * 100.';

                    if (type.value === 'KPI') {
                        typeBadge.className = 'badge bg-purple-lt';
                        typeBadge.innerHTML = '<i class="ti ti-math-function me-1"></i><span>Показатель (KPI)</span>';
                    } else if (type.value === 'SUBTOTAL') {
                        typeBadge.className = 'badge bg-blue-lt';
                        typeBadge.innerHTML = '<i class="ti ti-sum me-1"></i><span>Итог (subtotal)</span>';
                    } else {
                        typeBadge.className = 'badge bg-secondary-lt';
                        typeBadge.innerHTML = '<i class="ti ti-forms me-1"></i><span>Лист (из фактов)</span>';
                    }
                };

                const syncFlow = function () {
                    const selected = form.querySelector('input[name="{{ form.flow.vars.full_name }}"]:checked');
                    expenseType.disabled = !selected || selected.value !== 'EXPENSE';
                };

                type.addEventListener('change', syncType);
                flowInputs.forEach(function (input) {
                    input.addEventListener('change', syncFlow);
                });

                form.addEventListener('click', async function (event) {
                    const copyButton = event.target.closest('[data-copy-target]');
                    if (copyButton) {
                        const input = document.querySelector(copyButton.dataset.copyTarget);
                        if (!input || !input.value) {
                            return;
                        }

                        try {
                            await navigator.clipboard.writeText(input.value);
                            const feedback = document.getElementById(copyButton.dataset.copyFeedback);
                            if (feedback) {
                                feedback.classList.remove('d-none');
                                setTimeout(function () { feedback.classList.add('d-none'); }, 1400);
                            }
                        } catch (error) {
                            return;
                        }
                    }
                });

                document.querySelectorAll('[data-insert-code]').forEach(function (button) {
                    button.addEventListener('click', function () {
                        const textarea = document.querySelector(button.dataset.insertTarget);
                        if (!textarea) {
                            return;
                        }

                        const value = button.dataset.insertCode;
                        const start = typeof textarea.selectionStart === 'number' ? textarea.selectionStart : textarea.value.length;
                        const end = typeof textarea.selectionEnd === 'number' ? textarea.selectionEnd : textarea.value.length;
                        textarea.value = textarea.value.slice(0, start) + value + textarea.value.slice(end);
                        const cursor = start + value.length;
                        textarea.focus();
                        textarea.setSelectionRange(cursor, cursor);
                    });
                });

                form.addEventListener('submit', function () {
                    formula.disabled = false;
                    expenseType.disabled = false;
                });

                const deleteForm = document.getElementById('pl-category-delete-form');
                deleteForm.addEventListener('submit', function (event) {
                    if (!window.confirm(deleteForm.dataset.confirmMessage)) {
                        event.preventDefault();
                    }
                });

                form.dataset.plCategoryEditBound = '1';
                syncType();
                syncFlow();
            };

            initPlCategoryEdit();
            document.addEventListener('DOMContentLoaded', initPlCategoryEdit);
            document.addEventListener('turbo:load', initPlCategoryEdit);
        })();
    </script>
{% endblock %}
