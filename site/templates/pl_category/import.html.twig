{% extends 'base.html.twig' %}
{% block title %}Импорт категорий ОПиУ{% endblock %}

{% block body %}
    {% embed 'partials/_page_header.html.twig' with {title: 'Импорт категорий ОПиУ'} %}
        {% block actions %}
            <div class="btn-list">
                <a href="{{ path('pl_category_index') }}" class="btn btn-outline-secondary">Назад к списку</a>
            </div>
        {% endblock %}
    {% endembed %}
    <div class="container-xl mt-3">
        {% include 'pl_category/import/_base_template.html.twig' with {businessProfile: businessProfile ?? null, templateOrigin: templateOrigin ?? null} only %}

        {% if businessProfile is defined and businessProfile.value == 'UNIVERSAL' %}
            {% include 'pl_category/import/_marketplace.html.twig' with {extendPreview: extendPreview ?? null, targetCompanyId: targetCompanyId} only %}
        {% endif %}

        <div class="card mb-3">
            <div class="card-body">
                {% if sources is empty %}
                    <div class="alert alert-info mb-0">
                        Нет других компаний, к которым у вас есть доступ.
                    </div>
                {% else %}
                    <form method="get" action="{{ path('pl_category_import') }}" class="row g-2 align-items-end">
                        <div class="col-auto">
                            <label class="form-label" for="sourceCompanyId">Компания-источник</label>
                            <select class="form-select" id="sourceCompanyId" name="sourceCompanyId">
                                <option value="">— выберите компанию —</option>
                                {% for source in sources %}
                                    <option value="{{ source.id }}"{{ selectedSourceCompanyId == source.id ? ' selected' : '' }}>{{ source.name }}</option>
                                {% endfor %}
                            </select>
                        </div>
                        <div class="col-auto">
                            <button type="submit" class="btn btn-primary">Показать предпросмотр</button>
                        </div>
                    </form>
                {% endif %}
            </div>
        </div>

        {% include 'pl_category/import/_from_file.html.twig' with {targetCompanyId: targetCompanyId} only %}

        {% set withUpdates = previewWithUpdates|default(null) %}
        {% set keepError = keepError|default(null) %}
        {% set updateError = updateError|default(null) %}
        {% set shown = preview ?? withUpdates %}
        {% if shown is not null %}
            {% include 'pl_category/import/_preview.html.twig' with {preview: preview ?? null, withUpdates: withUpdates, keepError: keepError, updateError: updateError, shown: shown, previewMode: previewMode, uploadedFileName: uploadedFileName, uploadedPayload: uploadedPayload, selectedSourceCompanyId: selectedSourceCompanyId, targetCompanyId: targetCompanyId} only %}
        {% endif %}
    </div>
{% endblock %}
