{% extends 'base.html.twig' %}
{% block title %}Импорт категорий ОПиУ{% endblock %}

{% block body %}
    <div class="page-header d-print-none">
        <div class="container-xl">
            <div class="row g-2 align-items-center">
                <div class="col">
                    <h2 class="page-title">Импорт категорий ОПиУ</h2>
                </div>
                <div class="col-auto ms-auto d-print-none">
                    <div class="btn-list">
                        <a href="{{ path('pl_category_index') }}" class="btn btn-outline-secondary">Назад к списку</a>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <div class="container-xl mt-3">
        <div class="card mb-3">
            <div class="card-body">
                <h3 class="card-title">Базовый шаблон ОПиУ</h3>
                <p class="text-secondary">
                    {% if businessProfile is defined and businessProfile.value == 'UNIVERSAL' %}
                    Стандартное дерево статей профиля «{{ businessProfile.label }}»: выручка, себестоимость,
                    валовая прибыль и маржа, операционные расходы, EBITDA и чистая прибыль.
                    {% else %}
                    Стандартное дерево статей: выручка, прямые расходы, маржинальность CM1–CM3, склад и
                    удержания МП, косвенные расходы, EBITDA и чистая прибыль. Коды статей совпадают с
                    шаблоном маппинга затрат маркетплейсов — после переноса затраты разносятся по статьям
                    автоматически ночью.
                    {% endif %}
                    Добавляются только недостающие статьи, существующие не меняются. Если у вас своё дерево,
                    сначала сопоставьте свои статьи со статьями шаблона — иначе шаблон не встанет вторым деревом
                    рядом и откажет.
                </p>
                <p class="text-secondary small" data-template-origin>
                    {% if templateOrigin is defined and templateOrigin is not null %}
                        Дерево из шаблона «{{ templateOrigin.profile.label }}»{{ templateOrigin.source.value == 'mp_extension' ? ' со статьями маркетплейса' : '' }}
                        (последнее применение {{ templateOrigin.appliedAt|date('d.m.Y') }}). Шаблон другого профиля к нему не применяется.
                    {% else %}
                        Происхождение дерева не записано: оно создано до учёта шаблонов или вручную.
                    {% endif %}
                </p>
                <form method="get" action="{{ path('pl_category_import') }}" class="btn-list">
                    <input type="hidden" name="source" value="template">
                    <button type="submit" class="btn btn-primary">Показать предпросмотр</button>
                    <a href="{{ path('pl_category_template_mapping') }}" class="btn btn-outline-secondary">Сопоставить с шаблоном</a>
                </form>
            </div>
        </div>

        {% if businessProfile is defined and businessProfile.value == 'UNIVERSAL' %}
            <div class="card mb-3" data-marketplace-extension>
                <div class="card-body">
                    <h3 class="card-title">Статьи маркетплейса</h3>
                    <p class="text-secondary">
                        Для продаж на маркетплейсах: выручка маркетплейса, комиссия, логистика возвратов, склад и
                        удержания, продвижение, услуги фулфилмента — с теми кодами, которые ждут правила разнесения
                        затрат и продаж маркетплейсов. Выручка маркетплейса войдёт в «Выручку», его расходы — в EBITDA:
                        формулы этих итогов заменятся. Свои статьи и изменённые вами формулы не трогаются.
                    </p>
                    {% if extendPreview is defined and extendPreview is not null %}
                        {% if extendPreview.empty %}
                            <div class="alert alert-secondary mb-0">Статьи маркетплейса уже есть — добавлять нечего.</div>
                        {% else %}
                            <div class="row g-3 mb-3">
                                <div class="col-auto">
                                    <div class="text-secondary">Будет создано</div>
                                    <div class="h2 mb-0">{{ extendPreview.import.created|length }}</div>
                                </div>
                            </div>
                            {% if extendPreview.formulaChanges is not empty %}
                                <p class="mb-1">Итоги, в которые войдут статьи маркетплейса:</p>
                                <ul>
                                    {% for change in extendPreview.formulaChanges %}
                                        <li>{{ change.name }}: <code>{{ change.from }}</code> → <code>{{ change.to }}</code></li>
                                    {% endfor %}
                                </ul>
                            {% endif %}
                            {% if extendPreview.import.similar is not empty %}
                                <div class="alert alert-warning">
                                    Не будут созданы — у вас есть похожие статьи:
                                    <ul class="mb-0">
                                        {% for row in extendPreview.import.similar %}
                                            <li>{{ row.path }} <code>{{ row.code }}</code> — у вас «{{ row.existingName }}»</li>
                                        {% endfor %}
                                    </ul>
                                </div>
                            {% endif %}
                            <div class="table-responsive mb-3">
                                <table class="table table-vcenter card-table">
                                    <thead><tr><th>Путь</th><th>Код</th></tr></thead>
                                    <tbody>
                                        {% for row in extendPreview.import.created %}
                                            <tr><td>{{ row.path }}</td><td>{{ row.code }}</td></tr>
                                        {% endfor %}
                                    </tbody>
                                </table>
                            </div>
                            {% if is_granted('module.finance.write') %}
                                <form method="post" action="{{ path('pl_category_marketplace_extension') }}">
                                    <input type="hidden" name="_token" value="{{ csrf_token('pl-marketplace-extension' ~ targetCompanyId) }}">
                                    <button type="submit" class="btn btn-primary">Добавить статьи маркетплейса</button>
                                </form>
                            {% else %}
                                <div class="text-secondary">Добавить статьи может пользователь с правом записи в «Финансы».</div>
                            {% endif %}
                        {% endif %}
                    {% else %}
                        <form method="get" action="{{ path('pl_category_import') }}">
                            <input type="hidden" name="source" value="marketplace">
                            <button type="submit" class="btn btn-outline-primary">Показать, что добавится</button>
                        </form>
                    {% endif %}
                </div>
            </div>
        {% endif %}

        <div class="card mb-3">
            <div class="card-body">
                {% if sources is empty %}
                    <div class="alert alert-info mb-0">
                        Нет других компаний, к которым у вас есть доступ.
                    </div>
                {% else %}
                    <form method="get" action="{{ path('pl_category_import') }}" class="row g-2 align-items-end">
                        <div class="col-auto">
                            <label class="form-label" for="sourceCompanyId">Компания-источник</label>
                            <select class="form-select" id="sourceCompanyId" name="sourceCompanyId">
                                <option value="">— выберите компанию —</option>
                                {% for source in sources %}
                                    <option value="{{ source.id }}"{{ selectedSourceCompanyId == source.id ? ' selected' : '' }}>{{ source.name }}</option>
                                {% endfor %}
                            </select>
                        </div>
                        <div class="col-auto">
                            <button type="submit" class="btn btn-primary">Показать предпросмотр</button>
                        </div>
                    </form>
                {% endif %}
            </div>
        </div>

        <div class="card mb-3">
            <div class="card-body">
                <h3 class="card-title">Из файла</h3>
                <p class="text-secondary">
                    Файл выгружается кнопкой «Выгрузить в файл» на экране категорий той компании,
                    откуда переносим. Так дерево можно перенести и в другой аккаунт.
                </p>
                <form method="post" action="{{ path('pl_category_import_upload') }}" enctype="multipart/form-data" class="row g-2 align-items-end">
                    <input type="hidden" name="_token" value="{{ csrf_token('pl-category-import-file' ~ targetCompanyId) }}">
                    <div class="col-auto">
                        <label class="form-label" for="import_file">Файл выгрузки (JSON)</label>
                        <input type="file" class="form-control" id="import_file" name="import_file" accept="application/json,.json" required>
                    </div>
                    <div class="col-auto">
                        <button type="submit" class="btn btn-primary">Показать предпросмотр</button>
                    </div>
                </form>
            </div>
        </div>

        {% if preview is not null %}
            <div class="card">
                <div class="card-body">
                    <h3 class="card-title">
                        Предпросмотр
                        {% if previewMode == 'file' %}— файл {{ uploadedFileName }}{% endif %}
                        {% if previewMode == 'template' %}— базовый шаблон{% endif %}
                    </h3>

                    {% if preview.unresolvedFormulaCodes is not empty %}
                        <div class="alert alert-warning">
                            После импорта в формулах категорий этой компании останутся ссылки
                            на обозначения, которых в ней не будет:
                            <strong>{{ preview.unresolvedFormulaCodes|join(', ') }}</strong>.
                            Это могут быть как переносимые формулы, так и формулы категорий,
                            которых в источнике нет — импорт способен освободить код, на который
                            они ссылаются. Формулы не правятся автоматически, проверьте их вручную.
                            Среди перечисленного могут быть имена функций, а не коды категорий.
                        </div>
                    {% endif %}

                    {% if preview.similar is not empty %}
                        <div class="alert alert-warning">
                            <p>Эти статьи шаблона не будут созданы: у вас есть статьи с похожими названиями.
                            Чтобы шаблон считал их своими, <a href="{{ path('pl_category_template_mapping') }}">сопоставьте их с шаблоном</a>.</p>
                            <ul class="mb-0">
                                {% for row in preview.similar %}
                                    <li>{{ row.path }} <code>{{ row.code }}</code> — у вас «{{ row.existingName }}»</li>
                                {% endfor %}
                            </ul>
                            {% if preview.skippedWithSimilar is not empty %}
                                <p class="mt-2 mb-1">Вместе с ними не будут созданы вложенные статьи шаблона:</p>
                                <ul class="mb-0">
                                    {% for row in preview.skippedWithSimilar %}
                                        <li>{{ row.path }} <code>{{ row.code }}</code></li>
                                    {% endfor %}
                                </ul>
                            {% endif %}
                            <p class="mt-2 mb-0 small">Сопоставить можно статью того же типа и уровня; иначе переименуйте свою статью, если это не дубль.</p>
                        </div>
                    {% endif %}

                    <div class="row g-3 mb-3">
                        <div class="col-auto">
                            <div class="text-secondary">Будет создано</div>
                            <div class="h2 mb-0">{{ preview.created|length }}</div>
                        </div>
                        <div class="col-auto">
                            <div class="text-secondary">Будет обновлено</div>
                            <div class="h2 mb-0">{{ preview.updated|length }}</div>
                        </div>
                        <div class="col-auto">
                            <div class="text-secondary">Без изменений</div>
                            <div class="h2 mb-0">{{ preview.unchangedCount }}</div>
                        </div>
                    </div>

                    {% if preview.created is empty and preview.updated is empty %}
                        <div class="alert alert-secondary mb-3">Изменений нет — импортировать нечего.</div>
                    {% else %}
                        <div class="table-responsive mb-3">
                            <table class="table table-vcenter card-table">
                                <thead>
                                    <tr>
                                        <th>Действие</th>
                                        <th>Путь</th>
                                        <th>Код</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    {% for row in preview.created %}
                                        <tr>
                                            <td><span class="badge bg-green-lt">Создать</span></td>
                                            <td>{{ row.path }}</td>
                                            <td>{{ row.code }}</td>
                                        </tr>
                                    {% endfor %}
                                    {% for row in preview.updated %}
                                        <tr>
                                            <td><span class="badge bg-blue-lt">Обновить</span></td>
                                            <td>{{ row.path }}</td>
                                            <td>{{ row.code }}</td>
                                        </tr>
                                    {% endfor %}
                                </tbody>
                            </table>
                        </div>
                    {% endif %}

                    <form method="post" action="{{ path('pl_category_import_apply') }}">
                        {% if previewMode == 'file' %}
                            <input type="hidden" name="mode" value="file">
                            <input type="hidden" name="payload" value="{{ uploadedPayload }}">
                        {% elseif previewMode == 'template' %}
                            <input type="hidden" name="mode" value="template">
                        {% else %}
                            <input type="hidden" name="sourceCompanyId" value="{{ selectedSourceCompanyId }}">
                        {% endif %}
                        <input type="hidden" name="_token" value="{{ csrf_token('pl-category-import' ~ targetCompanyId) }}">
                        <button type="submit" class="btn btn-primary"{{ (preview.created is empty and preview.updated is empty) ? ' disabled' : '' }}>
                            Импортировать
                        </button>
                    </form>
                </div>
            </div>
        {% endif %}
    </div>
{% endblock %}
