{% extends 'admin/base.html.twig' %}

{% block title %}Admin · Тариф · {{ company.name }}{% endblock %}

{% set statusView = {
  active: {cls: 'success', label: 'Активен'},
  grace: {cls: 'warning', label: 'Льготный период'},
  read_only: {cls: 'danger', label: 'Только чтение'},
  none: {cls: 'neutral', label: 'Нет тарифа'},
} %}

{% block body %}
  <div class="wz-head">
    <div>
      <h1 class="wz-title">Тариф кабинета</h1>
      <div class="wz-subtitle">
        {{ company.name }}{% if company.inn %} · ИНН {{ company.inn }}{% endif %}
      </div>
    </div>
    <a href="{{ path('admin_user_index', {company: company.id}) }}" class="btn btn-md btn-secondary">К пользователям</a>
  </div>

  {# Текущее состояние #}
  <section class="card u-mb-4">
    {% set view = statusView[access.status.value] %}
    <div class="wz-stat-row">
      <div>
        <div class="form-hint">Тариф</div>
        <div class="u-fs-16 u-fw-600">{{ access.tariffName ?? '—' }}</div>
      </div>
      <div>
        <div class="form-hint">Статус</div>
        <span class="status status--{{ view.cls }}"><span class="dot"></span>{{ view.label }}</span>
      </div>
      <div>
        <div class="form-hint">Оплачено с</div>
        <div class="u-tnum">{{ paidFrom ? paidFrom|date('d.m.Y') : '—' }}</div>
      </div>
      <div>
        <div class="form-hint">Оплачено по</div>
        <div class="u-tnum">
          {% if subscription is null %}—{% elseif access.paidUntil is null %}бессрочно{% else %}{{ access.paidUntil|date('d.m.Y') }}{% endif %}
        </div>
      </div>
      {% if access.nextTariffName is not null %}
        <div data-billing-next-tariff>
          <div class="form-hint">Запланировано</div>
          <div>С {{ access.nextTariffFrom|date('d.m.Y') }} — тариф «{{ access.nextTariffName }}»</div>
          <form method="post" action="{{ path('admin_billing_company_cancel_next', {companyId: company.id}) }}" class="u-mt-1" data-billing-cancel-next>
            <input type="hidden" name="_token" value="{{ csrf_token('billing_cancel_next_' ~ company.id) }}">
            <button type="submit" class="btn btn-sm btn-secondary" title="До {{ access.paidUntil|date('d.m.Y') }} останется тариф «{{ access.tariffName }}» — дни, оплаченные по цене «{{ access.nextTariffName }}», клиент получит на текущем тарифе. Онлайн-повышение до этой даты — только через вас.">Отменить переход</button>
          </form>
        </div>
      {% endif %}
      {% if access.daysLeft is not null %}
        <div>
          <div class="form-hint">Осталось дней</div>
          <div class="u-tnum">{{ access.daysLeft }}</div>
        </div>
      {% endif %}
    </div>
  </section>

  <div class="wz-card-grid">
    {# Назначить тариф #}
    <section class="card">
      <h2 class="wz-card-title">Назначить тариф</h2>
      <p class="form-hint u-m-0 u-mb-3">Без оплаты: «Друг» — бессрочно; остальные — с периодом (договор сопровождения, особые условия, ручная правка).</p>
      <form method="post" action="{{ path('admin_billing_company_assign', {companyId: company.id}) }}">
        <input type="hidden" name="_token" value="{{ csrf_token('billing_assign_' ~ company.id) }}">
        <div class="form-field">
          <label class="form-label" for="assign-tariff">Тариф</label>
          <select id="assign-tariff" name="tariff" class="select" required>
            {% for tariff in tariffs %}
              <option value="{{ tariff.code.value }}" {% if currentTariff and currentTariff.code == tariff.code %}selected{% endif %}>
                {{ tariff.name }}{% if not tariff.public %} (скрытый){% endif %}{% if tariff.perpetual %} — бессрочно{% endif %}
              </option>
            {% endfor %}
          </select>
        </div>
        <div class="u-flex u-gap-3">
          <div class="form-field u-flex-1">
            <label class="form-label" for="assign-from">С</label>
            <input id="assign-from" type="date" name="from" class="input" value="{{ paidFrom ? paidFrom|date('Y-m-d') : today }}" required>
          </div>
          <div class="form-field u-flex-1">
            <label class="form-label" for="assign-until">По (включительно)</label>
            <input id="assign-until" type="date" name="until" class="input" value="{{ subscription and subscription.paidUntil ? subscription.paidUntil|date('Y-m-d') : '' }}">
          </div>
        </div>
        <div class="form-hint u-mb-3">Для бессрочного тарифа дата «По» не учитывается. Назначение снимает запланированный переход.</div>
        <label class="checkbox-label u-mb-3" data-billing-confirm-shorten>
          <input type="checkbox" class="checkbox" name="confirm_shorten" value="1">
          <span>Сократить оплаченный период (например, после возврата)</span>
        </label>
        <button type="submit" class="btn btn-md btn-primary">Назначить</button>
      </form>
    </section>

    {# Отметить оплату #}
    <section class="card">
      <h2 class="wz-card-title">Отметить оплату по счёту</h2>
      <p class="form-hint u-m-0 u-mb-3">Период считается от даты зачисления; оплата до окончания продлевает текущий период. Другой тариф: дороже — сразу, остаток пересчитывается в дни; дешевле — со следующего периода.</p>
      <form method="post" action="{{ path('admin_billing_company_payment', {companyId: company.id}) }}">
        <input type="hidden" name="_token" value="{{ csrf_token('billing_payment_' ~ company.id) }}">
        <input type="hidden" name="payment_id" value="{{ paymentFormId }}">
        <div class="u-flex u-gap-3">
          <div class="form-field u-flex-1">
            <label class="form-label" for="payment-tariff">Тариф</label>
            <select id="payment-tariff" name="tariff" class="select" required>
              {% for tariff in tariffs|filter(t => not t.perpetual) %}
                <option value="{{ tariff.code.value }}" {% if tariff.code.value == defaultPaymentTariff %}selected{% endif %}>{{ tariff.name }}</option>
              {% endfor %}
            </select>
          </div>
          <div class="form-field u-w-120">
            <label class="form-label" for="payment-months">Срок</label>
            <select id="payment-months" name="months" class="select">
              {% for m in [1, 3, 6, 12] %}<option value="{{ m }}">{{ m }} мес</option>{% endfor %}
            </select>
          </div>
        </div>
        <div class="u-flex u-gap-3">
          <div class="form-field u-flex-1">
            <label class="form-label" for="payment-amount">Сумма, ₽</label>
            <input id="payment-amount" type="text" inputmode="decimal" name="amount" class="input" placeholder="4970" required>
          </div>
          <div class="form-field u-flex-1">
            <label class="form-label" for="payment-received">Дата зачисления</label>
            <input id="payment-received" type="date" name="received_on" class="input" value="{{ today }}" required>
          </div>
        </div>
        <div class="form-field">
          <label class="form-label" for="payment-invoice">Номер счёта</label>
          <input id="payment-invoice" type="text" name="invoice" class="input" maxlength="128" placeholder="необязательно">
          <div class="form-hint">Тот же номер второй раз не зачисляется.</div>
        </div>
        {% if subscription and subscription.tariff.perpetual %}
          <label class="checkbox-label u-mb-3">
            <input type="checkbox" class="checkbox" name="confirm_leave_perpetual" value="1">
            <span>Перевести с бессрочного «{{ subscription.tariff.name }}» на платный тариф</span>
          </label>
        {% endif %}
        <button type="submit" class="btn btn-md btn-primary">Зачислить оплату</button>
      </form>

      {% if pricesByTariff is not empty %}
        <table class="t-table u-mt-4">
          <thead>
            <tr><th>Цены</th>{% for m in [1, 3, 6, 12] %}<th class="t-cell--right">{{ m }} мес</th>{% endfor %}</tr>
          </thead>
          <tbody>
            {% for tariff in tariffs|filter(t => pricesByTariff[t.code.value] is defined) %}
              <tr>
                <td>{{ tariff.name }}</td>
                {% for m in [1, 3, 6, 12] %}
                  <td class="t-cell--right u-tnum">{{ (pricesByTariff[tariff.code.value][m] ?? null)|vf_minor|vf_money(0) }}</td>
                {% endfor %}
              </tr>
            {% endfor %}
          </tbody>
        </table>
      {% endif %}
    </section>
  </div>

  {# Онлайн-оплаты, которые не зачислились сами: деньги получены — зачислить вручную формой выше или вернуть #}
  {% if failedCheckouts is not empty %}
    <section class="card u-p-0 wz-scroll u-mb-4" data-billing-failed-checkouts>
      <div class="wz-card-intro">
        <h2 class="u-fs-15 u-m-0">Онлайн-оплаты без зачисления</h2>
        <p class="u-text-muted u-m-0 u-mt-1">Продлить автоматически не удалось, или платёж больше суток не доходит до конечного статуса. Проверьте платёж в кабинете ЮKassa: если деньги списаны — отметьте оплату вручную (номер — ID платежа ЮKassa) или оформите возврат.</p>
      </div>
      <table class="t-table">
        <thead>
          <tr>
            <th>Создана</th>
            <th>Тариф</th>
            <th class="t-cell--right">Срок</th>
            <th class="t-cell--right">Сумма, ₽</th>
            <th>ID платежа ЮKassa</th>
            <th>Причина</th>
          </tr>
        </thead>
        <tbody>
          {% for c in failedCheckouts %}
            <tr>
              <td class="u-tnum">{{ c.createdAt|date('d.m.Y H:i') }}</td>
              <td>{{ c.tariff.name }}</td>
              <td class="t-cell--right">{{ c.months }} мес</td>
              <td class="t-cell--right u-tnum">{{ c.amountKopecks|vf_minor|vf_money }}</td>
              <td class="u-break-all">{{ c.providerPaymentId ?? '—' }}</td>
              <td>{{ c.failureReason ?? (c.status.value == 'pending' ? 'нет конечного статуса больше суток' : '—') }}</td>
            </tr>
          {% endfor %}
        </tbody>
      </table>
    </section>
  {% endif %}

  {# История оплат #}
  <section class="card u-p-0 wz-scroll">
    <div class="wz-card-intro">
      <h2 class="u-fs-15 u-m-0">История оплат</h2>
    </div>
    {% if payments.nbResults > 0 %}
      <table class="t-table">
        <thead>
          <tr>
            <th>Зачислено</th>
            <th>Тариф</th>
            <th class="t-cell--right">Срок</th>
            <th class="t-cell--right">Сумма, ₽</th>
            <th>Период</th>
            <th>Способ</th>
            <th>Номер</th>
          </tr>
        </thead>
        <tbody>
          {% for payment in payments.currentPageResults %}
            <tr>
              <td class="u-tnum">{{ payment.receivedAt|date('d.m.Y') }}</td>
              <td>{{ payment.tariff.name }}</td>
              <td class="t-cell--right">{{ payment.months }} мес</td>
              <td class="t-cell--right u-tnum">{{ payment.amountKopecks|vf_minor|vf_money }}</td>
              <td class="u-tnum">{{ payment.periodFrom|date('d.m.Y') }} — {{ payment.periodUntil|date('d.m.Y') }}{% if payment.carriedDays > 0 %}<div class="form-hint" data-billing-carried>+{{ payment.carriedDays }} дн. за остаток ({{ payment.carriedKopecks|vf_minor|vf_money }})</div>{% endif %}</td>
              <td>{{ payment.source.label }}</td>
              <td class="u-break-all">{{ payment.externalId ?? '—' }}</td>
            </tr>
          {% endfor %}
        </tbody>
      </table>
      {% include 'app/_ui/_pagination.html.twig' with {pager: payments} %}
    {% else %}
      {% include 'partials/_empty.html.twig' with {title: 'Оплат пока нет', hint: 'Отметьте оплату по счёту формой выше — она появится здесь.', variant: 'app'} only %}
    {% endif %}
  </section>
{% endblock %}
