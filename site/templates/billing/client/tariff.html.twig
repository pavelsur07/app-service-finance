{% extends 'base.html.twig' %}

{% block title %}Тариф и оплата — {{ company.name }}{% endblock %}

{% set statusView = {
  active: { cls: 'success', label: 'Активен' },
  grace: { cls: 'warning', label: 'Оплата просрочена' },
  read_only: { cls: 'danger', label: 'Только чтение' },
  none: { cls: 'secondary', label: 'Тариф не выбран' },
} %}

{% block body %}
  <div class="page-header mb-3">
    <h2 class="page-title">Тариф и оплата</h2>
    <div class="text-secondary">{{ company.name }}</div>
  </div>

  {# Текущий тариф #}
  {% set view = statusView[access.status.value] %}
  <div class="card mb-3" data-billing-current>
    <div class="card-body">
      <div class="row g-3 align-items-baseline">
        <div class="col-sm-auto">
          <div class="text-secondary small">Тариф</div>
          <div class="h3 mb-0">
            {{ access.tariffName ?? '—' }}
            {% if access.trial %}<span class="badge bg-blue-lt ms-1">пробный период</span>{% endif %}
          </div>
        </div>
        <div class="col-sm-auto">
          <div class="text-secondary small">Статус</div>
          <span class="badge bg-{{ view.cls }}-lt">{{ view.label }}</span>
        </div>
        <div class="col-sm-auto">
          <div class="text-secondary small">{{ access.trial ? 'Пробный период до' : 'Оплачено по' }}</div>
          <div style="font-variant-numeric:tabular-nums;">
            {% if access.tariffName is null %}—{% elseif access.paidUntil is null %}бессрочно{% else %}{{ access.paidUntil|date('d.m.Y') }}{% endif %}
          </div>
        </div>
        {% if access.daysLeft is not null and access.daysLeft > 0 %}
          <div class="col-sm-auto">
            <div class="text-secondary small">Осталось дней</div>
            <div style="font-variant-numeric:tabular-nums;">{{ access.daysLeft }}</div>
          </div>
        {% endif %}
      </div>
    </div>
  </div>

  {# Цены #}
  {% if offers is not empty %}
    <div class="card mb-3">
      <div class="card-header"><h3 class="card-title">Тарифы</h3></div>
      <div class="table-responsive">
        <table class="table table-vcenter card-table" data-billing-prices>
          <thead>
            <tr>
              <th>Тариф</th>
              {% for m in months %}<th class="text-end">{{ m }} мес</th>{% endfor %}
            </tr>
          </thead>
          <tbody>
            {% for offer in offers %}
              <tr>
                <td class="fw-medium">{{ offer.tariff.name }}</td>
                {% for m in months %}
                  {% set price = offer.prices[m] ?? null %}
                  <td class="text-end" style="font-variant-numeric:tabular-nums;">
                    {% if price %}
                      <div>{{ price.total|vf_minor|vf_money(0) }}</div>
                      {% if m > 1 %}
                        <div class="text-secondary small">{{ price.perMonth|vf_minor|vf_money(0) }} / мес{% if price.discountPercent > 0 %} · −{{ price.discountPercent }}%{% endif %}</div>
                      {% endif %}
                    {% else %}—{% endif %}
                  </td>
                {% endfor %}
              </tr>
            {% endfor %}
          </tbody>
        </table>
      </div>
    </div>
  {% endif %}

  {# Как оплатить #}
  <div class="card mb-3" data-billing-how-to-pay>
    <div class="card-body">
      <h3 class="card-title">Как оплатить</h3>
      <p class="mb-1">Напишите на <a href="mailto:{{ billingEmail }}?subject={{ ('Счёт на оплату: ' ~ company.name)|url_encode }}">{{ billingEmail }}</a>: тариф, срок и реквизиты компании. Мы выставим счёт.</p>
      <p class="text-secondary mb-0">Срок считается со дня зачисления оплаты. Если оплатить до окончания текущего периода (или пробного), новый начнётся сразу после него — оплаченные дни не теряются.</p>
    </div>
  </div>

  {# История оплат — только владельцу #}
  {% if payments is not null %}
    <div class="card" data-billing-payments>
      <div class="card-header"><h3 class="card-title">История оплат</h3></div>
      {% if payments.nbResults > 0 %}
        <div class="table-responsive">
          <table class="table table-vcenter card-table">
            <thead>
              <tr>
                <th>Зачислено</th>
                <th>Тариф</th>
                <th class="text-end">Срок</th>
                <th class="text-end">Сумма</th>
                <th>Период</th>
                <th>Счёт</th>
              </tr>
            </thead>
            <tbody>
              {% for payment in payments.currentPageResults %}
                <tr>
                  <td style="font-variant-numeric:tabular-nums;">{{ payment.receivedAt|date('d.m.Y') }}</td>
                  <td>{{ payment.tariff.name }}</td>
                  <td class="text-end">{{ payment.months }} мес</td>
                  <td class="text-end" style="font-variant-numeric:tabular-nums;">{{ payment.amountKopecks|vf_minor|vf_money }}</td>
                  <td style="font-variant-numeric:tabular-nums;">{{ payment.periodFrom|date('d.m.Y') }} — {{ payment.periodUntil|date('d.m.Y') }}</td>
                  <td>{{ payment.externalId ?? '—' }}</td>
                </tr>
              {% endfor %}
            </tbody>
          </table>
        </div>
        {% if payments.haveToPaginate %}
          <div class="card-footer">
            {% include 'partials/_pagination.html.twig' with { pager: payments, route: 'company_price_index', params: {} } %}
          </div>
        {% endif %}
      {% else %}
        <div class="card-body text-secondary">Оплат пока нет.</div>
      {% endif %}
    </div>
  {% endif %}
{% endblock %}
