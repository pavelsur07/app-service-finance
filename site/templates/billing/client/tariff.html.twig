{% extends 'base.html.twig' %}

{% block title %}Тариф и оплата — {{ company.name }}{% endblock %}

{% set statusView = {
  active: { cls: 'success', label: 'Активен' },
  grace: { cls: 'warning', label: 'Оплата просрочена' },
  read_only: { cls: 'danger', label: 'Только чтение' },
  none: { cls: 'secondary', label: 'Тариф не выбран' },
} %}

{% block body %}
  <div class="page-header mb-3">
    <h2 class="page-title">Тариф и оплата</h2>
    <div class="text-secondary">{{ company.name }}</div>
  </div>

  {# Итог онлайн-оплаты после возврата с ЮKassa #}
  {% if checkout %}
    {% set checkoutView = {
      pending: { cls: 'info', text: 'Платёж обрабатывается. Если вы уже оплатили, обновите страницу через минуту — срок продлится автоматически.' },
      succeeded: { cls: 'success', text: 'Оплата прошла, тариф продлён.' },
      canceled: { cls: 'warning', text: 'Оплата не прошла или отменена. Деньги не списаны — можно попробовать ещё раз.' },
      failed_to_apply: { cls: 'danger', text: 'Оплата получена, но не зачислена автоматически. Мы уже видим её и продлим тариф вручную — писать не нужно.' },
    } %}
    {% set cv = checkoutView[checkout.status.value] %}
    <div class="alert alert-{{ cv.cls }}" role="alert" data-billing-checkout-status="{{ checkout.status.value }}">
      {{ cv.text }}
    </div>
  {% endif %}

  {# Текущий тариф #}
  {% set view = statusView[access.status.value] %}
  <div class="card mb-3" data-billing-current>
    <div class="card-body">
      <div class="row g-3 align-items-baseline">
        <div class="col-sm-auto">
          <div class="text-secondary small">Тариф</div>
          <div class="h3 mb-0">
            {{ access.tariffName ?? '—' }}
            {% if access.trial %}<span class="badge bg-blue-lt ms-1">пробный период</span>{% endif %}
          </div>
        </div>
        <div class="col-sm-auto">
          <div class="text-secondary small">Статус</div>
          <span class="badge bg-{{ view.cls }}-lt">{{ view.label }}</span>
        </div>
        <div class="col-sm-auto">
          <div class="text-secondary small">{{ access.trial ? 'Пробный период до' : 'Оплачено по' }}</div>
          <div style="font-variant-numeric:tabular-nums;">
            {% if access.tariffName is null %}—{% elseif access.paidUntil is null %}бессрочно{% else %}{{ access.paidUntil|date('d.m.Y') }}{% endif %}
          </div>
        </div>
        {% if access.nextTariffName is not null %}
          <div class="col-sm-auto" data-billing-next-tariff>
            <div class="text-secondary small">Запланировано</div>
            <div>С {{ access.nextTariffFrom|date('d.m.Y') }} — тариф «{{ access.nextTariffName }}»</div>
          </div>
        {% endif %}
        {% if access.daysLeft is not null and access.daysLeft > 0 %}
          <div class="col-sm-auto">
            <div class="text-secondary small">Осталось дней</div>
            <div style="font-variant-numeric:tabular-nums;">{{ access.daysLeft }}</div>
          </div>
        {% endif %}
      </div>
    </div>
  </div>

  {# Цены #}
  {% if offers is not empty %}
    <div class="card mb-3">
      <div class="card-header"><h3 class="card-title">Тарифы</h3></div>
      <div class="table-responsive">
        <table class="table table-vcenter card-table" data-billing-prices>
          <thead>
            <tr>
              <th>Тариф</th>
              {% for m in months %}<th class="text-end">{{ m }} мес</th>{% endfor %}
            </tr>
          </thead>
          <tbody>
            {% for offer in offers %}
              <tr>
                <td class="fw-medium">{{ offer.tariff.name }}</td>
                {% for m in months %}
                  {% set price = offer.prices[m] ?? null %}
                  <td class="text-end" style="font-variant-numeric:tabular-nums;">
                    {% if price %}
                      <div>{{ price.total|vf_minor|vf_money(0) }}</div>
                      {% if m > 1 %}
                        <div class="text-secondary small">{{ price.perMonth|vf_minor|vf_money(0) }} / мес{% if price.discountPercent > 0 %} · −{{ price.discountPercent }}%{% endif %}</div>
                      {% endif %}
                    {% else %}—{% endif %}
                  </td>
                {% endfor %}
              </tr>
            {% endfor %}
          </tbody>
        </table>
      </div>
    </div>
  {% endif %}

  {# Онлайн-оплата — владельцу, если ключи ЮKassa заданы и продление допустимо #}
  {% if online %}
    <div class="card mb-3" data-billing-online>
      <div class="card-body">
        <h3 class="card-title">Оплатить онлайн</h3>
        <form method="post" action="{{ path('company_price_checkout') }}" class="row g-2 align-items-end">
          <input type="hidden" name="_token" value="{{ csrf_token('billing_checkout') }}">
          <input type="hidden" name="checkout_id" value="{{ online.checkoutId }}">
          <div class="col-sm-auto">
            <label class="form-label" for="billing-online-tariff">Тариф</label>
            <select class="form-select" id="billing-online-tariff" name="tariff" required>
              {% for offer in online.offers %}
                <option value="{{ offer.tariff.code.value }}"{% if online.selected == offer.tariff.code.value %} selected{% endif %}>{{ offer.tariff.name }}</option>
              {% endfor %}
            </select>
          </div>
          <div class="col-sm-auto">
            <label class="form-label" for="billing-online-months">Срок</label>
            <select class="form-select" id="billing-online-months" name="months" required>
              {% for m in months %}<option value="{{ m }}">{{ m }} мес</option>{% endfor %}
            </select>
          </div>
          <div class="col-sm-auto">
            <button type="submit" class="btn btn-primary">Оплатить онлайн</button>
          </div>
        </form>
        {# Что произойдёт при оплате сегодня: показывается подсказка выбранных тарифа и срока #}
        {% set defaultKey = online.selected ~ ':1' %}
        {% for key, plan in online.plans %}
          {% set tariffName = (online.offers|filter(o => o.tariff.code.value == key|split(':')|first)|first).tariff.name %}
          <p class="small mt-2 mb-0" data-billing-plan="{{ key }}" data-billing-plan-kind="{{ plan.kind.value }}"{% if key != defaultKey %} hidden{% endif %}>
            {% if plan.kind.value == 'renewal' %}
              Продлим тариф «{{ tariffName }}» до {{ plan.period.until|date('d.m.Y') }} — новый период начнётся {{ plan.period.from|date('d.m.Y') }}.
            {% elseif plan.kind.value == 'upgrade' %}
              Тариф «{{ tariffName }}» начнёт действовать сразу — по {{ plan.period.until|date('d.m.Y') }}{% if plan.carriedDays > 0 %}, включая +{{ plan.carriedDays }} дн. за неиспользованный остаток текущего тарифа{% endif %}.
            {% elseif plan.kind.value == 'downgrade' %}
              До {{ access.paidUntil|date('d.m.Y') }} остаётся текущий тариф, с {{ plan.period.from|date('d.m.Y') }} по {{ plan.period.until|date('d.m.Y') }} — «{{ tariffName }}».
            {% else %}
              Тариф «{{ tariffName }}» с {{ plan.period.from|date('d.m.Y') }} по {{ plan.period.until|date('d.m.Y') }}.
            {% endif %}
          </p>
        {% endfor %}
        <p class="text-secondary small mt-2 mb-0">Картой, СБП или другим способом на странице ЮKassa. Сумма — по таблице выше. Расчёт — на день оплаты.{% for reason in online.unavailable %} {{ reason }}{% endfor %}</p>
        <script>
          (() => {
            const card = document.currentScript.closest('[data-billing-online]');
            const tariff = card.querySelector('[name="tariff"]');
            const months = card.querySelector('[name="months"]');
            const update = () => {
              const key = tariff.value + ':' + months.value;
              card.querySelectorAll('[data-billing-plan]').forEach((el) => { el.hidden = el.dataset.billingPlan !== key; });
            };
            tariff.addEventListener('change', update);
            months.addEventListener('change', update);
            update();
          })();
        </script>
      </div>
    </div>
  {% endif %}

  {# Как оплатить #}
  <div class="card mb-3" data-billing-how-to-pay>
    <div class="card-body">
      <h3 class="card-title">{{ online ? 'Оплатить по счёту' : 'Как оплатить' }}</h3>
      <p class="mb-1">Напишите на <a href="mailto:{{ billingEmail }}?subject={{ ('Счёт на оплату: ' ~ company.name)|url_encode }}">{{ billingEmail }}</a>: тариф, срок и реквизиты компании. Мы выставим счёт.</p>
      <p class="text-secondary mb-0">Срок считается со дня зачисления оплаты. Если оплатить до окончания текущего периода (или пробного), новый начнётся сразу после него — оплаченные дни не теряются. Переход на тариф дороже — сразу, неиспользованный остаток пересчитаем в дни нового тарифа; на тариф дешевле — со следующего периода.</p>
    </div>
  </div>

  {# История оплат — только владельцу #}
  {% if payments is not null %}
    <div class="card" data-billing-payments>
      <div class="card-header"><h3 class="card-title">История оплат</h3></div>
      {% if payments.nbResults > 0 %}
        <div class="table-responsive">
          <table class="table table-vcenter card-table">
            <thead>
              <tr>
                <th>Зачислено</th>
                <th>Тариф</th>
                <th class="text-end">Срок</th>
                <th class="text-end">Сумма</th>
                <th>Период</th>
                <th>Способ</th>
                <th>Номер</th>
              </tr>
            </thead>
            <tbody>
              {% for payment in payments.currentPageResults %}
                <tr>
                  <td style="font-variant-numeric:tabular-nums;">{{ payment.receivedAt|date('d.m.Y') }}</td>
                  <td>{{ payment.tariff.name }}</td>
                  <td class="text-end">{{ payment.months }} мес</td>
                  <td class="text-end" style="font-variant-numeric:tabular-nums;">{{ payment.amountKopecks|vf_minor|vf_money }}</td>
                  <td style="font-variant-numeric:tabular-nums;">{{ payment.periodFrom|date('d.m.Y') }} — {{ payment.periodUntil|date('d.m.Y') }}{% if payment.carriedDays > 0 %}<div class="text-secondary small" data-billing-carried>+{{ payment.carriedDays }} дн. за остаток прежнего тарифа</div>{% endif %}</td>
                  <td>{{ payment.source.label }}</td>
                  <td class="text-break">{{ payment.externalId ?? '—' }}</td>
                </tr>
              {% endfor %}
            </tbody>
          </table>
        </div>
        {% if payments.haveToPaginate %}
          <div class="card-footer">
            {% include 'partials/_pagination.html.twig' with { pager: payments, route: 'company_price_index', params: {} } %}
          </div>
        {% endif %}
      {% else %}
        <div class="card-body text-secondary">Оплат пока нет.</div>
      {% endif %}
    </div>
  {% endif %}
{% endblock %}
