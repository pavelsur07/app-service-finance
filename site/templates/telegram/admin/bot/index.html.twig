{% extends 'admin/base.html.twig' %}

{% block title %}Admin · Telegram-боты{% endblock %}

{% block body %}
  <div class="wz-head">
    <h1 class="wz-title">
      Telegram-боты
      <span class="wz-sub">Управление ботами сервиса</span>
    </h1>
    <div class="wz-head-actions">
      <a href="{{ path('admin_telegram_bot_webhook_set') }}" class="btn btn-md btn-secondary">Установить webhook</a>
      <a href="{{ path('admin_telegram_bot_webhook_health') }}" class="btn btn-md btn-secondary">Проверить webhook</a>
      <a href="{{ path('admin_telegram_bot_new') }}" class="btn btn-md btn-primary">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg>
        Добавить бота
      </a>
    </div>
  </div>

  {% for status in app.flashes('webhook_status') %}
    <div class="card wz-sec">
      <div class="card-head">Статус webhook</div>
      <div class="wz-form-grid">
        <div class="form-field wz-span-all">
          <span class="form-label">Webhook URL (ожидается)</span>
          <span>{{ status.expectedUrl }}</span>
        </div>
        <div class="form-field">
          <span class="form-label">Webhook установлен</span>
          <span>
            {% if status.webhookInstalled %}
              <span class="status status--success"><span class="dot"></span>Да</span>
            {% else %}
              <span class="status status--danger"><span class="dot"></span>Нет</span>
            {% endif %}
          </span>
        </div>
        <div class="form-field">
          <span class="form-label">Webhook живой</span>
          <span>
            {% if status.webhookAlive %}
              <span class="status status--success"><span class="dot"></span>Да</span>
            {% else %}
              <span class="status status--danger"><span class="dot"></span>Нет</span>
            {% endif %}
          </span>
        </div>
        <div class="form-field">
          <span class="form-label">Ожидающих обновлений</span>
          <span>{{ status.pendingUpdateCount is not null ? status.pendingUpdateCount : 'нет данных' }}</span>
        </div>
        <div class="form-field wz-span-all">
          <span class="form-label">Текущий URL</span>
          <span>{{ status.actualUrl ?? '—' }}</span>
        </div>
        <div class="form-field wz-span-all">
          <span class="form-label">Последняя ошибка</span>
          {% if status.lastErrorDate or status.lastErrorMessage %}
            <span>{{ status.lastErrorMessage ?: 'сообщение отсутствует' }}</span>
            {% if status.lastErrorDate %}
              <span style="color:var(--text-muted); font-size:var(--font-11);">{{ status.lastErrorDate|date('d.m.Y H:i:s') }}</span>
            {% endif %}
          {% else %}
            <span>Ошибок не зафиксировано</span>
          {% endif %}
        </div>
      </div>
    </div>
  {% endfor %}

  {% if bots is empty %}
    <div class="empty">
      <div class="empty-icon">
        <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M21 11.5a8.38 8.38 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.38 8.38 0 0 1-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.38 8.38 0 0 1 3.8-.9h.5a8.48 8.48 0 0 1 8 8v.5z"/></svg>
      </div>
      <div class="empty-title">Пока нет ни одного бота</div>
      <div class="empty-text">Нажмите «Добавить бота», чтобы создать первую запись.</div>
      <a href="{{ path('admin_telegram_bot_new') }}" class="btn btn-md btn-primary">Добавить бота</a>
    </div>
  {% else %}
    <div class="card card--flush">
      <div class="card-head">
        <span>Боты</span>
        <span class="card-head-aside">В списке: {{ bots|length }}</span>
      </div>
      <div class="wz-scroll">
        <table class="t-table">
          <thead>
            <tr>
              <th>Имя пользователя</th>
              <th>Токен</th>
              <th>Webhook URL</th>
              <th>Активен</th>
              <th><span class="sr-only">Действия</span></th>
            </tr>
          </thead>
          <tbody>
            {% for bot in bots %}
              <tr>
                <td>{{ bot.username ?? '—' }}</td>
                <td style="color:var(--text-muted); font-family:var(--font-mono);">
                  {{ bot.token ? bot.token|slice(0, 6) ~ '****' : '—' }}
                </td>
                <td>{{ bot.webhookUrl ?? '—' }}</td>
                <td>
                  {% if bot.isActive %}
                    <span class="status status--success"><span class="dot"></span>Да</span>
                  {% else %}
                    <span class="status status--neutral"><span class="dot"></span>Нет</span>
                  {% endif %}
                </td>
                <td>
                  <div class="wz-head-actions">
                    <a class="btn btn-sm btn-secondary" href="{{ path('admin_telegram_bot_edit', {id: bot.id}) }}">Редактировать</a>
                    <form method="post" action="{{ path('admin_telegram_bot_toggle', {id: bot.id}) }}">
                      <input type="hidden" name="_token" value="{{ csrf_token('toggle_bot' ~ bot.id) }}">
                      {% if bot.isActive %}
                        <button class="btn btn-sm btn-danger" type="submit"
                                data-admin-confirm="Бот перестанет обрабатывать входящие вебхуки. Продолжить?"
                                data-admin-confirm-title="Деактивировать бота?"
                                data-admin-confirm-label="Деактивировать"
                                data-admin-confirm-tone="danger">Деактивировать</button>
                      {% else %}
                        <button class="btn btn-sm btn-primary" type="submit"
                                data-admin-confirm="Бот начнёт обрабатывать входящие вебхуки. Продолжить?"
                                data-admin-confirm-title="Активировать бота?"
                                data-admin-confirm-label="Активировать"
                                data-admin-confirm-tone="primary">Активировать</button>
                      {% endif %}
                    </form>
                  </div>
                </td>
              </tr>
            {% endfor %}
          </tbody>
        </table>
      </div>
    </div>
  {% endif %}
{% endblock %}
