{% extends 'api/settings/layout.html.twig' %}
{% block content %}
{% include 'partials/_page_header.html.twig' with {title: 'Управление API', container: false, class: 'mb-3'} only %}
<section class="card"><div class="card-body">
    <div class="alert alert-danger" role="alert">{{ message }}</div>
    <div class="d-flex flex-wrap gap-2">
        {% if reloadKeyId|default(null) %}<a class="btn btn-primary" href="{{ path('settings_api_permissions', {id: reloadKeyId}) }}">Перечитать права</a>{% endif %}
        <a class="btn btn-outline-secondary" href="{{ path('settings_api_index') }}">К списку ключей</a>
    </div>
</div></section>
{% endblock %}
