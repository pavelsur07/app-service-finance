{% extends 'api/settings/layout.html.twig' %}
{% block content %}
{% include 'partials/_page_header.html.twig' with {title: title, container: false, class: 'mb-3'} only %}
<section class="card"><div class="card-body">
    <div class="alert alert-warning" role="alert">{{ warning }}</div>
    {% if key is defined %}<div class="mb-3"><label class="form-label" for="api-key-current-name">Ключ</label><input id="api-key-current-name" class="form-control" readonly value="{{ key.name }}"></div>{% endif %}
    {{ form_start(form) }}
    {{ form_errors(form) }}
    {{ form_rest(form) }}
    <div class="d-flex flex-wrap gap-2">
        <button type="submit" class="btn btn-primary">{{ submit }}</button>
        <a class="btn btn-outline-secondary" href="{{ path('settings_api_index') }}">Отмена</a>
    </div>
    {{ form_end(form) }}
</div></section>
{% endblock %}
