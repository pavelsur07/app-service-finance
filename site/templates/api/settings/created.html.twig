{% extends 'api/settings/layout.html.twig' %}
{% block content %}
{% include 'partials/_page_header.html.twig' with {title: 'API-ключ создан', container: false, class: 'mb-3'} only %}
<section class="card"><div class="card-body">
    <div class="alert alert-warning" role="alert"><div><h3 class="alert-title">Сохраните ключ сейчас</h3><p class="mb-0">Секрет показан только в этом ответе. После ухода со страницы его нельзя открыть снова.</p></div></div>
    <div class="mb-3"><label class="form-label" for="api-key-current-name">Название ключа</label><input id="api-key-current-name" class="form-control" readonly value="{{ key.name }}"></div>
    <p>Действует до {{ key.expiresAt|date('d.m.Y H:i', 'UTC') }} UTC</p>
    <div class="mb-3"><label class="form-label" for="api-secret">Секрет API-ключа</label><input id="api-secret" class="form-control" type="text" readonly autocomplete="off" spellcheck="false" value="{{ secret }}" data-api-secret></div>
    <div class="d-flex flex-wrap gap-2"><button class="btn btn-primary" type="button" data-api-copy>Скопировать</button><a class="btn btn-outline-secondary" href="{{ path('settings_api_index') }}">Готово</a></div>
    <p class="form-hint mt-2" role="status" aria-live="polite" data-api-copy-status>Скопируйте ключ в безопасное место.</p>
</div></section>
{% endblock %}
