{% use 'form_div_layout.html.twig' %}
{% block form_row %}
    <div class="form-field">
        {{ form_label(form, null, {label_attr: {class: 'form-label'}}) }}
        {{ form_widget(form, {attr: attr|merge({class: valid ? 'input' : 'input input-error', 'aria-invalid': valid ? 'false' : 'true', 'aria-describedby': valid ? '' : id ~ '_errors'})}) }}
        {{ form_errors(form) }}
    </div>
{% endblock %}
{% block form_errors %}
    {% if errors|length > 0 %}
        <div id="{{ id }}_errors" class="field-helper error" role="alert">{% for error in errors %}<p>{{ error.message }}</p>{% endfor %}</div>
    {% endif %}
{% endblock %}
