{% extends 'api/settings/layout.html.twig' %}
{% block content %}
{% embed 'partials/_page_header.html.twig' with {title: 'Права API-ключа', container: false, class: 'mb-3'} %}
    {% block subtitle %}<div class="text-secondary mt-1">Подготовьте доступ отдельно для каждого подключения</div>{% endblock %}
    {% block actions %}<a class="btn btn-outline-secondary" href="{{ path('settings_api_index') }}">К списку ключей</a>{% endblock %}
{% endembed %}
<section class="card mb-3"><div class="card-body">
    <div class="mb-3"><label class="form-label" for="api-key-current-name">Ключ</label><input id="api-key-current-name" class="form-control" readonly value="{{ key.name }}"></div>
    <div class="alert alert-warning" role="alert">Права подготовлены. Доступ появится после подключения раздела и вашего включения</div>
    <p>Подготовлено прав: {{ key.selectedScopes|length|vf_number }}. Действующих прав: {{ effectiveScopes|length|vf_number }}.</p>
    <p class="mb-0">Новые разделы и права не выдаются автоматически. Сохранение прав не продлевает срок действия ключа.</p>
</div></section>
{{ form_start(form, {attr: {'data-api-permissions': ''}}) }}
{{ form_errors(form) }}{{ form_errors(form.selectedScopes) }}{{ form_errors(form.enabledResources) }}{{ form_errors(form.version) }}
{% set scope_fields = {} %}{% for field in form.selectedScopes %}{% set scope_fields = scope_fields|merge({(field.vars.value): field}) %}{% endfor %}
{% set enable_fields = {} %}{% for field in form.enabledResources %}{% set enable_fields = enable_fields|merge({(field.vars.value): field}) %}{% endfor %}
{% set action_labels = {read: 'Чтение', create: 'Создание', update: 'Изменение', soft_delete: 'Мягкое удаление'} %}
<div class="d-flex flex-wrap gap-2 mb-2">
    <button class="btn btn-outline-secondary" type="button" data-api-preset="{{ presets.read_only|json_encode|e('html_attr') }}">Только чтение</button>
    <button class="btn btn-outline-secondary" type="button" data-api-preset="{{ presets.all_scopes|json_encode|e('html_attr') }}">Все действия</button>
</div>
<p class="form-hint mb-3" role="status" aria-live="polite" data-api-preset-status>Выбор набора меняет только отметки. Сохраните изменения отдельной кнопкой.</p>
<section class="card mb-3">
    <div class="table-responsive" role="region" aria-label="Матрица прав API" tabindex="0">
        <table class="table table-vcenter">
            <thead><tr><th scope="col">Раздел</th>{% for label in action_labels %}<th scope="col">{{ label }}</th>{% endfor %}<th scope="col">Включить доступ</th><th scope="col">Подключение</th></tr></thead>
            <tbody>{% for resource, definition in resources %}
                <tr><th scope="row">{{ definition.label }}</th>
                    {% for action, label in action_labels %}
                        <td>{% if action in definition.actions %}
                            {{ form_widget(scope_fields[resource ~ '.' ~ action], {label: false, attr: {'data-api-scope': '', 'aria-label': definition.label ~ ': ' ~ label}}) }}
                        {% else %}<span aria-label="Право не предусмотрено">—</span>{% endif %}</td>
                    {% endfor %}
                    <td>{% if definition.connected %}{{ form_widget(enable_fields[resource], {label: false, attr: {'data-api-resource-enable': '', 'aria-label': 'Включить доступ: ' ~ definition.label}}) }}{% else %}<input class="form-check-input" type="checkbox" disabled data-api-resource-enable aria-label="{{ definition.label }}: раздел ещё не подключён">{% endif %}</td>
                    <td>{% if definition.connected %}<span class="badge bg-success-lt">Подключён</span>{% else %}<span class="badge bg-warning-lt">Не подключён</span>{% endif %}</td>
                </tr>
            {% endfor %}</tbody>
        </table>
    </div>
</section>
{{ form_widget(form.version) }}{{ form_widget(form._token) }}
<div class="d-flex flex-wrap gap-2"><button class="btn btn-primary" type="submit">Сохранить права</button><a class="btn btn-outline-secondary" href="{{ path('settings_api_index') }}">Отмена</a></div>
{{ form_end(form, {render_rest: false}) }}
{% endblock %}
