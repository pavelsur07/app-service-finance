{% extends '_layout/app.html.twig' %}

{% set app_breadcrumb = 'Финансовый обзор' %}
{% set app_nav_active = 'home' %}

{% macro money(value, currency) %}
    {% if value < 0 %}−{% endif %}{{ value|abs|number_format(0, ',', ' ') }} {{ currency }}
{% endmacro %}

{% macro comparison(name, data, currency, previousLabel) %}
    <div
        class="kpi-meta"
        data-dashboard-kpi-comparison="{{ name }}"
        data-comparison-state="{{ data.state }}"
        data-comparison-variant="{{ data.variant }}"
    >
        <span class="delta delta--{{ data.variant }}">
            {% if data.state == 'percent' %}
                {% set formattedPercent = data.percent|abs|number_format(1, ',', ' ') %}
                {% if data.percent > 0 %}<span class="sr-only">Рост на {{ formattedPercent }}%</span><span aria-hidden="true">+{{ formattedPercent }}%</span>{% elseif data.percent < 0 %}<span class="sr-only">Снижение на {{ formattedPercent }}%</span><span aria-hidden="true">−{{ formattedPercent }}%</span>{% else %}{{ formattedPercent }}%{% endif %}
            {% elseif data.state == 'cross_up' %}
                Из минуса в плюс
            {% elseif data.state == 'cross_down' %}
                Из плюса в минус
            {% elseif data.state == 'no_base' %}
                Нет базы
            {% endif %}
        </span>
        {{ previousLabel }}: {{ _self.money(data.previous, currency) }}
    </div>
{% endmacro %}

{% block title %}Финансовый обзор{% endblock %}

{% block content %}
    <section class="app-dashboard" data-dashboard-mode="app" aria-labelledby="dashboard-title">
        <header class="wz-head">
            <h1 class="wz-title" id="dashboard-title">
                Финансовый обзор
                <span class="wz-sub">Ключевые показатели компании на текущую дату</span>
            </h1>
            <form method="get" class="wz-head-actions">
                <input type="hidden" name="activity" value="{{ cashflowActivity }}">
                <label class="sr-only" for="app-dashboard-currency">Валюта ДДС</label>
                <select id="app-dashboard-currency" name="currency" class="select">
                    {% for currency in cashCurrencies %}
                        <option value="{{ currency.value }}" {{ currency == cashCurrency ? 'selected' : '' }}>{{ currency.value }}</option>
                    {% endfor %}
                </select>
                <button type="submit" class="btn btn-md btn-primary">Применить</button>
            </form>
        </header>

        <div class="wz-row">
            <div class="tabs-row">
                <form method="get" class="tabs" aria-label="Вид деятельности" data-dashboard-activity-filter data-selected-activity="{{ cashflowActivity }}">
                    <input type="hidden" name="currency" value="{{ cashCurrency.value }}">
                    {% for activity, label in cashflowActivities %}
                        {% set activity_tab_class = activity == cashflowActivity ? ' is-active' : '' %}
                        <button
                            type="submit"
                            name="activity"
                            value="{{ activity }}"
                            class="tab{{ activity_tab_class }}"
                            aria-pressed="{{ activity == cashflowActivity ? 'true' : 'false' }}"
                        >{{ label }}</button>
                    {% endfor %}
                </form>
                <div class="u-flex-1"></div>
                <span class="tabs-meta">
                    <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
                    Данные на <b>{{ 'now'|date('d.m.Y') }}</b>
                </span>
            </div>
        </div>

        <div class="wz-row" aria-label="Ключевые финансовые показатели">
            <article class="kpi kpi--dark">
                <div class="kpi-label">Остаток на сегодня</div>
                <div class="kpi-value kpi-value--hero money" data-dashboard-kpi="todayBalance">{{ _self.money(kpi.todayBalance, cashCurrency.value) }}</div>
                <div class="kpi-meta">По активным денежным счетам</div>
                {{ _self.comparison('todayBalance', kpiComparisons.todayBalance, cashCurrency.value, kpiPeriodLabels.balanceComparison) }}
            </article>

            <article class="kpi kpi--accent-success">
                <div class="kpi-label">Приход</div>
                <div class="kpi-value money" data-dashboard-kpi="inflow30">{{ _self.money(kpi.inflow30, cashCurrency.value) }}</div>
                <div class="kpi-meta" data-dashboard-kpi-period="current">{{ kpiPeriodLabels.current }}</div>
                <div class="kpi-meta"><a href="{{ path('report_cashflow_index', cashflowReconciliationQuery) }}" data-dashboard-reconcile-link="inflow30">Сверить в ДДС</a></div>
                {{ _self.comparison('inflow30', kpiComparisons.inflow30, cashCurrency.value, kpiPeriodLabels.previous) }}
            </article>

            <article class="kpi kpi--accent-danger">
                <div class="kpi-label">Расход</div>
                <div class="kpi-value money" data-dashboard-kpi="outflow30">{{ _self.money(kpi.outflow30, cashCurrency.value) }}</div>
                <div class="kpi-meta" data-dashboard-kpi-period="current">{{ kpiPeriodLabels.current }}</div>
                <div class="kpi-meta"><a href="{{ path('report_cashflow_index', cashflowReconciliationQuery) }}" data-dashboard-reconcile-link="outflow30">Сверить в ДДС</a></div>
                {{ _self.comparison('outflow30', kpiComparisons.outflow30, cashCurrency.value, kpiPeriodLabels.previous) }}
            </article>

            <article class="kpi kpi--accent-primary">
                <div class="kpi-label">Чистый поток</div>
                <div class="kpi-value money" data-dashboard-kpi="netFlow30">{{ _self.money(kpi.netFlow30, cashCurrency.value) }}</div>
                <div class="kpi-meta" data-dashboard-kpi-period="current">{{ kpiPeriodLabels.current }}</div>
                <div class="kpi-meta"><a href="{{ path('report_cashflow_index', cashflowReconciliationQuery) }}" data-dashboard-reconcile-link="netFlow30">Сверить в ДДС</a></div>
                {{ _self.comparison('netFlow30', kpiComparisons.netFlow30, cashCurrency.value, kpiPeriodLabels.previous) }}
            </article>
        </div>
    </section>
{% endblock %}
