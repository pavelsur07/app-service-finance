<aside class="app-sidebar" aria-label="Навигация нового интерфейса">
    {% set home_item_class = app_nav_active|default('') == 'home' ? 'sb-item is-active' : 'sb-item' %}
    <div class="sb">
        <nav class="sb-nav" aria-label="Основная навигация">
            <div class="sb-group-title">Пилот</div>
            <a class="{{ home_item_class }}"
               href="{{ path('app_home_index') }}"
               aria-current="{{ app_nav_active|default('') == 'home' ? 'page' : 'false' }}">
                <svg class="ico" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <rect x="3" y="3" width="7" height="9" rx="1"></rect>
                    <rect x="14" y="3" width="7" height="5" rx="1"></rect>
                    <rect x="14" y="12" width="7" height="9" rx="1"></rect>
                    <rect x="3" y="16" width="7" height="5" rx="1"></rect>
                </svg>
                <span class="lbl">Обзор</span>
            </a>
        </nav>
        <div class="sb-foot">
            <span class="avatar avatar--md avatar--tint-3" aria-hidden="true">
                {{ app.user ? app.user.email|slice(0, 2)|upper : 'ВФ' }}
            </span>
            <div class="u-flex-1">
                <div class="me-name">{{ app.user ? app.user.email : 'Пользователь' }}</div>
                <div class="me-role">Пилот нового интерфейса</div>
            </div>
            <a class="settings" href="{{ path('app_logout') }}" title="Выйти" aria-label="Выйти">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"></path>
                    <polyline points="16 17 21 12 16 7"></polyline>
                    <line x1="21" y1="12" x2="9" y2="12"></line>
                </svg>
            </a>
        </div>
    </div>
</aside>
