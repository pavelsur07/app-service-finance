<header class="app-header">
    <div class="app-header-brand">
        <a href="{{ path('app_home_index') }}" aria-label="Ваш Финдир — главная">
            <img src="{{ asset('static/logo-vf-001.png') }}" alt="Ваш Финдир">
        </a>
    </div>
    <div class="app-header-body">
        <nav class="crumbs" aria-label="Хлебные крошки">
            <span class="crumb-current">{{ app_breadcrumb|default('Новый интерфейс') }}</span>
        </nav>
        <div class="u-flex-1"></div>
        {% if activeCompany|default(null) %}
            <span class="app-company"
                  title="{{ activeCompany.name }}"><span class="sr-only">Активная компания: </span>{{ activeCompany.name }}</span>
        {% endif %}
        <div class="app-header-actions">
            {% include '@Partials/_ui_mode_switch.html.twig' with {variant: 'app'} only %}
            <a class="h-btn h-btn--icon app-mobile-logout" href="{{ path('app_logout') }}" title="Выйти" aria-label="Выйти">
                <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"></path>
                    <polyline points="16 17 21 12 16 7"></polyline>
                    <line x1="21" y1="12" x2="9" y2="12"></line>
                </svg>
            </a>
        </div>
    </div>
</header>
