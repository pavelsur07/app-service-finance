{# Итог завершённого импорта товаров (import: ProductImport). Ту же разметку после опроса
   статуса рисует assets/pages/product_import_status.js; здесь — для открытия страницы заново. #}
{% set errors = import.resultJson ?? [] %}
<div class="row g-3 mb-3">
    <div class="col-4">
        <div class="card card-sm">
            <div class="card-body text-center">
                <div class="h1 text-success mb-0">{{ import.rowsCreated }}</div>
                <div class="text-muted">Создано</div>
            </div>
        </div>
    </div>
    <div class="col-4">
        <div class="card card-sm">
            <div class="card-body text-center">
                <div class="h1 text-warning mb-0">{{ import.rowsSkipped }}</div>
                <div class="text-muted">Пропущено</div>
            </div>
        </div>
    </div>
    <div class="col-4">
        <div class="card card-sm">
            <div class="card-body text-center">
                <div class="h1 mb-0">{{ import.rowsTotal }}</div>
                <div class="text-muted">Всего строк</div>
            </div>
        </div>
    </div>
</div>
{% if errors is not empty %}
    <div class="mt-3">
        <h4 class="mb-2">Пропущенные строки ({{ errors|length }})</h4>
        <div class="table-responsive">
            <table class="table table-sm">
                <thead><tr><th>Строка</th><th>Причина</th><th>Сообщение</th></tr></thead>
                <tbody>
                {% for error in errors %}
                    <tr>
                        <td>{{ error.row|default('') }}</td>
                        <td><span class="badge {{ error.reason|default('') == 'duplicate' ? 'bg-warning-lt' : 'bg-danger-lt' }}">{{ error.reason|default('') == 'duplicate' ? 'Дубль' : 'Ошибка' }}</span></td>
                        <td>{{ error.message|default(error.error|default('')) }}</td>
                    </tr>
                {% endfor %}
                </tbody>
            </table>
        </div>
    </div>
{% endif %}
