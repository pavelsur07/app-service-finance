{% extends 'base.html.twig' %}
{% block title %}Качество данных маркетплейсов{% endblock %}

{% block stylesheets %}
    {{ parent() }}
    {{ vite_entry_link_tags('marketplace_economics') }}
{% endblock %}
{% block javascripts %}
    {{ parent() }}
    {{ vite_entry_script_tags('marketplace_economics') }}
{% endblock %}

{% macro money(minor) %}{{ minor|vf_minor(2)|vf_amount(2) }}{% endmacro %}
{% macro day(value) %}{{ value is null ? '—' : value|date('d.m.Y') }}{% endmacro %}

{% block content %}
    {% import _self as ui %}
    {% set links = {
        untranslated: 'Факты не переведены',
        quarantine: 'Коды без решения (карантин)',
        translation_canon: 'Перевод ≠ канон',
        canon_mart: 'Канон ≠ витрина',
    } %}

    <div class="vf-page-head">
        <div class="vf-page-head__title"><h1>Экономика маркетплейсов</h1></div>
    </div>
    <div class="card mb-3">
        <div class="card-header">
            <nav aria-label="Отчёт">
                {% include 'partials/_tabs.html.twig' with {class: 'card-header-tabs', tabs: [
                    {label: 'По SKU', href: path('marketplace_economics_sku'), active: false},
                    {label: 'Динамика', href: path('marketplace_economics_dynamics'), active: false},
                    {label: 'ОПиУ', href: path('marketplace_pl_projection'), active: false},
                    {label: 'Качество данных', href: path('marketplace_economics_quality'), active: true},
                ]} only %}
            </nav>
        </div>
    </div>


    <p class="text-secondary small mb-0">
        {{ report.from|date('d.m.Y') }} – {{ report.to|date('d.m.Y') }}. Данные проходят цепочку: факты маркетплейса → перевод в операции → канон →
        витрина отчётов. В каждом звене суммы должны совпадать до копейки; дни с расхождением перечислены ниже.
    </p>

    {% if report.cabinets is empty %}
        <section class="card card-body">
            <p class="mb-0">Кабинетов в новом контуре нет: данные маркетплейсов этой компании пока считает прежний отчёт.</p>
        </section>
    {% else %}
        <section class="card mb-3 me-table-card" data-economics-table>
            <div class="me-table-scroll" data-economics-scroll tabindex="0" role="region" aria-label="Качество данных">
            <table class="table table-vcenter card-table me-table">
                <thead>
                    <tr>
                        <th>Кабинет</th>
                        <th>Последний день фактов</th>
                        <th>Последний переведённый</th>
                        <th>Последний в витрине</th>
                        <th class="text-end">Дней не переведено</th>
                        <th class="text-end">Факты, ₽</th>
                        <th class="text-end">Карантин, ₽</th>
                        <th class="text-end">Канон, ₽</th>
                        <th class="text-end">Витрина, ₽</th>
                        <th class="text-end">Нераспределено, %</th>
                    </tr>
                </thead>
                <tbody>
                    {% for c in report.cabinets %}
                        <tr>
                            <td>{{ c.channel|upper }} · {{ c.connectionRef }}</td>
                            <td>{{ ui.day(c.lastFactDay) }}</td>
                            <td>{{ ui.day(c.lastTranslatedDay) }}</td>
                            <td>{{ ui.day(c.lastMartDay) }}</td>
                            <td class="text-end">{{ c.untranslatedDays|vf_number }}</td>
                            <td class="text-end">{{ ui.money(c.factsMinor) }}</td>
                            <td class="text-end">{{ ui.money(c.quarantineMinor) }}</td>
                            <td class="text-end">{{ ui.money(c.canonMinor) }}</td>
                            <td class="text-end">{{ ui.money(c.martMinor) }}</td>
                            <td class="text-end">{{ c.unallocatedPercent is null ? '—' : c.unallocatedPercent|vf_number(2) ~ ' %' }}</td>
                        </tr>
                    {% endfor %}
                </tbody>
            </table>
            </div>
            <p class="card-body text-secondary small mb-0">Факты = канон + карантин. Канон и витрина — без справочных строк (СПП, соинвестирование) и себестоимости.</p>
        </section>

        <section class="card mb-3 me-table-card" data-economics-table>
            <div class="card-header"><h2 class="card-title">Дни с расхождениями</h2></div>
            {% if report.problems is empty %}
                <div class="card-body">Расхождений нет.</div>
            {% else %}
                <div class="me-table-scroll" data-economics-scroll tabindex="0" role="region" aria-label="Качество данных">
                <table class="table table-vcenter card-table me-table">
                    <thead>
                        <tr>
                            <th>День</th>
                            <th>Кабинет</th>
                            <th>Звено</th>
                            <th class="text-end">Расхождение, ₽</th>
                        </tr>
                    </thead>
                    <tbody>
                        {% for p in report.problems %}
                            <tr>
                                <td>{{ p.date|date('d.m.Y') }}</td>
                                <td>{{ p.connectionRef }}</td>
                                <td>{{ links[p.link] }}</td>
                                <td class="text-end">{{ p.diffMinor is null ? '—' : ui.money(p.diffMinor) }}</td>
                            </tr>
                        {% endfor %}
                    </tbody>
                </table>
                </div>
            {% endif %}
        </section>
    {% endif %}
{% endblock %}
