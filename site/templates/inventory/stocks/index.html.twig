{% extends 'inventory/layout.html.twig' %}

{% set active_tab = 'stocks' %}

{% block tab_content %}
    <div class="p-3">

    <div class="card mb-3">
        <div class="card-body">
            <form method="get" class="row g-2">
                <div class="col-md-3">
                    <label class="form-label">Источник</label>
                    <select name="source" class="form-select">
                        {% for item in sources %}
                            <option value="{{ item.value }}" {{ source.value == item.value ? 'selected' : '' }}>{{ item.getDisplayName() }}</option>
                        {% endfor %}
                    </select>
                </div>
                <div class="col-md-3">
                    <label class="form-label">Остатки на дату</label>
                    <input type="date" name="date" value="{{ date|date('Y-m-d') }}" class="form-control">
                </div>
                <div class="col-12 d-flex gap-2">
                    <button class="btn btn-primary" type="submit">Применить</button>
                    <a class="btn btn-outline-secondary" href="{{ path('inventory_stocks_index') }}">Сбросить</a>
                </div>
                {% if effectiveDate and effectiveDate|date('Y-m-d') != date|date('Y-m-d') %}
                    <div class="col-12 text-muted">
                        На {{ date|date('d.m.Y') }} снимка нет — показан ближайший на {{ effectiveDate|date('d.m.Y') }}.
                    </div>
                {% endif %}
            </form>
        </div>
    </div>

    <div class="card">
        <div class="table-responsive">
            <table class="table table-vcenter card-table">
                <thead>
                <tr>
                    <th>Дата-время snapshot</th>
                    <th>Marketplace/source</th>
                    <th>SKU</th>
                    <th>Offer ID</th>
                    <th>Остаток</th>
                    <th>Зарезервировано</th>
                    <th>Доступно расчётно</th>
                    {% for column in breakdownColumns %}
                        <th>{{ column.label }}</th>
                    {% endfor %}
                    <th>mappingStatus</th>
                </tr>
                </thead>
                <tbody>
                {% for row in pager.currentPageResults %}
                    <tr>
                        <td>{{ row.snapshot_at|date('d.m.Y H:i:s') }}</td>
                        <td><span class="badge bg-azure-lt">{{ source.value|upper }}</span></td>
                        <td>{{ row.source_sku ?: '—' }}</td>
                        <td>{{ row.source_offer_id ?: '—' }}</td>
                        <td>{{ row.quantity }}</td>
                        <td>{{ row.reserved_quantity }}</td>
                        <td>{{ row.available_for_sale }}</td>
                        {% for alias in breakdownColumns|keys %}
                            <td>{{ attribute(row, alias) }}</td>
                        {% endfor %}
                        <td>
                            {% set mapClass = {
                                'mapped': 'bg-green-lt',
                                'unmapped': 'bg-yellow-lt',
                                'ambiguous': 'bg-red-lt'
                            } %}
                            <span class="badge {{ mapClass[row.mapping_status]|default('bg-secondary-lt') }}">{{ row.mapping_status }}</span>
                        </td>
                    </tr>
                {% else %}
                    <tr>
                        <td colspan="{{ 8 + breakdownColumns|length }}" class="text-center text-muted py-4">Нет остатков на выбранную дату.</td>
                    </tr>
                {% endfor %}
                </tbody>
            </table>
        </div>

        <div class="card-footer d-flex align-items-center">
            <p class="m-0 text-muted">
                Показано <strong>{{ pager.currentPageOffsetStart }}–{{ pager.currentPageOffsetEnd }}</strong>
                из <strong>{{ pager.nbResults }}</strong>
            </p>
            {% if pager.nbPages > 1 %}
                <div class="ms-auto">
                    {% include 'partials/_pagerfanta.html.twig' with {
                        pager: pager,
                        route: 'inventory_stocks_index',
                        params: {source: source.value, date: date|date('Y-m-d')}
                    } %}
                </div>
            {% endif %}
        </div>
    </div>

    </div>
{% endblock %}
