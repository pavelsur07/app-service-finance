{% extends 'inventory/layout.html.twig' %}

{% set active_tab = 'stocks' %}

{% block tab_content %}
    <div class="p-3">

    <div class="card mb-3">
        <div class="card-body">
            <form method="get" class="row g-2">
                <div class="col-md-3">
                    <label class="form-label">Источник</label>
                    <select name="source" class="form-select">
                        {% for item in sources %}
                            <option value="{{ item.value }}" {{ source.value == item.value ? 'selected' : '' }}>{{ item.getDisplayName() }}</option>
                        {% endfor %}
                    </select>
                </div>
                <div class="col-md-3">
                    <label class="form-label">Схема</label>
                    <div class="btn-group w-100" role="group" aria-label="Схема">
                        {% for item in schemes %}
                            <input type="radio" class="btn-check" name="scheme" id="scheme-{{ item.value }}" value="{{ item.value }}" {{ scheme.value == item.value ? 'checked' : '' }}>
                            <label class="btn" for="scheme-{{ item.value }}">{{ item.label() }}</label>
                        {% endfor %}
                    </div>
                    <div class="form-hint">FBO — склад маркетплейса, FBS — склад продавца</div>
                </div>
                <div class="col-md-3">
                    <label class="form-label">Остатки на дату</label>
                    <input type="date" name="date" value="{{ date|date('Y-m-d') }}" class="form-control">
                </div>
                <div class="col-12 d-flex gap-2">
                    <button class="btn btn-primary" type="submit">Применить</button>
                    <a class="btn btn-outline-secondary" href="{{ path('inventory_stocks_index') }}">Сбросить</a>
                </div>
                {% if effectiveDate and effectiveDate|date('Y-m-d') != date|date('Y-m-d') %}
                    <div class="col-12 text-muted">
                        На {{ date|date('d.m.Y') }} снимка нет — показан ближайший на {{ effectiveDate|date('d.m.Y') }}.
                    </div>
                {% endif %}
            </form>
        </div>
    </div>

    <div class="card">
        {# Итог по всему фильтру: страница показывает до PER_PAGE SKU, сравнивать FBO и FBS нужно по целому числу. #}
        <div class="card-header vf-stocks-totals text-secondary">
            Итого по фильтру:
            остаток&nbsp;<span class="vf-num vf-strong">{{ totals.quantity|vf_number }}</span>,
            резерв&nbsp;<span class="vf-num">{{ totals.reservedQuantity|vf_number }}</span>,
            доступно&nbsp;<span class="vf-num vf-strong{{ totals.availableForSale < 0 ? ' text-danger' : '' }}">{{ totals.availableForSale|vf_number }}</span>{% if totals.inSupply > 0 %},
            в&nbsp;поставке&nbsp;<span class="vf-num">{{ totals.inSupply|vf_number }}</span>{% endif %}
        </div>
        <div class="table-responsive">
            {% set hasBreakdown = breakdownColumns|length > 0 %}
            {# Поставки Ozon в пути: товар едет на склад и в остаток не входит — отдельная колонка, только когда он есть. #}
            {% set hasSupply = totals.inSupply > 0 %}
            {% set extraColumns = breakdownColumns|length + (hasSupply ? 1 : 0) %}
            {% set rowspan = hasBreakdown ? 2 : 1 %}
            <table class="table table-vcenter card-table vf-table">
                <caption class="visually-hidden">Остатки {{ source.getDisplayName() }}, схема {{ scheme.label() }}, на {{ (effectiveDate ?? date)|date('d.m.Y') }}</caption>
                <thead>
                <tr>
                    <th scope="col" rowspan="{{ rowspan }}">Снимок</th>
                    <th scope="col" rowspan="{{ rowspan }}">Источник</th>
                    <th scope="col" rowspan="{{ rowspan }}">SKU</th>
                    <th scope="col" rowspan="{{ rowspan }}" class="d-none d-md-table-cell">Артикул продавца</th>
                    <th scope="col" rowspan="{{ rowspan }}" class="text-end text-nowrap">Остаток</th>
                    <th scope="col" rowspan="{{ rowspan }}" class="text-end text-nowrap d-none d-md-table-cell">Резерв</th>
                    <th scope="col" rowspan="{{ rowspan }}" class="text-end text-nowrap">Доступно</th>
                    {% if hasSupply %}
                        <th scope="col" rowspan="{{ rowspan }}" class="text-end text-nowrap" title="Активные заявки на поставку FBO: товар едет на склад Ozon, в остаток не входит">В поставке</th>
                    {% endif %}
                    {% if hasBreakdown %}
                        <th scope="colgroup" colspan="{{ breakdownColumns|length }}" class="text-center text-secondary">В том числе</th>
                    {% endif %}
                    <th scope="col" rowspan="{{ rowspan }}">Сопоставление</th>
                </tr>
                {% if hasBreakdown %}
                    <tr>
                        {% for column in breakdownColumns %}
                            <th scope="col" class="text-end text-secondary text-wrap">{{ column.label }}</th>
                        {% endfor %}
                    </tr>
                {% endif %}
                </thead>
                <tbody>
                {% set mapClass = {'mapped': 'bg-green-lt', 'unmapped': 'bg-yellow-lt', 'ambiguous': 'bg-red-lt'} %}
                {% for row in pager.currentPageResults %}
                    {% set mappingStatus = enum('App\\Inventory\\Enum\\StockSnapshotMappingStatus').tryFrom(row.mapping_status) %}
                    <tr>
                        <td class="vf-num" title="{{ row.snapshot_at|date('d.m.Y H:i:s') }}">{{ row.snapshot_at|date('d.m.Y') }}</td>
                        <td><span class="badge bg-azure-lt">{{ source.value|upper }}</span></td>
                        <td class="font-monospace">{{ row.source_sku ?: '—' }}</td>
                        <td class="font-monospace d-none d-md-table-cell">{{ row.source_offer_id ?: '—' }}</td>
                        <td class="text-end vf-num">{{ row.quantity|vf_number }}</td>
                        <td class="text-end vf-num text-secondary d-none d-md-table-cell">{{ row.reserved_quantity|vf_number }}</td>
                        {# Резерв больше остатка — расхождение данных маркетплейса, подсвечиваем, а не прячем. #}
                        <td class="text-end vf-num vf-strong{{ row.available_for_sale < 0 ? ' text-danger' : '' }}">{{ row.available_for_sale|vf_number }}</td>
                        {% if hasSupply %}
                            <td class="text-end vf-num">{{ row.in_supply == 0 ? '—' : row.in_supply|vf_number }}</td>
                        {% endif %}
                        {% for alias in breakdownColumns|keys %}
                            {% set part = attribute(row, alias) %}
                            <td class="text-end vf-num text-secondary">{{ part == 0 ? '—' : part|vf_number }}</td>
                        {% endfor %}
                        <td>
                            <span class="badge {{ mapClass[row.mapping_status]|default('bg-secondary-lt') }}">{{ mappingStatus ? mappingStatus.label() : row.mapping_status }}</span>
                        </td>
                    </tr>
                {% else %}
                    <tr>
                        <td colspan="{{ 8 + extraColumns }}" class="text-center text-secondary py-4">
                            Нет остатков на выбранную дату. Попробуйте другую дату, источник или схему FBO / FBS.
                        </td>
                    </tr>
                {% endfor %}
                </tbody>
                {% if pager.nbResults > 0 %}
                    {% set rows = pager.currentPageResults %}
                    {% set pageAvailable = rows|map(r => r.available_for_sale)|reduce((a, b) => a + b, 0) %}
                    <tfoot>
                    {# Сетка подвала повторяет строки: скрытые на узких экранах ячейки тоже скрыты, иначе итоги съезжают под чужие заголовки. #}
                    <tr class="vf-strong">
                        <th scope="row" colspan="3" class="fw-medium">Итого на странице</th>
                        <td class="d-none d-md-table-cell"></td>
                        <td class="text-end vf-num">{{ rows|map(r => r.quantity)|reduce((a, b) => a + b, 0)|vf_number }}</td>
                        <td class="text-end vf-num d-none d-md-table-cell">{{ rows|map(r => r.reserved_quantity)|reduce((a, b) => a + b, 0)|vf_number }}</td>
                        <td class="text-end vf-num{{ pageAvailable < 0 ? ' text-danger' : '' }}">{{ pageAvailable|vf_number }}</td>
                        {% if hasSupply %}
                            <td class="text-end vf-num">{{ rows|map(r => r.in_supply)|reduce((a, b) => a + b, 0)|vf_number }}</td>
                        {% endif %}
                        <td colspan="{{ 1 + breakdownColumns|length }}"></td>
                    </tr>
                    </tfoot>
                {% endif %}
            </table>
        </div>

        {% if pager.nbResults > 0 %}
            <div class="card-footer d-flex align-items-center">
                {{ include('partials/_pagination.html.twig', {pager: pager}) }}
            </div>
        {% endif %}
    </div>

    </div>
{% endblock %}
