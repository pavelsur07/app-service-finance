{% extends 'base.html.twig' %}

{% block title %}Товары и остатки{% endblock %}

{% block body %}
    {% embed 'partials/_page_header.html.twig' with {title: 'Товары и остатки'} %}
        {% block actions %}
            <a href="{{ path('inventory_snapshots_index') }}" class="btn btn-outline-secondary">К загрузкам</a>
        {% endblock %}
    {% endembed %}

    <div class="page-body">
        <div class="container-xl">

            <div class="card">
                <div class="card-header">
                    {% include 'inventory/_tabs.html.twig' with {active_tab: active_tab} only %}
                </div>

                <div class="card-body p-0">
                    {% block tab_content %}{% endblock %}
                </div>
            </div>

        </div>
    </div>

    {% block modals %}{% endblock %}

{% endblock %}
