{% extends 'base.html.twig' %}

{% block title %}Товары и остатки{% endblock %}

{% block body %}
    <div class="page-header d-print-none">
        <div class="container-xl">
            <div class="row g-2 align-items-center">
                <div class="col">
                    <h2 class="page-title">Товары и остатки</h2>
                </div>
                <div class="col-auto ms-auto">
                    <a href="{{ path('inventory_snapshots_index') }}" class="btn btn-outline-secondary">К загрузкам</a>
                </div>
            </div>
        </div>
    </div>

    <div class="page-body">
        <div class="container-xl">

            {% for label, messages in app.flashes %}
                {% for message in messages %}
                    <div class="alert alert-{{ label == 'error' ? 'danger' : label }} alert-dismissible mb-3" role="alert">
                        <div class="d-flex">
                            <div>{{ message }}</div>
                        </div>
                        <a class="btn-close" data-bs-dismiss="alert" aria-label="close"></a>
                    </div>
                {% endfor %}
            {% endfor %}

            <div class="card">
                <div class="card-header">
                    {% include 'partials/_tabs.html.twig' with {class: 'card-header-tabs', tabs: [
                        {label: 'Листинг', href: path('marketplace_listings_index'), active: active_tab == 'listings'},
                        {label: 'Остатки', href: path('inventory_stocks_index'), active: active_tab == 'stocks'},
                        {label: 'Себестоимость', href: path('marketplace_inventory_index'), active: active_tab == 'inventory'},
                        {label: 'Теги', href: path('marketplace_listing_tags_manage'), active: active_tab == 'listings_tags'},
                    ]} only %}
                </div>

                <div class="card-body p-0">
                    {% block tab_content %}{% endblock %}
                </div>
            </div>

        </div>
    </div>

    {% block modals %}{% endblock %}

{% endblock %}
