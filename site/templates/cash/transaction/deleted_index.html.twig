{% extends 'base.html.twig' %}

{% block title %}Удалённые транзакции ДДС{% endblock %}

{% block content %}
<div class="d-flex align-items-center gap-2 flex-wrap mb-3">
    <h2 class="page-title mb-0">Удалённые транзакции ДДС</h2>
    <a href="{{ path('cash_transfer_deleted_index') }}" class="btn btn-outline-secondary ms-auto">Удалённые переводы</a>
</div>

<div class="card">
    <div class="card-header card-head">
        {% include 'transaction/_tabs.html.twig' with {active: 'deleted'} only %}
    </div>
    <div class="table-responsive">
        <table class="table card-table table-vcenter">
            <thead>
                <tr>
                    <th>Дата удаления</th>
                    {# DS-Money: «₽» в заголовке — только когда вся колонка в рублях; иначе валюта в каждой строке. #}
                    {% set amounts_in_rub = transactions|filter(t => t.currency != 'RUB')|length == 0 %}
                    <th class="text-end text-nowrap">Сумма{% if amounts_in_rub %}, ₽{% endif %}</th>
                    <th>Счёт/категория</th>
                    <th class="text-end">Действия</th>
                </tr>
            </thead>
            <tbody>
            {% for tx in transactions %}
                {% set transfer = transferByTransactionId[tx.id]|default(null) %}
                <tr>
                    <td>{{ tx.deletedAt ? tx.deletedAt|date('d.m.Y H:i') : '—' }}</td>
                    <td class="text-end text-nowrap">
                        {% set inflow = tx.direction.value == 'INFLOW' %}
                        {{ tx.amount|vf_amount(2, inflow ? 'income' : null, signed: true, currency: amounts_in_rub or tx.currency != 'RUB' ? tx.currency : '₽', negate: not inflow) }}
                    </td>
                    <td>
                        <div>{{ tx.moneyAccount ? tx.moneyAccount.name : '—' }}</div>
                        <div class="text-muted small">{% if tx.splits is empty %}—{% else %}{% for s in tx.splits %}{{ s.cashflowCategory.name }}{% if not loop.last %}, {% endif %}{% endfor %}{% endif %}</div>
                    </td>
                    <td class="text-end">
                        {% if transfer %}
                            <a href="{{ path('cash_transfer_show', {id: transfer.id}) }}" class="btn btn-outline-secondary btn-sm">Открыть перевод</a>
                        {% else %}
                        <form method="post" action="{{ path('cash_transaction_restore', {id: tx.id}) }}">
                            <input type="hidden" name="_token" value="{{ csrf_token('tx_restore' ~ tx.id) }}">
                            <button type="submit" class="btn btn-outline-primary btn-sm">Восстановить</button>
                        </form>
                        {% endif %}
                    </td>
                </tr>
            {% else %}
                <tr>
                    <td colspan="4" class="text-center text-muted">Нет удалённых транзакций</td>
                </tr>
            {% endfor %}
            </tbody>
        </table>
    </div>
    <div class="card-footer d-flex align-items-center">
        {% include 'partials/_pagination.html.twig' with {pager: pager} %}
    </div>
</div>
{% endblock %}
