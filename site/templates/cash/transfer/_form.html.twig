{{ form_start(form) }}
{{ form_widget(form._token) }}
{{ form_widget(form.idempotencyKey) }}
<div class="card">
    <div class="card-body">
        {{ form_errors(form) }}
        <div class="row g-3">
            <div class="col-12 col-md-4">
                {{ form_label(form.occurredAt, null, {label_attr: {class: 'form-label'}}) }}
                {{ form_widget(form.occurredAt, {attr: {class: 'form-control'}}) }}
                <div class="invalid-feedback d-block">{{ form_errors(form.occurredAt) }}</div>
            </div>
        </div>
        <div class="row g-3 mt-1">
            <div class="col-12 col-lg-6">
                <h3 class="card-title">Списание</h3>
                {{ form_label(form.sourceAccount, null, {label_attr: {class: 'form-label'}}) }}
                {{ form_widget(form.sourceAccount, {attr: {class: 'form-select', 'data-currency-select': 'source'}}) }}
                <div class="invalid-feedback d-block">{{ form_errors(form.sourceAccount) }}</div>
                <div class="row g-2 mt-1">
                    <div class="col-8">
                        {{ form_label(form.sourceAmount, null, {label_attr: {class: 'form-label'}}) }}
                        {{ form_widget(form.sourceAmount, {attr: {class: 'form-control'}}) }}
                        <div class="invalid-feedback d-block">{{ form_errors(form.sourceAmount) }}</div>
                    </div>
                    <div class="col-4">
                        <label class="form-label" for="source-currency">Валюта</label>
                        <output id="source-currency" class="form-control" data-currency-output="source">—</output>
                    </div>
                </div>
            </div>
            <div class="col-12 col-lg-6">
                <h3 class="card-title">Поступление</h3>
                {{ form_label(form.targetAccount, null, {label_attr: {class: 'form-label'}}) }}
                {{ form_widget(form.targetAccount, {attr: {class: 'form-select', 'data-currency-select': 'target'}}) }}
                <div class="invalid-feedback d-block">{{ form_errors(form.targetAccount) }}</div>
                <div class="row g-2 mt-1">
                    <div class="col-8">
                        {{ form_label(form.targetAmount, null, {label_attr: {class: 'form-label'}}) }}
                        {{ form_widget(form.targetAmount, {attr: {class: 'form-control'}}) }}
                        <div class="invalid-feedback d-block">{{ form_errors(form.targetAmount) }}</div>
                    </div>
                    <div class="col-4">
                        <label class="form-label" for="target-currency">Валюта</label>
                        <output id="target-currency" class="form-control" data-currency-output="target">—</output>
                    </div>
                </div>
            </div>
        </div>
        <div class="mt-3">
            {{ form_label(form.description, null, {label_attr: {class: 'form-label'}}) }}
            {{ form_widget(form.description, {attr: {class: 'form-control', rows: 3}}) }}
            <div class="invalid-feedback d-block">{{ form_errors(form.description) }}</div>
        </div>
    </div>
    <div class="card-footer d-flex justify-content-end gap-2">
        <a href="{{ path('cash_transaction_index') }}" class="btn btn-secondary">Отмена</a>
        <button type="submit" class="btn btn-primary">Создать перевод</button>
    </div>
</div>
{{ form_end(form, {render_rest: false}) }}
