{% extends 'base.html.twig' %}

{% block title %}Удалённые переводы ДДС{% endblock %}

{% block content %}
<div class="d-flex align-items-center gap-2 flex-wrap mb-3">
    <h2 class="page-title mb-0">Удалённые переводы ДДС</h2>
    <a href="{{ path('cash_transaction_deleted_index') }}" class="btn btn-outline-secondary ms-auto">Удалённые операции</a>
</div>

<div class="card">
    <div class="table-responsive">
        <table class="table card-table table-vcenter">
            <thead>
                <tr>
                    <th>Дата удаления</th>
                    <th>Перевод</th>
                    <th class="text-end">Действия</th>
                </tr>
            </thead>
            <tbody>
            {% for transfer in transfers %}
                <tr>
                    <td>{{ transfer.deletedAt|date('d.m.Y H:i') }}</td>
                    <td>
                        <div>{{ transfer.sourceTransaction.moneyAccount.name }} → {{ transfer.targetTransaction.moneyAccount.name }}</div>
                        <div class="text-muted small">
                            {{ transfer.sourceTransaction.amount|number_format(2, ',', ' ') }} {{ transfer.sourceTransaction.currency }}
                            → {{ transfer.targetTransaction.amount|number_format(2, ',', ' ') }} {{ transfer.targetTransaction.currency }}
                        </div>
                    </td>
                    <td class="text-end">
                        <a href="{{ path('cash_transfer_show', {id: transfer.id}) }}" class="btn btn-outline-secondary btn-sm">Открыть</a>
                        <form method="post" action="{{ path('cash_transfer_restore', {id: transfer.id}) }}" class="d-inline">
                            <input type="hidden" name="_token" value="{{ csrf_token('cash_transfer_restore' ~ transfer.id) }}">
                            <button type="submit" class="btn btn-outline-primary btn-sm">Восстановить</button>
                        </form>
                    </td>
                </tr>
            {% else %}
                <tr><td colspan="3" class="text-center text-muted">Нет удалённых переводов</td></tr>
            {% endfor %}
            </tbody>
        </table>
    </div>
    <div class="card-footer d-flex align-items-center">
        {% include 'partials/_pagerfanta.html.twig' with {pager: pager} %}
    </div>
</div>
{% endblock %}
