{% extends 'base.html.twig' %}
{% block title %}ДДС группы{% endblock %}

{% block body %}
    {% set range = report ?? oversized %}
    {% set period = range ? {from: range.from|date('Y-m-d'), to: range.to|date('Y-m-d')} : {} %}
    {% embed 'partials/_page_header.html.twig' with {title: 'Консолидированный ДДС группы'} %}
        {% block actions %}
            <a href="{{ path('report_cashflow_index', period) }}" class="btn btn-outline-secondary">Отчёт ДДС компании</a>
        {% endblock %}
    {% endembed %}
    <div class="container-xl mt-3">
        {% if range is null %}
            <div class="card">
                <div class="card-body">
                    Компания «{{ companyName }}» не входит в группу консолидации. Группу задаёт владелец в настройках
                    головной компании, блок «Консолидация».
                </div>
            </div>
        {% else %}
            {% set byPeriod = oversized or report.periods is not null %}
            {% set groups = {week: 'Неделя', month: 'Месяц', quarter: 'Квартал', year: 'Год'} %}
            {% set view = byPeriod ? 'periods' : 'companies' %}
            {% set selection = period|merge({group: selectedGroup}) %}
            <nav class="nav nav-pills mb-3" aria-label="Вид отчёта">
                {% for key, label in {periods: 'По периодам', companies: 'По компаниям'} %}
                    <a class="nav-link{{ key == view ? ' active' : '' }}"{% if key == view %} aria-current="page"{% endif %}
                       href="{{ path('report_cashflow_group', selection|merge({view: key})) }}">{{ label }}</a>
                {% endfor %}
            </nav>
            {% set reconciliationUrl = path('report_cashflow_group_reconciliation', period) %}
            <form method="get" action="{{ path('report_cashflow_group') }}" class="d-flex flex-wrap gap-2 align-items-end mb-3">
                <input type="hidden" name="view" value="{{ view }}">
                <label class="form-label mb-0">С
                    <input type="date" name="from" value="{{ period.from }}" class="form-control">
                </label>
                <label class="form-label mb-0">По
                    <input type="date" name="to" value="{{ period.to }}" class="form-control">
                </label>
                {% if byPeriod %}
                    <label class="form-label mb-0">Шаг
                        <select name="group" class="form-select">
                            {% for key, label in groups %}
                                <option value="{{ key }}" {{ key == selectedGroup ? 'selected' }}>{{ label }}</option>
                            {% endfor %}
                        </select>
                    </label>
                {% else %}
                    <input type="hidden" name="group" value="{{ selectedGroup }}">
                {% endif %}
                <button type="submit" class="btn btn-primary">Показать</button>
                {% if not oversized %}
                    <a href="{{ reconciliationUrl }}" class="btn btn-outline-primary">Сверка</a>
                    <a href="{{ path('report_cashflow_group_export', selection|merge({view: view})) }}" class="btn btn-outline-secondary">
                        <i class="ti ti-download" aria-hidden="true"></i> Excel
                    </a>
                {% endif %}
            </form>

            {% if oversized %}
                <div class="alert alert-info" role="status">Диапазон слишком большой — выберите не больше 36 лет</div>
            {% else %}
                {% include 'cash/report/cashflow_group/_accounts.html.twig' with {report: report} only %}
                {% if byPeriod %}
                    {% include 'cash/report/cashflow_group/_periods.html.twig' with {
                        report: report, period: period, selectedGroup: selectedGroup, groups: groups
                    } only %}
                {% else %}
                    {% include 'cash/report/cashflow_group/_companies.html.twig' with {
                        report: report, period: period, reconciliationUrl: reconciliationUrl
                    } only %}
                {% endif %}
                {% for currency, amounts in report.otherCurrencies %}
                    <div class="card mt-3">
                        <div class="card-header"><h3 class="card-title">Другая валюта: {{ currency }} — в таблицу выше не входит</h3></div>
                        <table class="table table-sm card-table">
                            <tr>{% for name in report.companies %}<th class="text-end">{{ name }}</th>{% endfor %}</tr>
                            <tr>{% for amount in amounts %}<td class="text-end">{{ amount|vf_amount(2, null, false, currency) }}</td>{% endfor %}</tr>
                        </table>
                    </div>
                {% endfor %}
            {% endif %}
        {% endif %}
    </div>
{% endblock %}
