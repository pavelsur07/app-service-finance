{% if report.companiesWithoutInn is not empty %}
    <div class="alert alert-warning" data-test="group-report-inn-warning">
        Не заполнен ИНН: {{ report.companiesWithoutInn|join(', ') }}. Платежи этим компаниям не распознаются
        как внутригрупповые и попадают в итог. ИНН задаётся в настройках компании.
    </div>
{% endif %}

{% import 'document/_list_macros.html.twig' as ui %}
{% set accountsTotal = report.accounts|length %}
{% set laggingTotal = report.accounts|filter(a => a.lagging)|length %}
{# Отстающие счета — повод заглянуть: тогда блок открыт сразу. Шеврон, сводка и «Показать/Скрыть» — vf-disclosure. #}
<details class="card vf-disclosure mb-3" data-test="group-report-accounts"{% if laggingTotal > 0 %} open{% endif %}>
    <summary class="vf-disclosure__summary">
        <i class="ti ti-chevron-right vf-disclosure__chevron" aria-hidden="true"></i>
        <span class="vf-disclosure__title">Данные по счетам</span>
        <span class="vf-disclosure__meta" data-accounts-count>{{ accountsTotal > 0 ? accountsTotal ~ ' ' ~ ui.plural(accountsTotal, 'счёт', 'счёта', 'счетов') : 'нет счетов' }}</span>
        {% if laggingTotal > 0 %}
            <span class="badge bg-yellow-lt" data-accounts-lagging>{{ laggingTotal }} {{ ui.plural(laggingTotal, 'отстаёт', 'отстают', 'отстают') }}</span>
        {% endif %}
        <span class="vf-disclosure__action" aria-hidden="true">
            <span class="vf-disclosure__action-show">Показать</span>
            <span class="vf-disclosure__action-hide">Скрыть</span>
        </span>
    </summary>
    {% if report.accounts is empty %}
        <div class="card-body text-secondary">Нет активных счетов в RUB.</div>
    {% else %}
        <div class="table-responsive">
            <table class="table table-sm table-vcenter card-table">
                <thead><tr><th scope="col">Счёт</th><th scope="col">Последняя операция</th></tr></thead>
                <tbody>
                {% for account in report.accounts %}
                    <tr>
                        <td>{{ report.companies[account.companyId] }} · {{ account.label }}</td>
                        <td class="text-nowrap">
                            {{ account.lastDate ? account.lastDate|date('d.m.Y') : 'Нет операций' }}
                            {% if account.lagging %}<span class="badge bg-yellow-lt">Отстаёт</span>{% endif %}
                        </td>
                    </tr>
                {% endfor %}
                </tbody>
            </table>
        </div>
    {% endif %}
</details>
