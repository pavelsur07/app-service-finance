{% extends 'base.html.twig' %}

{% block title %}Профили импорта{% endblock %}

{% block body %}
    {% embed 'partials/_page_header.html.twig' with {title: 'Профили импорта'} %}
        {% block actions %}
            {% if is_granted('module.finance.write') %}
                <a href="{{ path('cash_file_import_profile_new') }}" class="btn btn-primary">Добавить профиль</a>
            {% endif %}
        {% endblock %}
    {% endembed %}

    <div class="container-xl mt-3">
        <div class="card">
            <div class="card-body table-responsive">
                <table class="table table-vcenter">
                    <thead>
                        <tr>
                            <th>Название</th>
                            <th>Тип</th>
                            <th>Обновлено</th>
                            <th class="w-1"></th>
                        </tr>
                    </thead>
                    <tbody>
                    {% for profile in profiles %}
                        <tr>
                            <td>{{ profile.name }}</td>
                            <td>{{ profile.type }}</td>
                            <td>{{ profile.updatedAt|date('d.m.Y H:i') }}</td>
                            <td class="text-end">
                                <a href="{{ path('cash_file_import_profile_edit', {'id': profile.id}) }}" class="btn btn-icon" title="Редактировать">
                                    <i class="ti ti-pencil"></i>
                                </a>
                                {% if is_granted('module.finance.write') %}
                                <button type="button" class="btn btn-icon btn-danger" title="Удалить"
                                        data-bs-toggle="modal" data-bs-target="#import-profile-confirm"
                                        data-confirm-action="{{ path('cash_file_import_profile_delete', {'id': profile.id}) }}"
                                        data-confirm-token="{{ csrf_token('delete' ~ profile.id) }}"
                                        data-confirm-title="Удалить профиль?"
                                        data-confirm-submit="Удалить" data-confirm-variant="danger"><i class="ti ti-trash"></i></button>
                                {% endif %}
                            </td>
                        </tr>
                    {% else %}
                        <tr>
                            <td colspan="4" class="text-center text-secondary">Профилей ещё нет.</td>
                        </tr>
                    {% endfor %}
                    </tbody>
                </table>
            </div>
            <div class="card-footer">
                {% include 'partials/_pagination.html.twig' with {pager: pager} only %}
            </div>
        </div>
    </div>
    {% include 'partials/_confirm_modal.html.twig' with {id: 'import-profile-confirm'} only %}
{% endblock %}
