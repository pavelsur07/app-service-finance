{% extends 'security/base_auth.html.twig' %}
{% import 'security/_auth/_macros.html.twig' as auth %}

{% block title %}Регистрация · Ваш Финдир{% endblock %}
{% block meta %}<meta name="description" content="Создайте аккаунт «Ваш Финдир»: финансовый учёт для e-commerce и малого бизнеса. 7 дней бесплатно, без карты и обязательств.">{% endblock %}

{% block header_switch %}Уже есть аккаунт? <a href="{{ path('app_login') }}">Войти</a>{% endblock %}

{% block body %}
{% set f = registrationForm %}
{% set not_unique = constant('Symfony\\Bridge\\Doctrine\\Validator\\Constraints\\UniqueEntity::NOT_UNIQUE_ERROR') %}
{% set email_taken = f.email.vars.errors|filter(e => e.cause.code|default(null) == not_unique)|length > 0 %}
{% set email_errors = f.email.vars.errors|filter(e => e.cause.code|default(null) != not_unique)|map(e => e.message) %}
{% set pw_min = f.plainPassword.vars.attr['data-min'] %}

<div class="vf-auth__card vf-auth__card--wide">
    <h1 class="vf-auth__title">Создайте аккаунт</h1>
    <p class="vf-auth__subtitle">7 дней бесплатно · без карты и обязательств</p>

    {% if email_taken %}
        {# Ссылки «восстановить пароль» нет: сброса пароля в сервисе пока нет. #}
        <div class="vf-auth__alert" role="alert">
            {{ auth.alert_icon() }}
            <div><strong>Этот email уже зарегистрирован.</strong> <a href="{{ path('app_login') }}">Войти</a></div>
        </div>
    {% endif %}
    {% for error in f.vars.errors %}
        <div class="vf-auth__alert" role="alert">
            {{ auth.alert_icon() }}
            <div>{{ error.message }}</div>
        </div>
    {% endfor %}

    <form class="vf-auth__form" name="{{ f.vars.name }}" method="post" action="{{ f.vars.action }}" novalidate
          data-auth-form>

        {% if f.companyName is defined %}
            {% set fld = f.companyName %}
            <div>
                <label class="lbl" for="{{ fld.vars.id }}">Название компании</label>
                <input id="{{ fld.vars.id }}" class="inp" type="text" name="{{ fld.vars.full_name }}" value="{{ fld.vars.value }}"
                       autocomplete="organization" placeholder="Например, ООО «Ромашка» или ИП Иванов" required maxlength="120"
                       aria-describedby="{{ fld.vars.id }}-err" aria-invalid="{{ fld.vars.errors|length ? 'true' : 'false' }}"
                       data-check="required" data-msg-required="Укажите название компании">
                {{ auth.field_errors(fld.vars.id, fld.vars.errors|map(e => e.message)) }}
            </div>
            {% do fld.setRendered %}
        {% endif %}

        {% if f.businessProfile is defined %}
            <fieldset class="vf-auth__fieldset">
                <legend class="lbl" id="businessProfileLabel">Как вы продаёте?</legend>
                <div class="vf-auth__radios">
                    {% for choice in f.businessProfile %}
                        <label class="rc" for="{{ choice.vars.id }}">
                            <input type="radio" id="{{ choice.vars.id }}" name="{{ choice.vars.full_name }}" value="{{ choice.vars.value }}"
                                   aria-describedby="{{ f.businessProfile.vars.id }}-hint"{{ choice.vars.checked ? ' checked' }}>
                            <span class="dot" aria-hidden="true"></span>
                            <span class="rc__body">
                                <span class="rc__title">{{ choice.vars.label }}</span>
                                <span class="rc__desc">{{ choice.vars.attr['data-description']|default('') }}</span>
                            </span>
                        </label>
                        {% do choice.setRendered %}
                    {% endfor %}
                </div>
                <div class="hint" id="{{ f.businessProfile.vars.id }}-hint">От выбора зависят стартовые статьи учёта. Их можно изменить позже.</div>
                {{ auth.field_errors(f.businessProfile.vars.id, f.businessProfile.vars.errors|map(e => e.message)) }}
            </fieldset>
            {% do f.businessProfile.setRendered %}
        {% endif %}

        {% set fld = f.email %}
        <div>
            <label class="lbl" for="{{ fld.vars.id }}">Email</label>
            {# Текстовое поле, не type=email: адреса с кириллицей допустимы (см. UserEmailType). #}
            <input id="{{ fld.vars.id }}" class="inp" type="text" name="{{ fld.vars.full_name }}" value="{{ fld.vars.value }}"
                   inputmode="email" autocomplete="username" autocapitalize="none" spellcheck="false"
                   placeholder="name@company.ru" required
                   aria-describedby="{{ fld.vars.id }}-err" aria-invalid="{{ fld.vars.errors|length ? 'true' : 'false' }}"
                   data-check="required email" data-msg-required="Укажите email"
                   data-msg-email="Проверьте адрес: нужен формат name@company.ru">
            {{ auth.field_errors(fld.vars.id, email_errors) }}
        </div>
        {% do fld.setRendered %}

        {% set fld = f.plainPassword %}
        <div>
            <label class="lbl" for="{{ fld.vars.id }}">Пароль</label>
            <div class="vf-auth__pw">
                <input id="{{ fld.vars.id }}" class="inp inp--pw" type="password" name="{{ fld.vars.full_name }}"
                       autocomplete="new-password" placeholder="Придумайте пароль" required
                       aria-describedby="{{ fld.vars.id }}-err {{ fld.vars.id }}-rules"
                       aria-invalid="{{ fld.vars.errors|length ? 'true' : 'false' }}"
                       data-check="required minlen" data-min="{{ pw_min }}"
                       data-msg-required="Введите пароль" data-msg-minlen="Пароль — не короче {{ pw_min }} символов">
                {{ auth.pw_toggle(fld.vars.id) }}
            </div>
            {{ auth.field_errors(fld.vars.id, fld.vars.errors|map(e => e.message)) }}
            <div class="vf-auth__meter" data-pw-meter="{{ fld.vars.id }}" data-min="{{ pw_min }}" data-score="0">
                <div class="vf-auth__segs" aria-hidden="true">
                    <div class="seg"></div><div class="seg"></div><div class="seg"></div><div class="seg"></div>
                </div>
                <div class="vf-auth__meter-row" aria-live="polite"><span>Надёжность пароля</span><span class="vf-auth__meter-label" data-pw-label></span></div>
                {# Правило — серверное (RegistrationFormType::PASSWORD_MIN_LENGTH); остальное — совет, не требование. #}
                <ul class="vf-auth__rules" id="{{ fld.vars.id }}-rules">
                    <li class="rule" data-pw-rule="len" data-min="{{ pw_min }}" data-ok="false"{% if fld.vars.errors|length %} data-error="true"{% endif %}>
                        <span class="rule__icon" aria-hidden="true"></span><span>Не короче {{ pw_min }} символов</span><span class="sr-only" data-sr></span>
                    </li>
                </ul>
                <div class="hint">Для надёжности сочетайте строчные и заглавные буквы, цифры и символ, например ! или №.</div>
            </div>
        </div>
        {% do fld.setRendered %}

        <div class="vf-auth__consents">
            {% set fld = f.agreeTerms %}
            <div>
                <label class="chk">
                    <input type="checkbox" id="{{ fld.vars.id }}" name="{{ fld.vars.full_name }}" value="1"{{ fld.vars.checked ? ' checked' }}
                           aria-describedby="{{ fld.vars.id }}-err" aria-invalid="{{ fld.vars.errors|length ? 'true' : 'false' }}"
                           data-check="checked" data-msg-checked="Без принятия условий мы не можем создать аккаунт">
                    <span>Принимаю {{ auth.doc('terms', 'Пользовательское соглашение') }}, {{ auth.doc('offer', 'Публичную оферту') }} и {{ auth.doc('privacy', 'Политику конфиденциальности') }}</span>
                </label>
                {{ auth.field_errors(fld.vars.id, fld.vars.errors|map(e => e.message), 'err--indent') }}
            </div>
            {% do fld.setRendered %}

            {% set fld = f.agreePersonalData %}
            <div>
                <label class="chk">
                    <input type="checkbox" id="{{ fld.vars.id }}" name="{{ fld.vars.full_name }}" value="1"{{ fld.vars.checked ? ' checked' }}
                           aria-describedby="{{ fld.vars.id }}-err" aria-invalid="{{ fld.vars.errors|length ? 'true' : 'false' }}"
                           data-check="checked" data-msg-checked="Нужно согласие на обработку персональных данных">
                    <span>Даю {{ auth.doc('personal_data', 'согласие на обработку персональных данных') }}</span>
                </label>
                {{ auth.field_errors(fld.vars.id, fld.vars.errors|map(e => e.message), 'err--indent') }}
            </div>
            {% do fld.setRendered %}
        </div>

        {# Необязательное согласие на рассылку (SPEC §5) не выводится: хранить его негде — вопрос владельцу (SPEC §10.3). #}
        <p class="legal-note">
            {%- if legal.company_name %}Оператор персональных данных — {{ legal.company_name }}. {% endif -%}
            Данные хранятся на серверах в России.
            {% if legal.privacy_email %}Согласие можно отозвать, написав на <a href="mailto:{{ legal.privacy_email }}">{{ legal.privacy_email }}</a>.{% else %}Согласие можно отозвать в любой момент.{% endif %}
            Регистрируясь, вы подтверждаете, что вам исполнилось 18 лет и вы вправе действовать от имени компании или индивидуального предпринимателя.
        </p>

        <button class="btn btn-primary btn-lg" type="submit" data-loading-text="Создаём аккаунт…">Создать аккаунт</button>

        {# Honeypot против ботов: скрыт, вне порядка табуляции (RegistrationFormType::website). #}
        {{ form_widget(f.website) }}
        {{ form_rest(f) }}
    </form>
</div>
{% endblock %}
