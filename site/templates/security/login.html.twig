{% extends 'security/base_auth.html.twig' %}
{% import 'security/_auth/_macros.html.twig' as auth %}

{% block title %}Вход · Ваш Финдир{% endblock %}

{% block header_switch %}Нет аккаунта? <a href="{{ path('app_register') }}">Создать</a>{% endblock %}

{% block body %}
<div class="vf-auth__card">
    <h1 class="vf-auth__title">Вход в сервис</h1>
    <p class="vf-auth__subtitle">Рады видеть снова. Введите email и пароль.</p>

    {% if error %}
        {# Неверная пара email/пароль — одним текстом: не раскрываем, что именно неверно и есть ли аккаунт. #}
        <div class="vf-auth__alert" role="alert">
            {{ auth.alert_icon() }}
            {% if error.messageKey starts with 'Too many failed login attempts' %}
                <div><strong>Слишком много попыток входа.</strong> Попробуйте ещё раз через {{ error.messageData['%minutes%']|default(15) }} мин.</div>
            {% elseif error.messageKey == 'Invalid CSRF token.' %}
                <div><strong>Страница устарела.</strong> Обновите её и войдите снова.</div>
            {% else %}
                <div><strong>Неверный email или пароль.</strong> Проверьте раскладку и Caps Lock.</div>
            {% endif %}
        </div>
    {% endif %}

    <form class="vf-auth__form" action="{{ path('app_login') }}" method="post" novalidate data-auth-form>
        <div>
            <label class="lbl" for="l-email">Email</label>
            {# Текстовое поле, не type=email: адреса с кириллицей допустимы (см. UserEmailType). #}
            <input id="l-email" class="inp" type="text" name="_username" value="{{ last_username }}"
                   inputmode="email" autocomplete="username" autocapitalize="none" spellcheck="false"
                   placeholder="name@company.ru" required aria-describedby="l-email-err"
                   aria-invalid="false"
                   data-check="required email"
                   data-msg-required="Укажите email"
                   data-msg-email="Проверьте адрес: нужен формат name@company.ru">
            {{ auth.field_errors('l-email', []) }}
        </div>

        <div>
            {# Ссылки «Забыли пароль?» нет: сброса пароля в сервисе пока нет (вопрос в docs/plan/ds-auth-pages.md). #}
            <label class="lbl" for="l-pw">Пароль</label>
            <div class="vf-auth__pw">
                <input id="l-pw" class="inp inp--pw" type="password" name="_password"
                       autocomplete="current-password" placeholder="Ваш пароль" required
                       aria-describedby="l-pw-err" aria-invalid="false"
                       data-check="required" data-msg-required="Введите пароль">
                {{ auth.pw_toggle('l-pw') }}
            </div>
            {{ auth.field_errors('l-pw', []) }}
        </div>

        <label class="chk chk--center">
            <input type="checkbox" name="_remember_me" checked>
            <span>Запомнить меня на этом устройстве</span>
        </label>

        <input type="hidden" name="_csrf_token" value="{{ csrf_token('authenticate') }}">

        <button class="btn btn-primary btn-lg" type="submit" data-loading-text="Входим…">Войти</button>
    </form>

    <p class="legal-note vf-auth__card-legal">Входя в сервис, вы подтверждаете, что ознакомились с {{ auth.doc('terms', 'Пользовательским соглашением') }} и {{ auth.doc('privacy', 'Политикой конфиденциальности') }}.</p>

    <div class="vf-auth__alt">Ещё нет аккаунта? <a href="{{ path('app_register') }}">Создать — 7 дней бесплатно</a></div>
</div>
{% endblock %}
