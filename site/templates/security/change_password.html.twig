{% extends 'base.html.twig' %}
{% block title %}Смена пароля{% endblock %}

{% block breadcrumbs %}
    {% include 'partials/_breadcrumbs.html.twig' with {
        breadcrumbs: [
            {'label': 'Главная', 'path': 'app_home_index'},
            {'label': 'Смена пароля'}
        ]
    } %}
{% endblock %}

{% block body %}
    {% include 'partials/_page_header.html.twig' with {title: 'Смена пароля'} only %}
    <div class="container-xl mt-3">
        <div class="card">
            <div class="card-body">
                {{ form_start(form) }}
                {{ form_errors(form) }}
                {{ form_row(form.currentPassword) }}
                {{ form_row(form.plainPassword.first) }}
                {{ form_row(form.plainPassword.second) }}
                {{ form_widget(form.website) }}
                <div class="btn-list mt-3">
                    <button class="btn btn-primary">Изменить пароль</button>
                </div>
                {{ form_end(form) }}
            </div>
        </div>
    </div>
{% endblock %}
