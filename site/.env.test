# define your env variables for the test env here
KERNEL_CLASS='App\Kernel'
APP_SECRET='$ecretf0rt3st'
APP_ENV=test
APP_DEBUG=1
DATABASE_URL="postgresql://app:secret@site-postgres:5432/app_test?serverVersion=15&charset=utf8"

FEATURE_FUNDS_AND_WIDGET=false
WB_LEGACY_RECONCILE_ENABLED=false

TELEGRAM_WEBHOOK_URL=https://tg.example.test/telegram/webhook
TELEGRAM_WEBHOOK_SECRET=test-secret-123
TELEGRAM_API_BASE_URL=https://tg-proxy.example.test

APP_ENCRYPTION_KEY_FILE=%kernel.project_dir%/var/secrets/encryption_keys.test.json
APP_ENCRYPTION_CURRENT_KEY_VERSION=v1
APP_ENCRYPTION_FALLBACK_KEY=AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA=
# Тестовая карта версий для тестов ротации (v1 == FALLBACK_KEY, v2 — второй тестовый ключ)
APP_ENCRYPTION_KEYS_JSON='{"v1":"AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA=","v2":"AQEBAQEBAQEBAQEBAQEBAQEBAQEBAQEBAQEBAQEBAQE="}'

INTERNAL_AUTH_TOKEN=test-internal-token-0123456789abcdef
INTERNAL_ALLOWED_IPS=10.10.0.0/16,127.0.0.1
