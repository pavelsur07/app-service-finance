{
  "name": "list_cash_transactions",
  "description": "Фактические операции ДДС за период, включая разбивку по статьям.",
  "inputSchema": {
    "type": "object",
    "properties": {
      "dateFrom": {
        "type": "string",
        "format": "date"
      },
      "dateTo": {
        "type": "string",
        "format": "date"
      },
      "moneyAccountId": {
        "type": "string",
        "format": "uuid"
      },
      "categoryId": {
        "type": "string",
        "format": "uuid"
      },
      "direction": {
        "type": "string",
        "enum": [
          "INFLOW",
          "OUTFLOW"
        ]
      },
      "limit": {
        "type": "integer",
        "minimum": 1,
        "maximum": 100,
        "default": 50
      },
      "cursor": {
        "type": "string",
        "minLength": 1,
        "maxLength": 2048
      }
    },
    "required": [
      "dateFrom",
      "dateTo"
    ],
    "additionalProperties": false,
    "$schema": "https://json-schema.org/draft/2020-12/schema"
  },
  "outputSchema": {
    "type": "object",
    "properties": {
      "items": {
        "type": "array",
        "items": {
          "type": "object",
          "properties": {
            "id": {
              "type": "string",
              "format": "uuid"
            },
            "date": {
              "type": "string",
              "format": "date"
            },
            "moneyAccountId": {
              "type": "string",
              "format": "uuid"
            },
            "direction": {
              "type": "string",
              "enum": [
                "INFLOW",
                "OUTFLOW"
              ]
            },
            "amount": {
              "type": "string",
              "pattern": "^-?(0|[1-9][0-9]{0,15})\\.[0-9]{2}$"
            },
            "currency": {
              "type": "string",
              "minLength": 1,
              "maxLength": 3
            },
            "description": {
              "anyOf": [
                {
                  "type": "string",
                  "maxLength": 1024
                },
                {
                  "type": "null"
                }
              ]
            },
            "isTransfer": {
              "type": "boolean"
            },
            "splits": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "categoryId": {
                    "type": "string",
                    "format": "uuid"
                  },
                  "amount": {
                    "type": "string",
                    "pattern": "^-?(0|[1-9][0-9]{0,15})\\.[0-9]{2}$"
                  }
                },
                "required": [
                  "categoryId",
                  "amount"
                ],
                "additionalProperties": false
              }
            },
            "importSource": {
              "anyOf": [
                {
                  "type": "string",
                  "maxLength": 32
                },
                {
                  "type": "null"
                }
              ]
            }
          },
          "required": [
            "id",
            "date",
            "moneyAccountId",
            "direction",
            "amount",
            "currency",
            "description",
            "isTransfer",
            "splits",
            "importSource"
          ],
          "additionalProperties": false
        },
        "maxItems": 100
      },
      "nextCursor": {
        "anyOf": [
          {
            "type": "string",
            "minLength": 1,
            "maxLength": 2048
          },
          {
            "type": "null"
          }
        ]
      }
    },
    "required": [
      "items",
      "nextCursor"
    ],
    "additionalProperties": false,
    "$schema": "https://json-schema.org/draft/2020-12/schema"
  },
  "annotations": {
    "readOnlyHint": true,
    "destructiveHint": false,
    "idempotentHint": true,
    "openWorldHint": false
  }
}
