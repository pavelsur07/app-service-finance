{
  "name": "create_cash_draft",
  "description": "Создаёт один черновик платежа для проверки сотрудником.",
  "inputSchema": {
    "type": "object",
    "properties": {
      "externalId": {
        "type": "string",
        "minLength": 1,
        "maxLength": 128,
        "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]*$"
      },
      "moneyAccountId": {
        "type": "string",
        "format": "uuid"
      },
      "date": {
        "type": "string",
        "format": "date"
      },
      "direction": {
        "type": "string",
        "enum": [
          "INFLOW",
          "OUTFLOW"
        ]
      },
      "amount": {
        "type": "string",
        "pattern": "^(0|[1-9][0-9]{0,15})\\.[0-9]{2}$",
        "not": {
          "const": "0.00"
        }
      },
      "currency": {
        "type": "string",
        "enum": [
          "RUB",
          "USD",
          "EUR",
          "KZT"
        ]
      },
      "categoryId": {
        "type": "string",
        "format": "uuid"
      },
      "description": {
        "type": "string",
        "maxLength": 1024
      }
    },
    "required": [
      "externalId",
      "moneyAccountId",
      "date",
      "direction",
      "amount"
    ],
    "additionalProperties": false,
    "$schema": "https://json-schema.org/draft/2020-12/schema"
  },
  "outputSchema": {
    "type": "object",
    "properties": {
      "draftId": {
        "type": "string",
        "format": "uuid"
      },
      "source": {
        "const": "mcp"
      },
      "status": {
        "type": "string",
        "enum": [
          "awaiting_confirmation",
          "confirmed",
          "cancelled"
        ]
      }
    },
    "required": [
      "draftId",
      "source",
      "status"
    ],
    "additionalProperties": false,
    "$schema": "https://json-schema.org/draft/2020-12/schema"
  },
  "annotations": {
    "readOnlyHint": false,
    "destructiveHint": false,
    "idempotentHint": true,
    "openWorldHint": false
  }
}
