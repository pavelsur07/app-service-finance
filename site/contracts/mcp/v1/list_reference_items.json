{
  "name": "list_reference_items",
  "description": "Счета или статьи ДДС компании подключения.",
  "inputSchema": {
    "type": "object",
    "properties": {
      "kind": {
        "type": "string",
        "enum": [
          "money_accounts",
          "cashflow_categories"
        ]
      },
      "search": {
        "type": "string",
        "minLength": 1,
        "maxLength": 128
      },
      "limit": {
        "type": "integer",
        "minimum": 1,
        "maximum": 100,
        "default": 50
      },
      "cursor": {
        "type": "string",
        "minLength": 1,
        "maxLength": 2048
      }
    },
    "required": [
      "kind"
    ],
    "additionalProperties": false,
    "$schema": "https://json-schema.org/draft/2020-12/schema"
  },
  "outputSchema": {
    "type": "object",
    "oneOf": [
      {
        "type": "object",
        "properties": {
          "kind": {
            "const": "money_accounts"
          },
          "items": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "id": {
                  "type": "string",
                  "format": "uuid"
                },
                "name": {
                  "type": "string",
                  "minLength": 1
                },
                "currency": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 3
                }
              },
              "required": [
                "id",
                "name",
                "currency"
              ],
              "additionalProperties": false
            },
            "maxItems": 100
          },
          "nextCursor": {
            "anyOf": [
              {
                "type": "string",
                "minLength": 1,
                "maxLength": 2048
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "required": [
          "kind",
          "items",
          "nextCursor"
        ],
        "additionalProperties": false
      },
      {
        "type": "object",
        "properties": {
          "kind": {
            "const": "cashflow_categories"
          },
          "items": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "id": {
                  "type": "string",
                  "format": "uuid"
                },
                "name": {
                  "type": "string",
                  "minLength": 1
                },
                "parentId": {
                  "anyOf": [
                    {
                      "type": "string",
                      "format": "uuid"
                    },
                    {
                      "type": "null"
                    }
                  ]
                }
              },
              "required": [
                "id",
                "name",
                "parentId"
              ],
              "additionalProperties": false
            },
            "maxItems": 100
          },
          "nextCursor": {
            "anyOf": [
              {
                "type": "string",
                "minLength": 1,
                "maxLength": 2048
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "required": [
          "kind",
          "items",
          "nextCursor"
        ],
        "additionalProperties": false
      }
    ],
    "$schema": "https://json-schema.org/draft/2020-12/schema"
  },
  "annotations": {
    "readOnlyHint": true,
    "destructiveHint": false,
    "idempotentHint": true,
    "openWorldHint": false
  }
}
