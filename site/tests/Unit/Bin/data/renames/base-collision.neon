parameters:
	ignoreErrors:
		-
			message: '#^Method App\\Old\\Foo\:\:bar\(\) has no return type\.$#'
			identifier: test.rule
			count: 1
			path: src/Old/Foo.php

		-
			message: '#^Method App\\New\\Foo\:\:bar\(\) has no return type\.$#'
			identifier: test.rule
			count: 1
			path: src/New/Foo.php
