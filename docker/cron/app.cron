# ┌─ min  ┌ hour ┌ dom ┌ mon ┌ dow
# │       │      │     │     │

# Каждые 5 минут: авто-правила ДДС
#*/5 * * * * php /app/bin/console app:cash:auto-rules:enqueue --no-interaction

# Ночная синхронизация отчётов WB по реализации.
# Legacy WB daily command kept for backward compatibility; cron disabled after TASK-028-FIX.
# 0 3 * * * php bin/console app:marketplace:wb-daily-sync --no-interaction

# Новый WB financial sync: только загрузка за вчерашний день
10 3 * * * cd /app && php bin/console app:marketplace:wb-financial-reports:sync --mode=daily --max-days=1 --no-interaction --quiet >> /proc/1/fd/1 2>> /proc/1/fd/2

# Временно отключено: refresh последних 14 дней
#*/30 6-23 * * * cd /app && php bin/console app:marketplace:wb-financial-reports:sync --mode=refresh14 --max-days=1 --no-interaction --quiet >> /proc/1/fd/1 2>> /proc/1/fd/2

# Временно отключено: восстановление пропущенных дней
#10 * * * * cd /app && php bin/console app:marketplace:wb-financial-reports:sync --mode=missing --max-days=1 --no-interaction --quiet >> /proc/1/fd/1 2>> /proc/1/fd/2

# Оркестрация WB financial reports: каждый час восстанавливает текущий месяц
# плюс хвост предыдущего глубиной refresh-days-back (daily/retry/missing/empty),
# затем переобновляет последние 14 дней для задних правок WB. Хвост нужен,
# чтобы empty-день, записанный ночью 1-го числа, не выпадал из восстановления.
# Команда учитывает cooldown/LockableTrait и ставит не больше одной задачи на
# подключение за запуск.
#
# Окно с 03:20, а не с 00:20: WB формирует отчёт за вчера уже после полуночи, и
# прогоны 00:20/01:20/02:20 систематически получали пустой ответ. Они не только
# тратили лимит API, но и записывали дню статус empty со счётчиком attempts,
# который потом приходилось расчищать восстановлением. Первым за вчерашний день
# теперь ходит ingestion в 03:00 и wb-financial-reports:sync --mode=daily в
# 03:10, оркестратор подхватывает с 03:20. Цена: в сутках остаётся 21 прогон
# вместо 24, а за прогон ставится одна задача на подключение, поэтому при
# накопленном backlog восстановления ротация обновления 14 дней сдвигается.
20 3-23 * * * cd /app && php bin/console app:marketplace:wb-financial-reports:orchestrate --refresh-days-back=14 --no-interaction --quiet >> /proc/1/fd/1 2>> /proc/1/fd/2

# Почасовой обход заказов Ozon. Отдельная строка с --resource, а НЕ перевод
# всей команды run-incremental на час: иначе финансовые стратегии просыпались бы
# 24 раза в сутки без нужды. Каденция принадлежит ресурсу и выражена его
# cursorIsDue(); крон лишь даёт возможность.
35 * * * * cd /app && php bin/console app:ingestion:run-incremental --resource=ozon_orders_fbo --no-interaction --quiet >> /proc/1/fd/1 2>> /proc/1/fd/2
37 * * * * cd /app && php bin/console app:ingestion:run-incremental --resource=ozon_orders_fbs --no-interaction --quiet >> /proc/1/fd/1 2>> /proc/1/fd/2

# Почасовой обход заказов Wildberries. Потоков два, и оба нужны: marketplace
# знает состав заказа, statistics приносит отмены и правки задним числом.
# Разнесены по минутам, потому что у statistics-api лимит порядка одного
# запроса в минуту, и одновременный старт съел бы его впустую.
39 * * * * cd /app && php bin/console app:ingestion:run-incremental --resource=wildberries_orders_marketplace --no-interaction --quiet >> /proc/1/fd/1 2>> /proc/1/fd/2
41 * * * * cd /app && php bin/console app:ingestion:run-incremental --resource=wildberries_orders_statistics --no-interaction --quiet >> /proc/1/fd/1 2>> /proc/1/fd/2

# Почасовой перепрос статусов нетерминальных заказов.
#
# Потоки заказов фильтруются по времени СОЗДАНИЯ, поэтому заказ попадает в них
# один раз и его дальнейшие смены статуса не увидит никто. Отдельная строка
# после загрузок: сначала появляются новые заказы, затем опрашиваются старые.
47 * * * * cd /app && php bin/console app:ingestion:orders:refresh-statuses --no-interaction --quiet >> /proc/1/fd/1 2>> /proc/1/fd/2

# Освобождение ресурсов, заблокированных зависшими задачами синхронизации.
# findLatestForResource() считает активной любую задачу в OPEN/RUNNING БЕЗ
# ограничения по возрасту, поэтому воркер, убитый по SIGKILL или OOM, молча
# останавливает загрузку ресурса навсегда. Раз в час, дешёвый индексный запрос.
52 * * * * cd /app && php bin/console app:ingestion:reap-stale-jobs --no-interaction --quiet >> /proc/1/fd/1 2>> /proc/1/fd/2

# Каталог товаров Ozon -> листинги (наименование, offer_id, дата создания товара).
# Слот 03:40 выбран ДО финансовой выгрузки в 04:00, чтобы её процессоры видели уже
# именованные листинги. Команда только диспатчит; HTTP-обход каталога делает
# async_sync-воркер. Это единственный путь, видящий товары без продаж:
# /v3/product/list отдаёт весь каталог, а не то, что засветилось в деньгах.
# Соседи по суткам: 03:00 ingestion run-incremental, 03:10 WB financial daily.
40 3 * * * cd /app && php bin/console app:marketplace:ozon-listing-catalog:sync --no-interaction --quiet >> /proc/1/fd/1 2>> /proc/1/fd/2

# Ночная синхронизация отчётов Ozon по реализации.
#
# ОТКЛЮЧЕНО 09.09.2026. Ozon снял POST /v3/finance/transaction/list — единственный
# источник этой команды. Ответ: HTTP 400 {"code":9,"message":"obsolete method
# cannot be used"}. Последний успешный прогон — 08.09.2026 04:00.
#
# Оставлять включённой нельзя: каждая ночь клала 56 сообщений (4 подключения x
# 14 дней) в failed-транспорт, и это уже не сигнал, а шум — причина известна и
# ремонтом не лечится, пока не переписан адаптер.
#
# Включить обратно после Stage 4 задачи ozon-accrual-adapter, когда загрузка
# поедет на /v1/finance/accrual/by-day. Разбор — docs/tasks/ozon-accrual-adapter/plan.md.
#0 4 * * * php bin/console app:marketplace:ozon-daily-sync --no-interaction

# Замена: загрузка финансовых отчётов Ozon через /v1/finance/accrual/by-day.
#
# Окно 2 дня, а не 14, как у снятой команды. Причина не в экономии запросов:
# дни по 07.09.2026 включительно уже покрыты документами формата v3
# (document_type = sales_report), и их продажи лежат в marketplace_sales.
# Документы by-day с ними не конфликтуют — у by-day свой document_type, — но
# нормализованные строки не разводятся: уникальность marketplace_sales стоит на
# external_order_id, а ключи у путей разные (posting_number против
# ozon-accrual-{posting}-product-{i}). День, обработанный из обоих документов,
# дал бы двойной учёт продаж. Окно 2 дня до таких дней не дотягивается и
# при этом переживает суточную правку начислений задним числом: строки документа
# при перезагрузке заменяются целиком, поэтому правка доезжает до таблиц, а не
# оседает в сырье. Границу проверяет и сама команда (EARLIEST_SAFE_DAY).
#
# Известное ограничение: строки, уже привязанные к документу ОПиУ, замена не
# трогает. Текущий месяц закрывается предварительно в 04:45, поэтому правка Ozon
# по его дням доезжает не раньше следующего reopen. Разделение предварительной
# привязки и окончательной — работа Stage 2 задачи ozon-accrual-adapter.
0 4 * * * cd /app && php bin/console app:marketplace:ozon-financial-reports:sync --days-back=2 --no-interaction >> /proc/1/fd/1 2>> /proc/1/fd/2

# Гейт свежести под ту же загрузку: у активного seller-подключения обязан быть
# документ начислений за вчера. Ненулевой exit code = загрузка встала сейчас.
# Починка под гейт — команда выше, её окно вчерашний день покрывает.
50 6 * * * cd /app && php bin/console app:marketplace:ozon-financial-reports:freshness-check --no-interaction >> /proc/1/fd/1 2>> /proc/1/fd/2

# Inventory Ozon snapshot: запуск в 04:05 MSK, команда только инициирует pipeline; HTTP-загрузка выполняется async worker'ом.
5 4 * * * cd /app && php bin/console app:inventory:ozon-daily-sync --no-interaction >> /proc/1/fd/1 2>> /proc/1/fd/2

# Inventory WB snapshot: 04:15 MSK, зеркало Ozon-команды. Тоже только диспатч;
# handler дополнительно освежает каталог карточек (Content API) до чтения остатков,
# поэтому слот отдельный от Ozon, чтобы две выгрузки не толкались в async_sync.
# WB отдаёт остатки «на сейчас» — пропущенный день задним числом не восстановить.
15 4 * * * cd /app && php bin/console app:inventory:wb-daily-sync --no-interaction >> /proc/1/fd/1 2>> /proc/1/fd/2

# Read-only гейт свежести остатков. Ненулевой exit code означает «загрузка встала
# сейчас», а не «когда-то были пропуски»: проверяется возраст последнего снапшота,
# а не накопленное число исторических дыр.
#
# Охват равен охвату починки — только компании с активным подключением нужного
# маркетплейса. У компании без подключения загрузка не запускается, чинить нечего,
# и включение её сделало бы гейт вечно красным.
#
# Слот 05:30: больше часа после диспатча WB в 04:15, чтобы async-загрузка и
# нормализация успели завершиться, и до тяжёлого reconcile в 05:45. Порог свежести
# 2 суток, поэтому точное время некритично — оно лишь не даёт мерить в момент загрузки.
# Проверено на PROD 2026-09-06 через codex-psql-ro: 7 из 7 пар OK, гейт достижимо зелёный.
30 5 * * * cd /app && php bin/console app:inventory:stock-freshness-check --no-interaction >> /proc/1/fd/1 2>> /proc/1/fd/2

# Read-only гейт расхождений «остаток есть, карточки в каталоге нет». Маркетплейс
# может прислать остаток по варианту, которого нет в его же каталоге; листинг тогда
# не находится, и строка молча сохраняется с listing_id = NULL.
#
# Алертит только на варианты, чей ТЕКУЩИЙ эпизод непривязанности начался внутри окна
# (по умолчанию 2 дня). Накопленный остаток печатается метрикой и на exit code не
# влияет: разобрать его можно только вручную, и гейт на нём был бы вечно красным.
#
# Слот 05:40 — сразу после гейта свежести в 05:30, чтобы два инвентарных гейта шли
# подряд и их вывод читался вместе. Проверено на PROD 2026-09-07 прогоном самой
# команды: new 0, накопленных 9 вариантов / 309 строк, exit code 0.
40 5 * * * cd /app && php bin/console app:inventory:unmapped-stock-check --no-interaction >> /proc/1/fd/1 2>> /proc/1/fd/2

# Daily-sync: создаёт AdLoadJob за вчера для всех компаний с активным Ozon
# Performance подключением. Дальше работу подхватывают cron-driven worker'ы
# (scheduler → poller → finalizer → auto-extract), без ручных действий.
# Scheduler-контейнер запущен с TZ=Europe/Moscow → 30 4 = 04:30 MSK.
30 4 * * * php bin/console app:marketplace-ads:daily-sync --no-interaction --quiet

# Reconcile missed Ozon Performance ad spend days.
# Runs after daily ads sync window. Creates at most one recovery job per company per run.
# Covers transient 429/API failures and restores missing/failed days safely.
10,40 6-23 * * * php bin/console app:marketplace-ads:reconcile --marketplace=ozon --all-active --days-back=14 --include-rate-limited --no-interaction --quiet

# Poll Ozon Performance reports (async-poll redesign, step 5)
# Picks up pending reports in REQUESTED state, transitions state via
# GET /statistics/list (one call per company), dispatches download
# on state=OK. See ARCHITECTURE.md.
*/2 * * * * php bin/console app:marketplace-ads:ozon-poll-reports --quiet

# Cron-driven Ozon Performance pipeline (Task-11.9a, ARCHITECTURE v1.27).
# Заменяет event-driven Messenger-цепочку (FetchOzonAdStatisticsHandler →
# RequestOzonAdBatchHandler → DownloadOzonAdReportHandler). Старый
# ozon-poll-reports выше оставлен: обслуживает остатки in-flight
# OzonAdPendingReport'ов старого pipeline'а до Task-11.9b.
#
# Scheduler: берёт 1 PLANNED batch → POST /statistics → IN_FLIGHT.
# Минутный интервал — естественный rate-limiter под лимит Ozon «1
# активная выгрузка на аккаунт».
* * * * * php bin/console app:marketplace-ads:scheduler --no-interaction --quiet

# Poller: обрабатывает все IN_FLIGHT — poll GET /statistics/{uuid} +
# download + переход в OK/FAILED/ABANDONED. Двойной запуск с offset'ом
# 30 секунд даёт фактический ≤30-секундный lag между готовностью отчёта
# в Ozon и сохранением файла на диск. LockableTrait (Task-11.6) защищает
# от overlap: если предыдущий тик ещё не завершился, новый просто выйдет.
* * * * * php bin/console app:marketplace-ads:poller --no-interaction --quiet
* * * * * sleep 30 && php bin/console app:marketplace-ads:poller --no-interaction --quiet

# Finalizer: финализирует RUNNING job'ы когда все их batch'и терминальные
# (OK/FAILED/ABANDONED). Решение по статусу — по агрегату: all-OK →
# COMPLETED, 0-OK → FAILED, mix → PARTIAL_SUCCESS.
* * * * * php bin/console app:marketplace-ads:finalizer --no-interaction --quiet

# Wildberries advertising actual expense for the completed previous day.
# /adv/v1/upd is the financial source; /adv/v3/fullstats supplies nmId weights.
# Scheduler container uses TZ=Europe/Moscow, so this starts at 06:15 MSK.
15 6 * * * cd /app && php bin/console app:marketplace-ads:wb-daily-spend --no-interaction --quiet >> /proc/1/fd/1 2>> /proc/1/fd/2

# 10-е число каждого месяца в 6:00 Загрузка отчётов о реализации Ozon
0 6 5 * * php bin/console app:marketplace:ozon-realization-sync --env=prod

# Ежедневная пересборка предварительного («оперативного») закрытия
# текущего открытого месяца для всех активных SELLER-подключений.
# Запуск после ozon-daily-sync (04:00) и marketplace-ads:daily-sync (04:30),
# чтобы свежие сырые данные за вчера к этому моменту были загружены.
45 4 * * * php bin/console app:marketplace:month-preliminary-rebuild --no-interaction --quiet

# Раз в час: пересчёт оперативных P&L-агрегатов
#5 * * * * php /app/bin/console app:pl:rebuild --no-interaction

# Страховка для зависших PENDING raw-records: повторно ставит нормализацию в очередь.
*/10 * * * * cd /app && php bin/console app:ingestion:normalize-pending --limit=50 --no-interaction --quiet >> /proc/1/fd/1 2>> /proc/1/fd/2

# Ежедневный инкрементальный запуск нового Ingestion pipeline.
0 3 * * * cd /app && php bin/console app:ingestion:run-incremental --no-interaction --quiet

# Ежедневный rolling refresh Ozon accrual by-day: пере-fetch последних 45 дней,
# HTTP-загрузка выполняется async worker'ом, unchanged raw по hash не перенормализуется.
30 2 * * * cd /app && php bin/console app:ingestion:ozon-accrual:rolling-refresh --days-back=45 --limit=50 --execute --no-interaction --quiet >> /proc/1/fd/1 2>> /proc/1/fd/2

# Ежедневное обслуживание справочника категорий Ozon accrual:
# seed code mappings → refresh metadata for all companies/shops → discover/rebuild taxonomy → health-check.
15 5 * * * cd /app && php -d memory_limit=1G bin/console app:ingestion:ozon-accrual:daily-maintenance --days-back=45 --execute --no-interaction --quiet >> /proc/1/fd/1 2>> /proc/1/fd/2

# Ежедневная сверка Ozon accrual raw snapshot → FinancialTransaction projection.
# Первый проход отправляет stale raw records на нормализацию; второй проход
# после ingest_normalize workers дочищает товарное enrichment-связывание без повторного dispatch.
45 5 * * * cd /app && php -d memory_limit=1G bin/console app:ingestion:ozon-accrual:reconcile-financial-projection --days-back=30 --execute --dispatch-normalization --summary-only --no-interaction --quiet >> /proc/1/fd/1 2>> /proc/1/fd/2
30 6 * * * cd /app && php -d memory_limit=1G bin/console app:ingestion:ozon-accrual:reconcile-financial-projection --days-back=30 --execute --repair-enrichment-only --summary-only --no-interaction --quiet >> /proc/1/fd/1 2>> /proc/1/fd/2

# Read-only контроль после rolling refresh и normalize workers: latest raw coverage vs canonical.
45 6 * * * cd /app && php -d memory_limit=1G bin/console app:ingestion:ozon-accrual:verify-rolling-refresh --days-back=45 --limit=100 --no-interaction >> /proc/1/fd/1 2>> /proc/1/fd/2

# Ежедневно в 05:50: очистка сырья, вышедшего за год горячего хранения.
#
# Удаляется ПОЛЕЗНАЯ НАГРУЗКА, строка ingest_raw_records ОСТАЁТСЯ. Дорого стоит
# объект, а не сотня байт метаданных, и со строкой на месте указатели из
# ingest_financial_transactions, ingest_order_status_events и
# ingest_orders.last_raw_record_id остаются разрешимыми: ReadRawRecordAction
# отвечает внятным RawPayloadPrunedException, а не сбоем хранилища.
# Lifecycle-правило провайдера здесь не годится по той же причине: оно видит
# только объекты и не оставило бы признака, что нагрузку удалили НАМЕРЕННО.
#
# Возраст считается по «последний раз видели», а не по «скачали»: дедуп при
# часовом опросе обновляет отметку, не создавая новую запись.
#
# Слот 05:50 выбран как свободный: :15 и :45 того же часа заняты accrual-задачами,
# а на :35 приходится часовой заказный ingestion. Лимит на прогон ограничивает
# длительность; накопленное разбирается за несколько суток.
#
# ЗДЕСЬ СОЗНАТЕЛЬНО `--dry-run`. Удаление сырья необратимо и затрагивает
# production-аудит, поэтому включение `--execute` — решение Владельца на
# Production Gate, а не побочный эффект выкатки стадии. Пока команда каждую ночь
# печатает, сколько записей и байт УШЛО БЫ: это даёт настоящие цифры до того,
# как что-то будет удалено, и делает переключение осознанным.
50 5 * * * cd /app && php bin/console app:ingestion:raw:prune --dry-run --no-interaction >> /proc/1/fd/1 2>> /proc/1/fd/2

# Ежедневная загрузка Ozon Performance ingestion с начала месяца до вчерашнего дня.
# Команда только планирует SyncJob/chunks; HTTP-загрузка выполняется async worker'ом.
# Запуск вынесен после ночного marketplace/inventory/accrual окна.
25 7 * * * cd /app && php bin/console app:ingestion:ozon-performance:daily-load --window=month-to-date --execute --dispatch-spacing-seconds=120 --no-interaction --quiet >> /proc/1/fd/1 2>> /proc/1/fd/2

# Ежедневно в 02:10: снапшоты остатков по счетам
#10 2 * * * php /app/bin/console app:money-account:snapshot --no-interaction

# Ежедневно в 03:00: чистка логов/временных таблиц
#0 3 * * * php /app/bin/console app:maintenance:cleanup --env=prod

# Каждые 5 минут: синтетическая проверка живости объектного хранилища (write→read→delete).
# Сбой → logger->error → GlitchTip. Успех печатает "OK (N ms)" в docker logs (heartbeat).
*/5 * * * * cd /app && php bin/console app:storage:healthcheck --no-interaction >> /proc/1/fd/1 2>> /proc/1/fd/2

# Раз в час: живость SMTP (connect→EHLO→STARTTLS→AUTH→QUIT, письмо не отправляется).
# Сбой → logger->error → GlitchTip + exit 1. Успех печатает "OK (N ms)" в docker logs.
# Минута 7 — свободный слот: :00/:05/:10/:15/:20/:25/:30/:40/:45 уже заняты.
7 * * * * cd /app && php bin/console app:mailer:healthcheck --no-interaction >> /proc/1/fd/1 2>> /proc/1/fd/2

# Dead man's switch: пинг heartbeat-монитора GlitchTip. Молчание → монитор сам заводит issue.
# Отдельно от почтовой пробы: ловит смерть supercronic/контейнера, т.е. немоту ВСЕХ кронов.
# Пустой GLITCHTIP_SCHEDULER_HEARTBEAT_URL = выключено. wget, а не curl: busybox есть в alpine всегда.
*/30 * * * * [ -n "$GLITCHTIP_SCHEDULER_HEARTBEAT_URL" ] && wget -qO /dev/null --timeout=10 "$GLITCHTIP_SCHEDULER_HEARTBEAT_URL" || true
