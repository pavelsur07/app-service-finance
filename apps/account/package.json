{
  "name": "@vashfindir/account",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "preview": "vite preview --host 0.0.0.0",
    "typecheck": "tsc --noEmit",
    "lint": "cd ../.. && apps/account/node_modules/.bin/eslint --config apps/account/eslint.config.js apps/account site/packages apps/packages/ds --max-warnings=0 && cd apps/account && prettier --check . ../../site/packages && prettier --check --ignore-path ../packages/ds/.prettierignore ../packages/ds",
    "format": "prettier --write . ../../site/packages",
    "test": "vitest run",
    "build": "tsc --noEmit && vite build",
    "test:e2e": "playwright test",
    "prebuild": "node ../packages/ds/build/tokens.mjs --check",
    "test:components": "npm --prefix ../packages/ds ci --ignore-scripts --no-audit --no-fund && vite build --config tests/components/vite.config.ts && playwright test --config tests/components/playwright.config.ts",
    "posttest:e2e": "npm run test:components"
  },
  "dependencies": {
    "@vashfindir/api": "file:../../site/packages/api",
    "@vashfindir/ds": "file:../packages/ds",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-router": "^8.3.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.0",
    "@playwright/test": "1.56.1",
    "@tailwindcss/vite": "4.3.5",
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.1.4",
    "eslint": "^9.39.0",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-import": "^2.32.0",
    "jsdom": "31.0.1",
    "msw": "^2.15.0",
    "prettier": "^3.6.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.62.0",
    "vite": "^6.4.0",
    "vitest": "^3.2.4"
  },
  "allowScripts": {
    "esbuild": true,
    "msw": false
  }
}
