{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noImplicitAny": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noImplicitReturns": true,
    "noFallthroughCasesInSwitch": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "noEmit": true,
    "types": ["node"],
    "baseUrl": ".",
    "paths": {
      "react": ["../../account/node_modules/@types/react"],
      "react/*": ["../../account/node_modules/@types/react/*"],
      "react-dom/*": ["../../account/node_modules/@types/react-dom/*"],
      "vitest": ["../../account/node_modules/vitest"]
    },
    "resolveJsonModule": true,
    "typeRoots": ["../../account/node_modules/@types"]
  },
  "include": ["src"]
}
