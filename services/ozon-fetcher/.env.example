# Шаблон env сервиса. Значения не коммитятся; секреты — только через env
# (см. README «Переменные окружения» и services/AGENTS.md §9).

LISTEN_ADDR=:8080
# PostgreSQL сервисной БД (prod: общий инстанс в docker-сети, sslmode=disable; dev см. README).
# DB_DSN=postgres://svc_ozon_fetcher:<password>@<host>:5432/ozon_fetcher?sslmode=disable

# Ключи Ozon в env не задаются: приходят по кабинету из Symfony
# (GET /internal/marketplace-connections), живут только в памяти.
# SYMFONY_INTERNAL_BASE_URL=
# Токен «сервис → Symfony».
# INTERNAL_AUTH_TOKEN=
# Токен «Symfony → сервис» для /internal/* сервиса (≥ 32 символов); пусто — закрыт.
# SERVICE_API_TOKEN=
# CONNECTIONS_POLL_INTERVAL=5m
# MAX_PARALLEL_CONNECTIONS=

# GlitchTip (Sentry-протокол): только ERROR. Пусто — ошибки только в лог.
# SENTRY_DSN=
# SENTRY_RELEASE=
# SENTRY_ENVIRONMENT=prod

# S3 raw-хранилище (этап 8 плана): бакет vashfindir-services-raw,
# ключи — пары дополнительного пользователя, ограниченного этим бакетом.
# S3_ENDPOINT=https://s3.twcstorage.ru
# S3_REGION=ru-1
# S3_BUCKET=vashfindir-services-raw
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
