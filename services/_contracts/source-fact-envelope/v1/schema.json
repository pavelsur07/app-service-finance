{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "source-fact-envelope/v1",
  "title": "source-fact-envelope v1",
  "description": "Pull-канал фактов сервис → Symfony: GET /internal/source-facts (batches_response), GET /internal/source-facts/page (page_response), POST /internal/source-facts/ack (ack_request → ack_response). Факт — запись источника целиком.",
  "oneOf": [
    { "$ref": "#/$defs/batches_response" },
    { "$ref": "#/$defs/page_response" },
    { "$ref": "#/$defs/ack_request" },
    { "$ref": "#/$defs/ack_response" }
  ],
  "$defs": {
    "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "batch": {
      "type": "object",
      "additionalProperties": false,
      "required": ["batch_id", "connection_ref", "resource_type", "period_key", "revision", "content_hash", "page_count", "created_at"],
      "properties": {
        "batch_id": { "type": "string", "minLength": 1, "description": "Стабилен для ревизии периода" },
        "connection_ref": { "type": "string", "minLength": 1, "maxLength": 64 },
        "resource_type": { "type": "string", "minLength": 1 },
        "period_key": { "type": "string", "minLength": 1, "description": "YYYY-MM-DD | YYYY-Www | YYYY-MM — по ресурсу" },
        "revision": { "type": "integer", "minimum": 1 },
        "content_hash": { "$ref": "#/$defs/sha256", "description": "Хеш содержимого ревизии; меняется вместе с ревизией" },
        "page_count": { "type": "integer", "minimum": 1 },
        "created_at": { "type": "string", "format": "date-time" }
      }
    },
    "record": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source_key", "payload_hash", "payload"],
      "properties": {
        "source_key": { "type": "string", "minLength": 1, "maxLength": 255, "description": "Семантика — README контракта" },
        "payload_hash": { "$ref": "#/$defs/sha256", "description": "SHA-256 байтов записи в ответе источника; идентификатор версии записи" },
        "payload": { "type": "object", "description": "Запись источника без изменений" }
      }
    },
    "batches_response": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_version", "service", "batches", "next_cursor"],
      "properties": {
        "schema_version": { "const": "1" },
        "service": { "type": "string", "minLength": 1 },
        "batches": { "type": "array", "items": { "$ref": "#/$defs/batch" } },
        "next_cursor": { "type": ["string", "null"], "minLength": 1 }
      }
    },
    "page_response": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_version", "service", "batch_id", "page", "page_count", "record_count", "records"],
      "properties": {
        "schema_version": { "const": "1" },
        "service": { "type": "string", "minLength": 1 },
        "batch_id": { "type": "string", "minLength": 1 },
        "page": { "type": "integer", "minimum": 1 },
        "page_count": { "type": "integer", "minimum": 1 },
        "record_count": { "type": "integer", "minimum": 0, "description": "Равно длине records" },
        "records": { "type": "array", "items": { "$ref": "#/$defs/record" } }
      }
    },
    "ack_request": {
      "type": "object",
      "additionalProperties": false,
      "required": ["batch_ids"],
      "properties": {
        "batch_ids": { "type": "array", "minItems": 1, "maxItems": 1000, "items": { "type": "string", "minLength": 1 } }
      }
    },
    "ack_response": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_version", "acked"],
      "properties": {
        "schema_version": { "const": "1" },
        "acked": { "type": "integer", "minimum": 0, "description": "Подтверждено впервые этим вызовом" }
      }
    }
  }
}
