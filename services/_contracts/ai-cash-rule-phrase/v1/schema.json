{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:vashfindir:ai-cash-rule-phrase:v1",
  "$defs": {
    "input": {
      "type": "object", "additionalProperties": false, "required": ["examples"],
      "properties": {
        "examples": {
          "type": "array", "minItems": 1, "maxItems": 60,
          "items": {
            "type": "object", "additionalProperties": false, "required": ["text", "target"],
            "properties": {
              "text": {"type": "string", "minLength": 1, "maxLength": 1600},
              "target": {"type": "boolean"}
            }
          }
        }
      }
    },
    "output": {
      "type": "object", "additionalProperties": false, "required": ["phrase"],
      "properties": {"phrase": {"type": ["string", "null"], "minLength": 1, "maxLength": 255}}
    }
  }
}
